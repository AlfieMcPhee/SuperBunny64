function Menus.StartPhoto(back)
	screen = "photo"
	clear()
	deps.Hud.SetVisible(false)
	deps.SetOverlaysVisible(false)
	UI.label(layer, {
		Text = "PHOTO MODE   WASD / stick: move   hold right mouse / right stick: look   Q E: down / up   Shift: fast   BACKSPACE / B: done",
		TextSize = 14, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -8), Size = UDim2.new(1, 0, 0, 18), Stroke = 2, TextTransparency = 0.25,
	})
	deps.PhotoMode.Start(function()
		deps.Hud.SetVisible(true)
		deps.SetOverlaysVisible(true)
		back()
	end)
end

--------------------------------------------------------------------------------
-- Pause, warp, ending
--------------------------------------------------------------------------------

local function regionName()
	local id = deps.WorldFX.Region()
	for _, r in ipairs(Config.Regions) do
		if r.id == id then
			return r.name
		end
	end
	return ""
end

function Menus.Close()
	screen = nil
	clear()
	gui.Enabled = false
	deps.Hud.SetVisible(true)
	deps.Movement.SetEnabled(true)
end

local function showPause()
	screen = "pause"
	clear()
	gui.Enabled = true
	deps.Movement.SetEnabled(false)
	UI.backdrop(layer, 0.35)
	UI.title(layer, "PAUSED", 72, UDim2.new(0.5, 0, 0, 30), Vector2.new(0.5, 0))
	local slot = snap.slot
	if slot then
		UI.label(layer, {
			Text = string.format("FILE %s   -   %s   -   %d GOLDEN   -   %d CARROTS", FILE_LETTERS[snap.active or 1], regionName(), slot.goldenCount, slot.carrotCount),
			TextSize = 20, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 120), Size = UDim2.new(1, 0, 0, 24), Stroke = 2,
		})
	end
	local panel = UI.panel(layer, UDim2.fromOffset(460, 470), UDim2.fromScale(0.5, 0.6))
	local list = Instance.new("Frame")
	list.BackgroundTransparency = 1
	list.Size = UDim2.new(1, -30, 1, -30)
	list.Position = UDim2.fromOffset(15, 15)
	list.Parent = panel
	UI.list(list, 4)
	local resume = UI.item(list, "RESUME", { LayoutOrder = 1 })
	local map = UI.item(list, "MAP", { LayoutOrder = 2 })
	local log = UI.item(list, "CARROT LOG", { LayoutOrder = 3 })
	local stamps = UI.item(list, "STAMPS", { LayoutOrder = 4 })
	local custom = UI.item(list, "CUSTOMISE", { LayoutOrder = 5 })
	local photo = UI.item(list, "PHOTO MODE", { LayoutOrder = 6 })
	local options = UI.item(list, "OPTIONS", { LayoutOrder = 7 })
	local quit = UI.item(list, "SAVE & QUIT", { LayoutOrder = 8 })
	local backToPause = function()
		showPause()
	end
	UI.SetNav({
		{ button = resume, select = Menus.Close },
		{ button = map, select = function() Menus.ShowMap(backToPause) end },
		{ button = log, select = function() showLog(backToPause) end },
		{ button = stamps, select = function() Menus.ShowStamps(backToPause) end },
		{ button = custom, select = function() showCustomise(backToPause) end },
		{ button = photo, select = function() Menus.StartPhoto(backToPause) end },
		{ button = options, select = function() showOptions(backToPause) end },
		{ button = quit, select = function()
			confirm("SAVE AND QUIT TO THE TITLE SCREEN?", function()
				deps.onQuit()
			end, backToPause)
		end },
	}, Menus.Close)
end

function Menus.TogglePause()
	if screen == nil and snap and snap.slot then
		deps.Effects.Play("MenuSelect", 0.9)
		showPause()
	elseif screen == "pause" then
		Menus.Close()
	end
end

function Menus.ShowWarp(ids)
	if screen ~= nil then
		return
	end
	screen = "warp"
	clear()
	gui.Enabled = true
	deps.Movement.SetEnabled(false)
	UI.backdrop(layer, 0.4)
	UI.title(layer, "BURROW WARP", 60, UDim2.new(0.5, 0, 0, 40), Vector2.new(0.5, 0))
	local panel = UI.panel(layer, UDim2.fromOffset(460, 80 + 50 * (#ids + 1)), UDim2.fromScale(0.5, 0.55))
	local list = Instance.new("Frame")
	list.BackgroundTransparency = 1
	list.Size = UDim2.new(1, -30, 1, -30)
	list.Position = UDim2.fromOffset(15, 15)
	list.Parent = panel
	UI.list(list, 6)
	UI.label(list, { Text = "Where to, little bunny?", TextSize = 18, LayoutOrder = 0, Size = UDim2.new(1, 0, 0, 30), Stroke = 2 })
	local entries = {}
	for i, id in ipairs(ids) do
		local name = id
		for _, w in ipairs(Config.Warps) do
			if w.id == id then
				name = w.name
			end
		end
		local b = UI.item(list, name, { LayoutOrder = i })
		table.insert(entries, { button = b, select = function()
			deps.Remotes.Warp:FireServer(id)
			Menus.Close()
		end })
	end
	local cancel = UI.item(list, "STAY HERE", { LayoutOrder = 100 })
	table.insert(entries, { button = cancel, select = Menus.Close })
	UI.SetNav(entries, Menus.Close)
end

local CREDITS = {
	{ "BUNNY 64", true },
	{ "" },
	{ "STARRING", true }, { "A plush bunny with a patched ear" },
	{ "" },
	{ "FRIENDS", true }, { "Elder Shellby" }, { "Granny Clover" }, { "Pip" }, { "Prospector Digby" }, { "Guard Nibbles" }, { "Sir Ember" },
	{ "" },
	{ "BADDIES", true }, { "Grumblebugs" }, { "Hopscotch Toads" }, { "Flitbats" }, { "Thornhogs" }, { "Puffshrooms" },
	{ "and King Grumble as himself" },
	{ "" },
	{ "MUSIC", true }, { "Bunny's Theme and its many moods" },
	{ "" },
	{ "PLACES", true }, { "Carrot Meadow" }, { "Frostbite Peaks" }, { "Dustbowl Canyon" }, { "The Infernal Castle" },
	{ "" },
	{ "FOR", true }, { "everyone who ever chased" }, { "one more golden carrot" },
	{ "" }, { "" },
	{ "THANK YOU FOR PLAYING", true },
}

local function rollCredits(done)
	screen = "credits"
	clear()
	gui.Enabled = true
	UI.backdrop(layer, 0.05)
	bunnyViewport(layer, UDim2.fromOffset(220, 220), UDim2.new(0.82, 0, 0.5, 0), snap.menu.custom)
	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.AnchorPoint = Vector2.new(0.5, 0)
	holder.Size = UDim2.new(0.6, 0, 0, #CREDITS * 40)
	holder.Position = UDim2.new(0.42, 0, 1, 20)
	holder.Parent = layer
	for i, line in ipairs(CREDITS) do
		UI.label(holder, {
			Text = line[1], Font = line[2] and UI.TITLE or UI.BODY, TextSize = line[2] and 34 or 24,
			TextColor3 = line[2] and UI.Gold or UI.Cream, Size = UDim2.new(1, 0, 0, 38),
			Position = UDim2.fromOffset(0, (i - 1) * 40), Stroke = line[2] and 4 or 3,
		})
	end
	local finished = false
	local function finish()
		if finished then
			return
		end
		finished = true
		done()
	end
	local roll = TweenService:Create(holder, TweenInfo.new(32, Enum.EasingStyle.Linear), { Position = UDim2.new(0.42, 0, 0, -#CREDITS * 40 - 20) })
	roll:Play()
	roll.Completed:Connect(finish)
	local skip = UI.item(layer, "SKIP", { Size = UDim2.fromOffset(140, 36), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -12), TextSize = 20 })
	UI.SetNav({ { button = skip, select = function()
		roll:Cancel()
		finish()
	end } })
end

function Menus.ShowEnding(s)
	gui.Enabled = true
	deps.Movement.SetEnabled(false)
	deps.Effects.SetMusic("ending") -- "Home Again": the full reprise of Bunny's Theme
	rollCredits(function()
		Menus.ShowEndingCard(s)
	end)
end

function Menus.ShowEndingCard(s)
	screen = "ending"
	clear()
	gui.Enabled = true
	deps.Movement.SetEnabled(false)
	UI.backdrop(layer, 0.2)
	UI.title(layer, "CONGRATULATIONS!", 76, UDim2.new(0.5, 0, 0, 40), Vector2.new(0.5, 0))
	bunnyViewport(layer, UDim2.fromOffset(260, 260), UDim2.fromScale(0.5, 0.42), snap.menu.custom)
	local panel = UI.panel(layer, UDim2.fromOffset(640, 210), UDim2.fromScale(0.5, 0.76))
	UI.label(panel, { Text = "Every golden carrot is home and King Grumble has learned his manners.\nThanks for playing BUNNY 64!", TextSize = 20, TextWrapped = true, Size = UDim2.new(1, -40, 0, 70), Position = UDim2.fromOffset(20, 16) })
	UI.label(panel, {
		Text = string.format("CLEAR TIME %s     CARROTS %d/%d", fmtTime(s.slot.completedTime), s.slot.carrotCount, s.totalCarrots or 0),
		Font = UI.TITLE, TextSize = 26, TextColor3 = UI.Gold, Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 96),
	})
	local keep = UI.item(panel, "KEEP EXPLORING", { Size = UDim2.fromOffset(300, 44), Position = UDim2.new(0.5, -150, 1, -58) })
	local function finish()
		deps.WorldFX.ResetRegion() -- back to the area's own music and lighting
		Menus.Close()
	end
	UI.SetNav({ { button = keep, select = finish } }, finish)
end

--------------------------------------------------------------------------------
-- Starting / quitting a file
--------------------------------------------------------------------------------

function Menus.StartFile(index)
	if screen ~= "files" then
		return
	end
	screen = "loading"
	clear()
	UI.backdrop(layer, 0)
	UI.title(layer, "LOADING FILE " .. FILE_LETTERS[index] .. "...", 48, UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5))
	local ok = deps.Remotes.SelectSlot:InvokeServer(index)
	if not ok then
		screen = "files"
		showFiles(false)
		return
	end
	local char = player.Character or player.CharacterAdded:Wait()
	char:WaitForChild("Humanoid", 10)
	task.wait(0.3)
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Custom
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		cam.CameraSubject = hum
	end
	deps.onPlay()
	Menus.Close()
end

function Menus.BackToTitle()
	screen = "files"
	gui.Enabled = true
	deps.Hud.SetVisible(false)
	deps.Movement.SetEnabled(false)
	workspace.CurrentCamera.CameraType = Enum.CameraType.Scriptable
	deps.Effects.SetMusic("title")
	showFiles(false)
end

function Menus.SetSnapshot(s)
	local first = snap == nil
	snap = s
	if first and deps then
		Menus.ApplyControls() -- the player's saved key bindings
	end
end

function Menus.Screen()
	return screen
end

function Menus.Init(dependencies)
	deps = dependencies
	UI.Sound = function(name, speed)
		deps.Effects.Play(name, speed)
	end
	gui = Instance.new("ScreenGui")
	gui.Name = "Bunny64Menus"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 10
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = player:WaitForChild("PlayerGui")
	layer = Instance.new("Frame")
	layer.BackgroundTransparency = 1
	layer.Size = UDim2.fromScale(1, 1)
	layer.Parent = gui
	scaler = Instance.new("UIScale")
	scaler.Parent = layer

	-- shrink menus to fit small screens
	local function rescale()
		local size = workspace.CurrentCamera.ViewportSize
		local s = math.min(1, size.X / 900, size.Y / 640)
		scaler.Scale = s
		layer.Size = UDim2.fromScale(1 / s, 1 / s)
	end
	rescale()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)

	-- attract-mode camera while on the title / file screens
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Scriptable
	RunService.RenderStepped:Connect(function(dt)
		if screen ~= nil and not snap or (screen ~= nil and not (snap and snap.slot)) then
			orbit += dt * 0.06
			local pos = Vector3.new(math.cos(orbit) * 190, 75 + math.sin(orbit * 1.7) * 15, 60 + math.sin(orbit) * 190)
			cam.CameraType = Enum.CameraType.Scriptable
			cam.CFrame = CFrame.lookAt(pos, Vector3.new(0, 25, 0))
		end
	end)

	Menus.ApplyControls()

	showTitle()
end

return Menus
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000025"><Properties><string name="Name">Movement</string><ProtectedString name="Source"><![CDATA[--[[
	Movement - the bunny's moveset on top of Roblox's humanoid.

	  Jump            Space / A / jump button
	  Double jump     jump again in the air (with a front flip)
	  Roll            Shift / Q / X / ROLL button: a quick tumble that bops bugs
	  Long jump       jump during a roll or a slide
	  Slide           Crouch (C / Ctrl / E / B / CROUCH button) while running.
	                  Ice chutes start a slide automatically; steer with the stick.
	  Ground pound    Crouch in the air
	  Wall jump       jump while pressed against a wall in mid-air

	Game-feel helpers (the invisible stuff good platformers do):
	  coyote time     you can still jump for a moment after running off a ledge
	  jump buffer     pressing jump just before landing jumps as soon as you land
	  variable jump   let go of jump early for a short hop, hold for full height
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Bunny64")
local Config = require(Shared:WaitForChild("Config"))

local player = Players.LocalPlayer
local HST = Enum.HumanoidStateType
local DOWN = Vector3.new(0, -1, 0)

local Movement = {}

local Effects, Remotes
local enabled = false
local controls = nil

local character, humanoid, root, lv
local move = "" -- "", roll, longjump, slide, pound
local moveStart = 0
local moveDir = Vector3.new(0, 0, -1)
local moveSpeed = 0
local usedDouble = false
local flipAt = -10
local lastGrounded = 0
local lastJumpRequest = 0
local lastRollEnd = 0
local lastBounce = 0
local airborneSince = nil
local sentMove = nil
local flying = false -- admin fly mode (client/AdminPanel) takes over movement
local windFolder = nil -- workspace.Bunny64World.Winds, found on first use
local inWind = false
local jumpedSinceGround = false
local jumpRising = false
local bufferUntil = 0
local lastVy = 0
local nextDust = 0
local celebrateUntil = 0
local emote, emoteStart = nil, 0 -- wave / dance / sit
local talking = false
local COYOTE_TIME = 0.13
local BUFFER_TIME = 0.15
local DUST = Color3.fromRGB(206, 196, 176)
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function sendMove(name)
	if name ~= sentMove then
		sentMove = name
		Remotes.SetMove:FireServer(name)
	end
end

local function setPlane(vec)
	if lv then
		lv.PlaneVelocity = Vector2.new(vec.X, vec.Z)
	end
end

local function setMove(name)
	move = name
	moveStart = os.clock()
	if lv then
		lv.Enabled = (name == "roll" or name == "longjump" or name == "slide" or name == "walljump")
	end
	if name == "" then
		sendMove(os.clock() - flipAt < 0.5 and "flip" or "")
	else
		sendMove(name)
	end
end

local function grounded()
	return humanoid and humanoid.FloorMaterial ~= Enum.Material.Air
end

local function inAir()
	if not humanoid then
		return false
	end
	local s = humanoid:GetState()
	return s == HST.Freefall or s == HST.Jumping
end

local function flatVelocity()
	local v = root.AssemblyLinearVelocity
	return Vector3.new(v.X, 0, v.Z)
end

local function facingDir()
	local md = humanoid.MoveDirection
	if md.Magnitude > 0.1 then
		return Vector3.new(md.X, 0, md.Z).Unit
	end
	local look = root.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	return flat.Magnitude > 0.01 and flat.Unit or Vector3.new(0, 0, -1)
end

-- Walls push back on the velocity we command; follow what physics actually
-- did so the bunny glances along walls instead of grinding into them.
local function followActual()
	local actual = flatVelocity()
	if actual.Magnitude > 4 then
		local d = actual.Unit
		if d:Dot(moveDir) < 0.995 then
			moveDir = d
		end
		if actual.Magnitude < moveSpeed * 0.5 then
			moveSpeed = actual.Magnitude + 4
		end
	end
end

local function floorHit()
	return workspace:Raycast(root.Position, Vector3.new(0, -5, 0), rayParams)
end

--------------------------------------------------------------------------------
-- Moves
--------------------------------------------------------------------------------

local function launch(velocity, kind)
	if not root then
		return
	end
	if move ~= "" then
		setMove("")
	end
	usedDouble = false
	root.AssemblyLinearVelocity = velocity
	if humanoid and velocity.Y > 0 then
		humanoid:ChangeState(HST.Freefall)
	end
	if kind == "stomp" then
		Effects.Play("Stomp", 1.3)
	elseif kind == "hurt" then
		Effects.Play("Hurt", 0.8)
		Effects.Shake(0.8, 0.3)
	elseif kind == "burn" then
		Effects.Play("Burn", 1.3)
		Effects.Shake(0.6, 0.25)
	end
end

local function startRoll()
	if flying or not enabled or not root or move ~= "" or not grounded() or os.clock() - lastRollEnd < Config.RollCooldown then
		return
	end
	moveDir = facingDir()
	moveSpeed = Config.RollSpeed
	setMove("roll")
	setPlane(moveDir * moveSpeed)
	Effects.Play("Roll", 0.9)
	Effects.Burst(root.Position - Vector3.new(0, 2.4, 0), Config.Palette.Path, 5, 3, 0.5, 1)
end

local function startLongJump(speed)
	moveSpeed = math.max(speed or 0, Config.LongJumpSpeed)
	setMove("longjump")
	usedDouble = true -- no double jump out of a long jump
	local v = root.AssemblyLinearVelocity
	root.AssemblyLinearVelocity = Vector3.new(v.X, Config.LongJumpUp, v.Z)
	setPlane(moveDir * moveSpeed)
	task.defer(function()
		-- the humanoid applies its own jump this frame; make sure our arc wins
		if root and move == "longjump" and root.AssemblyLinearVelocity.Y < Config.LongJumpUp - 5 then
			local v2 = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(v2.X, Config.LongJumpUp, v2.Z)
		end
	end)
	Effects.Play("DoubleJump", 0.8)
end

local function startSlide(onChute)
	local hv = flatVelocity()
	if not onChute and hv.Magnitude < 10 then
		return
	end
	moveDir = hv.Magnitude > 1 and hv.Unit or facingDir()
	moveSpeed = math.max(hv.Magnitude, onChute and 30 or Config.SlideStartSpeed)
	setMove("slide")
	setPlane(moveDir * moveSpeed)
	Effects.Play("Roll", 0.7)
end

local function startPound()
	if not enabled or not root or move == "pound" or not inAir() or os.clock() - lastGrounded < 0.1 then
		return
	end
	setMove("pound")
	Remotes.Pound:FireServer("start")
	Effects.Play("Pound", 1.4)
end

local function landPound()
	setMove("")
	local pos = root.Position - Vector3.new(0, 2.6, 0)
	Remotes.Pound:FireServer("land", pos)
	Effects.Shake(1.2, 0.3)
	Effects.Play("Land", 0.8)
end

local function crouch()
	if flying or not enabled or not root then
		return
	end
	if move == "" or move == "longjump" then
		if inAir() and not grounded() then
			startPound()
		elseif move == "" then
			startSlide(false)
		end
	end
end

-- A wall right in front of us (or where the stick points)?
local function findWall()
	local dirs = { facingDir() }
	local md = humanoid.MoveDirection
	if md.Magnitude > 0.1 then
		table.insert(dirs, Vector3.new(md.X, 0, md.Z).Unit)
	end
	for _, d in ipairs(dirs) do
		for _, h in ipairs({ 0, 1.2 }) do
			local hit = workspace:Raycast(root.Position + Vector3.new(0, h, 0), d * 2.8, rayParams)
			if hit and math.abs(hit.Normal.Y) < 0.35 and not hit.Instance:GetAttribute("Lava") then
				return hit
			end
		end
	end
	return nil
end

local function wallJump(hit)
	local n = Vector3.new(hit.Normal.X, 0, hit.Normal.Z).Unit
	moveDir = n
	moveSpeed = 40
	setMove("walljump")
	usedDouble = false -- a wall jump gives you your double jump back
	jumpRising = false
	root.CFrame = CFrame.lookAt(root.Position, root.Position + n)
	root.AssemblyLinearVelocity = n * moveSpeed + Vector3.new(0, 60, 0)
	setPlane(n * moveSpeed)
	flipAt = os.clock()
	Effects.Play("Stomp", 1.6)
	Effects.Burst(hit.Position, DUST, 6, 3, 0.5, 2)
end

local function tryJumpMove()
	if flying or not enabled or not root or os.clock() < celebrateUntil then
		return
	end
	local now = os.clock()
	if move == "roll" or (move == "slide" and now - moveStart > 0.08) then
		startLongJump(moveSpeed + 10)
		return
	end
	-- coyote time: walked off a ledge a moment ago and haven't jumped yet
	if move == "" and not grounded() and not jumpedSinceGround and now - lastGrounded < COYOTE_TIME then
		jumpedSinceGround = true
		jumpRising = true
		local v = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(v.X, Config.JumpPower, v.Z)
		humanoid:ChangeState(HST.Jumping)
		Effects.Play("Jump", 1.05)
		return
	end
	if (move == "" or move == "longjump") and inAir() and now - lastGrounded > 0.12 then
		local wall = findWall()
		if wall then
			wallJump(wall)
			return
		end
	end
	if move ~= "" or usedDouble or not inAir() or now - lastGrounded < 0.15 then
		-- remember the press: if we land in the next moment, jump right away
		if not grounded() then
			bufferUntil = now + BUFFER_TIME
		end
		return
	end
	usedDouble = true
	jumpRising = true
	flipAt = now
	sendMove("flip")
	local v = root.AssemblyLinearVelocity
	root.AssemblyLinearVelocity = Vector3.new(v.X, Config.DoubleJumpPower, v.Z)
	Effects.Play("DoubleJump", 1.1)
	Effects.Burst(root.Position - Vector3.new(0, 2.5, 0), Color3.fromRGB(230, 222, 204), 6, 4, 0.5, -1)
end

--------------------------------------------------------------------------------
-- Character setup
--------------------------------------------------------------------------------

-- The world (especially terrain) reaches each player a moment after they join.
-- Hold the bunny in place until there's ground under it, so a fresh spawn or a
-- teleport can never drop it through a world that hasn't loaded yet.
local holdToken = nil
local function holdUntilGround(minTime)
	if not root then
		return
	end
	local token = {}
	holdToken = token
	local myRoot = root
	myRoot.Anchored = true
	task.spawn(function()
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { character, Effects.Folder }
		local start = os.clock()
		task.wait(minTime or 0.5) -- let the server move us to the checkpoint first
		local shown = false
		while holdToken == token and myRoot.Parent and os.clock() - start < 20 do
			local hit = workspace:Raycast(myRoot.Position + Vector3.new(0, 2, 0), Vector3.new(0, -24, 0), params)
			if hit then
				break
			end
			if not shown and os.clock() - start > 1.5 and Movement.OnLoading then
				shown = true
				Movement.OnLoading()
			end
			task.wait(0.1)
		end
		if holdToken == token and myRoot.Parent then
			myRoot.AssemblyLinearVelocity = Vector3.zero
			myRoot.Anchored = false
		end
	end)
end

local function onCharacter(char)
	character = char
	flying = false
	emote = nil
	talking = false
	humanoid = char:WaitForChild("Humanoid")
	root = char:WaitForChild("HumanoidRootPart")
	move = ""
	usedDouble = false
	sentMove = nil
	rayParams.FilterDescendantsInstances = { char, Effects.Folder }

	local att = Instance.new("Attachment")
	att.Name = "MoveAttachment"
	att.Parent = root
	lv = Instance.new("LinearVelocity")
	lv.Name = "MoveVelocity"
	lv.Attachment0 = att
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	lv.PrimaryTangentAxis = Vector3.new(1, 0, 0)
	lv.SecondaryTangentAxis = Vector3.new(0, 0, 1)
	lv.MaxForce = 200000
	lv.Enabled = false
	lv.Parent = root
	holdUntilGround(0.5)

	jumpedSinceGround = false
	jumpRising = false
	celebrateUntil = 0
	humanoid.StateChanged:Connect(function(_, new)
		if new == HST.Landed or new == HST.Running then
			usedDouble = false
			jumpedSinceGround = false
			jumpRising = false
			lastGrounded = os.clock()
			if new == HST.Landed and lastVy < -55 then
				Effects.Ring(root.Position - Vector3.new(0, 2.6, 0), DUST, 5, 10, 0.3)
			end
			-- jump buffer: jump was pressed just before touching down
			if os.clock() < bufferUntil and enabled and move == "" then
				bufferUntil = 0
				task.defer(function()
					if humanoid and humanoid.Parent then
						humanoid:ChangeState(HST.Jumping)
					end
				end)
			end
		elseif new == HST.Jumping then
			lastGrounded = os.clock()
			jumpedSinceGround = true
			jumpRising = true
			if move == "" then
				Effects.Play("Jump", 1 + math.random() * 0.1)
			end
		end
	end)
end

function Movement.SetEnabled(on)
	enabled = on
	if controls then
		if on then
			controls:Enable()
		else
			controls:Disable()
		end
	end
	if not on and move ~= "" and root then
		setMove("")
	end
end

function Movement.SetFlying(on)
	flying = on
	if on and move ~= "" and root then
		setMove("")
	end
end

-- Emotes: wave, dance or sit until you move (wave ends on its own)
function Movement.Emote(id)
	if not enabled or flying or not root or move ~= "" or not grounded() then
		return
	end
	if emote == id then
		emote = nil
		sendMove("")
		return
	end
	emote = id
	emoteStart = os.clock()
	sendMove(id)
end

local function endEmote()
	if emote then
		emote = nil
		sendMove("")
	end
end

-- While chatting with a friend: shown to others, and baddies leave you alone
function Movement.SetTalking(on)
	talking = on
	endEmote()
	if root then
		sendMove(on and "talk" or "")
	end
end

-- Golden-carrot celebration: a little cheer, controls paused for a moment
function Movement.Celebrate(duration)
	if not root or flying then
		return
	end
	if move ~= "" then
		setMove("")
	end
	celebrateUntil = os.clock() + duration
	sendMove("cheer")
	if controls and enabled then
		controls:Disable()
	end
	if grounded() then
		root.AssemblyLinearVelocity = Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
	end
	task.delay(duration, function()
		if os.clock() >= celebrateUntil - 0.01 then
			sendMove("")
			if controls and enabled then
				controls:Enable()
			end
		end
	end)
end

-- Is the player holding jump? (humanoid.Jump mirrors the jump input on every device)
local jumpCodes = { Enum.KeyCode.Space, Enum.KeyCode.ButtonA }
local function jumpHeld()
	if humanoid and humanoid.Jump then
		return true
	end
	for _, code in ipairs(jumpCodes) do
		local isPad = string.sub(code.Name, 1, 6) == "Button" or string.sub(code.Name, 1, 4) == "DPad"
		if isPad then
			if UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, code) then
				return true
			end
		elseif UserInputService:IsKeyDown(code) then
			return true
		end
	end
	return false
end

function Movement.GetControls()
	return controls
end

function Movement.IsEnabled()
	return enabled
end

-- For the animator: what is the local bunny doing right now?
function Movement.State()
	return {
		move = flying and "fly"
			or (os.clock() < celebrateUntil and "cheer")
			or (talking and "talk")
			or (move == "" and emote)
			or move,
		moveStart = moveStart,
		flipAt = flipAt,
		speed = moveSpeed,
	}
end

--------------------------------------------------------------------------------
-- Per-frame update
--------------------------------------------------------------------------------

-- Springy mushrooms: launch the bunny when it lands on one. (Detected with a
-- ray straight down, because the bunny's collision box hovers above the
-- ground and never actually "touches" what it stands on.)
local function bounceOff(part)
	local now = os.clock()
	if not root or now - lastBounce < 0.4 then
		return
	end
	lastBounce = now
	local power = part:GetAttribute("Bounce") or Config.MushroomBounce
	if move == "pound" then
		power *= 1.15
	end
	local v = root.AssemblyLinearVelocity
	launch(Vector3.new(v.X, power, v.Z), "bounce")
	Effects.Play("Boing", 0.7)
	Effects.Burst(part.Position + Vector3.new(0, part.Size.Y / 2, 0), part.Color, 10, 8, 0.7, 3)
end

local function step(dt)
	if not root or not humanoid or humanoid.Health <= 0 or flying then
		return
	end
	local now = os.clock()
	local onGround = grounded()
	if onGround then
		lastGrounded = now
		airborneSince = nil
	elseif not airborneSince then
		airborneSince = now
	end

	local vel = root.AssemblyLinearVelocity
	if emote then
		local moving = humanoid.MoveDirection.Magnitude > 0.1 or not onGround or move ~= ""
		if moving or (emote == "wave" and now - emoteStart > 2.6) then
			endEmote()
		end
	end
	-- variable jump height: letting go early cuts the jump short
	if jumpRising then
		if vel.Y <= 0 then
			jumpRising = false
		elseif move == "" and vel.Y > 16 and not jumpHeld() then
			root.AssemblyLinearVelocity = Vector3.new(vel.X, vel.Y * 0.45, vel.Z)
			jumpRising = false
		end
	end
	-- running dust
	if onGround and move == "" and now > nextDust and Vector3.new(vel.X, 0, vel.Z).Magnitude > 20 then
		nextDust = now + 0.16
		Effects.Burst(root.Position - Vector3.new(0, 2.5, 0), DUST, 2, 2, 0.45, 0.8)
	end
	lastVy = vel.Y

	-- landed on a bounce pad?
	if root.AssemblyLinearVelocity.Y < 5 then
		local under = floorHit()
		if under and under.Instance:GetAttribute("Bounce") and root.Position.Y - under.Position.Y < 3.6 then
			bounceOff(under.Instance)
		end
	end

	-- rising winds and gusts (Cloudtop Heights): parts in the world's Winds folder
	if not windFolder then
		local world = workspace:FindFirstChild("Bunny64World")
		windFolder = world and world:FindFirstChild("Winds")
	end
	local nowInWind = false
	if windFolder then
		local pos = root.Position
		for _, w in ipairs(windFolder:GetChildren()) do
			local force = w:GetAttribute("Wind")
			if typeof(force) == "Vector3" and w:IsA("BasePart") then
				local lp = w.CFrame:PointToObjectSpace(pos)
				local half = w.Size / 2
				if math.abs(lp.X) < half.X and math.abs(lp.Z) < half.Z and lp.Y > -half.Y - 3 and lp.Y < half.Y then
					nowInWind = true
					local v = root.AssemblyLinearVelocity
					local vy = force.Y > 0 and math.max(v.Y, force.Y) or v.Y
					local push = Vector3.new(force.X, 0, force.Z) * math.clamp(dt * 3, 0, 1)
					root.AssemblyLinearVelocity = Vector3.new(v.X + push.X, vy, v.Z + push.Z)
					if not inWind and force.Y > 0 then
						humanoid:ChangeState(HST.Freefall)
						jumpRising = false
						if move == "pound" then
							setMove("")
						end
					end
					usedDouble = false -- the wind gives you your double jump back
				end
			end
		end
	end
	inWind = nowInWind

	if move == "" and onGround and sentMove == "flip" then
		sendMove("")
	end

	if move == "roll" or move == "longjump" or move == "slide" then
		if now - moveStart > 0.1 then
			followActual()
		end
	end

	if move == "walljump" then
		local t = now - moveStart
		setPlane(moveDir * moveSpeed)
		if t > 0.3 or (onGround and t > 0.1) then
			setMove("")
		end
	elseif move == "roll" then
		local t = now - moveStart
		moveSpeed = Config.RollSpeed * (1 - 0.35 * t / Config.RollTime)
		setPlane(moveDir * moveSpeed)
		if t > Config.RollTime then
			lastRollEnd = now
			setMove("")
		end
	elseif move == "longjump" then
		local t = now - moveStart
		local md = humanoid.MoveDirection
		if md.Magnitude > 0.1 then
			local want = Vector3.new(md.X, 0, md.Z).Unit
			local blend = math.clamp(dt * 2.4, 0, 1)
			moveDir = (moveDir:Lerp(want, blend)).Unit
		end
		moveSpeed = math.max(moveSpeed - 9 * dt, 26)
		setPlane(moveDir * moveSpeed)
		if onGround and t > 0.15 then
			setMove("")
			Effects.Burst(root.Position - Vector3.new(0, 2.5, 0), Config.Palette.Path, 6, 4, 0.5, 1)
		end
	elseif move == "slide" then
		local hit = floorHit()
		if hit then
			local onChute = hit.Instance:GetAttribute("Slide") == true
			local n = hit.Normal
			local v = moveDir * moveSpeed
			-- gravity pulls you downhill
			local downhill = DOWN - n * n:Dot(DOWN)
			local flatDown = Vector3.new(downhill.X, 0, downhill.Z)
			if flatDown.Magnitude > 0.02 then
				local steep = math.sqrt(math.max(0, 1 - n.Y * n.Y))
				v += flatDown.Unit * Config.Gravity * steep * dt * 1.6
			end
			-- steering
			local md = humanoid.MoveDirection
			if md.Magnitude > 0.1 then
				v += Vector3.new(md.X, 0, md.Z) * (onChute and 50 or 28) * dt
			end
			local speed = v.Magnitude
			if onChute then
				-- chutes keep you moving forward, fast
				speed = math.clamp(speed + 22 * dt, 30, Config.ChuteSpeed)
			else
				speed = math.max(0, speed - Config.SlideFriction * dt)
			end
			if v.Magnitude > 0.01 then
				moveDir = Vector3.new(v.X, 0, v.Z).Unit
			end
			moveSpeed = speed
			setPlane(moveDir * moveSpeed)
			if not onChute and speed < 8 then
				setMove("")
			end
		elseif airborneSince and now - airborneSince > 0.12 then
			-- sailed off an edge: keep the momentum as a glide
			setMove("longjump")
			usedDouble = true
		end
	elseif move == "pound" then
		local t = now - moveStart
		if t < Config.PoundHang then
			root.AssemblyLinearVelocity = Vector3.zero
		else
			root.AssemblyLinearVelocity = Vector3.new(0, -Config.PoundSpeed, 0)
			if onGround then
				landPound()
			elseif t > 4 then
				setMove("")
			end
		end
	elseif move == "" and onGround and enabled then
		-- ice chutes grab you
		local hit = floorHit()
		if hit and hit.Instance:GetAttribute("Slide") then
			startSlide(true)
		end
	end
end

--------------------------------------------------------------------------------

local function onBounceTouch(part, hit)
	if character and hit:IsDescendantOf(character) then
		bounceOff(part)
	end
end

local function watchBouncers()
	local worldFolder = workspace:WaitForChild("Bunny64World")
	local function hook(d)
		if d:IsA("BasePart") and d:GetAttribute("Bounce") then
			d.Touched:Connect(function(hit)
				onBounceTouch(d, hit)
			end)
		end
	end
	for _, d in ipairs(worldFolder:GetDescendants()) do
		hook(d)
	end
	worldFolder.DescendantAdded:Connect(hook)
end

local function keyCode(name, fallback)
	local ok, code = pcall(function()
		return Enum.KeyCode[name]
	end)
	return (ok and code) or Enum.KeyCode[fallback]
end

-- (Re)bind the moves to the player's chosen keys. controls = { [id] = { key, pad } }
function Movement.ApplyControls(controls)
	controls = controls or {}
	local binds = {}
	for _, def in ipairs(Config.Controls) do
		local c = controls[def.id] or {}
		binds[def.id] = { keyCode(c.key or def.key, def.key), keyCode(c.pad or def.pad, def.pad) }
	end
	for _, name in ipairs({ "Bunny64Roll", "Bunny64Crouch", "Bunny64Jump" }) do
		ContextActionService:UnbindAction(name)
	end

	ContextActionService:BindAction("Bunny64Roll", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			startRoll()
		end
		return Enum.ContextActionResult.Sink
	end, true, binds.roll[1], binds.roll[2])
	ContextActionService:SetTitle("Bunny64Roll", "ROLL")
	ContextActionService:SetPosition("Bunny64Roll", UDim2.new(1, -230, 1, -110))

	ContextActionService:BindAction("Bunny64Crouch", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			crouch()
		end
		return Enum.ContextActionResult.Sink
	end, true, binds.crouch[1], binds.crouch[2])
	ContextActionService:SetTitle("Bunny64Crouch", "CROUCH")
	ContextActionService:SetPosition("Bunny64Crouch", UDim2.new(1, -170, 1, -170))

	ContextActionService:UnbindAction("Bunny64Emote")
	local emoteKeys, emoteOf = {}, {}
	for _, e in ipairs(Config.Emotes) do
		for _, name in ipairs({ e.key, e.pad }) do
			local ok, code = pcall(function()
				return Enum.KeyCode[name]
			end)
			if ok and code then
				table.insert(emoteKeys, code)
				emoteOf[code] = e.id
			end
		end
	end
	ContextActionService:BindAction("Bunny64Emote", function(_, inputState, input)
		if inputState == Enum.UserInputState.Begin and emoteOf[input.KeyCode] then
			Movement.Emote(emoteOf[input.KeyCode])
		end
		return Enum.ContextActionResult.Pass
	end, false, table.unpack(emoteKeys))

	-- Space / A always jump (Roblox handles those); a custom jump key is added on top
	local jumpKeys = {}
	jumpCodes = { Enum.KeyCode.Space, Enum.KeyCode.ButtonA, binds.jump[1], binds.jump[2] }
	if binds.jump[1] ~= Enum.KeyCode.Space then
		table.insert(jumpKeys, binds.jump[1])
	end
	if binds.jump[2] ~= Enum.KeyCode.ButtonA then
		table.insert(jumpKeys, binds.jump[2])
	end
	if #jumpKeys > 0 then
		ContextActionService:BindAction("Bunny64Jump", function(_, inputState)
			if not enabled or not humanoid then
				return Enum.ContextActionResult.Pass
			end
			if inputState == Enum.UserInputState.Begin then
				local now = os.clock()
				lastJumpRequest = now
				if grounded() then
					humanoid.Jump = true
				end
				tryJumpMove()
			end
			return Enum.ContextActionResult.Sink
		end, false, table.unpack(jumpKeys))
	end
end

function Movement.Init(effects, remotes)
	Effects = effects
	Remotes = remotes

	task.spawn(function()
		local ok, module = pcall(function()
			return require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"))
		end)
		if ok and module then
			controls = module:GetControls()
			if not enabled then
				controls:Disable()
			end
		end
	end)

	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	player.CharacterAdded:Connect(onCharacter)

	UserInputService.JumpRequest:Connect(function()
		local now = os.clock()
		local fresh = now - lastJumpRequest > 0.2
		lastJumpRequest = now
		if fresh then
			tryJumpMove()
		end
	end)

	Movement.ApplyControls(nil)

	remotes.Bounce.OnClientEvent:Connect(function(vel, keepHorizontal, kind)
		if not root then
			return
		end
		if kind == "reset" then
			if move ~= "" then
				setMove("")
			end
			root.AssemblyLinearVelocity = Vector3.zero
			holdUntilGround(0.15) -- teleported: wait for the ground there
			return
		end
		local v = root.AssemblyLinearVelocity
		if keepHorizontal then
			vel = Vector3.new(v.X, vel.Y, v.Z)
		end
		launch(vel, kind)
	end)

	RunService.Heartbeat:Connect(step)
	task.spawn(watchBouncers)
end

return Movement
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000026"><Properties><string name="Name">PhotoMode</string><ProtectedString name="Source"><![CDATA[--[[
	PhotoMode - a free camera for screenshots (Pause > PHOTO MODE).

	  WASD / left stick       fly
	  hold right mouse / right stick   look around
	  Q / E (or LB / RB)      down / up
	  Shift (or LT)           faster
	  Backspace / B           back to the pause menu
	The camera stays within 120 studs of the bunny so it can't roam the map.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local PhotoMode = {}

local active = false

function PhotoMode.Start(onExit)
	if active then
		return
	end
	active = true
	local cam = workspace.CurrentCamera
	local startCF = cam.CFrame
	local pos = startCF.Position
	local _, yaw, _ = startCF:ToOrientation()
	local pitch = math.asin(math.clamp(startCF.LookVector.Y, -1, 1))
	local anchor = pos
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root then
		anchor = root.Position
	end
	cam.CameraType = Enum.CameraType.Scriptable

	local conns = {}
	local function stop()
		if not active then
			return
		end
		active = false
		for _, c in ipairs(conns) do
			c:Disconnect()
		end
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		cam.CameraType = Enum.CameraType.Custom
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum then
			cam.CameraSubject = hum
		end
		onExit()
	end

	table.insert(conns, UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.ButtonB or input.KeyCode == Enum.KeyCode.M then
			stop()
		end
	end))
	table.insert(conns, UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
			yaw -= input.Delta.X * 0.004
			pitch = math.clamp(pitch - input.Delta.Y * 0.004, -1.45, 1.45)
		end
	end))

	local pad = Enum.UserInputType.Gamepad1
	table.insert(conns, RunService.RenderStepped:Connect(function(dt)
		-- look
		UserInputService.MouseBehavior = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
			and Enum.MouseBehavior.LockCurrentPosition or Enum.MouseBehavior.Default
		local move = Vector3.zero
		local up = 0
		local fast = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
		for _, state in ipairs(UserInputService:GetGamepadState(pad)) do
			if state.KeyCode == Enum.KeyCode.Thumbstick1 and state.Position.Magnitude > 0.15 then
				move += Vector3.new(state.Position.X, 0, -state.Position.Y)
			elseif state.KeyCode == Enum.KeyCode.Thumbstick2 and state.Position.Magnitude > 0.15 then
				yaw -= state.Position.X * dt * 2.2
				pitch = math.clamp(pitch + state.Position.Y * dt * 1.6, -1.45, 1.45)
			elseif state.KeyCode == Enum.KeyCode.ButtonL1 and state.UserInputState == Enum.UserInputState.Begin then
				up -= 1
			elseif state.KeyCode == Enum.KeyCode.ButtonR1 and state.UserInputState == Enum.UserInputState.Begin then
				up += 1
			elseif state.KeyCode == Enum.KeyCode.ButtonL2 and state.Position.Z > 0.5 then
				fast = true
			end
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then
			move += Vector3.new(0, 0, -1)
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then
			move += Vector3.new(0, 0, 1)
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then
			move += Vector3.new(-1, 0, 0)
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then
			move += Vector3.new(1, 0, 0)
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.E) then
			up += 1
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.Q) then
			up -= 1
		end
		local rot = CFrame.fromOrientation(pitch, yaw, 0)
		local speed = fast and 70 or 25
		local delta = rot:VectorToWorldSpace(move) + Vector3.new(0, up, 0)
		if delta.Magnitude > 0.01 then
			pos += delta.Unit * speed * dt
		end
		-- stay near the bunny
		local off = pos - anchor
		if off.Magnitude > 120 then
			pos = anchor + off.Unit * 120
		end
		cam.CFrame = CFrame.new(pos) * rot
	end))
end

function PhotoMode.IsActive()
	return active
end

return PhotoMode
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000027"><Properties><string name="Name">Shadows</string><ProtectedString name="Source"><![CDATA[--[[
	Shadows - a round "blob" shadow straight under every bunny.

	In a 3D platformer the sun's shadow is rarely directly beneath you, so
	judging where you'll land is hard. Classic console platformers solved it
	with a simple dark disc projected straight down; it shrinks and fades as
	you get higher. This is that disc.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shadows = {}

local discs = {} -- [Model] = Part
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Include

local function makeDisc()
	local p = Instance.new("Part")
	p.Name = "BlobShadow"
	p.Shape = Enum.PartType.Cylinder
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.SmoothPlastic
	p.Color = Color3.new(0, 0, 0)
	p.Transparency = 0.5
	p.Size = Vector3.new(0.05, 3, 3)
	p.Parent = workspace:FindFirstChild("Bunny64LocalFX") or workspace
	return p
end

function Shadows.Init()
	local world = workspace:WaitForChild("Bunny64World")
	params.FilterDescendantsInstances = { world:WaitForChild("Solid"), workspace.Terrain }
	RunService.RenderStepped:Connect(function()
		local seen = {}
		for _, plr in ipairs(Players:GetPlayers()) do
			local char = plr.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if root and char:GetAttribute("Bunny") then
				seen[char] = true
				local disc = discs[char]
				if not disc then
					disc = makeDisc()
					discs[char] = disc
				end
				local hit = workspace:Raycast(root.Position, Vector3.new(0, -120, 0), params)
				if hit then
					local height = math.max(0, root.Position.Y - 2.6 - hit.Position.Y)
					local d = math.clamp(3.4 - height * 0.04, 1.2, 3.4)
					disc.Size = Vector3.new(0.05, d, d)
					disc.Transparency = math.clamp(0.42 + height * 0.006, 0.42, 0.8)
					-- lie flat on whatever slope is below (cylinder axis along the surface normal)
					local pos = hit.Position + hit.Normal * 0.06
					local n = hit.Normal
					local ref = math.abs(n.Y) < 0.9 and Vector3.yAxis or Vector3.xAxis
					disc.CFrame = CFrame.fromMatrix(pos, n, ref:Cross(n).Unit)
					disc.Parent = workspace:FindFirstChild("Bunny64LocalFX") or workspace
				else
					disc.Parent = nil
				end
			end
		end
		for char, disc in pairs(discs) do
			if not seen[char] then
				disc:Destroy()
				discs[char] = nil
			end
		end
	end)
end

return Shadows
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000028"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[--[[
	UI - shared building blocks for Bunny 64's late-90s console look:
	chunky beveled panels with gold trim, gradient title lettering, a bouncing
	carrot cursor, and menu navigation that works with keyboard, gamepad,
	mouse and touch.
]]

local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Bunny64")
local Config = require(Shared:WaitForChild("Config"))
local P = Config.Palette

local UI = {}

UI.TITLE = Enum.Font.LuckiestGuy
UI.BODY = Enum.Font.FredokaOne
UI.Cream = P.UiText
UI.Gold = Color3.fromRGB(246, 200, 86)
UI.Ink = Color3.fromRGB(20, 14, 18)
UI.Navy = Color3.fromRGB(30, 32, 60)

local rgb = Color3.fromRGB

function UI.stroke(inst, thickness, color, mode)
	local s = Instance.new("UIStroke")
	s.Thickness = thickness or 3
	s.Color = color or UI.Ink
	s.ApplyStrokeMode = mode or Enum.ApplyStrokeMode.Contextual
	s.LineJoinMode = Enum.LineJoinMode.Round
	s.Parent = inst
	return s
end

function UI.corner(inst, px)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, px or 10)
	c.Parent = inst
	return c
end

function UI.gradient(inst, colors, rotation)
	local g = Instance.new("UIGradient")
	local keys = {}
	for i, c in ipairs(colors) do
		table.insert(keys, ColorSequenceKeypoint.new((i - 1) / math.max(1, #colors - 1), c))
	end
	g.Color = ColorSequence.new(keys)
	g.Rotation = rotation or 90
	g.Parent = inst
	return g
end

function UI.label(parent, props)
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Font = UI.BODY
	t.TextColor3 = UI.Cream
	t.TextSize = 22
	t.Size = UDim2.new(1, 0, 0, 30)
	local strokeSize = 3
	for k, v in pairs(props) do
		if k == "Stroke" then
			strokeSize = v
		else
			t[k] = v
		end
	end
	if strokeSize > 0 then
		UI.stroke(t, strokeSize)
	end
	t.Parent = parent
	return t
end

-- Big lettering with a gold-to-orange face and a chunky extruded shadow
function UI.title(parent, text, size, pos, anchor, colors)
	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.new(1, 0, 0, size + 16)
	holder.Position = pos or UDim2.new()
	holder.AnchorPoint = anchor or Vector2.new()
	holder.Parent = parent
	for i = 4, 1, -1 do
		local shadow = UI.label(holder, {
			Text = text, Font = UI.TITLE, TextSize = size, TextColor3 = rgb(40 + i * 6, 22 + i * 4, 30 + i * 4),
			Size = UDim2.fromScale(1, 1), Position = UDim2.fromOffset(i * 1.5, i * 2), Stroke = 0,
		})
		shadow.ZIndex = 1
	end
	local face = UI.label(holder, {
		Text = text, Font = UI.TITLE, TextSize = size, TextColor3 = Color3.new(1, 1, 1),
		Size = UDim2.fromScale(1, 1), Stroke = 4,
	})
	face.ZIndex = 2
	UI.gradient(face, colors or { rgb(255, 236, 140), rgb(246, 186, 70), rgb(214, 110, 46) }, 90)
	return holder, face
end

-- Beveled panel with gold trim and a drop shadow
function UI.panel(parent, size, pos, anchor)
	local shadow = Instance.new("Frame")
	shadow.Size = size
	shadow.Position = pos
	shadow.AnchorPoint = anchor or Vector2.new(0.5, 0.5)
	shadow.BackgroundColor3 = Color3.new(0, 0, 0)
	shadow.BackgroundTransparency = 0.55
	shadow.BorderSizePixel = 0
	UI.corner(shadow, 16)
	shadow.Parent = parent
	local f = Instance.new("Frame")
	f.Name = "Panel"
	f.Size = UDim2.new(1, 0, 1, 0)
	f.Position = UDim2.fromOffset(-7, -7)
	f.BackgroundColor3 = Color3.new(1, 1, 1)
	f.BorderSizePixel = 0
	UI.corner(f, 16)
	UI.gradient(f, { rgb(64, 70, 120), rgb(36, 38, 72), rgb(24, 24, 46) }, 90)
	UI.stroke(f, 4, UI.Gold, Enum.ApplyStrokeMode.Border)
	f.Parent = shadow
	local inner = Instance.new("Frame")
	inner.BackgroundTransparency = 1
	inner.Size = UDim2.new(1, -12, 1, -12)
	inner.Position = UDim2.fromOffset(6, 6)
	UI.stroke(inner, 2, rgb(16, 14, 30), Enum.ApplyStrokeMode.Border)
	UI.corner(inner, 12)
	inner.Parent = f
	return f, shadow
end

-- Little carrot drawn with frames (icons, cursor)
function UI.carrot(parent, color, scale, pos, anchor)
	scale = scale or 1
	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.fromOffset(22 * scale, 30 * scale)
	holder.Position = pos or UDim2.new()
	holder.AnchorPoint = anchor or Vector2.new()
	holder.Parent = parent
	local function bit(x, y, w, h, c)
		local f = Instance.new("Frame")
		f.BorderSizePixel = 0
		f.BackgroundColor3 = c
		f.Position = UDim2.fromOffset(x * scale, y * scale)
		f.Size = UDim2.fromOffset(w * scale, h * scale)
		UI.stroke(f, math.max(1, 2 * scale), UI.Ink, Enum.ApplyStrokeMode.Border)
		f.Parent = holder
		return f
	end
	for i, x in ipairs({ 4, 9, 14 }) do
		bit(x, i == 2 and 0 or 3, 4, i == 2 and 10 or 7, color == P.Gold and rgb(236, 222, 170) or P.CarrotLeaf)
	end
	local body = bit(5, 9, 12, 12, color)
	UI.corner(body, 3 * scale)
	bit(7, 20, 8, 6, color)
	bit(9, 25, 4, 4, color)
	return holder
end

-- Scrolling patterned backdrop (sits behind menus)
function UI.backdrop(parent, opacity)
	local bg = Instance.new("Frame")
	bg.Name = "Backdrop"
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color3.new(1, 1, 1)
	bg.BackgroundTransparency = opacity or 0.15
	bg.BorderSizePixel = 0
	bg.ClipsDescendants = true
	bg.Parent = parent
	local grad = UI.gradient(bg, { rgb(46, 52, 104), rgb(70, 44, 92), rgb(38, 70, 96) }, 45)
	local tiles = Instance.new("Frame")
	tiles.BackgroundTransparency = 1
	tiles.Size = UDim2.new(1, 240, 1, 240)
	tiles.Parent = bg
	for gx = 0, 13 do
		for gy = 0, 9 do
			if (gx + gy) % 2 == 0 then
				local c = UI.carrot(tiles, rgb(255, 255, 255), 1, UDim2.fromOffset(gx * 120, gy * 120))
				c.Rotation = 25
				for _, d in ipairs(c:GetDescendants()) do
					if d:IsA("Frame") then
						d.BackgroundTransparency = 0.9
					elseif d:IsA("UIStroke") then
						d.Transparency = 1
					end
				end
			end
		end
	end
	local conn
	conn = RunService.RenderStepped:Connect(function()
		if not bg.Parent then
			conn:Disconnect()
			return
		end
		local t = os.clock()
		local off = (t * 24) % 240
		tiles.Position = UDim2.fromOffset(-off, -off)
		grad.Rotation = 45 + math.sin(t * 0.2) * 20
	end)
	return bg
end

--------------------------------------------------------------------------------
-- Menu navigation
--------------------------------------------------------------------------------
-- entries: { button = GuiButton, select = fn, left = fn?, right = fn? }

local nav = { entries = {}, index = 1, back = nil, sound = nil }
UI.Sound = function() end

local function highlight()
	for i, e in ipairs(nav.entries) do
		local on = i == nav.index
		if e.button and e.button.Parent then
			e.button.TextColor3 = on and UI.Gold or UI.Cream
			local scale = e.button:FindFirstChildOfClass("UIScale")
			if scale then
				TweenService:Create(scale, TweenInfo.new(0.12), { Scale = on and 1.08 or 1 }):Play()
			end
			local cursor = e.button:FindFirstChild("Cursor")
			if cursor then
				cursor.Visible = on
			end
		end
		if e.focus then
			e.focus(on)
		end
	end
end

function UI.SetNav(entries, back, startIndex)
	nav.entries = entries or {}
	nav.back = back
	nav.index = math.clamp(startIndex or 1, 1, math.max(1, #nav.entries))
	for i, e in ipairs(nav.entries) do
		if e.button and not e.hooked then
			e.hooked = true
			e.button.MouseEnter:Connect(function()
				if nav.entries[i] == e and nav.index ~= i then
					nav.index = i
					UI.Sound("MenuMove", 1.3)
					highlight()
				end
			end)
			e.button.Activated:Connect(function()
				if nav.entries[i] == e then
					nav.index = i
					highlight()
					UI.Sound("MenuSelect", 1)
					if e.select then
						e.select()
					end
				end
			end)
		end
	end
	highlight()
end

function UI.ClearNav()
	nav.entries = {}
	nav.back = nil
end

function UI.NavActive()
	return #nav.entries > 0
end

local function moveSel(delta)
	if #nav.entries == 0 then
		return
	end
	nav.index = (nav.index - 1 + delta) % #nav.entries + 1
	UI.Sound("MenuMove", 1.3)
	highlight()
end

local function side(delta)
	local e = nav.entries[nav.index]
	if e then
		local fn = delta < 0 and e.left or e.right
		if fn then
			UI.Sound("MenuMove", delta < 0 and 1.1 or 1.5)
			fn()
			return true
		end
	end
	return false
end

local function activate()
	local e = nav.entries[nav.index]
	if e and e.select then
		UI.Sound("MenuSelect", 1)
		e.select()
	end
end

local KEYS_UP = { [Enum.KeyCode.Up] = true, [Enum.KeyCode.W] = true, [Enum.KeyCode.DPadUp] = true }
local KEYS_DOWN = { [Enum.KeyCode.Down] = true, [Enum.KeyCode.S] = true, [Enum.KeyCode.DPadDown] = true }
local KEYS_LEFT = { [Enum.KeyCode.Left] = true, [Enum.KeyCode.A] = true, [Enum.KeyCode.DPadLeft] = true }
local KEYS_RIGHT = { [Enum.KeyCode.Right] = true, [Enum.KeyCode.D] = true, [Enum.KeyCode.DPadRight] = true }
local KEYS_OK = { [Enum.KeyCode.Return] = true, [Enum.KeyCode.Space] = true, [Enum.KeyCode.ButtonA] = true, [Enum.KeyCode.KeypadEnter] = true }
local KEYS_BACK = { [Enum.KeyCode.Backspace] = true, [Enum.KeyCode.ButtonB] = true }

UserInputService.InputBegan:Connect(function(input, processed)
	if processed or #nav.entries == 0 then
		return
	end
	local k = input.KeyCode
	if KEYS_UP[k] then
		moveSel(-1)
	elseif KEYS_DOWN[k] then
		moveSel(1)
	elseif KEYS_LEFT[k] then
		if not side(-1) then
			moveSel(-1)
		end
	elseif KEYS_RIGHT[k] then
		if not side(1) then
			moveSel(1)
		end
	elseif KEYS_OK[k] then
		activate()
	elseif KEYS_BACK[k] and nav.back then
		UI.Sound("MenuMove", 0.8)
		nav.back()
	end
end)

-- Thumbstick navigation with repeat
local stickReady = true
UserInputService.InputChanged:Connect(function(input)
	if input.KeyCode ~= Enum.KeyCode.Thumbstick1 or #nav.entries == 0 then
		return
	end
	local p = input.Position
	if math.abs(p.X) < 0.4 and math.abs(p.Y) < 0.4 then
		stickReady = true
		return
	end
	if not stickReady then
		return
	end
	stickReady = false
	if math.abs(p.Y) > math.abs(p.X) then
		moveSel(p.Y > 0 and -1 or 1)
	elseif not side(p.X > 0 and 1 or -1) then
		moveSel(p.X > 0 and 1 or -1)
	end
end)

-- A menu row: text button with a bouncing carrot cursor
function UI.item(parent, text, props)
	local b = Instance.new("TextButton")
	b.BackgroundTransparency = 1
	b.AutoButtonColor = false
	b.Font = UI.BODY
	b.Text = text
	b.TextSize = 28
	b.TextColor3 = UI.Cream
	b.Size = UDim2.new(1, 0, 0, 42)
	for k, v in pairs(props or {}) do
		b[k] = v
	end
	UI.stroke(b, 3)
	local scale = Instance.new("UIScale")
	scale.Parent = b
	local cursor = UI.carrot(b, P.Carrot, 1, UDim2.new(0, 6, 0.5, 0), Vector2.new(0, 0.5))
	cursor.Name = "Cursor"
	cursor.Rotation = 90
	cursor.Visible = false
	TweenService:Create(cursor, TweenInfo.new(0.28, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
		Position = UDim2.new(0, 14, 0.5, 0),
	}):Play()
	b.Parent = parent
	return b
end

function UI.list(parent, padding)
	local l = Instance.new("UIListLayout")
	l.Padding = UDim.new(0, padding or 4)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.HorizontalAlignment = Enum.HorizontalAlignment.Center
	l.Parent = parent
	return l
end

return UI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000029"><Properties><string name="Name">Weather</string><ProtectedString name="Source"><![CDATA[--[[
	Weather - a little atmosphere for each region, drawn around the camera:
	  meadow  drifting pollen motes
	  peaks   gentle snowfall
	  canyon  wind-blown dust
	  castle  rising embers
	  forest  drifting fireflies
	  sky     wisps of cloud streaming past
	Uses particle textures that ship with Roblox, so no uploads are needed.
]]

local RunService = game:GetService("RunService")

local Weather = {}

local SPARK = "rbxasset://textures/particles/sparkles_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local FIRE = "rbxasset://textures/particles/fire_main.dds"

local STYLES = {
	meadow = {
		texture = SPARK, rate = 6, lifetime = NumberRange.new(6, 9), speed = NumberRange.new(0.5, 1.5),
		accel = Vector3.new(0.6, 0.2, 0.3), size = 0.35, color = Color3.fromRGB(255, 240, 170), light = 0.4,
		offset = Vector3.new(0, 4, 0), dir = Enum.NormalId.Top, spread = 180,
	},
	peaks = {
		texture = SPARK, rate = 60, lifetime = NumberRange.new(6, 8), speed = NumberRange.new(4, 7),
		accel = Vector3.new(1.2, -1, 0.4), size = 0.4, color = Color3.fromRGB(246, 250, 255), light = 0.2,
		offset = Vector3.new(0, 30, 0), dir = Enum.NormalId.Bottom, spread = 20,
	},
	canyon = {
		texture = SMOKE, rate = 4, lifetime = NumberRange.new(4, 6), speed = NumberRange.new(8, 12),
		accel = Vector3.new(4, 0, 1), size = 4, color = Color3.fromRGB(214, 180, 130), light = 0,
		offset = Vector3.new(-30, 1, 0), dir = Enum.NormalId.Right, spread = 30, transparency = 0.8,
	},
	castle = {
		texture = FIRE, rate = 14, lifetime = NumberRange.new(3, 5), speed = NumberRange.new(2, 5),
		accel = Vector3.new(0.5, 2.5, 0.2), size = 0.3, color = Color3.fromRGB(255, 150, 70), light = 1,
		offset = Vector3.new(0, -8, 0), dir = Enum.NormalId.Top, spread = 40,
	},
	forest = {
		texture = SPARK, rate = 9, lifetime = NumberRange.new(4, 7), speed = NumberRange.new(0.3, 1.2),
		accel = Vector3.new(0.3, 0.15, -0.2), size = 0.3, color = Color3.fromRGB(214, 236, 130), light = 1,
		offset = Vector3.new(0, 2, 0), dir = Enum.NormalId.Top, spread = 180,
	},
	sky = {
		texture = SMOKE, rate = 3, lifetime = NumberRange.new(5, 7), speed = NumberRange.new(6, 9),
		accel = Vector3.new(1.5, 0, 0.5), size = 6, color = Color3.fromRGB(240, 244, 252), light = 0.1,
		offset = Vector3.new(-30, -6, 0), dir = Enum.NormalId.Right, spread = 25, transparency = 0.82,
	},
}

local emitterPart, emitter
local current = nil

local function apply(style)
	emitter.Texture = style.texture
	emitter.Rate = style.rate
	emitter.Lifetime = style.lifetime
	emitter.Speed = style.speed
	emitter.Acceleration = style.accel
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.15, style.size),
		NumberSequenceKeypoint.new(0.85, style.size),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Color = ColorSequence.new(style.color)
	emitter.LightEmission = style.light
	local t = style.transparency or 0.15
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.2, t),
		NumberSequenceKeypoint.new(0.8, t),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.EmissionDirection = style.dir
	emitter.SpreadAngle = Vector2.new(style.spread, style.spread)
	emitter.Enabled = true
end

function Weather.SetRegion(region)
	if region == current or not emitter then
		return
	end
	current = region
	local style = STYLES[region]
	if style then
		apply(style)
	else
		emitter.Enabled = false
	end
end

function Weather.SetEnabled(on)
	if emitter then
		emitter.Enabled = on and current ~= nil and STYLES[current] ~= nil
	end
end

function Weather.Init()
	emitterPart = Instance.new("Part")
	emitterPart.Name = "WeatherEmitter"
	emitterPart.Anchored = true
	emitterPart.CanCollide = false
	emitterPart.CanQuery = false
	emitterPart.CanTouch = false
	emitterPart.Transparency = 1
	emitterPart.Size = Vector3.new(90, 1, 90)
	emitterPart.Parent = workspace:FindFirstChild("Bunny64LocalFX") or workspace
	emitter = Instance.new("ParticleEmitter")
	emitter.Enabled = false
	emitter.LockedToPart = false
	emitter.Parent = emitterPart
	RunService.RenderStepped:Connect(function()
		local style = STYLES[current or ""]
		local cam = workspace.CurrentCamera
		if style then
			emitterPart.CFrame = CFrame.new(cam.CFrame.Position + style.offset)
		end
	end)
end

return Weather
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002A"><Properties><string name="Name">WorldFX</string><ProtectedString name="Source"><![CDATA[--[[
	WorldFX - client-side world behaviour:
	  * animates firebars and crushers from the shared server clock
	  * opens golden-carrot gates for players who have enough golden carrots
	  * per-region lighting, fog and music, plus the region title banner
	  * makes King Grumble flash when he's hit
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Bunny64")
local Config = require(Shared:WaitForChild("Config"))
local HazardMath = require(Shared:WaitForChild("HazardMath"))

local player = Players.LocalPlayer
local WorldFX = {}

local Effects, Hud
local hazards = {}
local gates = {}
local flags = {}
local activeCheckpoint = nil
local goldenCount = 0
local currentRegion = nil
local slotRef = nil

-- Region title cards show how many golden carrots you've found there
function WorldFX.SetSlot(slot)
	slotRef = slot
end
local inArena = false

-- Region looks -------------------------------------------------------------------
local LOOKS = {
	-- ambient = outdoor fill light, indoor = light inside roofed rooms (keep, dungeon...)
	meadow = {
		fog = Color3.fromRGB(176, 182, 172), fogStart = 160, fogEnd = 900, ambient = Color3.fromRGB(132, 124, 112),
		indoor = Color3.fromRGB(120, 114, 106), tint = Color3.fromRGB(255, 244, 228), sat = -0.18, clock = 16.3, brightness = 2.2,
	},
	peaks = {
		fog = Color3.fromRGB(196, 206, 214), fogStart = 120, fogEnd = 700, ambient = Color3.fromRGB(138, 144, 156),
		indoor = Color3.fromRGB(124, 130, 140), tint = Color3.fromRGB(236, 244, 255), sat = -0.25, clock = 14.5, brightness = 2.2,
	},
	canyon = {
		fog = Color3.fromRGB(206, 178, 140), fogStart = 160, fogEnd = 850, ambient = Color3.fromRGB(150, 126, 100),
		indoor = Color3.fromRGB(130, 112, 94), tint = Color3.fromRGB(255, 236, 210), sat = -0.12, clock = 17.2, brightness = 2.3,
	},
	-- moody but readable: warm red haze far out, plenty of fill light indoors
	castle = {
		fog = Color3.fromRGB(150, 98, 82), fogStart = 160, fogEnd = 950, ambient = Color3.fromRGB(168, 138, 126),
		indoor = Color3.fromRGB(150, 122, 110), tint = Color3.fromRGB(255, 234, 220), sat = -0.08, clock = 16.6, brightness = 2.6,
	},
	-- late-afternoon gloom under the trees: green-grey haze, close fog
	forest = {
		fog = Color3.fromRGB(128, 146, 126), fogStart = 60, fogEnd = 520, ambient = Color3.fromRGB(112, 124, 104),
		indoor = Color3.fromRGB(110, 118, 100), tint = Color3.fromRGB(236, 246, 226), sat = -0.2, clock = 17.6, brightness = 1.9,
	},
	-- bright and clear above the clouds; the fog is the cloud sea far below
	sky = {
		fog = Color3.fromRGB(214, 222, 236), fogStart = 260, fogEnd = 1200, ambient = Color3.fromRGB(156, 160, 176),
		indoor = Color3.fromRGB(140, 144, 160), tint = Color3.fromRGB(246, 248, 255), sat = -0.1, clock = 13.4, brightness = 2.6,
	},
}

local function regionAt(pos)
	if pos.Y > Config.SkyFloor - 60 then
		return "sky"
	elseif pos.Z > 470 and math.abs(pos.X) < 320 then
		return "castle"
	elseif pos.Z < -470 then
		return "peaks"
	elseif pos.X > 460 then
		return "canyon"
	elseif pos.X < -470 then
		return "forest"
	end
	return "meadow"
end

local function applyLook(id)
	if WorldFX.OnRegion then
		WorldFX.OnRegion(id)
	end
	local look = LOOKS[id]
	local info = TweenInfo.new(2.5, Enum.EasingStyle.Sine)
	TweenService:Create(Lighting, info, {
		FogColor = look.fog, FogStart = look.fogStart, FogEnd = look.fogEnd,
		OutdoorAmbient = look.ambient, Ambient = look.indoor, ClockTime = look.clock, Brightness = look.brightness,
	}):Play()
	local grade = Lighting:FindFirstChild("Bunny64Grade")
	if grade then
		TweenService:Create(grade, info, { TintColor = look.tint, Saturation = look.sat }):Play()
	end
end

-- Hazards ---------------------------------------------------------------------------------
local function register(model)
	if not model:IsA("Model") then
		return
	end
	local kind = model:GetAttribute("Kind")
	if kind == "firebar" then
		table.insert(hazards, {
			model = model, kind = kind, pivot = model:GetAttribute("Pivot"),
			speed = model:GetAttribute("Speed"), phase = model:GetAttribute("Phase"),
		})
	elseif kind == "crusher" then
		table.insert(hazards, {
			model = model, kind = kind, base = model:GetAttribute("Base"), drop = model:GetAttribute("Drop"),
			period = model:GetAttribute("Period"), offset = model:GetAttribute("Offset"), last = 0,
		})
	end
end

local function updateHazards()
	local t = HazardMath.Now()
	for _, h in ipairs(hazards) do
		if h.model.Parent then
			if h.kind == "firebar" then
				local a = HazardMath.FirebarAngle(h.speed, h.phase, t)
				h.model:PivotTo(CFrame.new(h.pivot) * CFrame.Angles(0, a, 0))
			else
				local d = HazardMath.CrusherDrop(h.period, h.offset, t)
				h.model:PivotTo(h.base - Vector3.new(0, d * h.drop, 0))
				if d >= 1 and h.last < 1 then
					local char = player.Character
					local root = char and char:FindFirstChild("HumanoidRootPart")
					if root and (root.Position - h.base.Position).Magnitude < 40 then
						Effects.Shake(0.5, 0.2)
						Effects.Play("Land", 0.6)
					end
				end
				h.last = d
			end
		end
	end
end

-- Gates -----------------------------------------------------------------------------------
local function refreshGates()
	for _, g in ipairs(gates) do
		local open = goldenCount >= (g:GetAttribute("GoldenGate") or 0)
		g.CanCollide = not open
		g.Transparency = open and 0.85 or 0.2
	end
end

local function refreshFlags()
	for _, f in ipairs(flags) do
		local on = f:GetAttribute("Checkpoint") == activeCheckpoint
		f.Color = on and Color3.fromRGB(226, 182, 74) or Color3.fromRGB(136, 66, 54)
		f.Material = on and Enum.Material.Neon or Enum.Material.Fabric
	end
end

-- The flag of the checkpoint you'll respawn at glows gold
function WorldFX.SetCheckpoint(id)
	activeCheckpoint = id
	refreshFlags()
end

function WorldFX.SetGoldenCount(n)
	goldenCount = n or 0
	refreshGates()
end

function WorldFX.InArena()
	return inArena
end

function WorldFX.Init(effects, hud)
	Effects, Hud = effects, hud
	local world = workspace:WaitForChild("Bunny64World")
	local hazardFolder = world:WaitForChild("Hazards")
	for _, m in ipairs(hazardFolder:GetChildren()) do
		register(m)
	end
	hazardFolder.ChildAdded:Connect(register)
	for _, d in ipairs(world:WaitForChild("Solid"):GetDescendants()) do
		if d:IsA("BasePart") and d:GetAttribute("GoldenGate") then
			table.insert(gates, d)
		elseif d:IsA("BasePart") and d:GetAttribute("Checkpoint") then
			table.insert(flags, d)
		end
	end
	refreshGates()
	refreshFlags()

	local nextZoneCheck = 0
	RunService.RenderStepped:Connect(function()
		updateHazards()

		local now = os.clock()
		if now < nextZoneCheck then
			return
		end
		nextZoneCheck = now + 0.5
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not root then
			return
		end
		local pos = root.Position
		local region = regionAt(pos)
		if region ~= currentRegion then
			currentRegion = region
			applyLook(region)
			for _, r in ipairs(Config.Regions) do
				if r.id == region then
					local got, total = 0, 0
					for _, g in ipairs(Config.Goldens) do
						if g.region == region then
							total += 1
							if slotRef and slotRef.goldens[g.id] then
								got += 1
							end
						end
					end
					Hud.RegionBanner(string.format("%s  %d/%d", r.name, got, total))
				end
			end
			if not inArena then
				Effects.SetMusic(region)
			end
		end
		local arena = (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(0, 0, 800)).Magnitude < 70 and pos.Y > 185
		if arena ~= inArena then
			inArena = arena
			Effects.SetMusic(arena and "boss" or region)
			if arena then
				Hud.RegionBanner("THRONE ROOM")
			end
		end
	end)

	-- Boss flashing while hurt
	task.spawn(function()
		local bossFolder = workspace:WaitForChild("Boss", 60)
		if not bossFolder then
			return
		end
		RunService.RenderStepped:Connect(function()
			local boss = bossFolder:FindFirstChild("KingGrumble")
			if not boss then
				return
			end
			local hurt = boss:GetAttribute("State") == "hurt"
			local flash = hurt and (math.floor(os.clock() * 12) % 2 == 0) and 0.6 or 0
			for _, d in ipairs(boss:GetChildren()) do
				if d:IsA("BasePart") and d.Name ~= "Root" then
					d.LocalTransparencyModifier = flash
				end
			end
		end)
	end)
end

-- Forget the current region so entering the game re-applies its look and music
function WorldFX.ResetRegion()
	currentRegion = nil
	inArena = false
end

function WorldFX.Region()
	return currentRegion
end

return WorldFX
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterCharacterScripts" referent="RBX0000002F"><Properties><string name="Name">StarterCharacterScripts</string></Properties><Item class="LocalScript" referent="RBX0000002D"><Properties><string name="Name">Animate</string><ProtectedString name="Source"><![CDATA[-- Intentionally empty: replaces Roblox's default "Animate" script.
-- The bunny is animated procedurally by StarterPlayerScripts.Bunny64Client.Animator.
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX0000002E"><Properties><string name="Name">Health</string><ProtectedString name="Source"><![CDATA[-- Intentionally empty: replaces Roblox's default health regeneration.
-- In Bunny 64 hearts only come back from carrots and golden carrots.
]]></ProtectedString><token name="RunContext">0</token></Properties></Item></Item></Item></roblox>
