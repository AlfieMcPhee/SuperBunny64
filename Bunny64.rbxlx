-- Players -----------------------------------------------------------------------------------------
local function onPlayerAdded(player)
	state[player] = { safe = checkpointCF("meadow"), invulnUntil = 0 }
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	for _, name in ipairs({ "Golden", "Carrots" }) do
		local v = Instance.new("IntValue")
		v.Name = name
		v.Parent = stats
	end
	stats.Parent = player
	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	local profile = DataService.Load(player)
	if profile and player.Parent then
		push(player, nil)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end
Players.PlayerRemoving:Connect(function(player)
	state[player] = nil
	DataService.Release(player)
end)

-- Water, lava, checkpoints & warp discovery ------------------------------------------------------------
local floorParams = RaycastParams.new()
floorParams.FilterType = Enum.RaycastFilterType.Include
floorParams.FilterDescendantsInstances = { info.solidFolder, workspace.Terrain }

local acc = 0
RunService.Heartbeat:Connect(function(dt)
	acc += dt
	if acc < 0.2 then
		return
	end
	acc = 0
	for player, st in pairs(state) do
		local root, hum = getRoot(player)
		local slot = DataService.ActiveSlot(player)
		if root and hum and hum.Health > 0 and slot then
			local pos = root.Position
			local hit = workspace:Raycast(pos, Vector3.new(0, -3.4, 0), floorParams)
			local inWater = pos.Y < Config.WaterLevel - 2.5 or (hit and hit.Instance:GetAttribute("Water"))
			-- Cloudtop Heights: falling off the clouds catches you and puts you back
			if pos.Y > Config.SkyFloor then
				st.sky = true
			elseif st.sky and pos.Y < Config.SkyFloor - 25 then
				st.sky = false
				if st.safe.Position.Y > Config.SkyFloor and player.Character:GetAttribute("Move") ~= "fly" then
					inWater = true
				end
			end
			if inWater then
				if pos.Y > Config.WaterLevel + 20 then
					Effect:FireAllClients("poof", pos) -- caught by the clouds, not the sea
				else
					Effect:FireAllClients("splash", Vector3.new(pos.X, hit and hit.Position.Y or Config.WaterLevel, pos.Z))
				end
				hurt(player, pos, Vector3.zero, true)
				if hum.Health > 0 then
					player.Character:PivotTo(st.safe)
					Bounce:FireClient(player, Vector3.zero, false, "reset")
				end
			elseif hit and hit.Instance:GetAttribute("Lava") then
				HazardService.Burn(player)
			elseif hit and not hit.Instance:GetAttribute("Moving") and hit.Instance.Anchored
				and hit.Instance:GetAttribute("Bounce") == nil and hit.Instance:GetAttribute("Slide") == nil then
				st.safe = CFrame.new(hit.Position + Vector3.new(0, 3, 0)) * (root.CFrame - root.CFrame.Position)
			end

			-- time trials
			local now = os.clock()
			if st.trial then
				local trial = Config.Trials[st.trial.id]
				local elapsed = now - st.trial.t0
				local flat = Vector3.new(pos.X - trial.finish.X, 0, pos.Z - trial.finish.Z).Magnitude
				if elapsed > trial.time then
					st.trial = nil
					push(player, { kind = "trialfail" })
				elseif flat < trial.finishRadius and math.abs(pos.Y - 2.6 - trial.finish.Y) < 10 then
					local id = st.trial.id
					st.trial = nil
					slot.trials = slot.trials or {}
					local first = not slot.trials[id]
					slot.trials[id] = true
					push(player, { kind = "trialwin", id = id, time = elapsed, first = first })
				end
			else
				local onPad = nil
				for id, trial in pairs(Config.Trials) do
					local flat = Vector3.new(pos.X - trial.start.X, 0, pos.Z - trial.start.Z).Magnitude
					if flat < 6 and math.abs(pos.Y - trial.start.Y) < 10 then
						onPad = id
					end
				end
				if onPad and st.lastPad ~= onPad then
					st.trial = { id = onPad, t0 = now }
					push(player, { kind = "trialstart", id = onPad, time = Config.Trials[onPad].time })
				end
				st.lastPad = onPad
			end

			-- regions visited (for the SIGHTSEER stamp)
			local region = "meadow"
			if pos.Y > Config.SkyFloor - 60 then
				region = "sky"
			elseif pos.Z > 470 and math.abs(pos.X) < 320 then
				region = "castle"
			elseif pos.Z < -470 then
				region = "peaks"
			elseif pos.X > 460 then
				region = "canyon"
			elseif pos.X < -470 then
				region = "forest"
			end
			slot.regions = slot.regions or {}
			if not slot.regions[region] then
				slot.regions[region] = true
				if region == "sky" then
					awardStamp(player, "sky")
				end
				if count(slot.regions) >= #Config.Regions then
					awardStamp(player, "regions")
				end
			end

			for id, cp in pairs(Config.Checkpoints) do
				if slot.checkpoint ~= id and (pos - cp.pos).Magnitude < 14 then
					slot.checkpoint = id
					push(player, { kind = "checkpoint", id = id })
				end
			end
			for _, w in ipairs(Config.Warps) do
				if not slot.warps[w.id] and (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(w.pos.X, 0, w.pos.Z)).Magnitude < 16
					and math.abs(pos.Y - w.pos.Y) < 30 then
					slot.warps[w.id] = true
					push(player, { kind = "warpfound", id = w.id })
				end
			end
		end
	end
end)

print(string.format("[Bunny64] Ready: %d carrots, %d golden carrots, %d bugs.", TOTAL_CARROTS, #Config.Goldens, #info.enemies))
]]></ProtectedString><token name="RunContext">0</token></Properties><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">AdminService</string><ProtectedString name="Source"><![CDATA[--[[
	AdminService - fun admin perks for the game owner and friends.

	Who is an admin:
	  * the place owner (or the owner rank of the owning group)
	  * anyone whose UserId is in Config.Admins
	  * everyone while testing in Roblox Studio

	Every command is checked here on the server; the client panel only asks.

	  Self:    fly, god mode, speed boost, full heal
	  Travel:  teleport to any checkpoint / the throne room / another player
	  Others:  bring, freeze, launch, heal, control (they follow you, inputs locked)
	  World:   reset King Grumble, give yourself every golden carrot (testing)
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Bunny64")
local Config = require(Shared:WaitForChild("Config"))

local AdminService = {}

local ctx
local controlled = {} -- [targetPlayer] = { by = adminPlayer, untilTime = number }
local speedLevel = {} -- [Player] = 1..3
local Notice

function AdminService.IsAdmin(player)
	if RunService:IsStudio() then
		return true
	end
	for _, id in ipairs(Config.Admins or {}) do
		if player.UserId == id then
			return true
		end
	end
	if game.CreatorType == Enum.CreatorType.User then
		return player.UserId == game.CreatorId
	end
	local ok, rank = pcall(function()
		return player:GetRankInGroup(game.CreatorId)
	end)
	return ok and rank == 255
end

local function rootOf(player)
	local char = player and player.Character
	return char and char:FindFirstChild("HumanoidRootPart"), char and char:FindFirstChildOfClass("Humanoid"), char
end

local function findPlayer(userId)
	if type(userId) ~= "number" then
		return nil
	end
	return Players:GetPlayerByUserId(userId)
end

local function notify(player, text)
	if player and player.Parent then
		Notice:FireClient(player, "toast", text)
	end
end

local function release(target)
	local c = controlled[target]
	controlled[target] = nil
	if c and target.Parent then
		Notice:FireClient(target, "control", false)
		notify(target, "YOU'RE FREE AGAIN!")
	end
end

local COMMANDS = {}

-- Self ---------------------------------------------------------------------------
function COMMANDS.god(admin)
	local _, _, char = rootOf(admin)
	if not char then
		return false, "No character"
	end
	local on = not char:GetAttribute("God")
	char:SetAttribute("God", on)
	return true, on and "GOD MODE ON" or "GOD MODE OFF", on
end

function COMMANDS.speed(admin)
	local _, hum = rootOf(admin)
	if not hum then
		return false, "No character"
	end
	local level = (speedLevel[admin] or 1) % 3 + 1
	speedLevel[admin] = level
	hum.WalkSpeed = Config.WalkSpeed * level
	return true, "SPEED x" .. level, level
end

function COMMANDS.heal(admin, targetId)
	local target = targetId and findPlayer(targetId) or admin
	if not target then
		return false, "Player not found"
	end
	ctx.heal(target, 99)
	if target ~= admin then
		notify(target, "AN ADMIN HEALED YOU")
	end
	return true, "HEALED " .. string.upper(target.DisplayName)
end

-- the client moves the bunny while flying; the server just shows the pose to everyone
function COMMANDS.fly(admin, on)
	local _, _, char = rootOf(admin)
	if not char then
		return false, "No character"
	end
	char:SetAttribute("Move", on and "fly" or "")
	char:SetAttribute("MoveAt", workspace:GetServerTimeNow())
	return true, on and "FLYING - WASD + SPACE/SHIFT" or "FLY OFF", on == true
end

-- Travel -------------------------------------------------------------------------
function COMMANDS.tp(admin, where)
	local cf
	if where == "boss" then
		cf = ctx.checkpointCF("throne")
	elseif type(where) == "string" and Config.Checkpoints[where] then
		cf = ctx.checkpointCF(where)
	end
	if not cf then
		return false, "Unknown place"
	end
	ctx.teleport(admin, cf)
	return true, "WHOOSH!"
end

COMMANDS["goto"] = function(admin, targetId)
	local target = findPlayer(targetId)
	local troot = rootOf(target)
	if not troot then
		return false, "Player not found"
	end
	ctx.teleport(admin, troot.CFrame * CFrame.new(0, 0, 6))
	return true, "WENT TO " .. string.upper(target.DisplayName)
end

-- Other players ---------------------------------------------------------------------
function COMMANDS.bring(admin, targetId)
	local target = findPlayer(targetId)
	local aroot = rootOf(admin)
	if not target or not aroot or not rootOf(target) then
		return false, "Player not found"
	end
	ctx.teleport(target, aroot.CFrame * CFrame.new(0, 0, -6))
	notify(target, string.upper(admin.DisplayName) .. " BROUGHT YOU HERE")
	return true, "BROUGHT " .. string.upper(target.DisplayName)
end

function COMMANDS.freeze(admin, targetId)
	local target = findPlayer(targetId)
	local troot = rootOf(target)
	if not troot then
		return false, "Player not found"
	end
	troot.Anchored = not troot.Anchored
	notify(target, troot.Anchored and "BRRR! AN ADMIN FROZE YOU" or "YOU THAWED OUT")
	return true, (troot.Anchored and "FROZE " or "UNFROZE ") .. string.upper(target.DisplayName)
end

function COMMANDS.launch(admin, targetId)
	local target = findPlayer(targetId)
	if not rootOf(target) then
		return false, "Player not found"
	end
	ctx.bounce(target, Vector3.new(math.random(-20, 20), 160, math.random(-20, 20)))
	notify(target, "WHEEEE!")
	return true, "LAUNCHED " .. string.upper(target.DisplayName)
end

function COMMANDS.control(admin, targetId)
	local target = findPlayer(targetId)
	if not target or target == admin or not rootOf(target) then
		return false, "Pick someone else"
	end
	if controlled[target] then
		release(target)
		return true, "RELEASED " .. string.upper(target.DisplayName)
	end
	controlled[target] = { by = admin, untilTime = os.clock() + 20 }
	Notice:FireClient(target, "control", true)
	notify(target, string.upper(admin.DisplayName) .. " IS CONTROLLING YOU!\nFOLLOW THE LEADER...")
	return true, string.upper(target.DisplayName) .. " FOLLOWS YOU FOR 20s"
end

-- World ----------------------------------------------------------------------------
function COMMANDS.resetboss()
	ctx.BossService.Reset()
	return true, "KING GRUMBLE RESET"
end

function COMMANDS.allgoldens(admin)
	local slot = ctx.DataService.ActiveSlot(admin)
	if not slot then
		return false, "Load a file first"
	end
	for _, g in ipairs(Config.Goldens) do
		slot.goldens[g.id] = true
	end
	slot.bossDefeated = true
	ctx.push(admin, nil)
	return true, "ALL GOLDEN CARROTS GIVEN (THIS FILE)"
end

--------------------------------------------------------------------------------

function AdminService.Start(context)
	ctx = context
	local fn = Instance.new("RemoteFunction")
	fn.Name = "AdminCommand"
	fn.Parent = ctx.remotes
	Notice = Instance.new("RemoteEvent")
	Notice.Name = "AdminNotice"
	Notice.Parent = ctx.remotes

	fn.OnServerInvoke = function(player, command, arg)
		if not AdminService.IsAdmin(player) then
			return false, "Admins only"
		end
		local handler = type(command) == "string" and COMMANDS[command]
		if not handler then
			return false, "Unknown command"
		end
		local ok, a, b, c = pcall(handler, player, arg)
		if not ok then
			warn("[Bunny64] Admin command failed:", a)
			return false, "Something went wrong"
		end
		return a, b, c
	end

	-- controlled players walk toward their admin
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.25 then
			return
		end
		acc = 0
		local now = os.clock()
		for target, c in pairs(controlled) do
			local aroot = rootOf(c.by)
			local troot, thum = rootOf(target)
			if not target.Parent or not c.by.Parent or not aroot or not thum or now > c.untilTime then
				release(target)
			else
				local behind = aroot.CFrame * CFrame.new(math.sin(now) * 3, 0, 7)
				thum:MoveTo(behind.Position)
				if (troot.Position - aroot.Position).Magnitude > 120 then
					troot.CFrame = behind
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		controlled[player] = nil
		speedLevel[player] = nil
		for target, c in pairs(controlled) do
			if c.by == player then
				release(target)
			end
		end
	end)
end

return AdminService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">BossService</string><ProtectedString name="Source"><![CDATA[--[[
	BossService - King Grumble, the giant crowned Grumblebug in the throne room.

	His three glowing weak points sit on top of his shell. They are only
	exposed while he is dazed: after he charges into a stone pillar, or after
	a ground slam tires him out. Jump (or ground pound) onto a weak point to
	break it. Break all three to win.

	  sleep -> roar -> chase -> windup -> charge -> (stunned | recover -> slam -> tired) -> chase ...
	Each hit makes him faster; from the second phase he spits fireballs.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Bunny64")
local Config = require(Shared:WaitForChild("Config"))
local BugModel = require(script.Parent:WaitForChild("BugModel"))

local BossService = {}

local SCALE = 3.4
local A, RADIUS
local cb
local boss = {}
local pillars = {}
local fireballs = {}
local waves = {}
local folder

local function setState(name)
	boss.state = name
	boss.t0 = os.clock()
	if boss.model then
		boss.model:SetAttribute("State", name)
	end
end

local function exposed()
	return boss.state == "stunned" or boss.state == "tired"
end

local function playersInArena()
	local list = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if root and hum and hum.Health > 0 then
			local p = root.Position
			if (Vector3.new(p.X, 0, p.Z) - Vector3.new(A.X, 0, A.Z)).Magnitude < RADIUS + 10 and p.Y > A.Y - 8 and p.Y < A.Y + 80 then
				table.insert(list, { player = player, root = root, hum = hum, char = char })
			end
		end
	end
	return list
end

local function nearest(list)
	local best, bestD = nil, math.huge
	for _, e in ipairs(list) do
		local d = (e.root.Position - boss.pos).Magnitude
		if d < bestD then
			best, bestD = e, d
		end
	end
	return best
end

local function build()
	if boss.model then
		boss.model:Destroy()
	end
	local model, _, root = BugModel.Build("castle", SCALE, CFrame.new())
	model.Name = "KingGrumble"
	-- crown
	local headY, headZ = 1.65 * SCALE, -2.9 * SCALE
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Material = Enum.Material.Metal
		p.Color = Config.Palette.Gold
		p.Size = Vector3.new(0.9, 2.2, 0.6)
		p.CFrame = CFrame.new(math.cos(a) * 2.6, headY + 3.4, headZ + math.sin(a) * 2.2) * CFrame.Angles(0, -a, 0)
		p.Parent = model
	end
	local band = Instance.new("Part")
	band.Shape = Enum.PartType.Cylinder
	band.Anchored = true
	band.CanCollide = false
	band.CanQuery = false
	band.CanTouch = false
	band.Material = Enum.Material.Metal
	band.Color = Config.Palette.Gold
	band.Size = Vector3.new(1.2, 5.6, 5.6)
	band.CFrame = CFrame.new(0, headY + 2.6, headZ) * CFrame.Angles(0, 0, math.pi / 2)
	band.Parent = model
	-- weak points
	boss.spots = {}
	for _, lp in ipairs({ Vector3.new(-1.15, 3.2, 1.5), Vector3.new(1.15, 3.2, 1.5), Vector3.new(0, 3.15, -0.6) }) do
		local s = Instance.new("Part")
		s.Name = "WeakPoint"
		s.Anchored = true
		s.CanCollide = false
		s.CanQuery = false
		s.CanTouch = false
		s.Size = Vector3.new(1.4, 0.9, 1.4) * SCALE
		s.CFrame = CFrame.new(lp * SCALE)
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Parent = s
		s.Parent = model
		table.insert(boss.spots, { part = s, alive = true })
	end
	boss.shells = {}
	for _, d in ipairs(model:GetChildren()) do
		if d.Name == "Shell" then
			table.insert(boss.shells, d)
		end
	end
	boss.model = model
	boss.root = root
	model:SetAttribute("Boss", true)
	model.Parent = folder
end

local function reset()
	build()
	boss.pos = A
	boss.yaw = 0
	boss.hp = 3
	boss.model:SetAttribute("HP", 3)
	boss.lastFire = 0
	boss.slams = 0
	setState("sleep")
end

local function place(extraY, tilt)
	boss.model:PivotTo(CFrame.new(boss.pos + Vector3.new(0, 1.8 * SCALE + (extraY or 0), 0)) * CFrame.Angles(0, boss.yaw, 0) * CFrame.Angles(tilt or 0, 0, 0))
end

local function refreshSpots()
	local on = exposed()
	for _, s in ipairs(boss.spots) do
		if s.alive then
			s.part.Material = on and Enum.Material.Neon or Enum.Material.SmoothPlastic
			s.part.Color = on and Color3.fromRGB(240, 170, 70) or Color3.fromRGB(80, 50, 40)
		end
	end
	for _, sh in ipairs(boss.shells) do
		sh.CanCollide = on -- climb onto his back while he's dazed
	end
end

local function faceTo(pos)
	local d = pos - boss.pos
	if Vector3.new(d.X, 0, d.Z).Magnitude > 0.1 then
		boss.yaw = math.atan2(-d.X, -d.Z)
	end
end

local function forward()
	return Vector3.new(-math.sin(boss.yaw), 0, -math.cos(boss.yaw))
end

local function clampToArena(p)
	local flat = Vector3.new(p.X - A.X, 0, p.Z - A.Z)
	if flat.Magnitude > RADIUS - 8 then
		flat = flat.Unit * (RADIUS - 8)
		return Vector3.new(A.X + flat.X, A.Y, A.Z + flat.Z), true
	end
	return Vector3.new(p.X, A.Y, p.Z), false
end

local function spitFireball(target)
	local from = boss.pos + Vector3.new(0, 2 * SCALE, 0) + forward() * 3.4 * SCALE
	local to = target.root.Position
	local dir = Vector3.new(to.X - from.X, 0, to.Z - from.Z)
	if dir.Magnitude < 0.1 then
		return
	end
	local ball = Instance.new("Part")
	ball.Name = "Fireball"
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.one * 3.2
	ball.Material = Enum.Material.Neon
	ball.Color = Config.Palette.Ember
	ball.Anchored = true
	ball.CanCollide = false
	ball.CanQuery = false
	ball.CanTouch = false
	ball.CFrame = CFrame.new(Vector3.new(from.X, A.Y + 3, from.Z))
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 140, 70)
	light.Range = 14
	light.Parent = ball
	ball.Parent = folder
	table.insert(fireballs, { part = ball, vel = dir.Unit * 36, die = os.clock() + 4 })
	cb.effect("fire", from)
end

local function slamLand()
	table.insert(waves, { center = boss.pos, t0 = os.clock(), speed = 44, maxR = 64, hit = {} })
	cb.effect("shockwave", boss.pos, 44)
end

local function hurtPlayer(e, fromPos)
	cb.hurt(e.player, fromPos)
end

-- Admin helper: put King Grumble back to full health, asleep in the middle
function BossService.Reset()
	if A then
		reset()
		place(0)
	end
end

function BossService.Start(worldInfo, callbacks)
	cb = callbacks
	A = worldInfo.arenaCenter
	RADIUS = worldInfo.arenaRadius
	folder = Instance.new("Folder")
	folder.Name = "Boss"
	folder.Parent = workspace
	for _, d in ipairs(worldInfo.solidFolder:GetDescendants()) do
		if d:IsA("BasePart") and d.Name == "ArenaPillar" then
			table.insert(pillars, Vector3.new(d.Position.X, A.Y, d.Position.Z))
		end
	end
	reset()
	place(0)

	local emptySince = os.clock()
	RunService.Heartbeat:Connect(function(dt)
		local now = os.clock()
		local list = playersInArena()
		if #list == 0 then
			if now - emptySince > 8 and (boss.state ~= "sleep" or boss.hp < 3) then
				reset()
				place(0)
			end
		else
			emptySince = now
		end
		local st = boss.state
		local age = now - boss.t0
		local phase = 4 - boss.hp -- 1, 2, 3
		local target = nearest(list)
		local lift, tilt = 0, 0

		if st == "sleep" then
			boss.yaw += dt * 0.2
			lift = math.sin(now * 1.5) * 0.3
			if #list > 0 then
				setState("roar")
				cb.effect("bossroar", boss.pos)
			end
		elseif st == "roar" then
			if target then
				faceTo(target.root.Position)
			end
			tilt = math.sin(age * 20) * 0.04 + 0.12
			if age > 2 then
				setState("chase")
			end
		elseif st == "chase" then
			if target then
				faceTo(target.root.Position)
				local speed = 12 + 4 * phase
				boss.pos = clampToArena(boss.pos + forward() * speed * dt)
				if phase >= 2 and now - boss.lastFire > (phase == 2 and 1.5 or 0.9) then
					boss.lastFire = now
					spitFireball(target)
				end
			end
			lift = math.abs(math.sin(now * 10)) * 0.6
			if age > 3.2 - 0.4 * phase then
				setState("windup")
			end
		elseif st == "windup" then
			if target and age < 0.4 then
				faceTo(target.root.Position)
			end
			tilt = -0.18
			lift = math.sin(age * 40) * 0.25
			if age > 1.0 - 0.15 * phase then
				setState("charge")
				cb.effect("bosscharge", boss.pos)
			end
		elseif st == "charge" then
			local speed = 56 + 8 * phase
			local nextPos, hitEdge = clampToArena(boss.pos + forward() * speed * dt)
			boss.pos = nextPos
			tilt = -0.08
			local bonk = false
			for _, pl in ipairs(pillars) do
				if (Vector3.new(boss.pos.X, 0, boss.pos.Z) - Vector3.new(pl.X, 0, pl.Z)).Magnitude < 4.5 + 2.6 * SCALE then
					bonk = true
				end
			end
			if bonk then
				setState("stunned")
				refreshSpots()
				cb.effect("bossbonk", boss.pos + Vector3.new(0, 3 * SCALE, 0))
			elseif hitEdge or age > 2.2 then
				setState("recover")
			end
		elseif st == "recover" then
			if age > 0.8 then
				boss.slams = 0
				setState("slam")
			end
		elseif st == "slam" then
			local dur = 1.1
			local u = math.clamp(age / dur, 0, 1)
			lift = math.sin(u * math.pi) * 22
			if target then
				faceTo(target.root.Position)
				boss.pos = clampToArena(boss.pos + forward() * 22 * dt)
			end
			if age >= dur then
				slamLand()
				boss.slams += 1
				if phase == 3 and boss.slams < 2 then
					setState("slam")
				else
					setState("tired")
					refreshSpots()
				end
			end
		elseif st == "stunned" or st == "tired" then
			tilt = math.sin(now * 3) * 0.06
			lift = -0.6
			if st == "stunned" then
				boss.yaw += math.sin(now * 5) * dt * 0.6
			end
			if age > (st == "stunned" and 4.2 or 3.2) then
				setState("chase")
				refreshSpots()
			end
		elseif st == "hurt" then
			tilt = math.sin(age * 30) * 0.1 -- clients flash him while State == "hurt"
			if age > 1.4 then
				if boss.hp <= 0 then
					setState("dying")
					cb.effect("bossdie", boss.pos + Vector3.new(0, 3 * SCALE, 0))
				else
					setState("chase")
				end
			end
		elseif st == "dying" then
			boss.yaw += dt * (4 + age * 6)
			lift = age * 4
			if age > 2.4 then
				cb.effect("poof", boss.pos + Vector3.new(0, 3 * SCALE, 0))
				boss.model.Parent = nil
				setState("dead")
				local winners = {}
				for _, e in ipairs(list) do
					table.insert(winners, e.player)
				end
				cb.defeated(winners)
			end
		elseif st == "dead" then
			if age > 45 and #list == 0 then
				reset()
			end
		end

		if boss.model.Parent then
			place(lift, tilt)
			boss.model:SetAttribute("Exposed", exposed())
		end

		-- Player interactions -------------------------------------------------
		if st ~= "dead" and st ~= "dying" and st ~= "sleep" then
			for _, e in ipairs(list) do
				local h = e.root.Position
				local feet = h.Y - 2.6
				local vy = e.root.AssemblyLinearVelocity.Y
				local handled = false
				if exposed() then
					for _, s in ipairs(boss.spots) do
						if s.alive then
							local w = s.part.Position
							local flat = Vector3.new(h.X - w.X, 0, h.Z - w.Z).Magnitude
							if flat < 4.6 and feet > w.Y - 2.2 and feet < w.Y + 5 and (vy < 1 or e.char:GetAttribute("Move") == "pound") then
								s.alive = false
								s.part.Parent = nil
								boss.hp -= 1
								boss.model:SetAttribute("HP", boss.hp)
								cb.bounce(e.player, Vector3.new(0, 80, 0))
								cb.effect("bosshit", w)
								setState("hurt")
								refreshSpots()
								handled = true
								break
							end
						end
					end
				end
				if not handled and not exposed() and boss.state ~= "hurt" then
					local flat = Vector3.new(h.X - boss.pos.X, 0, h.Z - boss.pos.Z).Magnitude
					if flat < 3.2 * SCALE and feet < boss.pos.Y + 3.4 * SCALE then
						hurtPlayer(e, boss.pos)
					end
				end
			end
		end

		-- Fireballs ---------------------------------------------------------------
		for i = #fireballs, 1, -1 do
			local f = fireballs[i]
			local p = f.part.Position + f.vel * dt
			f.part.CFrame = CFrame.new(p)
			local dead = now > f.die or (Vector3.new(p.X - A.X, 0, p.Z - A.Z)).Magnitude > RADIUS + 4
			if not dead then
				for _, e in ipairs(list) do
					if (e.root.Position - p).Magnitude < 3.6 then
						hurtPlayer(e, p - f.vel)
						dead = true
					end
				end
			end
			if dead then
				f.part:Destroy()
				table.remove(fireballs, i)
			end
		end

		-- Shockwaves --------------------------------------------------------------
		for i = #waves, 1, -1 do
			local w = waves[i]
			local r = (now - w.t0) * w.speed
			if r > w.maxR then
				table.remove(waves, i)
			else
				for _, e in ipairs(list) do
					local h = e.root.Position
					local flat = Vector3.new(h.X - w.center.X, 0, h.Z - w.center.Z).Magnitude
					local grounded = h.Y - 2.6 < A.Y + 1.4
					if grounded and not w.hit[e.player] and math.abs(flat - r) < 2.8 then
						w.hit[e.player] = true
						cb.hurt(e.player, w.center)
					end
				end
			end
		end
	end)
end

return BossService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">BugModel</string><ProtectedString name="Source"><![CDATA[--[[
	BugModel - builds a Grumblebug: a round beetle with split wing cases,
	a shield-shaped thorax, mandibles, glossy eyes under a cross brow,
	clubbed antennae and six two-part legs.

	Front is -Z, feet at Y = 0 (before scaling). Returns model, legs list
	and the root part. `scale` lets the boss reuse the same design.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Bunny64")
local Config = require(Shared:WaitForChild("Config"))

local BugModel = {}

local SMOOTH = Enum.Material.SmoothPlastic

function BugModel.Build(skinName, scale, origin)
	local skin = Config.BugSkins[skinName] or Config.BugSkins.meadow
	scale = scale or 1
	origin = origin or CFrame.new()
	local model = Instance.new("Model")
	model.Name = "Grumblebug"
	local legs = {}

	local function part(cf, size, color, ball, material, name)
		local p = Instance.new("Part")
		p.Name = name or "Part"
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Size = size * scale
		p.CFrame = origin * CFrame.new(cf.Position * scale) * (cf - cf.Position)
		p.Color = color
		p.Material = material or SMOOTH
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		if ball then
			local m = Instance.new("SpecialMesh")
			m.MeshType = Enum.MeshType.Sphere
			m.Parent = p
		end
		p.Parent = model
		return p
	end
	local CF, V, R = CFrame.new, Vector3.new, CFrame.Angles

	local root = part(CF(0, 1.8, 0), V(4, 3, 6), skin.shell, false, nil, "Root")
	root.Transparency = 1
	model.PrimaryPart = root

	-- underside & wing cases
	part(CF(0, 1.15, 0.3), V(3.9, 1.1, 5.8), skin.body, true)
	for _, sx in ipairs({ -1, 1 }) do
		part(CF(sx * 1.02, 2.05, 0.9) * R(0, 0, sx * -0.12), V(2.25, 2.4, 5.0), skin.shell, true, nil, "Shell")
		part(CF(sx * 1.25, 2.75, 1.6), V(0.85, 0.32, 1.1), skin.spot, true, skinName == "castle" and Enum.Material.Neon or SMOOTH)
		part(CF(sx * 0.9, 2.55, -0.1), V(0.6, 0.28, 0.75), skin.spot, true, skinName == "castle" and Enum.Material.Neon or SMOOTH)
	end
	part(CF(0, 3.1, 1.0), V(0.16, 0.2, 4.4), skin.body) -- wing seam
	-- thorax shield
	part(CF(0, 2.1, -1.75), V(3.2, 1.75, 1.9), skin.shell2, true)
	-- head
	part(CF(0, 1.65, -2.9), V(2.0, 1.55, 1.6), skin.body, true, nil, "Head")
	for _, sx in ipairs({ -1, 1 }) do
		-- eyes with a glint
		local eye = part(CF(sx * 0.62, 2.0, -3.45), V(0.62, 0.72, 0.5), Config.Palette.Button, true)
		eye.Reflectance = 0.2
		part(CF(sx * 0.58, 2.12, -3.7), V(0.2, 0.2, 0.08), skin.eye, true, Enum.Material.Neon)
		-- cross brow
		part(CF(sx * 0.55, 2.42, -3.5) * R(0, 0, sx * 0.38), V(0.95, 0.22, 0.32), skin.body)
		-- mandibles
		part(CF(sx * 0.42, 1.25, -3.75) * R(0, sx * 0.55, 0), V(0.3, 0.28, 1.0), skin.shell2)
		-- antenna: stalk + club
		part(CF(sx * 0.42, 2.7, -3.55) * R(-0.75, 0, sx * -0.35), V(0.14, 1.5, 0.14), skin.body)
		part(CF(sx * 0.72, 3.25, -4.15), V(0.38, 0.38, 0.38), skin.body, true)
		-- legs: thigh angled up and out, shin down to the ground
		for i, z in ipairs({ -1.4, 0.3, 1.9 }) do
			local thigh = part(CF(sx * 2.05, 1.65, z) * R(0, 0, sx * 0.45), V(1.5, 0.34, 0.34), skin.body)
			local shin = part(CF(sx * 2.75, 0.75, z + (i - 2) * 0.25) * R(0, 0, sx * -0.15), V(0.3, 1.6, 0.3), skin.body)
			table.insert(legs, { thigh = thigh, shin = shin, side = sx, index = i })
		end
	end
	model.Parent = nil
	return model, legs, root
end

return BugModel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">CrateService</string><ProtectedString name="Source"><![CDATA[--[[
	CrateService - breakable heart crates.

	Roll, slide, long jump or ground pound into a crate (or stomp on it) and
	it bursts, giving the bunny who broke it a heart. Crates come back after a
	while, so they're placed before the hard parts as a little mercy.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local CrateService = {}

local RESPAWN = 45
local BREAK_MOVES = { roll = true, slide = true, longjump = true, pound = true, walljump = true }
local crates = {}
local cb

local function breakCrate(c, player)
	if not c.alive then
		return
	end
	c.alive = false
	c.respawnAt = os.clock() + RESPAWN
	cb.effect("crate", c.part.Position)
	c.part.Parent = nil
	if player then
		cb.heal(player)
	end
end

function CrateService.Start(info, callbacks)
	cb = callbacks
	for _, part in ipairs(info.crates) do
		table.insert(crates, { part = part, parent = part.Parent, alive = true, respawnAt = 0 })
	end
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.08 then
			return
		end
		acc = 0
		local now = os.clock()
		for _, c in ipairs(crates) do
			if not c.alive then
				if now > c.respawnAt then
					c.alive = true
					c.part.Parent = c.parent
					cb.effect("poof", c.part.Position)
				end
				continue
			end
			local pos = c.part.Position
			for _, player in ipairs(Players:GetPlayers()) do
				local char = player.Character
				local root = char and char:FindFirstChild("HumanoidRootPart")
				if root then
					local p = root.Position
					local flat = Vector3.new(p.X - pos.X, 0, p.Z - pos.Z).Magnitude
					local feet = p.Y - 2.6
					if flat < 4.6 and feet > pos.Y - 3 and feet < pos.Y + 4 then
						local move = char:GetAttribute("Move")
						local vy = root.AssemblyLinearVelocity.Y
						if (move and BREAK_MOVES[move]) or (feet > pos.Y + 1.2 and vy < -6) then
							breakCrate(c, player)
							if feet > pos.Y + 1.2 then
								cb.bounce(player, Vector3.new(0, 48, 0))
							end
							break
						end
					end
				end
			end
		end
	end)
end

-- Ground pound shockwaves smash nearby crates too
function CrateService.Shockwave(player, pos)
	for _, c in ipairs(crates) do
		if c.alive and (c.part.Position - pos).Magnitude < 10 then
			breakCrate(c, player)
		end
	end
end

return CrateService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000C"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[--[[
	DataService - loads and saves each player's progress with DataStoreService.

	Save layout (one DataStore key per player):
	  {
	    version = 2,
	    slots = { ["1"] = slot, ["2"] = slot, ["3"] = slot },   -- File A / B / C
	    custom = { fur, accent, hat, neck },                     -- shared look
	    options = { sfx, music, shake },
	  }

	* Session locking so two servers can't overwrite each other.
	* Retries with back-off, autosave, save on leave and on shutdown.
	* Saves from the first version are moved into File A automatically.
	* In Studio without API access the game still runs; nothing is saved.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Bunny64")
local Config = require(Shared:WaitForChild("Config"))

local DataService = {}

local SCHEMA_VERSION = 2
local LOCK_TIMEOUT = 600

local store = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[Bunny64] DataStore unavailable:", result)
	end
end

local profiles = {} -- [Player] = profile

function DataService.NewSlot()
	return {
		carrots = {},
		goldens = {},
		carrotCount = 0,
		bugs = 0,
		playTime = 0,
		completedTime = nil,
		checkpoint = "meadow",
		warps = { meadow = true },
		bossDefeated = false,
		tips = {},
		stamps = {},
		silvers = {},
		trials = {},
		stats = { crates = 0, longjumps = 0 },
		regions = {},
		friends = {},
		created = os.time(),
	}
end

local function defaultData()
	return {
		version = SCHEMA_VERSION,
		slots = {},
		custom = table.clone(Config.DefaultCustom),
		options = { sfx = 8, music = 6, shake = true, tips = true, assist = false },
	}
end

local function reconcileSlot(slot)
	if type(slot) ~= "table" then
		return nil
	end
	for k, v in pairs(DataService.NewSlot()) do
		if slot[k] == nil and k ~= "completedTime" then
			slot[k] = v
		end
	end
	local n = 0
	for _ in pairs(slot.carrots) do
		n += 1
	end
	slot.carrotCount = n
	if not Config.Checkpoints[slot.checkpoint] then
		slot.checkpoint = "meadow"
	end
	return slot
end

local function reconcile(data)
	if type(data) ~= "table" then
		return defaultData()
	end
	if data.version == nil or data.version < 2 then
		-- version 1 kept a single game at the top level: move it into File A
		local legacy = {
			carrots = data.carrots or {},
			goldens = data.goldens or {},
			bugs = data.bugs or 0,
			playTime = data.playTime or 0,
			completedTime = nil, -- the game grew; the old ending no longer counts
		}
		data = defaultData()
		if next(legacy.carrots) or next(legacy.goldens) then
			data.slots["1"] = reconcileSlot(legacy)
		end
	end
	for k, v in pairs(defaultData()) do
		if data[k] == nil then
			data[k] = v
		end
	end
	for i = 1, Config.SaveSlots do
		local key = tostring(i)
		data.slots[key] = reconcileSlot(data.slots[key])
	end
	return data
end

local function shallowCopy(t)
	local out = {}
	for k, v in pairs(t) do
		out[k] = v
	end
	return out
end

local function isApiDisabledError(err)
	local msg = tostring(err)
	return string.find(msg, "StudioAccessToApisNotAllowed") ~= nil
		or string.find(msg, "publish", 1, true) ~= nil
		or string.find(msg, "403", 1, true) ~= nil
end

local function keyFor(player)
	return "player_" .. player.UserId
end

--------------------------------------------------------------------------------
-- Load / save
--------------------------------------------------------------------------------

function DataService.Load(player)
	local profile = {
		player = player,
		data = defaultData(),
		canSave = false,
		loaded = false,
		active = nil, -- "1" / "2" / "3" while playing a file
		lastTick = os.clock(),
	}
	profiles[player] = profile

	if store then
		local attempts = 5
		for attempt = 1, attempts do
			if not player.Parent then
				return nil
			end
			local locked = false
			local ok, result = pcall(function()
				return store:UpdateAsync(keyFor(player), function(old)
					old = reconcile(old)
					local lock = old.lock
					if lock and lock.job ~= game.JobId and os.time() - (lock.time or 0) < LOCK_TIMEOUT and attempt < attempts then
						locked = true
						return nil
					end
					old.lock = { job = game.JobId, time = os.time() }
					return old
				end)
			end)
			if ok and result then
				profile.data = reconcile(result)
				profile.canSave = true
				break
			elseif not ok then
				warn(string.format("[Bunny64] Load attempt %d for %s failed: %s", attempt, player.Name, tostring(result)))
				if isApiDisabledError(result) then
					break
				end
			end
			task.wait(locked and 3 or attempt * 1.5)
		end
	end

	profile.data.lock = nil
	profile.loaded = true
	if not profile.canSave then
		warn("[Bunny64] Progress for " .. player.Name .. " will NOT be saved this session.")
	end
	return profile
end

local function tickPlayTime(profile)
	local now = os.clock()
	local slot = profile.active and profile.data.slots[profile.active]
	if slot then
		slot.playTime += now - profile.lastTick
	end
	profile.lastTick = now
end

function DataService.Save(player, release)
	local profile = profiles[player]
	if not profile or not profile.loaded then
		return false
	end
	tickPlayTime(profile)
	if not profile.canSave or not store then
		return false
	end
	local payload = shallowCopy(profile.data)
	payload.lock = (not release) and { job = game.JobId, time = os.time() } or nil

	for attempt = 1, 3 do
		local stolen = false
		local ok, err = pcall(function()
			store:UpdateAsync(keyFor(player), function(old)
				if type(old) == "table" and old.lock and old.lock.job ~= game.JobId then
					stolen = true
					return nil
				end
				return payload
			end)
		end)
		if ok then
			if stolen then
				warn("[Bunny64] Save skipped for " .. player.Name .. ": session owned by another server.")
				profile.canSave = false
				return false
			end
			if DataService.OnSaved and not release then
				pcall(DataService.OnSaved, player)
			end
			return true
		end
		warn(string.format("[Bunny64] Save attempt %d for %s failed: %s", attempt, player.Name, tostring(err)))
		task.wait(attempt)
	end
	return false
end

function DataService.Release(player)
	DataService.Save(player, true)
	profiles[player] = nil
end

function DataService.Get(player)
	local profile = profiles[player]
	if profile and profile.loaded then
		return profile
	end
	return nil
end

function DataService.WaitFor(player, timeout)
	local start = os.clock()
	while player.Parent and os.clock() - start < (timeout or 30) do
		local profile = DataService.Get(player)
		if profile then
			return profile
		end
		task.wait(0.1)
	end
	return nil
end

--------------------------------------------------------------------------------
-- Files (save slots)
--------------------------------------------------------------------------------

function DataService.ActiveSlot(player)
	local profile = DataService.Get(player)
	if profile and profile.active then
		return profile.data.slots[profile.active], profile
	end
	return nil, profile
end

function DataService.SelectSlot(player, index)
	local profile = DataService.Get(player)
	if not profile or type(index) ~= "number" or index < 1 or index > Config.SaveSlots or index % 1 ~= 0 then
		return nil
	end
	tickPlayTime(profile)
	local key = tostring(index)
	if not profile.data.slots[key] then
		profile.data.slots[key] = DataService.NewSlot()
	end
	profile.active = key
	profile.lastTick = os.clock()
	return profile.data.slots[key]
end

function DataService.ClearActive(player)
	local profile = DataService.Get(player)
	if profile then
		tickPlayTime(profile)
		profile.active = nil
	end
end

function DataService.EraseSlot(player, index)
	local profile = DataService.Get(player)
	if not profile or type(index) ~= "number" or index < 1 or index > Config.SaveSlots then
		return false
	end
	local key = tostring(math.floor(index))
	if profile.active == key then
		return false
	end
	profile.data.slots[key] = nil
	return true
end

function DataService.GetPlayTime(player)
	local profile = profiles[player]
	local slot = profile and profile.active and profile.data.slots[profile.active]
	if not slot then
		return 0
	end
	return slot.playTime + (os.clock() - profile.lastTick)
end

local function count(t)
	local n = 0
	for _ in pairs(t or {}) do
		n += 1
	end
	return n
end
DataService.Count = count

function DataService.Summaries(player)
	local profile = DataService.Get(player)
	local out = {}
	for i = 1, Config.SaveSlots do
		local slot = profile and profile.data.slots[tostring(i)]
		if slot then
			out[i] = {
				exists = true,
				goldens = count(slot.goldens),
				carrots = slot.carrotCount,
				playTime = (profile.active == tostring(i)) and DataService.GetPlayTime(player) or slot.playTime,
				completed = slot.completedTime ~= nil,
			}
		else
			out[i] = { exists = false, goldens = 0, carrots = 0, playTime = 0, completed = false }
		end
	end
	return out
end

-- Best progress across all files (unlocks cosmetics)
function DataService.Progress(player)
	local profile = DataService.Get(player)
	local best, boss = 0, false
	if profile then
		for i = 1, Config.SaveSlots do
			local slot = profile.data.slots[tostring(i)]
			if slot then
				best = math.max(best, count(slot.goldens))
				boss = boss or slot.bossDefeated == true
			end
		end
	end
	return { goldens = best, boss = boss }
end

--------------------------------------------------------------------------------
-- Autosave & shutdown
--------------------------------------------------------------------------------

task.spawn(function()
	while true do
		task.wait(Config.AutosaveSeconds)
		for player in pairs(profiles) do
			task.spawn(DataService.Save, player, false)
		end
	end
end)

game:BindToClose(function()
	if RunService:IsStudio() and not store then
		return
	end
	local pending = 0
	for _, player in ipairs(Players:GetPlayers()) do
		if profiles[player] then
			pending += 1
			task.spawn(function()
				DataService.Save(player, true)
				pending -= 1
			end)
		end
	end
	local start = os.clock()
	while pending > 0 and os.clock() - start < 25 do
		task.wait(0.1)
	end
end)

return DataService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000D"><Properties><string name="Name">EnemyModels</string><ProtectedString name="Source"><![CDATA[--[[
	EnemyModels - builds the non-beetle baddies. Each builder returns
	(model, extras) with the model's PrimaryPart at the enemy's centre;
	front is -Z. Everything is anchored and non-colliding (the server moves
	them and does its own contact checks).

	  toad        Hopscotch Toad    hops after you in big arcs       stomp it
	  bat         Flitbat           circles, then swoops at you      stomp / roll into it
	  thornhog    Thornhog          rolls back and forth, all spikes ground pound it
	  puffshroom  Puffshroom        puffs a ring of spores           stomp it between puffs
]]

local EnemyModels = {}

local SMOOTH = Enum.Material.SmoothPlastic
local rgb = Color3.fromRGB
local CF, V, R = CFrame.new, Vector3.new, CFrame.Angles

local SKINS = {
	toad = {
		forest = { body = rgb(78, 104, 64), belly = rgb(196, 190, 150), spot = rgb(120, 92, 60), eye = rgb(200, 210, 110) },
		meadow = { body = rgb(96, 128, 70), belly = rgb(214, 204, 160), spot = rgb(70, 96, 52), eye = rgb(214, 180, 70) },
		canyon = { body = rgb(170, 130, 82), belly = rgb(226, 206, 166), spot = rgb(132, 96, 60), eye = rgb(226, 160, 60) },
		peaks = { body = rgb(120, 140, 156), belly = rgb(226, 230, 232), spot = rgb(92, 108, 124), eye = rgb(150, 210, 230) },
	},
	bat = {
		forest = { body = rgb(54, 60, 50), wing = rgb(80, 92, 70), eye = rgb(200, 230, 120) },
		sky = { body = rgb(110, 116, 140), wing = rgb(160, 170, 196), eye = rgb(250, 220, 140) },
		castle = { body = rgb(62, 44, 54), wing = rgb(92, 56, 66), eye = rgb(240, 120, 50) },
		peaks = { body = rgb(86, 100, 120), wing = rgb(120, 140, 160), eye = rgb(160, 220, 240) },
		meadow = { body = rgb(70, 56, 66), wing = rgb(104, 80, 92), eye = rgb(230, 200, 90) },
	},
	thornhog = {
		canyon = { body = rgb(112, 84, 60), spike = rgb(226, 214, 186), face = rgb(196, 160, 120), tip = rgb(226, 214, 186) },
		castle = { body = rgb(48, 40, 40), spike = rgb(80, 70, 70), face = rgb(120, 96, 86), tip = rgb(232, 120, 50) },
		meadow = { body = rgb(100, 84, 70), spike = rgb(214, 204, 180), face = rgb(190, 160, 128), tip = rgb(214, 204, 180) },
	},
	mossling = {
		forest = { moss = rgb(92, 118, 64), moss2 = rgb(72, 96, 52), face = rgb(120, 92, 66), eye = rgb(226, 214, 120) },
	},
	snapper = {
		forest = { stem = rgb(84, 114, 62), head = rgb(140, 70, 80), inside = rgb(200, 120, 120), leaf = rgb(70, 100, 54), tooth = rgb(236, 230, 214) },
	},
	puffer = {
		sky = { cloud = rgb(226, 230, 238), shade = rgb(186, 194, 212), cheek = rgb(214, 150, 160) },
	},
	puffshroom = {
		meadow = { cap = rgb(120, 82, 132), spot = rgb(222, 210, 190), stem = rgb(220, 208, 182) },
		peaks = { cap = rgb(90, 120, 150), spot = rgb(232, 236, 240), stem = rgb(220, 224, 228) },
		castle = { cap = rgb(150, 56, 46), spot = rgb(240, 170, 90), stem = rgb(170, 150, 136) },
		canyon = { cap = rgb(176, 120, 70), spot = rgb(232, 214, 170), stem = rgb(214, 196, 160) },
	},
}

local function skinFor(kind, name)
	local set = SKINS[kind]
	return set[name] or set[next(set)]
end

local function newPart(model, origin, cf, size, color, ball, material, name)
	local p = Instance.new("Part")
	p.Name = name or "Part"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Size = size
	p.CFrame = origin * cf
	p.Color = color
	p.Material = material or SMOOTH
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if ball then
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Parent = p
	end
	p.Parent = model
	return p
end

local function rootPart(model, origin, size)
	local r = newPart(model, origin, CF(), size, Color3.new(), false, nil, "Root")
	r.Transparency = 1
	model.PrimaryPart = r
	return r
end

local function eyes(model, origin, y, z, spread, size, glint, angry, browColor)
	for _, sx in ipairs({ -1, 1 }) do
		newPart(model, origin, CF(sx * spread, y, z), V(size, size * 1.1, size * 0.7), rgb(236, 230, 214), true)
		local pupil = newPart(model, origin, CF(sx * spread * 0.95, y - size * 0.05, z - size * 0.3), V(size * 0.5, size * 0.6, size * 0.3), rgb(24, 20, 22), true)
		pupil.Reflectance = 0.2
		if glint then
			newPart(model, origin, CF(sx * spread * 0.9, y + size * 0.12, z - size * 0.42), V(size * 0.16, size * 0.16, size * 0.08), glint, true, Enum.Material.Neon)
		end
		if angry then
			newPart(model, origin, CF(sx * spread, y + size * 0.62, z - size * 0.2) * R(0, 0, sx * 0.4), V(size * 1.1, size * 0.22, size * 0.3), browColor or rgb(30, 24, 24))
		end
	end
end

-- Hopscotch Toad --------------------------------------------------------------------
function EnemyModels.toad(skinName, origin)
	local s = skinFor("toad", skinName)
	local model = Instance.new("Model")
	model.Name = "HopscotchToad"
	rootPart(model, origin, V(4, 3, 4))
	newPart(model, origin, CF(0, -0.1, 0.2), V(4.2, 2.6, 4.6), s.body, true, nil, "Body")
	newPart(model, origin, CF(0, -0.55, -0.7), V(3.2, 1.6, 2.6), s.belly, true)
	for _, sp in ipairs({ { -0.9, 1.0, 0.8 }, { 1.0, 0.95, 1.4 }, { 0.2, 1.1, 0.2 } }) do
		newPart(model, origin, CF(sp[1], sp[2], sp[3]), V(0.9, 0.3, 0.9), s.spot, true)
	end
	-- bulging eyes on top
	for _, sx in ipairs({ -1, 1 }) do
		newPart(model, origin, CF(sx * 1.05, 1.15, -1.3), V(1.3, 1.3, 1.3), s.body, true)
	end
	eyes(model, origin, 1.35, -1.75, 1.05, 0.95, s.eye, false)
	newPart(model, origin, CF(0, -0.25, -2.25) * R(0, 0, 0), V(2.6, 0.12, 0.2), rgb(40, 30, 30))
	-- folded back legs and little front feet
	local legs = {}
	for _, sx in ipairs({ -1, 1 }) do
		table.insert(legs, newPart(model, origin, CF(sx * 2.05, -0.6, 1.3), V(1.4, 1.6, 2.6), s.body, true, nil, "BackLeg"))
		newPart(model, origin, CF(sx * 2.3, -1.3, 0.2), V(1.3, 0.4, 2.0), s.belly, true)
		newPart(model, origin, CF(sx * 1.3, -1.3, -1.8), V(0.8, 0.35, 1.0), s.belly, true)
	end
	model:SetAttribute("Kind", "toad")
	return model, { legs = legs }
end

-- Flitbat ---------------------------------------------------------------------------------
function EnemyModels.bat(skinName, origin)
	local s = skinFor("bat", skinName)
	local model = Instance.new("Model")
	model.Name = "Flitbat"
	rootPart(model, origin, V(2, 2, 2))
	newPart(model, origin, CF(0, 0, 0), V(2.2, 2.4, 2.0), s.body, true, nil, "Body")
	newPart(model, origin, CF(0, -0.3, -0.75), V(1.3, 1.0, 0.6), s.wing, true)
	for _, sx in ipairs({ -1, 1 }) do
		newPart(model, origin, CF(sx * 0.6, 1.45, 0) * R(0, 0, sx * -0.3), V(0.5, 1.2, 0.3), s.body)
	end
	eyes(model, origin, 0.35, -0.85, 0.42, 0.5, s.eye, true)
	for _, sx in ipairs({ -1, 1 }) do
		newPart(model, origin, CF(sx * 0.2, -0.55, -0.95), V(0.14, 0.3, 0.1), rgb(236, 230, 214))
	end
	local wings = {}
	for _, sx in ipairs({ -1, 1 }) do
		local offset = CF(sx * 1.0, 0.3, 0.1)
		local wing = newPart(model, origin, offset * CF(sx * 1.9, 0, 0), V(3.8, 0.18, 2.2), s.wing, false, nil, "Wing")
		local tip = newPart(model, origin, offset * CF(sx * 3.4, -0.1, 0.6) * R(0, sx * 0.4, 0), V(1.6, 0.16, 1.4), s.wing, false, nil, "WingTip")
		table.insert(wings, { part = wing, offset = offset, local1 = CF(sx * 1.9, 0, 0), side = sx, tip = tip, local2 = CF(sx * 3.4, -0.1, 0.6) * R(0, sx * 0.4, 0) })
	end
	model:SetAttribute("Kind", "bat")
	return model, { wings = wings }
end

-- Thornhog ---------------------------------------------------------------------------------
function EnemyModels.thornhog(skinName, origin)
	local s = skinFor("thornhog", skinName)
	local model = Instance.new("Model")
	model.Name = "Thornhog"
	rootPart(model, origin, V(4, 4, 4))
	newPart(model, origin, CF(), V(4.4, 4.0, 4.6), s.body, true, nil, "Body")
	-- spikes all over the back
	local n = 0
	for ring = 0, 3 do
		local pitch = -0.2 + ring * 0.55
		local count = 7 - math.abs(ring - 1)
		for i = 0, count - 1 do
			local yaw = i / count * math.pi * 2 + ring * 0.3
			local dir = (CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)).LookVector
			if dir.Z > -0.55 or dir.Y > 0.35 then
				local base = dir * 1.9
				local cf = CFrame.lookAt(base, base + dir) * CF(0, 0, -0.9)
				newPart(model, origin, cf, V(0.35, 0.35, 1.9), s.spike)
				newPart(model, origin, cf * CF(0, 0, -1.0), V(0.2, 0.2, 0.5), s.tip, false, s.tip == rgb(232, 120, 50) and Enum.Material.Neon or SMOOTH)
				n += 1
			end
		end
	end
	newPart(model, origin, CF(0, -0.4, -2.0), V(2.4, 2.0, 1.6), s.face, true)
	newPart(model, origin, CF(0, -0.55, -2.85), V(0.6, 0.5, 0.5), rgb(30, 24, 24), true)
	eyes(model, origin, 0.15, -2.45, 0.6, 0.48, nil, true)
	model:SetAttribute("Kind", "thornhog")
	return model, {}
end

-- Puffshroom -------------------------------------------------------------------------------
function EnemyModels.puffshroom(skinName, origin)
	local s = skinFor("puffshroom", skinName)
	local model = Instance.new("Model")
	model.Name = "Puffshroom"
	rootPart(model, origin, V(3, 3, 3))
	local stem = newPart(model, origin, CF(0, -0.4, 0), V(2.6, 3.2, 2.6), s.stem, true, nil, "Stem")
	local cap = newPart(model, origin, CF(0, 1.6, 0), V(6.2, 3.0, 6.2), s.cap, true, nil, "Cap")
	local spots = {}
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		table.insert(spots, newPart(model, origin, CF(math.cos(a) * 2.1, 2.45, math.sin(a) * 2.1), V(1.0, 0.4, 1.0), s.spot, true))
	end
	newPart(model, origin, CF(0, 3.05, 0), V(1.2, 0.4, 1.2), s.spot, true)
	eyes(model, origin, 0.0, -1.1, 0.5, 0.55, nil, true)
	newPart(model, origin, CF(0, -0.75, -1.25), V(0.7, 0.18, 0.1), rgb(40, 30, 30))
	model:SetAttribute("Kind", "puffshroom")
	return model, { cap = cap, stem = stem, spots = spots }
end

-- Mossling ---------------------------------------------------------------------------------
function EnemyModels.mossling(skinName, origin)
	local s = skinFor("mossling", skinName)
	local model = Instance.new("Model")
	model.Name = "Mossling"
	rootPart(model, origin, V(3, 3, 3))
	newPart(model, origin, CF(0, 0, 0), V(4.2, 3.2, 4.0), s.moss, true, Enum.Material.Grass, "Body")
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		newPart(model, origin, CF(math.cos(a) * 1.5, 1.2 + (i % 2) * 0.3, math.sin(a) * 1.4 + 0.3), V(1.6, 1.1, 1.6), i % 2 == 0 and s.moss2 or s.moss, true, Enum.Material.Grass)
	end
	-- a sprout on top and a little bark face
	newPart(model, origin, CF(0, 2.0, 0.2), V(0.2, 1.2, 0.2), s.moss2)
	newPart(model, origin, CF(0.35, 2.55, 0.2) * R(0, 0, -0.6), V(0.8, 0.12, 0.45), s.moss, true)
	newPart(model, origin, CF(-0.35, 2.5, 0.2) * R(0, 0, 0.6), V(0.8, 0.12, 0.45), s.moss2, true)
	newPart(model, origin, CF(0, -0.2, -1.6), V(2.4, 1.6, 0.8), s.face, true)
	eyes(model, origin, 0.0, -1.95, 0.5, 0.5, s.eye, true)
	newPart(model, origin, CF(0, -0.6, -1.95), V(0.8, 0.14, 0.1), rgb(40, 30, 24))
	model:SetAttribute("Kind", "mossling")
	return model, {}
end

-- Snapper (pivot at the base of the stem; the head sits on top) ----------------------------
function EnemyModels.snapper(skinName, origin)
	local s = skinFor("snapper", skinName)
	local model = Instance.new("Model")
	model.Name = "Snapper"
	rootPart(model, origin, V(1, 1, 1))
	newPart(model, origin, CF(0, 1.4, 0), V(0.9, 3.2, 0.9), s.stem, false, nil, "Stem")
	for _, sx in ipairs({ -1, 1 }) do
		newPart(model, origin, CF(sx * 1.4, -1.1, 0) * R(0, 0, sx * -0.3), V(2.8, 0.25, 1.6), s.leaf, true)
		newPart(model, origin, CF(0, -1.1, sx * 1.4) * R(sx * 0.3, 0, 0), V(1.6, 0.25, 2.8), s.leaf, true)
	end
	-- head: upper jaw fixed, lower jaw hinged at the back
	newPart(model, origin, CF(0, 4.9, -0.3), V(3.4, 1.6, 3.6), s.head, true, nil, "Head")
	for i = 0, 4 do
		local a = i / 4 * math.pi - math.pi / 2
		newPart(model, origin, CF(math.sin(a) * 1.4, 4.2, -0.3 - math.cos(a) * 1.5), V(0.3, 0.5, 0.3), s.tooth)
	end
	for _, sp in ipairs({ { -0.8, 5.6, 0.2 }, { 0.9, 5.5, -0.6 }, { 0.1, 5.75, 0.9 } }) do
		newPart(model, origin, CF(sp[1], sp[2], sp[3]), V(0.7, 0.3, 0.7), s.tooth, true)
	end
	eyes(model, origin, 5.5, -1.6, 0.7, 0.55, nil, true)
	local jawRest = CF(0, 3.9, 1.2)
	local jaw = newPart(model, origin, jawRest * CF(0, 0, -1.5), V(3.0, 0.9, 3.2), s.inside, true, nil, "Jaw")
	local jawLocal = CF(0, 0, -1.5)
	model:SetAttribute("Kind", "snapper")
	return model, { jaw = jaw, jawRest = jawRest, jawLocal = jawLocal }
end

-- Puffer ---------------------------------------------------------------------------------
function EnemyModels.puffer(skinName, origin)
	local s = skinFor("puffer", skinName)
	local model = Instance.new("Model")
	model.Name = "Puffer"
	rootPart(model, origin, V(2, 2, 2))
	local parts = {}
	local function add(cf, size, color, ball, material)
		local p = newPart(model, origin, cf, size, color, ball, material)
		table.insert(parts, { part = p, cf = cf, size = size })
		return p
	end
	add(CF(0, 0, 0), V(5.2, 3.8, 4.6), s.cloud, true)
	for _, b in ipairs({ { -2.2, 0.6, 0.4, 2.8 }, { 2.2, 0.5, 0.3, 2.6 }, { 0, 1.7, 0.4, 3 }, { -1.1, -1.1, 0.8, 2.4 }, { 1.2, -1.2, 0.6, 2.2 } }) do
		add(CF(b[1], b[2], b[3]), V(b[4], b[4] * 0.85, b[4]), b[2] < 0 and s.shade or s.cloud, true)
	end
	for _, sx in ipairs({ -1, 1 }) do
		add(CF(sx * 1.5, -0.3, -2.0), V(0.9, 0.5, 0.3), s.cheek, true)
		add(CF(sx * 0.7, 0.5, -2.25), V(0.6, 0.75, 0.3), rgb(40, 36, 48), true)
		add(CF(sx * 0.75, 1.1, -2.2) * R(0, 0, sx * 0.4), V(0.8, 0.16, 0.2), rgb(70, 66, 84))
	end
	-- pursed "O" mouth, ready to blow
	add(CF(0, -0.5, -2.3), V(0.7, 0.7, 0.3), rgb(70, 60, 76), true)
	model:SetAttribute("Kind", "puffer")
	return model, { puffs = parts }
end

return EnemyModels
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">EnemyService</string><ProtectedString name="Source"><![CDATA[--[[
	EnemyService - all the baddies.

	  bug         Grumblebug      wanders, charges            stomp / pound / roll / slide
	  toad        Hopscotch Toad  hops toward you in arcs     stomp / pound / roll / slide
	  bat         Flitbat         circles, swoops at you      stomp / roll / long jump / pound wave
	  thornhog    Thornhog        rolls back and forth        ONLY a ground-pound shockwave (spikes!)
	  puffshroom  Puffshroom      puffs a ring of spores      stomp it between puffs

	Defeated baddies come back after Config.BugRespawnSeconds.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Bunny64")
local Config = require(Shared:WaitForChild("Config"))
local BugModel = require(script.Parent:WaitForChild("BugModel"))
local EnemyModels = require(script.Parent:WaitForChild("EnemyModels"))

local EnemyService = {}

local enemies = {}
local folder
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include
local callbacks
local poundingUntil = {} -- [Player] = os.clock()

local ATTACK_MOVES = { roll = true, slide = true, longjump = true }
local FEET = 2.6 -- HumanoidRootPart centre to feet

-- Per-kind shape: how tall the centre sits above the ground, contact radius, top height
local SHAPE = {
	bug = { lift = 1.8, radius = 4.4, top = 4.0 },
	toad = { lift = 1.6, radius = 3.6, top = 3.2 },
	bat = { lift = 0, below = 1.6, radius = 3.2, top = 1.6 },
	thornhog = { lift = 2.0, radius = 3.6, top = 4.2 },
	puffshroom = { lift = 1.9, radius = 3.4, top = 5.0 },
	mossling = { lift = 1.6, radius = 3.6, top = 3.4 },
	snapper = { lift = 1.5, radius = 3.4, top = 3.2 }, -- measured around its head
	puffer = { lift = 0, below = 1.8, radius = 3.8, top = 3.4 },
}

-- Kinds that hover at their home point instead of standing on the ground
local FLYING = { bat = true, puffer = true }

local function groundAt(pos)
	local hit = workspace:Raycast(pos + Vector3.new(0, 8, 0), Vector3.new(0, -30, 0), rayParams)
	if hit then
		return hit.Position.Y, hit.Instance
	end
	return nil
end

local function walkable(gy, hitPart, fromY, maxStep)
	if not gy or gy < Config.WaterLevel + 1 or math.abs(gy - fromY) > (maxStep or 3) then
		return false
	end
	if hitPart and (hitPart:GetAttribute("Moving") or hitPart:GetAttribute("Lava") or hitPart:GetAttribute("Water") or hitPart:GetAttribute("Slide")) then
		return false
	end
	return true
end

local function center(e)
	if FLYING[e.kind] then
		return e.pos
	end
	return e.pos + Vector3.new(0, SHAPE[e.kind].lift + (e.lift or 0), 0)
end

local function place(e, roll, pitch)
	e.model:PivotTo(CFrame.new(center(e)) * CFrame.Angles(0, e.yaw, 0) * CFrame.Angles(pitch or 0, 0, roll or 0))
end

local function lookYaw(from, to)
	local d = to - from
	return math.atan2(-d.X, -d.Z)
end

local function forward(yaw)
	return Vector3.new(-math.sin(yaw), 0, -math.cos(yaw))
end

local function defeat(e, player)
	e.alive = false
	e.respawnAt = os.clock() + Config.BugRespawnSeconds
	local c = center(e)
	callbacks.effect("poof", c)
	task.spawn(function()
		for i = 1, 8 do
			if not e.model.Parent then
				break
			end
			e.model:PivotTo(CFrame.new(c + Vector3.new(0, math.sin(i / 8 * math.pi) * 2, 0)) * CFrame.Angles(0, e.yaw, i / 8 * math.pi))
			task.wait(0.03)
		end
		e.model.Parent = nil
	end)
	if player then
		callbacks.bopped(player)
	end
end

local function build(e)
	if e.kind == "bug" then
		e.model = BugModel.Build(e.skin, 1, CFrame.new(e.pos))
	else
		e.model, e.extra = EnemyModels[e.kind](e.skin, CFrame.new(e.pos))
	end
	e.model.Parent = folder
end

function EnemyService.Start(info, cb)
	callbacks = cb
	folder = Instance.new("Folder")
	folder.Name = "Baddies"
	folder.Parent = workspace
	rayParams.FilterDescendantsInstances = { info.solidFolder, workspace.Terrain }

	for _, def in ipairs(info.enemies) do
		local home = def.pos
		local pos = home
		if not FLYING[def.kind] then
			local y = groundAt(home + Vector3.new(0, 10, 0)) or home.Y
			pos = Vector3.new(home.X, y, home.Z)
		end
		local e = {
			kind = def.kind,
			skin = def.skin,
			home = pos,
			pos = pos,
			yaw = math.random() * math.pi * 2,
			alive = true,
			respawnAt = 0,
			phase = math.random() * 6,
			state = "idle",
			t0 = os.clock() + math.random() * 2,
			fast = def.skin == "castle",
			range = def.range or 22,
			axis = def.axis,
		}
		build(e)
		table.insert(enemies, e)
	end

	RunService.Heartbeat:Connect(function(dt)
		EnemyService.Step(dt)
	end)
end

function EnemyService.MarkPounding(player, seconds)
	poundingUntil[player] = os.clock() + seconds
end

-- Ground pound shockwave: beats every kind, even the spiky one
function EnemyService.Shockwave(player, pos)
	for _, e in ipairs(enemies) do
		if e.alive then
			local c = center(e)
			local d = Vector3.new(c.X - pos.X, 0, c.Z - pos.Z).Magnitude
			if d < 14 and math.abs(c.Y - pos.Y) < 9 then
				defeat(e, player)
			end
		end
	end
end

local function nearestPlayer(pos, maxDist, maxDy)
	local best, bestDist, bestHrp = nil, maxDist, nil
	for _, player in ipairs(Players:GetPlayers()) do
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hrp and hum and hum.Health > 0 then
			local d = (hrp.Position - pos).Magnitude
			if d < bestDist and math.abs(hrp.Position.Y - FEET - pos.Y) < maxDy then
				best, bestDist, bestHrp = player, d, hrp
			end
		end
	end
	return best, bestHrp
end

--------------------------------------------------------------------------------
-- Behaviours
--------------------------------------------------------------------------------

local BEHAVIOUR = {}

function BEHAVIOUR.bug(e, dt, now)
	local target, hrp = nearestPlayer(e.pos, 45, 10)
	local fromHome = Vector3.new(e.pos.X - e.home.X, 0, e.pos.Z - e.home.Z).Magnitude
	local speed = e.fast and 9 or 7
	if target and fromHome < 60 then
		e.yaw = lookYaw(e.pos, hrp.Position)
		speed = e.fast and 19 or 15
	elseif fromHome > e.range then
		e.yaw = lookYaw(e.pos, e.home)
	elseif now > e.t0 then
		e.yaw += (math.random() - 0.5) * 2.5
		e.t0 = now + 1 + math.random() * 2
	end
	local nextPos = e.pos + forward(e.yaw) * speed * dt
	local gy, hit = groundAt(nextPos)
	if walkable(gy, hit, e.pos.Y) then
		e.pos = Vector3.new(nextPos.X, gy, nextPos.Z)
	else
		e.yaw += math.pi * (0.5 + math.random() * 0.5)
	end
	local step = now * (speed > 10 and 18 or 10) + e.phase
	e.lift = math.abs(math.sin(step)) * 0.25
	place(e, math.sin(step) * 0.06)
end

function BEHAVIOUR.toad(e, dt, now)
	if e.state == "idle" then
		e.lift = math.abs(math.sin(now * 3 + e.phase)) * 0.12
		place(e, 0, -0.05)
		if now > e.t0 then
			local _, hrp = nearestPlayer(e.pos, 40, 12)
			local fromHome = (e.pos - e.home) * Vector3.new(1, 0, 1)
			if hrp then
				e.yaw = lookYaw(e.pos, hrp.Position)
			elseif fromHome.Magnitude > e.range then
				e.yaw = lookYaw(e.pos, e.home)
			else
				e.yaw += (math.random() - 0.5) * 2.4
			end
			local dist = hrp and 14 or 10
			local dest = e.pos + forward(e.yaw) * dist
			local gy, hit = groundAt(dest)
			if walkable(gy, hit, e.pos.Y, 8) then
				e.state = "hop"
				e.hopFrom = e.pos
				e.hopTo = Vector3.new(dest.X, gy, dest.Z)
				e.t0 = now
			else
				e.yaw += math.pi
				e.t0 = now + 0.6
			end
		end
	else
		local u = math.clamp((now - e.t0) / 0.7, 0, 1)
		local flat = e.hopFrom:Lerp(e.hopTo, u)
		e.pos = flat
		e.lift = math.sin(u * math.pi) * 7
		place(e, 0, -0.35 * math.sin(u * math.pi))
		if e.extra and e.extra.legs then
			-- legs kick out behind while airborne
			for _, leg in ipairs(e.extra.legs) do
				leg.CFrame = leg.CFrame * CFrame.new(0, -math.sin(u * math.pi) * 0.6, math.sin(u * math.pi) * 0.9)
			end
		end
		if u >= 1 then
			e.state = "idle"
			e.lift = 0
			e.t0 = now + 0.9 + math.random() * 1.2
		end
	end
end

function BEHAVIOUR.bat(e, dt, now)
	local hover = e.home + Vector3.new(0, 0, 0)
	if e.state == "idle" then
		e.orbit = (e.orbit or e.phase) + dt * 1.1
		local want = hover + Vector3.new(math.cos(e.orbit) * 10, math.sin(now * 2 + e.phase) * 1.2, math.sin(e.orbit) * 10)
		e.pos = e.pos:Lerp(want, math.clamp(dt * 3, 0, 1))
		e.yaw = e.orbit + math.pi
		if now > e.t0 then
			local _, hrp = nearestPlayer(e.pos, 42, 30)
			if hrp then
				e.state = "swoop"
				e.target = hrp.Position
				e.t0 = now
				e.yaw = lookYaw(e.pos, e.target)
				callbacks.effect("screech", e.pos)
			else
				e.t0 = now + 0.5
			end
		end
	elseif e.state == "swoop" then
		local d = e.target - e.pos
		if d.Magnitude < 2 or now - e.t0 > 1.6 then
			e.state = "rise"
			e.t0 = now
		else
			e.pos += d.Unit * math.min(d.Magnitude, (e.fast and 38 or 32) * dt)
		end
	else -- rise back home
		e.pos = e.pos:Lerp(hover, math.clamp(dt * 1.8, 0, 1))
		if now - e.t0 > 1.4 then
			e.state = "idle"
			e.t0 = now + 1.8 + math.random()
		end
	end
	place(e, 0, e.state == "swoop" and -0.5 or 0)
	-- flap
	local root = e.model.PrimaryPart.CFrame
	local flap = math.sin(now * (e.state == "swoop" and 10 or 18) + e.phase) * 0.7
	for _, w in ipairs(e.extra.wings) do
		local hinge = root * w.offset * CFrame.Angles(0, 0, w.side * flap)
		w.part.CFrame = hinge * w.local1
		w.tip.CFrame = hinge * w.local2
	end
end

function BEHAVIOUR.thornhog(e, dt, now)
	-- patrols along its axis; charges if a bunny is in front of it on the ground
	e.dir = e.dir or 1
	local axis = e.axis or Vector3.new(1, 0, 0)
	local _, hrp = nearestPlayer(e.pos, 26, 5)
	local speed = e.fast and 18 or 15
	local moveDir = axis * e.dir
	if hrp then
		local to = (hrp.Position - e.pos) * Vector3.new(1, 0, 1)
		if to.Magnitude > 0.1 then
			moveDir = to.Unit
			speed = e.fast and 26 or 22
		end
	end
	local nextPos = e.pos + moveDir * speed * dt
	local along = (nextPos - e.home):Dot(axis)
	local gy, hit = groundAt(nextPos)
	if not hrp and math.abs(along) > e.range then
		e.dir = -e.dir
	elseif walkable(gy, hit, e.pos.Y) and (nextPos - e.home).Magnitude < e.range + 25 then
		e.pos = Vector3.new(nextPos.X, gy, nextPos.Z)
	else
		e.dir = -e.dir
	end
	e.yaw = lookYaw(Vector3.zero, moveDir)
	e.spin = (e.spin or 0) + dt * speed / 2.2
	place(e, 0, -e.spin)
end

function BEHAVIOUR.puffshroom(e, dt, now)
	-- idle 2.4s, swell 0.6s, puff 0.9s
	local cycle = (now + e.phase) % 3.9
	local was = e.state
	if cycle < 2.4 then
		e.state = "idle"
		e.lift = math.sin(now * 2 + e.phase) * 0.1
	elseif cycle < 3.0 then
		e.state = "swell"
		e.lift = (cycle - 2.4) * 0.8
	else
		e.state = "puff"
		e.lift = 0
	end
	if e.state == "puff" and was ~= "puff" then
		callbacks.effect("spores", center(e))
	end
	place(e, math.sin(now * 20) * (e.state == "swell" and 0.06 or 0))
end

-- Mossling: a hump of moss until you get close, then it pops up and gives chase
local function stepToward(e, dir, speed, dt)
	local nextPos = e.pos + dir * speed * dt
	local gy, hit = groundAt(nextPos)
	if walkable(gy, hit, e.pos.Y) then
		e.pos = Vector3.new(nextPos.X, gy, nextPos.Z)
		return true
	end
	return false
end

function BEHAVIOUR.mossling(e, dt, now)
	local HIDDEN = -2.5
	if e.state == "idle" then
		e.lift = HIDDEN + math.sin(now * 1.5 + e.phase) * 0.08
		place(e)
		if now > e.t0 then
			local _, hrp = nearestPlayer(e.pos, 17, 8)
			if hrp then
				e.state = "pop"
				e.t0 = now
				e.yaw = lookYaw(e.pos, hrp.Position)
				callbacks.effect("poof", e.pos + Vector3.new(0, 1, 0))
			else
				e.t0 = now + 0.25
			end
		end
	elseif e.state == "pop" then
		local u = math.clamp((now - e.t0) / 0.35, 0, 1)
		e.lift = HIDDEN * (1 - u) + math.sin(u * math.pi) * 2
		place(e)
		if u >= 1 then
			e.state = "chase"
			e.t0 = now
		end
	elseif e.state == "chase" then
		local _, hrp = nearestPlayer(e.pos, 40, 10)
		local toHome = (e.home - e.pos) * Vector3.new(1, 0, 1)
		local speed = 0
		if hrp and now - e.t0 < 7 and toHome.Magnitude < 45 then
			e.yaw = lookYaw(e.pos, hrp.Position)
			speed = 13
		elseif toHome.Magnitude > 1.5 then
			e.yaw = lookYaw(Vector3.zero, toHome)
			speed = 9
		else
			e.state = "sink"
			e.t0 = now
		end
		if speed > 0 and not stepToward(e, forward(e.yaw), speed, dt) and not hrp then
			e.pos = e.home -- stuck on the way home: just burrow back
		end
		local step = now * 14 + e.phase
		e.lift = math.abs(math.sin(step)) * 0.5
		place(e, math.sin(step) * 0.12)
	else -- sink back into the moss
		local u = math.clamp((now - e.t0) / 0.5, 0, 1)
		e.lift = HIDDEN * u
		place(e)
		if u >= 1 then
			e.state = "idle"
			e.t0 = now + 2
		end
	end
end

-- Snapper: a rooted biting plant. Rears back (the tell), lunges, then droops
-- for a moment - the best time to stomp its head.
function BEHAVIOUR.snapper(e, dt, now)
	local pitch = 0
	if e.state == "idle" then
		pitch = math.sin(now * 1.6 + e.phase) * 0.08
		if now > e.t0 then
			local _, hrp = nearestPlayer(e.pos, 13, 7)
			if hrp then
				e.yaw = lookYaw(e.pos, hrp.Position)
				e.state = "wind"
				e.t0 = now
			else
				e.yaw += math.sin(now + e.phase) * 0.05
				e.t0 = now + 0.2
			end
		end
	elseif e.state == "wind" then
		local u = math.clamp((now - e.t0) / 0.5, 0, 1)
		pitch = 0.4 * u + math.sin(now * 40) * 0.03
		if u >= 1 then
			e.state = "lunge"
			e.t0 = now
		end
	elseif e.state == "lunge" then
		local u = math.clamp((now - e.t0) / 0.15, 0, 1)
		pitch = 0.4 - 1.45 * u
		if now - e.t0 > 0.45 then
			e.state = "tired"
			e.t0 = now
		end
	else -- tired
		local u = math.clamp((now - e.t0) / 1.1, 0, 1)
		pitch = -1.05 * (1 - u)
		if u >= 1 then
			e.state = "idle"
			e.t0 = now + 0.8
		end
	end
	place(e, 0, pitch)
	local cf = CFrame.new(center(e)) * CFrame.Angles(0, e.yaw, 0) * CFrame.Angles(pitch, 0, 0)
	e.head = (cf * CFrame.new(0, 4.6, 0)).Position
	if e.extra and e.extra.jaw then
		local open = (e.state == "wind" and 0.6) or (e.state == "lunge" and (now - e.t0 < 0.12 and 0.6 or 0)) or 0.15
		e.extra.jaw.CFrame = cf * e.extra.jawRest * CFrame.Angles(-open, 0, 0) * e.extra.jawLocal
	end
end

-- Puffer: a grumpy little cloud. Drifts, turns to face you, puffs up, then
-- blows a gust that shoves you back (straight off a cloud, if you're careless)
function BEHAVIOUR.puffer(e, dt, now)
	local drift = Vector3.new(math.cos(now * 0.5 + e.phase) * 3, math.sin(now * 1.3 + e.phase) * 0.8, math.sin(now * 0.5 + e.phase) * 3)
	e.pos = e.pos:Lerp(e.home + drift, math.clamp(dt * 2, 0, 1))
	local scale = 1
	if e.state == "idle" then
		if now > e.t0 then
			local _, hrp = nearestPlayer(e.pos, 36, 14)
			if hrp then
				e.yaw = lookYaw(e.pos, hrp.Position)
				e.state = "swell"
				e.t0 = now
			else
				e.t0 = now + 0.4
			end
		end
	elseif e.state == "swell" then
		local _, hrp = nearestPlayer(e.pos, 40, 14)
		if hrp then
			e.yaw = lookYaw(e.pos, hrp.Position)
		end
		local u = math.clamp((now - e.t0) / 0.9, 0, 1)
		scale = 1 + u * 0.35
		if u >= 1 then
			e.state = "blow"
			e.t0 = now
			e.blown = {}
			callbacks.effect("gust", e.pos, forward(e.yaw))
		end
	elseif e.state == "blow" then
		scale = 1.35 - math.clamp((now - e.t0) / 0.3, 0, 1) * 0.45
		local dir = forward(e.yaw)
		for _, player in ipairs(Players:GetPlayers()) do
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if hrp and not e.blown[player] then
				local to = hrp.Position - e.pos
				local flat = Vector3.new(to.X, 0, to.Z)
				if flat.Magnitude < 32 and math.abs(to.Y) < 12 and flat.Magnitude > 0.1 and flat.Unit:Dot(dir) > 0.8 then
					e.blown[player] = true
					callbacks.gust(player, dir * 58 + Vector3.new(0, 24, 0))
				end
			end
		end
		if now - e.t0 > 1.0 then
			e.state = "idle"
			e.t0 = now + 2.4 + math.random()
		end
	end
	place(e)
	if e.extra and e.extra.puffs then
		local root = e.model.PrimaryPart.CFrame
		for _, pf in ipairs(e.extra.puffs) do
			pf.part.Size = pf.size * scale
			pf.part.CFrame = root * CFrame.new(pf.cf.Position * scale) * pf.cf.Rotation
		end
	end
end

--------------------------------------------------------------------------------
-- Contact with bunnies
--------------------------------------------------------------------------------

local function contact(e, now)
	local shape = SHAPE[e.kind]
	if e.kind == "mossling" and (e.state == "idle" or e.state == "sink") then
		return -- tucked away under the moss
	end
	local c = e.head or center(e)
	for _, player in ipairs(Players:GetPlayers()) do
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if root and hum and hum.Health > 0 then
			local p = root.Position
			local feet = p.Y - FEET
			local flat = Vector3.new(p.X - c.X, 0, p.Z - c.Z).Magnitude
			local bottom = c.Y - (shape.below or shape.lift)
			local top = bottom + shape.top
			-- spore puffs reach further than the body
			if e.kind == "puffshroom" and e.state == "puff" and flat < 8.5 and feet < top + 2 and feet > bottom - 3 then
				callbacks.hurt(player, c)
			elseif flat < shape.radius and feet < top + 0.8 and p.Y + 2 > bottom then
				local vy = root.AssemblyLinearVelocity.Y
				local pounding = (poundingUntil[player] or 0) > now
				local move = char:GetAttribute("Move")
				local stomping = (vy < -1 and feet > top - 1.4) or pounding
				if e.kind == "thornhog" then
					-- spikes: only a shockwave works, everything else hurts
					callbacks.hurt(player, c)
					if stomping then
						callbacks.bounce(player, Vector3.new(0, 55, 0), true)
					end
				elseif stomping then
					defeat(e, player)
					callbacks.bounce(player, Vector3.new(0, Config.StompBounce, 0), true)
					return
				elseif move and ATTACK_MOVES[move] and e.kind ~= "puffshroom" and e.kind ~= "puffer" then
					defeat(e, player)
					return
				else
					callbacks.hurt(player, c)
				end
			end
		end
	end
end

function EnemyService.Step(dt)
	local now = os.clock()
	for _, e in ipairs(enemies) do
		if not e.alive then
			if now >= e.respawnAt then
				e.alive = true
				e.pos = e.home
				e.state = "idle"
				e.t0 = now + 1
				e.model.Parent = folder
				callbacks.effect("poof", center(e))
			end
			continue
		end
		BEHAVIOUR[e.kind](e, dt, now)
		contact(e, now)
	end
end

Players.PlayerRemoving:Connect(function(player)
	poundingUntil[player] = nil
end)

return EnemyService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">HazardService</string><ProtectedString name="Source"><![CDATA[--[[
	HazardService - decides who gets hurt by firebars, crushers, lava and
	boulders. Firebars and crushers move on the shared server clock (see
	shared/HazardMath); clients animate them, the server checks collisions.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Bunny64")
local Config = require(Shared:WaitForChild("Config"))
local HazardMath = require(Shared:WaitForChild("HazardMath"))

local HazardService = {}

local info, cb
local lastBurn = {}

local function characterOf(hit)
	local model = hit and hit:FindFirstAncestorOfClass("Model")
	if not model then
		return nil
	end
	local player = Players:GetPlayerFromCharacter(model)
	return player, model
end

function HazardService.Burn(player)
	local now = os.clock()
	if (lastBurn[player] or 0) > now - 0.35 then
		return
	end
	lastBurn[player] = now
	cb.burn(player)
end

local function hookLava(part)
	part.Touched:Connect(function(hit)
		local player = characterOf(hit)
		if player then
			HazardService.Burn(player)
		end
	end)
end

local function spawnBoulder(spawn)
	local b = Instance.new("Part")
	b.Name = "Boulder"
	b.Shape = Enum.PartType.Ball
	b.Size = Vector3.one * 8
	b.Material = Enum.Material.Sandstone
	b.Color = Config.Palette.SandstoneDark
	b.CFrame = CFrame.new(spawn.from + Vector3.new(0, 0, math.random(-6, 6)))
	b.CustomPhysicalProperties = PhysicalProperties.new(3, 0.5, 0.1, 1, 1)
	b.Parent = info.hazardFolder
	b:SetNetworkOwner(nil)
	b.AssemblyLinearVelocity = spawn.dir * 24
	local hitAt = {}
	b.Touched:Connect(function(hit)
		local player = characterOf(hit)
		if player and (hitAt[player] or 0) < os.clock() - 1 then
			hitAt[player] = os.clock()
			cb.hurt(player, b.Position, b.AssemblyLinearVelocity.Unit * 50 + Vector3.new(0, 40, 0))
		end
	end)
	Debris:AddItem(b, 14)
end

function HazardService.Start(worldInfo, callbacks)
	info, cb = worldInfo, callbacks

	for _, d in ipairs(info.solidFolder:GetDescendants()) do
		if d:IsA("BasePart") and d:GetAttribute("Lava") then
			hookLava(d)
		end
	end

	-- Boulders
	task.spawn(function()
		while true do
			for _, s in ipairs(info.boulderSpawns) do
				spawnBoulder(s)
			end
			task.wait(2.4)
		end
	end)
	-- clear boulders that fell off the world
	RunService.Heartbeat:Connect(function()
		for _, b in ipairs(info.hazardFolder:GetChildren()) do
			if b.Name == "Boulder" and b.Position.Y < Config.WaterLevel - 10 then
				b:Destroy()
			end
		end
	end)

	-- Firebars & crushers
	RunService.Heartbeat:Connect(function()
		local t = HazardMath.Now()
		for _, player in ipairs(Players:GetPlayers()) do
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if root and hum and hum.Health > 0 then
				local p = root.Position
				for _, fb in ipairs(info.firebars) do
					if math.abs(p.Y - fb.pivot.Y) < 4 and (Vector3.new(p.X, 0, p.Z) - Vector3.new(fb.pivot.X, 0, fb.pivot.Z)).Magnitude < fb.length + 3 then
						local a = HazardMath.FirebarAngle(fb.speed, fb.phase, t)
						local tip = fb.pivot + HazardMath.FirebarDir(a) * fb.length
						-- check the torso and the head
						local d = math.min(
							HazardMath.SegmentDistance(p, fb.pivot, tip),
							HazardMath.SegmentDistance(p + Vector3.new(0, 1.8, 0), fb.pivot, tip)
						)
						if d < 2.1 then
							cb.hurt(player, fb.pivot)
						end
					end
				end
				for _, c in ipairs(info.crushers) do
					local base = c.base.Position
					local half = c.size / 2
					if math.abs(p.X - base.X) < half.X + 0.9 and math.abs(p.Z - base.Z) < half.Z then
						local drop = HazardMath.CrusherDrop(c.period, c.offset, t)
						local bottom = base.Y - half.Y - drop * c.drop
						if bottom < p.Y + 3 and bottom > p.Y - 4 then
							cb.hurt(player, Vector3.new(base.X + 20, p.Y, p.Z)) -- knocked back toward the entrance
						end
					end
				end
			end
		end
	end)
end

Players.PlayerRemoving:Connect(function(player)
	lastBurn[player] = nil
end)

return HazardService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">Leaderboard</string><ProtectedString name="Source"><![CDATA[--[[
	Leaderboard - the "FASTEST BUNNIES" board by the meadow spawn.

	When a file finds every golden carrot, its clear time is stored in an
	OrderedDataStore (keeping each player's best). The board shows the top 10
	across every server and refreshes every couple of minutes.
	Without DataStore access (e.g. Studio with API access off) the board just
	says so.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Bunny64")
local Config = require(Shared:WaitForChild("Config"))
local P = Config.Palette

local Leaderboard = {}

local store
local rows = {}
local status

local function fmt(seconds)
	seconds = math.floor(seconds)
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%d:%02d", m, s)
end

local function build()
	local pos = Vector3.new(-34, 0, 60)
	local model = Instance.new("Model")
	model.Name = "FastestBunnies"
	local function block(cf, size, color, material)
		local p = Instance.new("Part")
		p.Anchored = true
		p.CFrame = cf
		p.Size = size
		p.Color = color
		p.Material = material or Enum.Material.Wood
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = model
		return p
	end
	-- the board faces the spawn (+X)
	local face = CFrame.lookAt(pos + Vector3.new(0, 7, 0), pos + Vector3.new(10, 7, 0))
	for _, dz in ipairs({ -5.5, 5.5 }) do
		block(CFrame.new(pos + Vector3.new(0, 5, dz)), Vector3.new(0.9, 10, 0.9), P.Wood)
	end
	local board = block(face * CFrame.new(0, 0.5, 0), Vector3.new(11, 9, 0.6), P.WoodLight)
	block(face * CFrame.new(0, 5.3, 0.1), Vector3.new(12, 1, 1.2), P.Roof, Enum.Material.Slate)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 1
	gui.Parent = board
	local function label(text, y, h, size, color, align)
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.new(1, -40, 0, h)
		t.Position = UDim2.fromOffset(20, y)
		t.Font = Enum.Font.Antique
		t.Text = text
		t.TextSize = size
		t.TextColor3 = color or Color3.fromRGB(50, 34, 24)
		t.TextXAlignment = align or Enum.TextXAlignment.Center
		t.Parent = gui
		return t
	end
	label("FASTEST BUNNIES", 10, 50, 44)
	label("every golden carrot", 56, 26, 22, Color3.fromRGB(110, 76, 50))
	for i = 1, 10 do
		rows[i] = label("", 84 + (i - 1) * 25, 24, 21, nil, Enum.TextXAlignment.Left)
	end
	status = label("", 334, 22, 16, Color3.fromRGB(110, 76, 50))
	model.Parent = workspace
end

local function refresh()
	if not store then
		status.Text = "(times appear once the game is published)"
		return
	end
	local ok, pages = pcall(function()
		return store:GetSortedAsync(true, 10)
	end)
	if not ok then
		status.Text = "(couldn't reach the leaderboard)"
		return
	end
	local entries = pages:GetCurrentPage()
	for i = 1, 10 do
		local e = entries[i]
		if e then
			local name = "a bunny"
			local okName, result = pcall(function()
				return Players:GetNameFromUserIdAsync(tonumber(e.key))
			end)
			if okName and result then
				name = result
			end
			rows[i].Text = string.format("%2d.  %-18s %s", i, name, fmt(e.value))
		else
			rows[i].Text = i == 1 and "    nobody yet - will it be you?" or ""
		end
	end
	status.Text = "updated " .. os.date("!%H:%M") .. " UTC"
end

function Leaderboard.Start()
	local ok, result = pcall(function()
		return DataStoreService:GetOrderedDataStore("Bunny64_ClearTimes_v1")
	end)
	if ok then
		store = result
	end
	build()
	task.spawn(function()
		while true do
			pcall(refresh)
			task.wait(120)
		end
	end)
end

-- Keep each player's best (lowest) clear time
function Leaderboard.RecordClear(player, seconds)
	if not store or type(seconds) ~= "number" then
		return
	end
	task.spawn(function()
		pcall(function()
			store:UpdateAsync(tostring(player.UserId), function(old)
				local t = math.max(1, math.floor(seconds))
				if old and old <= t then
					return nil
				end
				return t
			end)
		end)
		task.wait(2)
		pcall(refresh)
	end)
end

return Leaderboard
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">NPCService</string><ProtectedString name="Source"><![CDATA[--[[
	NPCService - builds the friendly characters and their "Talk" prompts.
	What they say lives in Config.NPCs and is shown by client/Dialogue.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Bunny64")
local Config = require(Shared:WaitForChild("Config"))
local BunnyModel = require(Shared:WaitForChild("BunnyModel"))
local P = Config.Palette

local NPCService = {}

local rgb = Color3.fromRGB

local function part(model, cf, size, color, ball, material)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if ball then
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Parent = p
	end
	p.Parent = model
	return p
end

local function eyes(model, base, y, z, spread, size)
	for _, sx in ipairs({ -1, 1 }) do
		local e = part(model, base * CFrame.new(sx * spread, y, z), Vector3.new(size, size * 1.2, size * 0.5), P.Button, true)
		e.Reflectance = 0.2
		part(model, base * CFrame.new(sx * spread * 0.9, y + size * 0.2, z - size * 0.25), Vector3.one * size * 0.3, rgb(240, 236, 228), true)
	end
end

-- Each builder makes a figure facing -Z with its feet at `base`
local BUILD = {}

function BUILD.tortoise(model, base)
	part(model, base * CFrame.new(0, 2.2, 0.4), Vector3.new(5.5, 3.6, 6), rgb(96, 110, 70), true) -- shell
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		part(model, base * CFrame.new(math.cos(a) * 1.6, 3.6, 0.4 + math.sin(a) * 1.8), Vector3.new(1.4, 0.4, 1.4), rgb(124, 138, 86), true)
	end
	part(model, base * CFrame.new(0, 1.1, 0.4), Vector3.new(5.2, 1.2, 5.8), rgb(196, 176, 120), true) -- belly rim
	part(model, base * CFrame.new(0, 2.6, -3.4), Vector3.new(2.2, 2, 2.4), rgb(150, 160, 104), true) -- head
	eyes(model, base, 2.9, -4.4, 0.5, 0.45)
	-- spectacles
	for _, sx in ipairs({ -1, 1 }) do
		part(model, base * CFrame.new(sx * 0.5, 2.95, -4.55), Vector3.new(0.7, 0.7, 0.08), rgb(170, 140, 70), false, Enum.Material.Metal).Transparency = 0.5
	end
	for _, l in ipairs({ { -1.8, -1.6 }, { 1.8, -1.6 }, { -1.8, 2.2 }, { 1.8, 2.2 } }) do
		part(model, base * CFrame.new(l[1], 0.5, l[2]), Vector3.new(1.2, 1.2, 1.2), rgb(150, 160, 104), true)
	end
	-- walking stick
	part(model, base * CFrame.new(2.6, 2.2, -2.2) * CFrame.Angles(0, 0, 0.15), Vector3.new(0.3, 4.4, 0.3), P.Wood, false, Enum.Material.Wood)
end

