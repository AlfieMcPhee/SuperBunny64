return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">HazardMath</string><ProtectedString name="Source"><![CDATA[--[[
	HazardMath - deterministic motion for firebars and crushers.
	Server and clients evaluate the same functions with the shared server
	clock, so clients can animate hazards smoothly while the server decides
	who gets hurt.
]]

local HazardMath = {}

function HazardMath.Now()
	return workspace:GetServerTimeNow()
end

-- Firebar: rotates about a vertical axis through `pivot`
function HazardMath.FirebarAngle(speed, phase, t)
	return phase + speed * t
end

-- Direction of the bar's arm for a given angle (matches CFrame.Angles(0, a, 0) * +X)
function HazardMath.FirebarDir(angle)
	return Vector3.new(math.cos(angle), 0, -math.sin(angle))
end

-- Crusher: returns how far (0 = resting high, 1 = slammed down) it is
--   [0, hold)               waiting high
--   [hold, hold+0.18)       slamming down
--   [hold+0.18, hold+1.0)   resting low
--   [hold+1.0, period)      rising back up
function HazardMath.CrusherDrop(period, offset, t)
	local hold = period - 1.8
	local u = (t + offset) % period
	if u < hold then
		return 0
	elseif u < hold + 0.18 then
		return (u - hold) / 0.18
	elseif u < hold + 1.0 then
		return 1
	else
		return 1 - (u - hold - 1.0) / 0.8
	end
end

-- Distance from point p to segment a-b
function HazardMath.SegmentDistance(p, a, b)
	local ab = b - a
	local len2 = ab:Dot(ab)
	if len2 < 1e-6 then
		return (p - a).Magnitude
	end
	local t = math.clamp((p - a):Dot(ab) / len2, 0, 1)
	return (p - (a + ab * t)).Magnitude
end

return HazardMath
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX00000015"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX00000014"><Properties><string name="Name">Bunny64Server</string><ProtectedString name="Source"><![CDATA[--[[
	Bunny 64 - server entry point.
	Builds the world, runs save files, pickups, hearts, hazards, checkpoints,
	warps, enemies, the boss and customisation.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterPlayer = game:GetService("StarterPlayer")

local Shared = ReplicatedStorage:WaitForChild("Bunny64")
local Config = require(Shared:WaitForChild("Config"))
local BunnyModel = require(Shared:WaitForChild("BunnyModel"))

local DataService = require(script:WaitForChild("DataService"))
local WorldBuilder = require(script:WaitForChild("WorldBuilder"))
local EnemyService = require(script:WaitForChild("EnemyService"))
local HazardService = require(script:WaitForChild("HazardService"))
local BossService = require(script:WaitForChild("BossService"))

Players.CharacterAutoLoads = false

-- The plush bunny is everyone's character
do
	local old = StarterPlayer:FindFirstChild("StarterCharacter")
	if old then
		old:Destroy()
	end
	BunnyModel.BuildCharacter().Parent = StarterPlayer
end

-- Remotes -------------------------------------------------------------------------
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local function remote(className, name)
	local r = Instance.new(className)
	r.Name = name
	r.Parent = remotes
	return r
end
local GetProfile = remote("RemoteFunction", "GetProfile")
local SelectSlot = remote("RemoteFunction", "SelectSlot")
local EraseSlot = remote("RemoteFunction", "EraseSlot")
local Customise = remote("RemoteFunction", "Customise")
local QuitToTitle = remote("RemoteEvent", "QuitToTitle")
local SetOptions = remote("RemoteEvent", "SetOptions")
local Collect = remote("RemoteEvent", "Collect")
local Update = remote("RemoteEvent", "Update")
local Pound = remote("RemoteEvent", "Pound")
local Bounce = remote("RemoteEvent", "Bounce")
local Effect = remote("RemoteEvent", "Effect")
local SetMove = remote("RemoteEvent", "SetMove")
local WarpMenu = remote("RemoteEvent", "WarpMenu")
local Warp = remote("RemoteEvent", "Warp")
remotes.Parent = Shared

-- World -------------------------------------------------------------------------------
local info = WorldBuilder.Build()

local goldenDefs = {}
for _, g in ipairs(Config.Goldens) do
	goldenDefs[g.id] = g
end
local TOTAL_CARROTS = 0
for _ in pairs(info.carrots) do
	TOTAL_CARROTS += 1
end
Shared:SetAttribute("TotalCarrots", TOTAL_CARROTS)

local count = DataService.Count
local state = {} -- [Player] = { safe = CFrame, invulnUntil = number }

local function getRoot(player)
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart"), char and char:FindFirstChildOfClass("Humanoid")
end

-- Snapshots -------------------------------------------------------------------------------
local function snapshot(player, event)
	local profile = DataService.Get(player)
	if not profile then
		return nil
	end
	local snap = {
		menu = {
			slots = DataService.Summaries(player),
			custom = profile.data.custom,
			options = profile.data.options,
			progress = DataService.Progress(player),
		},
		active = profile.active and tonumber(profile.active) or nil,
		canSave = profile.canSave,
		totalCarrots = TOTAL_CARROTS,
		event = event,
	}
	local slot = DataService.ActiveSlot(player)
	if slot then
		snap.slot = {
			carrots = slot.carrots,
			goldens = slot.goldens,
			carrotCount = slot.carrotCount,
			goldenCount = count(slot.goldens),
			bugs = slot.bugs,
			playTime = DataService.GetPlayTime(player),
			completedTime = slot.completedTime,
			checkpoint = slot.checkpoint,
			warps = slot.warps,
			bossDefeated = slot.bossDefeated,
		}
	end
	return snap
end

local function push(player, event)
	local snap = snapshot(player, event)
	if snap then
		Update:FireClient(player, snap)
	end
	local slot = DataService.ActiveSlot(player)
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		stats.Carrots.Value = slot and slot.carrotCount or 0
		stats.Golden.Value = slot and count(slot.goldens) or 0
	end
end

-- Hearts --------------------------------------------------------------------------------------
local function heal(player, amount)
	local _, hum = getRoot(player)
	if hum and hum.Health > 0 then
		hum.Health = math.min(hum.MaxHealth, hum.Health + amount)
	end
end

local function hurt(player, fromPos, velocity, ignoreInvuln)
	local root, hum = getRoot(player)
	local st = state[player]
	if not (root and hum and st) or hum.Health <= 0 then
		return false
	end
	if not ignoreInvuln and os.clock() < st.invulnUntil then
		return false
	end
	st.invulnUntil = os.clock() + 1.5
	hum:TakeDamage(1)
	if not velocity then
		local away = Vector3.new(root.Position.X - fromPos.X, 0, root.Position.Z - fromPos.Z)
		if away.Magnitude < 0.1 then
			away = Vector3.new(0, 0, 1)
		end
		velocity = away.Unit * 45 + Vector3.new(0, 40, 0)
	end
	Bounce:FireClient(player, velocity, false, "hurt")
	return true
end

local function burn(player)
	local root, hum = getRoot(player)
	local st = state[player]
	if not (root and hum and st) or hum.Health <= 0 then
		return
	end
	if os.clock() >= st.invulnUntil then
		st.invulnUntil = os.clock() + 1.5
		hum:TakeDamage(1)
	end
	Bounce:FireClient(player, Vector3.new(0, 88, 0), true, "burn")
	Effect:FireAllClients("burn", root.Position - Vector3.new(0, 2.5, 0))
end

-- Characters --------------------------------------------------------------------------------
local function checkpointCF(id)
	local cp = Config.Checkpoints[id] or Config.Checkpoints.meadow
	return CFrame.new(cp.pos)
end

local function spawnCharacter(player)
	if player.Parent and DataService.ActiveSlot(player) then
		player:LoadCharacter()
	end
end

local function onCharacter(player, character)
	local st = state[player]
	local slot, profile = DataService.ActiveSlot(player)
	local humanoid = character:WaitForChild("Humanoid")
	local root = character:WaitForChild("HumanoidRootPart")
	if slot then
		local cf = checkpointCF(slot.checkpoint)
		character:PivotTo(cf)
		root.AssemblyLinearVelocity = Vector3.zero
		if st then
			st.safe = cf
			st.invulnUntil = os.clock() + 2
		end
	end
	if profile then
		BunnyModel.Apply(character, profile.data.custom)
	end
	local regen = character:FindFirstChild("Health")
	if regen and regen:IsA("Script") then
		regen:Destroy()
	end
	humanoid.MaxHealth = Config.MaxHearts
	humanoid.Health = Config.MaxHearts
	humanoid.WalkSpeed = Config.WalkSpeed
	humanoid.UseJumpPower = true
	humanoid.JumpPower = Config.JumpPower
	character:SetAttribute("Move", "")
	humanoid.Died:Connect(function()
		task.wait(3)
		if player.Character == character then
			spawnCharacter(player)
		end
	end)
end

-- Progress ------------------------------------------------------------------------------------
local function checkCompletion(player, slot)
	if not slot.completedTime and count(slot.goldens) >= #Config.Goldens then
		slot.completedTime = DataService.GetPlayTime(player)
		return true
	end
	return false
end

local function onBopped(player)
	local slot = DataService.ActiveSlot(player)
	if not slot then
		return
	end
	slot.bugs += 1
	local event = { kind = "bop" }
	if slot.bugs == Config.BugBusterGoal then
		event = { kind = "unlock", id = "buster" }
	end
	push(player, event)
end

Collect.OnServerEvent:Connect(function(player, id)
	if type(id) ~= "string" then
		return
	end
	local slot = DataService.ActiveSlot(player)
	local root = getRoot(player)
	if not slot or not root then
		return
	end

	local carrotPos = info.carrots[id]
	if carrotPos then
		if slot.carrots[id] or (root.Position - carrotPos).Magnitude > 18 then
			return
		end
		slot.carrots[id] = true
		slot.carrotCount += 1
		local event = { kind = "carrot", id = id }
		if slot.carrotCount % Config.HealEveryCarrots == 0 then
			heal(player, 1)
			event.heal = true
		end
		if slot.carrotCount == Config.CollectorGoal then
			event = { kind = "unlock", id = "collector", heal = event.heal }
		end
		push(player, event)
		return
	end

	local goldPos = info.goldens[id]
	local def = goldenDefs[id]
	if goldPos and def then
		if slot.goldens[id] or (root.Position - goldPos).Magnitude > 20 then
			return
		end
		if def.req == "carrots" and slot.carrotCount < Config.CollectorGoal then
			return
		elseif def.req == "bugs" and slot.bugs < Config.BugBusterGoal then
			return
		elseif def.req == "boss" and not slot.bossDefeated then
			return
		end
		local before = DataService.Progress(player)
		slot.goldens[id] = true
		heal(player, Config.MaxHearts)
		local done = checkCompletion(player, slot)
		local after = DataService.Progress(player)
		local event = { kind = done and "complete" or "golden", id = id }
		-- tell the player about newly unlocked hats
		for _, list in ipairs({ Config.Hats, Config.Necks }) do
			for _, item in ipairs(list) do
				if not item.boss and (item.need or 0) > before.goldens and (item.need or 0) <= after.goldens then
					event.unlocked = item.name
				end
			end
		end
		push(player, event)
		task.spawn(DataService.Save, player, false)
	end
end)

GetProfile.OnServerInvoke = function(player)
	DataService.WaitFor(player, 30)
	return snapshot(player, nil)
end

SelectSlot.OnServerInvoke = function(player, index)
	local profile = DataService.WaitFor(player, 30)
	if not profile or profile.active then
		return false
	end
	local slot = DataService.SelectSlot(player, index)
	if not slot then
		return false
	end
	push(player, { kind = "start" })
	spawnCharacter(player)
	return true
end

EraseSlot.OnServerInvoke = function(player, index)
	local ok = DataService.EraseSlot(player, index)
	if ok then
		push(player, nil)
		task.spawn(DataService.Save, player, false)
	end
	return ok
end

QuitToTitle.OnServerEvent:Connect(function(player)
	if not DataService.ActiveSlot(player) then
		return
	end
	DataService.ClearActive(player)
	task.spawn(DataService.Save, player, false)
	local char = player.Character
	player.Character = nil
	if char then
		char:Destroy()
	end
	push(player, nil)
end)

Customise.OnServerInvoke = function(player, custom)
	local profile = DataService.Get(player)
	if not profile or type(custom) ~= "table" then
		return nil
	end
	local clean = BunnyModel.Sanitize(custom)
	local progress = DataService.Progress(player)
	if not BunnyModel.IsUnlocked(Config.Hats, clean.hat, progress) then
		clean.hat = profile.data.custom.hat
	end
	if not BunnyModel.IsUnlocked(Config.Necks, clean.neck, progress) then
		clean.neck = profile.data.custom.neck
	end
	profile.data.custom = clean
	if player.Character then
		BunnyModel.Apply(player.Character, clean)
	end
	push(player, nil)
	return clean
end

SetOptions.OnServerEvent:Connect(function(player, options)
	local profile = DataService.Get(player)
	if not profile or type(options) ~= "table" then
		return
	end
	local o = profile.data.options
	if type(options.sfx) == "number" then
		o.sfx = math.clamp(math.floor(options.sfx), 0, 10)
	end
	if type(options.music) == "number" then
		o.music = math.clamp(math.floor(options.music), 0, 10)
	end
	if type(options.shake) == "boolean" then
		o.shake = options.shake
	end
end)

local VALID_MOVES = { [""] = true, roll = true, slide = true, longjump = true, pound = true, flip = true }
SetMove.OnServerEvent:Connect(function(player, move)
	local char = player.Character
	if char and type(move) == "string" and VALID_MOVES[move] then
		char:SetAttribute("Move", move)
		char:SetAttribute("MoveAt", workspace:GetServerTimeNow())
	end
end)

Pound.OnServerEvent:Connect(function(player, action, pos)
	local root = getRoot(player)
	if not root then
		return
	end
	if action == "start" then
		EnemyService.MarkPounding(player, 2)
	elseif action == "land" and typeof(pos) == "Vector3" and (pos - root.Position).Magnitude < 15 then
		EnemyService.MarkPounding(player, 0.15)
		EnemyService.Shockwave(player, pos)
		Effect:FireAllClients("pound", pos)
	end
end)

-- Prompts: warps, exits, the throne room ------------------------------------------------------
local warpDefs = {}
for _, w in ipairs(Config.Warps) do
	warpDefs[w.id] = w
end

local function teleport(player, cf)
	local char = player.Character
	if char then
		char:PivotTo(cf)
		Bounce:FireClient(player, Vector3.zero, false, "reset")
		Effect:FireClient(player, "warp", cf.Position)
	end
end

for _, d in ipairs(info.solidFolder:GetDescendants()) do
	if d:IsA("ProximityPrompt") then
		local part = d.Parent
		d.Triggered:Connect(function(player)
			local slot = DataService.ActiveSlot(player)
			if not slot then
				return
			end
			if part:GetAttribute("Warp") then
				slot.warps[part:GetAttribute("Warp")] = true
				local list = {}
				for _, w in ipairs(Config.Warps) do
					if slot.warps[w.id] then
						table.insert(list, w.id)
					end
				end
				WarpMenu:FireClient(player, list)
			elseif part:GetAttribute("ExitTo") then
				teleport(player, checkpointCF(part:GetAttribute("ExitTo")))
			elseif part:GetAttribute("ThronePortal") then
				if count(slot.goldens) >= Config.ThroneGate then
					slot.checkpoint = "throne"
					teleport(player, checkpointCF("throne"))
					push(player, { kind = "checkpoint", id = "throne" })
				else
					Effect:FireClient(player, "locked", Config.ThroneGate)
				end
			end
		end)
	end
end

Warp.OnServerEvent:Connect(function(player, id)
	local slot = DataService.ActiveSlot(player)
	local def = type(id) == "string" and warpDefs[id]
	if slot and def and slot.warps[id] then
		teleport(player, CFrame.new(def.pos + Vector3.new(0, 5, -9)))
	end
end)

-- Hazards, enemies, boss ------------------------------------------------------------------------
HazardService.Start(info, {
	burn = burn,
	hurt = function(player, fromPos, velocity)
		hurt(player, fromPos, velocity, false)
	end,
})

EnemyService.Start(info, {
	effect = function(kind, pos)
		Effect:FireAllClients(kind, pos)
	end,
	bopped = onBopped,
	bounce = function(player, vel, keepHorizontal)
		Bounce:FireClient(player, vel, keepHorizontal, "stomp")
	end,
	hurt = function(player, fromPos)
		hurt(player, fromPos, nil, false)
	end,
})

BossService.Start(info, {
	effect = function(kind, pos, extra)
		Effect:FireAllClients(kind, pos, extra)
	end,
	hurt = function(player, fromPos)
		hurt(player, fromPos, nil, false)
	end,
	bounce = function(player, vel)
		Bounce:FireClient(player, vel, true, "stomp")
	end,
	defeated = function(winners)
		for _, player in ipairs(winners) do
			local slot = DataService.ActiveSlot(player)
			if slot then
				slot.bossDefeated = true
				push(player, { kind = "bossdown" })
				task.spawn(DataService.Save, player, false)
			end
		end
	end,
})

-- Players -----------------------------------------------------------------------------------------
local function onPlayerAdded(player)
	state[player] = { safe = checkpointCF("meadow"), invulnUntil = 0 }
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	for _, name in ipairs({ "Golden", "Carrots" }) do
		local v = Instance.new("IntValue")
		v.Name = name
		v.Parent = stats
	end
	stats.Parent = player
	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	local profile = DataService.Load(player)
	if profile and player.Parent then
		push(player, nil)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end
Players.PlayerRemoving:Connect(function(player)
	state[player] = nil
	DataService.Release(player)
end)

-- Water, lava, checkpoints & warp discovery ------------------------------------------------------------
local floorParams = RaycastParams.new()
floorParams.FilterType = Enum.RaycastFilterType.Include
floorParams.FilterDescendantsInstances = { info.solidFolder }

local acc = 0
RunService.Heartbeat:Connect(function(dt)
	acc += dt
	if acc < 0.2 then
		return
	end
	acc = 0
	for player, st in pairs(state) do
		local root, hum = getRoot(player)
		local slot = DataService.ActiveSlot(player)
		if root and hum and hum.Health > 0 and slot then
			local pos = root.Position
			local hit = workspace:Raycast(pos, Vector3.new(0, -3.4, 0), floorParams)
			local inWater = pos.Y < Config.WaterLevel - 2.5 or (hit and hit.Instance:GetAttribute("Water"))
			if inWater then
				Effect:FireAllClients("splash", Vector3.new(pos.X, hit and hit.Position.Y or Config.WaterLevel, pos.Z))
				hurt(player, pos, Vector3.zero, true)
				if hum.Health > 0 then
					player.Character:PivotTo(st.safe)
					Bounce:FireClient(player, Vector3.zero, false, "reset")
				end
			elseif hit and hit.Instance:GetAttribute("Lava") then
				HazardService.Burn(player)
			elseif hit and not hit.Instance:GetAttribute("Moving") and hit.Instance.Anchored
				and hit.Instance:GetAttribute("Bounce") == nil and hit.Instance:GetAttribute("Slide") == nil then
				st.safe = CFrame.new(hit.Position + Vector3.new(0, 3, 0)) * (root.CFrame - root.CFrame.Position)
			end

			for id, cp in pairs(Config.Checkpoints) do
				if slot.checkpoint ~= id and (pos - cp.pos).Magnitude < 14 then
					slot.checkpoint = id
					push(player, { kind = "checkpoint", id = id })
				end
			end
			for _, w in ipairs(Config.Warps) do
				if not slot.warps[w.id] and (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(w.pos.X, 0, w.pos.Z)).Magnitude < 16 then
					slot.warps[w.id] = true
					push(player, { kind = "warpfound", id = w.id })
				end
			end
		end
	end
end)

print(string.format("[Bunny64] Ready: %d carrots, %d golden carrots, %d bugs.", TOTAL_CARROTS, #Config.Goldens, #info.bugs))
]]></ProtectedString><token name="RunContext">0</token></Properties><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">BossService</string><ProtectedString name="Source"><![CDATA[--[[
	BossService - King Grumble, the giant crowned Grumblebug in the throne room.

	His three glowing weak points sit on top of his shell. They are only
	exposed while he is dazed: after he charges into a stone pillar, or after
	a ground slam tires him out. Jump (or ground pound) onto a weak point to
	break it. Break all three to win.

	  sleep -> roar -> chase -> windup -> charge -> (stunned | recover -> slam -> tired) -> chase ...
	Each hit makes him faster; from the second phase he spits fireballs.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Bunny64")
local Config = require(Shared:WaitForChild("Config"))
local BugModel = require(script.Parent:WaitForChild("BugModel"))

local BossService = {}

local SCALE = 3.4
local A, RADIUS
local cb
local boss = {}
local pillars = {}
local fireballs = {}
local waves = {}
local folder

local function setState(name)
	boss.state = name
	boss.t0 = os.clock()
	if boss.model then
		boss.model:SetAttribute("State", name)
	end
end

local function exposed()
	return boss.state == "stunned" or boss.state == "tired"
end

local function playersInArena()
	local list = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if root and hum and hum.Health > 0 then
			local p = root.Position
			if (Vector3.new(p.X, 0, p.Z) - Vector3.new(A.X, 0, A.Z)).Magnitude < RADIUS + 10 and p.Y > A.Y - 8 and p.Y < A.Y + 80 then
				table.insert(list, { player = player, root = root, hum = hum, char = char })
			end
		end
	end
	return list
end

local function nearest(list)
	local best, bestD = nil, math.huge
	for _, e in ipairs(list) do
		local d = (e.root.Position - boss.pos).Magnitude
		if d < bestD then
			best, bestD = e, d
		end
	end
	return best
end

local function build()
	if boss.model then
		boss.model:Destroy()
	end
	local model, _, root = BugModel.Build("castle", SCALE, CFrame.new())
	model.Name = "KingGrumble"
	-- crown
	local headY, headZ = 1.65 * SCALE, -2.9 * SCALE
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Material = Enum.Material.Metal
		p.Color = Config.Palette.Gold
		p.Size = Vector3.new(0.9, 2.2, 0.6)
		p.CFrame = CFrame.new(math.cos(a) * 2.6, headY + 3.4, headZ + math.sin(a) * 2.2) * CFrame.Angles(0, -a, 0)
		p.Parent = model
	end
	local band = Instance.new("Part")
	band.Shape = Enum.PartType.Cylinder
	band.Anchored = true
	band.CanCollide = false
	band.CanQuery = false
	band.CanTouch = false
	band.Material = Enum.Material.Metal
	band.Color = Config.Palette.Gold
	band.Size = Vector3.new(1.2, 5.6, 5.6)
	band.CFrame = CFrame.new(0, headY + 2.6, headZ) * CFrame.Angles(0, 0, math.pi / 2)
	band.Parent = model
	-- weak points
	boss.spots = {}
	for _, lp in ipairs({ Vector3.new(-1.15, 3.2, 1.5), Vector3.new(1.15, 3.2, 1.5), Vector3.new(0, 3.15, -0.6) }) do
		local s = Instance.new("Part")
		s.Name = "WeakPoint"
		s.Anchored = true
		s.CanCollide = false
		s.CanQuery = false
		s.CanTouch = false
		s.Size = Vector3.new(1.4, 0.9, 1.4) * SCALE
		s.CFrame = CFrame.new(lp * SCALE)
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Parent = s
		s.Parent = model
		table.insert(boss.spots, { part = s, alive = true })
	end
	boss.shells = {}
	for _, d in ipairs(model:GetChildren()) do
		if d.Name == "Shell" then
			table.insert(boss.shells, d)
		end
	end
	boss.model = model
	boss.root = root
	model:SetAttribute("Boss", true)
	model.Parent = folder
end

local function reset()
	build()
	boss.pos = A
	boss.yaw = 0
	boss.hp = 3
	boss.model:SetAttribute("HP", 3)
	boss.lastFire = 0
	boss.slams = 0
	setState("sleep")
end

local function place(extraY, tilt)
	boss.model:PivotTo(CFrame.new(boss.pos + Vector3.new(0, 1.8 * SCALE + (extraY or 0), 0)) * CFrame.Angles(0, boss.yaw, 0) * CFrame.Angles(tilt or 0, 0, 0))
end

local function refreshSpots()
	local on = exposed()
	for _, s in ipairs(boss.spots) do
		if s.alive then
			s.part.Material = on and Enum.Material.Neon or Enum.Material.SmoothPlastic
			s.part.Color = on and Color3.fromRGB(240, 170, 70) or Color3.fromRGB(80, 50, 40)
		end
	end
	for _, sh in ipairs(boss.shells) do
		sh.CanCollide = on -- climb onto his back while he's dazed
	end
end

local function faceTo(pos)
	local d = pos - boss.pos
	if Vector3.new(d.X, 0, d.Z).Magnitude > 0.1 then
		boss.yaw = math.atan2(-d.X, -d.Z)
	end
end

local function forward()
	return Vector3.new(-math.sin(boss.yaw), 0, -math.cos(boss.yaw))
end

local function clampToArena(p)
	local flat = Vector3.new(p.X - A.X, 0, p.Z - A.Z)
	if flat.Magnitude > RADIUS - 8 then
		flat = flat.Unit * (RADIUS - 8)
		return Vector3.new(A.X + flat.X, A.Y, A.Z + flat.Z), true
	end
	return Vector3.new(p.X, A.Y, p.Z), false
end

local function spitFireball(target)
	local from = boss.pos + Vector3.new(0, 2 * SCALE, 0) + forward() * 3.4 * SCALE
	local to = target.root.Position
	local dir = Vector3.new(to.X - from.X, 0, to.Z - from.Z)
	if dir.Magnitude < 0.1 then
		return
	end
	local ball = Instance.new("Part")
	ball.Name = "Fireball"
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.one * 3.2
	ball.Material = Enum.Material.Neon
	ball.Color = Config.Palette.Ember
	ball.Anchored = true
	ball.CanCollide = false
	ball.CanQuery = false
	ball.CanTouch = false
	ball.CFrame = CFrame.new(Vector3.new(from.X, A.Y + 3, from.Z))
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 140, 70)
	light.Range = 14
	light.Parent = ball
	ball.Parent = folder
	table.insert(fireballs, { part = ball, vel = dir.Unit * 36, die = os.clock() + 4 })
	cb.effect("fire", from)
end

local function slamLand()
	table.insert(waves, { center = boss.pos, t0 = os.clock(), speed = 44, maxR = 64, hit = {} })
	cb.effect("shockwave", boss.pos, 44)
end

local function hurtPlayer(e, fromPos)
	cb.hurt(e.player, fromPos)
end

function BossService.Start(worldInfo, callbacks)
	cb = callbacks
	A = worldInfo.arenaCenter
	RADIUS = worldInfo.arenaRadius
	folder = Instance.new("Folder")
	folder.Name = "Boss"
	folder.Parent = workspace
	for _, d in ipairs(worldInfo.solidFolder:GetDescendants()) do
		if d:IsA("BasePart") and d.Name == "ArenaPillar" then
			table.insert(pillars, Vector3.new(d.Position.X, A.Y, d.Position.Z))
		end
	end
	reset()
	place(0)

	local emptySince = os.clock()
	RunService.Heartbeat:Connect(function(dt)
		local now = os.clock()
		local list = playersInArena()
		if #list == 0 then
			if now - emptySince > 8 and (boss.state ~= "sleep" or boss.hp < 3) then
				reset()
				place(0)
			end
		else
			emptySince = now
		end
		local st = boss.state
		local age = now - boss.t0
		local phase = 4 - boss.hp -- 1, 2, 3
		local target = nearest(list)
		local lift, tilt = 0, 0

		if st == "sleep" then
			boss.yaw += dt * 0.2
			lift = math.sin(now * 1.5) * 0.3
			if #list > 0 then
				setState("roar")
				cb.effect("bossroar", boss.pos)
			end
		elseif st == "roar" then
			if target then
				faceTo(target.root.Position)
			end
			tilt = math.sin(age * 20) * 0.04 + 0.12
			if age > 2 then
				setState("chase")
			end
		elseif st == "chase" then
			if target then
				faceTo(target.root.Position)
				local speed = 12 + 4 * phase
				boss.pos = clampToArena(boss.pos + forward() * speed * dt)
				if phase >= 2 and now - boss.lastFire > (phase == 2 and 1.5 or 0.9) then
					boss.lastFire = now
					spitFireball(target)
				end
			end
			lift = math.abs(math.sin(now * 10)) * 0.6
			if age > 3.2 - 0.4 * phase then
				setState("windup")
			end
		elseif st == "windup" then
			if target and age < 0.4 then
				faceTo(target.root.Position)
			end
			tilt = -0.18
			lift = math.sin(age * 40) * 0.25
			if age > 1.0 - 0.15 * phase then
				setState("charge")
				cb.effect("bosscharge", boss.pos)
			end
		elseif st == "charge" then
			local speed = 56 + 8 * phase
			local nextPos, hitEdge = clampToArena(boss.pos + forward() * speed * dt)
			boss.pos = nextPos
			tilt = -0.08
			local bonk = false
			for _, pl in ipairs(pillars) do
				if (Vector3.new(boss.pos.X, 0, boss.pos.Z) - Vector3.new(pl.X, 0, pl.Z)).Magnitude < 4.5 + 2.6 * SCALE then
					bonk = true
				end
			end
			if bonk then
				setState("stunned")
				refreshSpots()
				cb.effect("bossbonk", boss.pos + Vector3.new(0, 3 * SCALE, 0))
			elseif hitEdge or age > 2.2 then
				setState("recover")
			end
		elseif st == "recover" then
			if age > 0.8 then
				boss.slams = 0
				setState("slam")
			end
		elseif st == "slam" then
			local dur = 1.1
			local u = math.clamp(age / dur, 0, 1)
			lift = math.sin(u * math.pi) * 22
			if target then
				faceTo(target.root.Position)
				boss.pos = clampToArena(boss.pos + forward() * 22 * dt)
			end
			if age >= dur then
				slamLand()
				boss.slams += 1
				if phase == 3 and boss.slams < 2 then
					setState("slam")
				else
					setState("tired")
					refreshSpots()
				end
			end
		elseif st == "stunned" or st == "tired" then
			tilt = math.sin(now * 3) * 0.06
			lift = -0.6
			if st == "stunned" then
				boss.yaw += math.sin(now * 5) * dt * 0.6
			end
			if age > (st == "stunned" and 4.2 or 3.2) then
				setState("chase")
				refreshSpots()
			end
		elseif st == "hurt" then
			tilt = math.sin(age * 30) * 0.1 -- clients flash him while State == "hurt"
			if age > 1.4 then
				if boss.hp <= 0 then
					setState("dying")
					cb.effect("bossdie", boss.pos + Vector3.new(0, 3 * SCALE, 0))
				else
					setState("chase")
				end
			end
		elseif st == "dying" then
			boss.yaw += dt * (4 + age * 6)
			lift = age * 4
			if age > 2.4 then
				cb.effect("poof", boss.pos + Vector3.new(0, 3 * SCALE, 0))
				boss.model.Parent = nil
				setState("dead")
				local winners = {}
				for _, e in ipairs(list) do
					table.insert(winners, e.player)
				end
				cb.defeated(winners)
			end
		elseif st == "dead" then
			if age > 45 and #list == 0 then
				reset()
			end
		end

		if boss.model.Parent then
			place(lift, tilt)
			boss.model:SetAttribute("Exposed", exposed())
		end

		-- Player interactions -------------------------------------------------
		if st ~= "dead" and st ~= "dying" and st ~= "sleep" then
			for _, e in ipairs(list) do
				local h = e.root.Position
				local feet = h.Y - 2.6
				local vy = e.root.AssemblyLinearVelocity.Y
				local handled = false
				if exposed() then
					for _, s in ipairs(boss.spots) do
						if s.alive then
							local w = s.part.Position
							local flat = Vector3.new(h.X - w.X, 0, h.Z - w.Z).Magnitude
							if flat < 4.6 and feet > w.Y - 2.2 and feet < w.Y + 5 and (vy < 1 or e.char:GetAttribute("Move") == "pound") then
								s.alive = false
								s.part.Parent = nil
								boss.hp -= 1
								boss.model:SetAttribute("HP", boss.hp)
								cb.bounce(e.player, Vector3.new(0, 80, 0))
								cb.effect("bosshit", w)
								setState("hurt")
								refreshSpots()
								handled = true
								break
							end
						end
					end
				end
				if not handled and not exposed() and boss.state ~= "hurt" then
					local flat = Vector3.new(h.X - boss.pos.X, 0, h.Z - boss.pos.Z).Magnitude
					if flat < 3.2 * SCALE and feet < boss.pos.Y + 3.4 * SCALE then
						hurtPlayer(e, boss.pos)
					end
				end
			end
		end

		-- Fireballs ---------------------------------------------------------------
		for i = #fireballs, 1, -1 do
			local f = fireballs[i]
			local p = f.part.Position + f.vel * dt
			f.part.CFrame = CFrame.new(p)
			local dead = now > f.die or (Vector3.new(p.X - A.X, 0, p.Z - A.Z)).Magnitude > RADIUS + 4
			if not dead then
				for _, e in ipairs(list) do
					if (e.root.Position - p).Magnitude < 3.6 then
						hurtPlayer(e, p - f.vel)
						dead = true
					end
				end
			end
			if dead then
				f.part:Destroy()
				table.remove(fireballs, i)
			end
		end

		-- Shockwaves --------------------------------------------------------------
		for i = #waves, 1, -1 do
			local w = waves[i]
			local r = (now - w.t0) * w.speed
			if r > w.maxR then
				table.remove(waves, i)
			else
				for _, e in ipairs(list) do
					local h = e.root.Position
					local flat = Vector3.new(h.X - w.center.X, 0, h.Z - w.center.Z).Magnitude
					local grounded = h.Y - 2.6 < A.Y + 1.4
					if grounded and not w.hit[e.player] and math.abs(flat - r) < 2.8 then
						w.hit[e.player] = true
						cb.hurt(e.player, w.center)
					end
				end
			end
		end
	end)
end

return BossService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">BugModel</string><ProtectedString name="Source"><![CDATA[--[[
	BugModel - builds a Grumblebug: a round beetle with split wing cases,
	a shield-shaped thorax, mandibles, glossy eyes under a cross brow,
	clubbed antennae and six two-part legs.

	Front is -Z, feet at Y = 0 (before scaling). Returns model, legs list
	and the root part. `scale` lets the boss reuse the same design.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Bunny64")
local Config = require(Shared:WaitForChild("Config"))

local BugModel = {}

local SMOOTH = Enum.Material.SmoothPlastic

function BugModel.Build(skinName, scale, origin)
	local skin = Config.BugSkins[skinName] or Config.BugSkins.meadow
	scale = scale or 1
	origin = origin or CFrame.new()
	local model = Instance.new("Model")
	model.Name = "Grumblebug"
	local legs = {}

	local function part(cf, size, color, ball, material, name)
		local p = Instance.new("Part")
		p.Name = name or "Part"
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Size = size * scale
		p.CFrame = origin * CFrame.new(cf.Position * scale) * (cf - cf.Position)
		p.Color = color
		p.Material = material or SMOOTH
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		if ball then
			local m = Instance.new("SpecialMesh")
			m.MeshType = Enum.MeshType.Sphere
			m.Parent = p
		end
		p.Parent = model
		return p
	end
	local CF, V, R = CFrame.new, Vector3.new, CFrame.Angles

	local root = part(CF(0, 1.8, 0), V(4, 3, 6), skin.shell, false, nil, "Root")
	root.Transparency = 1
	model.PrimaryPart = root

	-- underside & wing cases
	part(CF(0, 1.15, 0.3), V(3.9, 1.1, 5.8), skin.body, true)
	for _, sx in ipairs({ -1, 1 }) do
		part(CF(sx * 1.02, 2.05, 0.9) * R(0, 0, sx * -0.12), V(2.25, 2.4, 5.0), skin.shell, true, nil, "Shell")
		part(CF(sx * 1.25, 2.75, 1.6), V(0.85, 0.32, 1.1), skin.spot, true, skinName == "castle" and Enum.Material.Neon or SMOOTH)
		part(CF(sx * 0.9, 2.55, -0.1), V(0.6, 0.28, 0.75), skin.spot, true, skinName == "castle" and Enum.Material.Neon or SMOOTH)
	end
	part(CF(0, 3.1, 1.0), V(0.16, 0.2, 4.4), skin.body) -- wing seam
	-- thorax shield
	part(CF(0, 2.1, -1.75), V(3.2, 1.75, 1.9), skin.shell2, true)
	-- head
	part(CF(0, 1.65, -2.9), V(2.0, 1.55, 1.6), skin.body, true, nil, "Head")
	for _, sx in ipairs({ -1, 1 }) do
		-- eyes with a glint
		local eye = part(CF(sx * 0.62, 2.0, -3.45), V(0.62, 0.72, 0.5), Config.Palette.Button, true)
		eye.Reflectance = 0.2
		part(CF(sx * 0.58, 2.12, -3.7), V(0.2, 0.2, 0.08), skin.eye, true, Enum.Material.Neon)
		-- cross brow
		part(CF(sx * 0.55, 2.42, -3.5) * R(0, 0, sx * 0.38), V(0.95, 0.22, 0.32), skin.body)
		-- mandibles
		part(CF(sx * 0.42, 1.25, -3.75) * R(0, sx * 0.55, 0), V(0.3, 0.28, 1.0), skin.shell2)
		-- antenna: stalk + club
		part(CF(sx * 0.42, 2.7, -3.55) * R(-0.75, 0, sx * -0.35), V(0.14, 1.5, 0.14), skin.body)
		part(CF(sx * 0.72, 3.25, -4.15), V(0.38, 0.38, 0.38), skin.body, true)
		-- legs: thigh angled up and out, shin down to the ground
		for i, z in ipairs({ -1.4, 0.3, 1.9 }) do
			local thigh = part(CF(sx * 2.05, 1.65, z) * R(0, 0, sx * 0.45), V(1.5, 0.34, 0.34), skin.body)
			local shin = part(CF(sx * 2.75, 0.75, z + (i - 2) * 0.25) * R(0, 0, sx * -0.15), V(0.3, 1.6, 0.3), skin.body)
			table.insert(legs, { thigh = thigh, shin = shin, side = sx, index = i })
		end
	end
	model.Parent = nil
	return model, legs, root
end

return BugModel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[--[[
	DataService - loads and saves each player's progress with DataStoreService.

	Save layout (one DataStore key per player):
	  {
	    version = 2,
	    slots = { ["1"] = slot, ["2"] = slot, ["3"] = slot },   -- File A / B / C
	    custom = { fur, accent, hat, neck },                     -- shared look
	    options = { sfx, music, shake },
	  }

	* Session locking so two servers can't overwrite each other.
	* Retries with back-off, autosave, save on leave and on shutdown.
	* Saves from the first version are moved into File A automatically.
	* In Studio without API access the game still runs; nothing is saved.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Bunny64")
local Config = require(Shared:WaitForChild("Config"))

local DataService = {}

local SCHEMA_VERSION = 2
local LOCK_TIMEOUT = 600

local store = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[Bunny64] DataStore unavailable:", result)
	end
end

local profiles = {} -- [Player] = profile

function DataService.NewSlot()
	return {
		carrots = {},
		goldens = {},
		carrotCount = 0,
		bugs = 0,
		playTime = 0,
		completedTime = nil,
		checkpoint = "meadow",
		warps = { meadow = true },
		bossDefeated = false,
		created = os.time(),
	}
end

local function defaultData()
	return {
		version = SCHEMA_VERSION,
		slots = {},
		custom = table.clone(Config.DefaultCustom),
		options = { sfx = 8, music = 6, shake = true },
	}
end

local function reconcileSlot(slot)
	if type(slot) ~= "table" then
		return nil
	end
	for k, v in pairs(DataService.NewSlot()) do
		if slot[k] == nil and k ~= "completedTime" then
			slot[k] = v
		end
	end
	local n = 0
	for _ in pairs(slot.carrots) do
		n += 1
	end
	slot.carrotCount = n
	if not Config.Checkpoints[slot.checkpoint] then
		slot.checkpoint = "meadow"
	end
	return slot
end

local function reconcile(data)
	if type(data) ~= "table" then
		return defaultData()
	end
	if data.version == nil or data.version < 2 then
		-- version 1 kept a single game at the top level: move it into File A
		local legacy = {
			carrots = data.carrots or {},
			goldens = data.goldens or {},
			bugs = data.bugs or 0,
			playTime = data.playTime or 0,
			completedTime = nil, -- the game grew; the old ending no longer counts
		}
		data = defaultData()
		if next(legacy.carrots) or next(legacy.goldens) then
			data.slots["1"] = reconcileSlot(legacy)
		end
	end
	for k, v in pairs(defaultData()) do
		if data[k] == nil then
			data[k] = v
		end
	end
	for i = 1, Config.SaveSlots do
		local key = tostring(i)
		data.slots[key] = reconcileSlot(data.slots[key])
	end
	return data
end

local function shallowCopy(t)
	local out = {}
	for k, v in pairs(t) do
		out[k] = v
	end
	return out
end

local function isApiDisabledError(err)
	local msg = tostring(err)
	return string.find(msg, "StudioAccessToApisNotAllowed") ~= nil
		or string.find(msg, "publish", 1, true) ~= nil
		or string.find(msg, "403", 1, true) ~= nil
end

local function keyFor(player)
	return "player_" .. player.UserId
end

--------------------------------------------------------------------------------
-- Load / save
--------------------------------------------------------------------------------

function DataService.Load(player)
	local profile = {
		player = player,
		data = defaultData(),
		canSave = false,
		loaded = false,
		active = nil, -- "1" / "2" / "3" while playing a file
		lastTick = os.clock(),
	}
	profiles[player] = profile

	if store then
		local attempts = 5
		for attempt = 1, attempts do
			if not player.Parent then
				return nil
			end
			local locked = false
			local ok, result = pcall(function()
				return store:UpdateAsync(keyFor(player), function(old)
					old = reconcile(old)
					local lock = old.lock
					if lock and lock.job ~= game.JobId and os.time() - (lock.time or 0) < LOCK_TIMEOUT and attempt < attempts then
						locked = true
						return nil
					end
					old.lock = { job = game.JobId, time = os.time() }
					return old
				end)
			end)
			if ok and result then
				profile.data = reconcile(result)
				profile.canSave = true
				break
			elseif not ok then
				warn(string.format("[Bunny64] Load attempt %d for %s failed: %s", attempt, player.Name, tostring(result)))
				if isApiDisabledError(result) then
					break
				end
			end
			task.wait(locked and 3 or attempt * 1.5)
		end
	end

	profile.data.lock = nil
	profile.loaded = true
	if not profile.canSave then
		warn("[Bunny64] Progress for " .. player.Name .. " will NOT be saved this session.")
	end
	return profile
end

local function tickPlayTime(profile)
	local now = os.clock()
	local slot = profile.active and profile.data.slots[profile.active]
	if slot then
		slot.playTime += now - profile.lastTick
	end
	profile.lastTick = now
end

function DataService.Save(player, release)
	local profile = profiles[player]
	if not profile or not profile.loaded then
		return false
	end
	tickPlayTime(profile)
	if not profile.canSave or not store then
		return false
	end
	local payload = shallowCopy(profile.data)
	payload.lock = (not release) and { job = game.JobId, time = os.time() } or nil

	for attempt = 1, 3 do
		local stolen = false
		local ok, err = pcall(function()
			store:UpdateAsync(keyFor(player), function(old)
				if type(old) == "table" and old.lock and old.lock.job ~= game.JobId then
					stolen = true
					return nil
				end
				return payload
			end)
		end)
		if ok then
			if stolen then
				warn("[Bunny64] Save skipped for " .. player.Name .. ": session owned by another server.")
				profile.canSave = false
				return false
			end
			return true
		end
		warn(string.format("[Bunny64] Save attempt %d for %s failed: %s", attempt, player.Name, tostring(err)))
		task.wait(attempt)
	end
	return false
end

function DataService.Release(player)
	DataService.Save(player, true)
	profiles[player] = nil
end

function DataService.Get(player)
	local profile = profiles[player]
	if profile and profile.loaded then
		return profile
	end
	return nil
end

function DataService.WaitFor(player, timeout)
	local start = os.clock()
	while player.Parent and os.clock() - start < (timeout or 30) do
		local profile = DataService.Get(player)
		if profile then
			return profile
		end
		task.wait(0.1)
	end
	return nil
end

--------------------------------------------------------------------------------
-- Files (save slots)
--------------------------------------------------------------------------------

function DataService.ActiveSlot(player)
	local profile = DataService.Get(player)
	if profile and profile.active then
		return profile.data.slots[profile.active], profile
	end
	return nil, profile
end

function DataService.SelectSlot(player, index)
	local profile = DataService.Get(player)
	if not profile or type(index) ~= "number" or index < 1 or index > Config.SaveSlots or index % 1 ~= 0 then
		return nil
	end
	tickPlayTime(profile)
	local key = tostring(index)
	if not profile.data.slots[key] then
		profile.data.slots[key] = DataService.NewSlot()
	end
	profile.active = key
	profile.lastTick = os.clock()
	return profile.data.slots[key]
end

function DataService.ClearActive(player)
	local profile = DataService.Get(player)
	if profile then
		tickPlayTime(profile)
		profile.active = nil
	end
end

function DataService.EraseSlot(player, index)
	local profile = DataService.Get(player)
	if not profile or type(index) ~= "number" or index < 1 or index > Config.SaveSlots then
		return false
	end
	local key = tostring(math.floor(index))
	if profile.active == key then
		return false
	end
	profile.data.slots[key] = nil
	return true
end

function DataService.GetPlayTime(player)
	local profile = profiles[player]
	local slot = profile and profile.active and profile.data.slots[profile.active]
	if not slot then
		return 0
	end
	return slot.playTime + (os.clock() - profile.lastTick)
end

local function count(t)
	local n = 0
	for _ in pairs(t or {}) do
		n += 1
	end
	return n
end
DataService.Count = count

function DataService.Summaries(player)
	local profile = DataService.Get(player)
	local out = {}
	for i = 1, Config.SaveSlots do
		local slot = profile and profile.data.slots[tostring(i)]
		if slot then
			out[i] = {
				exists = true,
				goldens = count(slot.goldens),
				carrots = slot.carrotCount,
				playTime = (profile.active == tostring(i)) and DataService.GetPlayTime(player) or slot.playTime,
				completed = slot.completedTime ~= nil,
			}
		else
			out[i] = { exists = false, goldens = 0, carrots = 0, playTime = 0, completed = false }
		end
	end
	return out
end

-- Best progress across all files (unlocks cosmetics)
function DataService.Progress(player)
	local profile = DataService.Get(player)
	local best, boss = 0, false
	if profile then
		for i = 1, Config.SaveSlots do
			local slot = profile.data.slots[tostring(i)]
			if slot then
				best = math.max(best, count(slot.goldens))
				boss = boss or slot.bossDefeated == true
			end
		end
	end
	return { goldens = best, boss = boss }
end

--------------------------------------------------------------------------------
-- Autosave & shutdown
--------------------------------------------------------------------------------

task.spawn(function()
	while true do
		task.wait(Config.AutosaveSeconds)
		for player in pairs(profiles) do
			task.spawn(DataService.Save, player, false)
		end
	end
end)

game:BindToClose(function()
	if RunService:IsStudio() and not store then
		return
	end
	local pending = 0
	for _, player in ipairs(Players:GetPlayers()) do
		if profiles[player] then
			pending += 1
			task.spawn(function()
				DataService.Save(player, true)
				pending -= 1
			end)
		end
	end
	local start = os.clock()
	while pending > 0 and os.clock() - start < 25 do
		task.wait(0.1)
	end
end)

return DataService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">EnemyService</string><ProtectedString name="Source"><![CDATA[--[[
	EnemyService - Grumblebugs wander their patch and charge at bunnies who
	get too close. Stomp them, ground pound near them, or roll/slide into them.
	They come back after a while.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Bunny64")
local Config = require(Shared:WaitForChild("Config"))
local BugModel = require(script.Parent:WaitForChild("BugModel"))

local EnemyService = {}

local bugs = {}
local folder
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include
local callbacks
local poundingUntil = {} -- [Player] = os.clock()

local ATTACK_MOVES = { roll = true, slide = true, longjump = true }

local function groundAt(pos)
	local hit = workspace:Raycast(pos + Vector3.new(0, 8, 0), Vector3.new(0, -30, 0), rayParams)
	if hit then
		return hit.Position.Y, hit.Instance
	end
	return nil
end

local function placeModel(bug, extraY, roll)
	bug.model:PivotTo(CFrame.new(bug.pos + Vector3.new(0, 1.8 + extraY, 0)) * CFrame.Angles(0, bug.yaw, roll or 0))
end

local function defeat(bug, player)
	bug.alive = false
	bug.respawnAt = os.clock() + Config.BugRespawnSeconds
	callbacks.effect("poof", bug.pos + Vector3.new(0, 2, 0))
	task.spawn(function()
		-- flip over and squash
		for i = 1, 8 do
			if not bug.model.Parent then
				break
			end
			bug.model:PivotTo(CFrame.new(bug.pos + Vector3.new(0, 1.8 + math.sin(i / 8 * math.pi) * 2, 0)) * CFrame.Angles(0, bug.yaw, i / 8 * math.pi))
			task.wait(0.03)
		end
		bug.model.Parent = nil
	end)
	if player then
		callbacks.bopped(player)
	end
end

function EnemyService.Start(info, cb)
	callbacks = cb
	folder = Instance.new("Folder")
	folder.Name = "Grumblebugs"
	folder.Parent = workspace
	rayParams.FilterDescendantsInstances = { info.solidFolder }

	for _, def in ipairs(info.bugs) do
		local home = def.pos
		local y = groundAt(home + Vector3.new(0, 10, 0)) or home.Y
		local pos = Vector3.new(home.X, y, home.Z)
		local model = BugModel.Build(def.skin, 1, CFrame.new(pos))
		model.Parent = folder
		table.insert(bugs, {
			model = model,
			home = pos,
			pos = pos,
			yaw = math.random() * math.pi * 2,
			turnAt = 0,
			alive = true,
			respawnAt = 0,
			phase = math.random() * 6,
			fast = def.skin == "castle",
		})
	end

	RunService.Heartbeat:Connect(function(dt)
		EnemyService.Step(dt)
	end)
end

function EnemyService.MarkPounding(player, seconds)
	poundingUntil[player] = os.clock() + seconds
end

function EnemyService.Shockwave(player, pos)
	for _, bug in ipairs(bugs) do
		if bug.alive then
			local d = Vector3.new(bug.pos.X - pos.X, 0, bug.pos.Z - pos.Z).Magnitude
			if d < 14 and math.abs(bug.pos.Y - pos.Y) < 8 then
				defeat(bug, player)
			end
		end
	end
end

local function nearestPlayer(pos)
	local best, bestDist, bestHrp = nil, 45, nil
	for _, player in ipairs(Players:GetPlayers()) do
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hrp and hum and hum.Health > 0 then
			local d = (hrp.Position - pos).Magnitude
			if d < bestDist and math.abs(hrp.Position.Y - 2.6 - pos.Y) < 10 then
				best, bestDist, bestHrp = player, d, hrp
			end
		end
	end
	return best, bestHrp
end

function EnemyService.Step(dt)
	local now = os.clock()
	for _, bug in ipairs(bugs) do
		if not bug.alive then
			if now >= bug.respawnAt then
				bug.alive = true
				bug.pos = bug.home
				bug.model.Parent = folder
				placeModel(bug, 0)
				callbacks.effect("poof", bug.pos + Vector3.new(0, 2, 0))
			end
			continue
		end

		local target, hrp = nearestPlayer(bug.pos)
		local fromHome = Vector3.new(bug.pos.X - bug.home.X, 0, bug.pos.Z - bug.home.Z).Magnitude
		local speed = bug.fast and 9 or 7
		if target and fromHome < 60 then
			local d = hrp.Position - bug.pos
			bug.yaw = math.atan2(-d.X, -d.Z)
			speed = bug.fast and 19 or 15
		else
			if fromHome > 22 then
				local d = bug.home - bug.pos
				bug.yaw = math.atan2(-d.X, -d.Z)
			elseif now > bug.turnAt then
				bug.yaw += (math.random() - 0.5) * 2.5
				bug.turnAt = now + 1 + math.random() * 2
			end
		end

		local look = Vector3.new(-math.sin(bug.yaw), 0, -math.cos(bug.yaw))
		local nextPos = bug.pos + look * speed * dt
		local gy, hitPart = groundAt(nextPos)
		local ok = gy and gy > Config.WaterLevel + 1 and math.abs(gy - bug.pos.Y) < 3
		if ok and hitPart and (hitPart:GetAttribute("Moving") or hitPart:GetAttribute("Lava") or hitPart:GetAttribute("Water") or hitPart:GetAttribute("Slide")) then
			ok = false
		end
		if ok then
			bug.pos = Vector3.new(nextPos.X, gy, nextPos.Z)
		else
			bug.yaw += math.pi * (0.5 + math.random() * 0.5)
		end
		local step = now * (speed > 10 and 18 or 10) + bug.phase
		placeModel(bug, math.abs(math.sin(step)) * 0.25, math.sin(step) * 0.06)

		-- Contact with bunnies
		for _, player in ipairs(Players:GetPlayers()) do
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if root and hum and hum.Health > 0 then
				local feet = root.Position.Y - 2.6
				local flat = Vector3.new(root.Position.X - bug.pos.X, 0, root.Position.Z - bug.pos.Z).Magnitude
				if flat < 4.4 and feet < bug.pos.Y + 4 and feet > bug.pos.Y - 2.5 then
					local vy = root.AssemblyLinearVelocity.Y
					local pounding = (poundingUntil[player] or 0) > now
					local move = char:GetAttribute("Move")
					if (vy < -1 and feet > bug.pos.Y + 1.6) or pounding then
						defeat(bug, player)
						callbacks.bounce(player, Vector3.new(0, Config.StompBounce, 0), true)
						break
					elseif move and ATTACK_MOVES[move] then
						defeat(bug, player)
						break
					else
						callbacks.hurt(player, bug.pos)
					end
				end
			end
		end
	end
end

Players.PlayerRemoving:Connect(function(player)
	poundingUntil[player] = nil
end)

return EnemyService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000C"><Properties><string name="Name">HazardService</string><ProtectedString name="Source"><![CDATA[--[[
	HazardService - decides who gets hurt by firebars, crushers, lava and
	boulders. Firebars and crushers move on the shared server clock (see
	shared/HazardMath); clients animate them, the server checks collisions.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Bunny64")
local Config = require(Shared:WaitForChild("Config"))
local HazardMath = require(Shared:WaitForChild("HazardMath"))

local HazardService = {}

local info, cb
local lastBurn = {}

local function characterOf(hit)
	local model = hit and hit:FindFirstAncestorOfClass("Model")
	if not model then
		return nil
	end
	local player = Players:GetPlayerFromCharacter(model)
	return player, model
end

function HazardService.Burn(player)
	local now = os.clock()
	if (lastBurn[player] or 0) > now - 0.35 then
		return
	end
	lastBurn[player] = now
	cb.burn(player)
end

local function hookLava(part)
	part.Touched:Connect(function(hit)
		local player = characterOf(hit)
		if player then
			HazardService.Burn(player)
		end
	end)
end

local function spawnBoulder(spawn)
	local b = Instance.new("Part")
	b.Name = "Boulder"
	b.Shape = Enum.PartType.Ball
	b.Size = Vector3.one * 8
	b.Material = Enum.Material.Sandstone
	b.Color = Config.Palette.SandstoneDark
	b.CFrame = CFrame.new(spawn.from + Vector3.new(0, 0, math.random(-6, 6)))
	b.CustomPhysicalProperties = PhysicalProperties.new(3, 0.5, 0.1, 1, 1)
	b.Parent = info.hazardFolder
	b:SetNetworkOwner(nil)
	b.AssemblyLinearVelocity = spawn.dir * 24
	local hitAt = {}
	b.Touched:Connect(function(hit)
		local player = characterOf(hit)
		if player and (hitAt[player] or 0) < os.clock() - 1 then
			hitAt[player] = os.clock()
			cb.hurt(player, b.Position, b.AssemblyLinearVelocity.Unit * 50 + Vector3.new(0, 40, 0))
		end
	end)
	Debris:AddItem(b, 14)
end

function HazardService.Start(worldInfo, callbacks)
	info, cb = worldInfo, callbacks

	for _, d in ipairs(info.solidFolder:GetDescendants()) do
		if d:IsA("BasePart") and d:GetAttribute("Lava") then
			hookLava(d)
		end
	end

	-- Boulders
	task.spawn(function()
		while true do
			for _, s in ipairs(info.boulderSpawns) do
				spawnBoulder(s)
			end
			task.wait(2.4)
		end
	end)
	-- clear boulders that fell off the world
	RunService.Heartbeat:Connect(function()
		for _, b in ipairs(info.hazardFolder:GetChildren()) do
			if b.Name == "Boulder" and b.Position.Y < Config.WaterLevel - 10 then
				b:Destroy()
			end
		end
	end)

	-- Firebars & crushers
	RunService.Heartbeat:Connect(function()
		local t = HazardMath.Now()
		for _, player in ipairs(Players:GetPlayers()) do
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if root and hum and hum.Health > 0 then
				local p = root.Position
				for _, fb in ipairs(info.firebars) do
					if math.abs(p.Y - fb.pivot.Y) < 4 and (Vector3.new(p.X, 0, p.Z) - Vector3.new(fb.pivot.X, 0, fb.pivot.Z)).Magnitude < fb.length + 3 then
						local a = HazardMath.FirebarAngle(fb.speed, fb.phase, t)
						local tip = fb.pivot + HazardMath.FirebarDir(a) * fb.length
						-- check the torso and the head
						local d = math.min(
							HazardMath.SegmentDistance(p, fb.pivot, tip),
							HazardMath.SegmentDistance(p + Vector3.new(0, 1.8, 0), fb.pivot, tip)
						)
						if d < 2.1 then
							cb.hurt(player, fb.pivot)
						end
					end
				end
				for _, c in ipairs(info.crushers) do
					local base = c.base.Position
					local half = c.size / 2
					if math.abs(p.X - base.X) < half.X + 0.9 and math.abs(p.Z - base.Z) < half.Z then
						local drop = HazardMath.CrusherDrop(c.period, c.offset, t)
						local bottom = base.Y - half.Y - drop * c.drop
						if bottom < p.Y + 3 and bottom > p.Y - 4 then
							cb.hurt(player, Vector3.new(base.X + 20, p.Y, p.Z)) -- knocked back toward the entrance
						end
					end
				end
			end
		end
	end)
end

Players.PlayerRemoving:Connect(function(player)
	lastBurn[player] = nil
end)

return HazardService
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000012"><Properties><string name="Name">World</string></Properties><Item class="ModuleScript" referent="RBX0000000D"><Properties><string name="Name">Builder</string><ProtectedString name="Source"><![CDATA[--[[
	Builder - shared helpers for constructing the world out of chunky parts,
	plus the registry of collectibles, enemies, hazards and checkpoints that
	the rest of the server reads.
]]

local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Bunny64")
local Config = require(Shared:WaitForChild("Config"))

local P = Config.Palette
local SMOOTH = Enum.Material.SmoothPlastic

local B = {}
B.P = P
B.rng = Random.new(6464)

B.info = {
	carrots = {}, -- [id] = Vector3
	goldens = {}, -- [id] = Vector3
	bugs = {}, -- { pos = Vector3, skin = string }
	firebars = {}, -- { pivot, length, speed, phase }
	crushers = {}, -- { base = CFrame, size, drop, period, offset }
	boulderSpawns = {}, -- { from = Vector3, dir = Vector3 }
}

local movers = {}

function B.Init(root)
	local function folder(name)
		local f = Instance.new("Folder")
		f.Name = name
		f.Parent = root
		return f
	end
	B.root = root
	B.solid = folder("Solid")
	B.decor = folder("Decor")
	B.collect = folder("Collectibles")
	B.hazards = folder("Hazards")
	B.info.solidFolder = B.solid
	B.info.collectFolder = B.collect
	B.info.hazardFolder = B.hazards
end

--------------------------------------------------------------------------------
-- Primitive helpers
--------------------------------------------------------------------------------

function B.make(className, props, parent)
	local inst = Instance.new(className)
	if inst:IsA("BasePart") then
		inst.Anchored = true
		inst.TopSurface = Enum.SurfaceType.Smooth
		inst.BottomSurface = Enum.SurfaceType.Smooth
		inst.Material = SMOOTH
	end
	for k, v in pairs(props) do
		inst[k] = v
	end
	inst.Parent = parent or B.solid
	return inst
end

function B.block(cf, size, color, material, parent)
	return B.make("Part", { CFrame = cf, Size = size, Color = color, Material = material or SMOOTH }, parent)
end

-- Vertical cylinder with its base at `bottom`
function B.cyl(x, bottom, z, radius, height, color, material, parent)
	return B.make("Part", {
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, radius * 2, radius * 2),
		CFrame = CFrame.new(x, bottom + height / 2, z) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Material = material or SMOOTH,
	}, parent)
end

-- Ellipsoid (decoration unless collide = true)
function B.blob(pos, size, color, material, parent, collide)
	local p = B.make("Part", {
		Size = size,
		CFrame = typeof(pos) == "CFrame" and pos or CFrame.new(pos),
		Color = color,
		Material = material or SMOOTH,
		CanCollide = collide == true,
		CanQuery = collide == true,
	}, parent or B.decor)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

function B.ball(pos, radius, color, material, parent)
	return B.make("Part", {
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * radius * 2,
		CFrame = CFrame.new(pos),
		Color = color,
		Material = material or SMOOTH,
	}, parent)
end

function B.wedge(cf, size, color, material, parent)
	return B.make("WedgePart", { CFrame = cf, Size = size, Color = color, Material = material or SMOOTH }, parent)
end

-- Ramp that climbs from `low` to `high` (both are top-surface centre points).
-- Built as a tilted slab so it can't end up facing the wrong way.
function B.ramp(low, high, width, color, material)
	local dir = (high - low).Unit
	-- tuck the low end into the ground; keep the top end flush with the landing
	return B.plank(low - dir * 2, high, width, 3, color, material)
end

-- A beam/plank between two points (top surface passes through them)
function B.plank(a, b, width, thickness, color, material, parent)
	local len = (b - a).Magnitude
	return B.make("Part", {
		Size = Vector3.new(width, thickness, len),
		CFrame = CFrame.lookAt((a + b) / 2, b) * CFrame.new(0, -thickness / 2, 0),
		Color = color,
		Material = material or SMOOTH,
	}, parent)
end

-- Earthy pillar: side colour with a top cap
function B.mound(x, z, radius, top, capColor, base, sideColor, capMat, sideMat)
	base = base or -20
	B.cyl(x, base, z, radius, top - base - 0.6, sideColor or P.Dirt, sideMat)
	return B.cyl(x, top - 1, z, radius + 0.4, 1, capColor or P.Grass, capMat)
end

function B.terrace(x, z, tiers, sideColor, capMat, sideMat)
	for _, t in ipairs(tiers) do
		B.mound(x, z, t[1], t[2], t[3] or P.Grass, 0, sideColor, capMat, sideMat)
	end
end

function B.path(from, to, width, color, y)
	y = y or 0.12
	local a = Vector3.new(from.X, y, from.Z)
	local b = Vector3.new(to.X, y, to.Z)
	B.make("Part", {
		Size = Vector3.new(width, 0.25, (b - a).Magnitude),
		CFrame = CFrame.lookAt((a + b) / 2, b),
		Color = color or P.Path,
		CanCollide = false,
		CanQuery = false,
	}, B.decor)
end

-- An island: ground disc with a beach ring
function B.island(cx, cz, radius, top, groundColor, beachColor, groundMat, sideColor)
	B.cyl(cx, -30, cz, radius + 16, 27, beachColor or P.Sand, Enum.Material.Sand)
	B.mound(cx, cz, radius, top or 0, groundColor or P.Grass, -30, sideColor, groundMat)
end

--------------------------------------------------------------------------------
-- Moving platforms (physics-driven so riders are carried)
--------------------------------------------------------------------------------

function B.mover(part, fn)
	part.Anchored = false
	part.CustomPhysicalProperties = PhysicalProperties.new(50, 1, 0, 100, 1)
	part:SetAttribute("Moving", true)
	local att = Instance.new("Attachment")
	att.Parent = part
	local ap = Instance.new("AlignPosition")
	ap.Mode = Enum.PositionAlignmentMode.OneAttachment
	ap.Attachment0 = att
	ap.RigidityEnabled = true
	ap.Position = part.Position
	ap.Parent = part
	local ao = Instance.new("AlignOrientation")
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.Attachment0 = att
	ao.RigidityEnabled = true
	ao.CFrame = part.CFrame
	ao.Parent = part
	table.insert(movers, { part = part, fn = fn, ap = ap, ao = ao })
	return part
end

-- Bob up and down
function B.bobber(part, amplitude, speed, phase)
	local base = part.CFrame
	return B.mover(part, function(t)
		return base + Vector3.new(0, math.sin(t * speed + phase) * amplitude, 0)
	end)
end

-- Slide back and forth along an offset
function B.slider(part, offset, speed, phase)
	local base = part.CFrame
	return B.mover(part, function(t)
		return base + offset * math.sin(t * speed + (phase or 0))
	end)
end

-- Spin about the vertical axis
function B.spinner(part, speed)
	local base = part.CFrame
	local rot = base - base.Position
	return B.mover(part, function(t)
		return CFrame.new(base.Position) * CFrame.Angles(0, t * speed, 0) * rot
	end)
end

-- Orbit around a centre point
function B.orbiter(part, center, radius, speed, phase)
	local rot = part.CFrame - part.Position
	local y = part.Position.Y
	return B.mover(part, function(t)
		local a = t * speed + phase
		return CFrame.new(center.X + math.cos(a) * radius, y, center.Z + math.sin(a) * radius) * rot
	end)
end

function B.Finish()
	for _, m in ipairs(movers) do
		pcall(function()
			m.part:SetNetworkOwner(nil)
		end)
	end
	RunService.Heartbeat:Connect(function()
		local t = workspace:GetServerTimeNow()
		for _, m in ipairs(movers) do
			local cf = m.fn(t)
			m.ap.Position = cf.Position
			m.ao.CFrame = cf
		end
	end)
end

--------------------------------------------------------------------------------
-- Collectibles
--------------------------------------------------------------------------------

local function carrotModel(pos, golden)
	local model = Instance.new("Model")
	model.Name = golden and "GoldenCarrot" or "Carrot"
	local body = golden and P.Gold or P.Carrot
	local dark = golden and P.GoldDark or P.CarrotDark
	local leaf = golden and Color3.fromRGB(236, 222, 170) or P.CarrotLeaf
	local s = golden and 1.8 or 1
	local function piece(offset, size, color)
		return B.make("Part", {
			Size = size * s,
			CFrame = CFrame.new(pos + offset * s),
			Color = color,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			Material = golden and Enum.Material.Metal or SMOOTH,
		}, model)
	end
	local root = piece(Vector3.new(0, 0.5, 0), Vector3.new(1.4, 1.2, 1.4), body)
	piece(Vector3.new(0, -0.5, 0), Vector3.new(1.05, 1, 1.05), dark)
	piece(Vector3.new(0, -1.3, 0), Vector3.new(0.7, 0.8, 0.7), body)
	piece(Vector3.new(0, -1.9, 0), Vector3.new(0.35, 0.5, 0.35), dark)
	for i = -1, 1 do
		local l = piece(Vector3.new(0, 1.75, 0), Vector3.new(0.22, 1.5, 0.45), leaf)
		l.Material = SMOOTH
		l.CFrame = CFrame.new(pos + Vector3.new(i * 0.3, 1.75, 0) * s) * CFrame.Angles(0, i * 0.6, -i * 0.35)
	end
	model.PrimaryPart = root
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	if golden then
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 214, 140)
		light.Range = 16
		light.Brightness = 1.3
		light.Parent = root
		B.make("Part", {
			Name = "Beam",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(180, 3, 3),
			CFrame = CFrame.new(pos + Vector3.new(0, 92, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Color = Color3.fromRGB(230, 206, 140),
			Transparency = 0.84,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CastShadow = false,
		}, model)
	end
	model.Parent = B.collect
	return model
end

function B.carrot(pos)
	local id = string.format("c_%d_%d_%d", math.round(pos.X), math.round(pos.Y), math.round(pos.Z))
	if B.info.carrots[id] then
		return
	end
	B.info.carrots[id] = pos
	local m = carrotModel(pos, false)
	m:SetAttribute("CollectId", id)
	m:SetAttribute("Kind", "carrot")
end

-- A line of carrots between two points
function B.carrotLine(a, b, n)
	for i = 0, n - 1 do
		B.carrot(a:Lerp(b, n == 1 and 0 or i / (n - 1)))
	end
end

function B.carrotRing(center, radius, n)
	for i = 0, n - 1 do
		local a = i / n * math.pi * 2
		B.carrot(center + Vector3.new(math.cos(a) * radius, 0, math.sin(a) * radius))
	end
end

function B.golden(id, pos)
	B.info.goldens[id] = pos
	local m = carrotModel(pos, true)
	m:SetAttribute("CollectId", id)
	m:SetAttribute("Kind", "golden")
end

function B.bug(pos, skin)
	table.insert(B.info.bugs, { pos = pos, skin = skin or "meadow" })
end

--------------------------------------------------------------------------------
-- Scenery
--------------------------------------------------------------------------------

function B.roundTree(x, y, z, s, leaf, leafDark)
	local rng = B.rng
	B.cyl(x, y - 1, z, 0.9 * s, 9 * s, P.Wood, Enum.Material.Wood)
	B.blob(Vector3.new(x, y + 10 * s, z), Vector3.new(9, 7, 9) * s, leaf or P.Leaf)
	B.blob(Vector3.new(x + 2 * s, y + 8.5 * s, z + 1 * s), Vector3.new(6, 5, 6) * s, leafDark or P.LeafDark)
	B.blob(Vector3.new(x - 1.5 * s, y + 13 * s, z - 0.5 * s), Vector3.new(5.5, 4.5, 5.5) * s, leaf or P.Leaf)
	if rng:NextNumber() < 0.3 then
		B.blob(Vector3.new(x + 0.5 * s, y + 7 * s, z - 3 * s), Vector3.new(4, 3.5, 4) * s, leafDark or P.LeafDark)
	end
end

function B.pineTree(x, y, z, s, color, snow)
	B.cyl(x, y - 1, z, 0.7 * s, 5 * s, P.Wood, Enum.Material.Wood)
	local c = color or P.Pine
	for i, r in ipairs({ 4.2, 3.2, 2.1, 1.0 }) do
		B.cyl(x, y + (i * 3) * s, z, r * s, (i == 4 and 2.5 or 3) * s, c, nil, B.decor)
		if snow then
			B.cyl(x, y + (i * 3 + (i == 4 and 2.5 or 3)) * s - 0.3, z, r * s * 0.8, 0.5, P.Snow, Enum.Material.Snow, B.decor)
		end
	end
end

function B.rock(x, y, z, s, color)
	local rng = B.rng
	B.make("Part", {
		Size = Vector3.new(4, 3, 3.5) * s,
		CFrame = CFrame.new(x, y + 1 * s, z) * CFrame.Angles(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, 6.28), rng:NextNumber(-0.4, 0.4)),
		Color = color or (rng:NextNumber() < 0.5 and P.Stone or P.StoneDark),
		Material = Enum.Material.Slate,
	})
end

function B.flower(x, y, z)
	local colors = { Color3.fromRGB(196, 170, 96), Color3.fromRGB(176, 120, 132), Color3.fromRGB(214, 206, 186), Color3.fromRGB(140, 120, 160) }
	B.make("Part", {
		Size = Vector3.new(0.25, 1.2, 0.25),
		CFrame = CFrame.new(x, y + 0.6, z),
		Color = P.CarrotLeaf,
		CanCollide = false,
		CanQuery = false,
		CastShadow = false,
	}, B.decor)
	B.blob(Vector3.new(x, y + 1.3, z), Vector3.new(0.9, 0.5, 0.9), colors[B.rng:NextInteger(1, #colors)])
end

function B.cactus(x, y, z, s)
	local c = P.Cactus
	B.cyl(x, y - 1, z, 1.1 * s, 11 * s, c)
	B.blob(Vector3.new(x, y + 10 * s, z), Vector3.new(2.2, 1.4, 2.2) * s, c)
	for _, side in ipairs({ -1, 1 }) do
		local h = (side > 0 and 4 or 6) * s
		B.block(CFrame.new(x + side * 1.9 * s, y + h, z), Vector3.new(2.6 * s, 1.2 * s, 1.2 * s), c)
		B.cyl(x + side * 2.8 * s, y + h, z, 0.6 * s, 3.5 * s, c)
	end
end

function B.fence(from, to, y)
	y = y or 0
	local dir = to - from
	local n = math.max(1, math.floor(dir.Magnitude / 6))
	for i = 0, n do
		local p = from + dir * (i / n)
		B.block(CFrame.new(p.X, y + 1.6, p.Z), Vector3.new(0.7, 3.2, 0.7), P.Wood, Enum.Material.Wood)
	end
	for _, h in ipairs({ 1.2, 2.5 }) do
		local a = Vector3.new(from.X, y + h, from.Z)
		local b = Vector3.new(to.X, y + h, to.Z)
		B.make("Part", {
			Size = Vector3.new(0.35, 0.45, (b - a).Magnitude),
			CFrame = CFrame.lookAt((a + b) / 2, b),
			Color = P.WoodLight,
			Material = Enum.Material.Wood,
		})
	end
end

function B.sign(pos, facing, title, subtitle, boardColor, textColor)
	B.block(CFrame.new(pos + Vector3.new(0, 2.5, 0)), Vector3.new(0.8, 5, 0.8), P.Wood, Enum.Material.Wood)
	local board = B.block(
		CFrame.lookAt(pos + Vector3.new(0, 5, 0), pos + Vector3.new(0, 5, 0) + facing) * CFrame.new(0, 0, -0.5),
		Vector3.new(10, 3.8, 0.5),
		boardColor or P.WoodLight,
		Enum.Material.Wood
	)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 1
	gui.Parent = board
	local function label(text, y, h, size)
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.new(1, -20, h, 0)
		t.Position = UDim2.new(0, 10, y, 0)
		t.Font = Enum.Font.Antique
		t.Text = text
		t.TextSize = size
		t.TextScaled = true
		t.TextColor3 = textColor or Color3.fromRGB(50, 34, 24)
		t.Parent = gui
	end
	label(title, 0.08, 0.48, 64)
	label(subtitle, 0.56, 0.34, 36)
	return board
end

function B.torch(pos)
	B.block(CFrame.new(pos), Vector3.new(0.6, 2.4, 0.6), P.Wood, Enum.Material.Wood)
	local flame = B.blob(pos + Vector3.new(0, 1.7, 0), Vector3.new(0.9, 1.3, 0.9), P.Ember, Enum.Material.Neon)
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 150, 80)
	light.Range = 22
	light.Brightness = 1.6
	light.Shadows = false
	light.Parent = flame
	return flame
end

--------------------------------------------------------------------------------
-- Gameplay objects
--------------------------------------------------------------------------------

function B.lava(cf, size, parent)
	local p = B.make("Part", {
		Name = "Lava",
		CFrame = cf,
		Size = size,
		Color = P.Lava,
		Material = Enum.Material.Neon,
		CastShadow = false,
	}, parent)
	p:SetAttribute("Lava", true)
	return p
end

-- Hazard water (freezing pond etc.): touching it resets you like the sea
function B.hazardWater(cf, size, color)
	local p = B.make("Part", {
		Name = "HazardWater",
		CFrame = cf,
		Size = size,
		Color = color or P.Water,
		Material = Enum.Material.Glass,
		Transparency = 0.15,
		CastShadow = false,
	})
	p:SetAttribute("Water", true)
	return p
end

function B.firebar(pivot, length, speed, phase, noPost)
	local model = Instance.new("Model")
	model.Name = "Firebar"
	local count = math.max(3, math.floor(length / 1.8))
	local center
	for i = 0, count do
		local p = B.make("Part", {
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * (i == 0 and 1.6 or 1.5),
			CFrame = CFrame.new(pivot + Vector3.new(i * length / count, 0, 0)),
			Color = i == 0 and P.CastleDark or P.Ember,
			Material = i == 0 and SMOOTH or Enum.Material.Neon,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CastShadow = false,
		}, model)
		if i == 0 then
			center = p
		end
	end
	model.PrimaryPart = center
	model:SetAttribute("Kind", "firebar")
	model:SetAttribute("Pivot", pivot)
	model:SetAttribute("Speed", speed)
	model:SetAttribute("Phase", phase or 0)
	model.Parent = B.hazards
	table.insert(B.info.firebars, { pivot = pivot, length = length, speed = speed, phase = phase or 0 })
	if not noPost then
		-- a little post under the pivot
		B.cyl(pivot.X, pivot.Y - 2.5, pivot.Z, 0.6, 2.5, P.CastleDark)
	end
	return model
end

-- Crusher: a stone block that drops by `drop` studs on a cycle
function B.crusher(cf, size, drop, period, offset)
	local model = Instance.new("Model")
	model.Name = "Crusher"
	local body = B.make("Part", {
		CFrame = cf,
		Size = size,
		Color = P.CastleStone,
		Material = Enum.Material.Slate,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
	}, model)
	-- angry face on both long sides
	for _, side in ipairs({ -1, 1 }) do
		for _, ex in ipairs({ -1, 1 }) do
			B.make("Part", {
				CFrame = cf * CFrame.new(ex * size.X * 0.22, size.Y * 0.1, side * (size.Z / 2 + 0.05)),
				Size = Vector3.new(size.X * 0.16, size.Y * 0.14, 0.2),
				Color = P.Ember,
				Material = Enum.Material.Neon,
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
			}, model)
			B.make("Part", {
				CFrame = cf * CFrame.new(ex * size.X * 0.2, size.Y * 0.26, side * (size.Z / 2 + 0.06)) * CFrame.Angles(0, 0, ex * 0.4),
				Size = Vector3.new(size.X * 0.24, size.Y * 0.05, 0.2),
				Color = P.Ink,
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
			}, model)
		end
	end
	model.PrimaryPart = body
	model:SetAttribute("Kind", "crusher")
	model:SetAttribute("Base", cf)
	model:SetAttribute("Drop", drop)
	model:SetAttribute("Period", period)
	model:SetAttribute("Offset", offset)
	model.Parent = B.hazards
	table.insert(B.info.crushers, { base = cf, size = size, drop = drop, period = period, offset = offset })
	return model
end

-- Golden-carrot gate: solid for players who haven't collected `need` goldens
function B.gate(cf, size, need, color)
	local p = B.make("Part", {
		Name = "GoldenGate",
		CFrame = cf,
		Size = size,
		Color = color or P.Gold,
		Material = Enum.Material.ForceField,
		Transparency = 0.2,
		CastShadow = false,
	})
	p:SetAttribute("GoldenGate", need)
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 20
		gui.Parent = p
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.fromScale(1, 1)
		t.Font = Enum.Font.LuckiestGuy
		t.TextScaled = true
		t.Text = string.format("%d GOLDEN CARROTS", need)
		t.TextColor3 = Color3.fromRGB(255, 236, 180)
		t.TextStrokeTransparency = 0
		t.Parent = gui
		local c = Instance.new("UITextSizeConstraint")
		c.MaxTextSize = 60
		c.Parent = t
	end
	return p
end

-- A prompt that sends the player to a checkpoint (e.g. leaving a dungeon)
function B.exitPrompt(pos, checkpointId, text)
	local pad = B.cyl(pos.X, pos.Y - 0.5, pos.Z, 3, 0.8, Color3.fromRGB(70, 60, 90), Enum.Material.Slate)
	pad.Name = "ExitPad"
	pad:SetAttribute("ExitTo", checkpointId)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "ExitPrompt"
	prompt.ActionText = text or "Leave"
	prompt.ObjectText = "Exit"
	prompt.KeyboardKeyCode = Enum.KeyCode.F
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonY
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = pad
	return pad
end

function B.checkpointFlag(id)
	local def = Config.Checkpoints[id]
	local base = def.pos - Vector3.new(0, 4, 0)
	local pos = base + Vector3.new(7, 0, 0)
	B.block(CFrame.new(pos + Vector3.new(0, 5, 0)), Vector3.new(0.5, 10, 0.5), P.Stone, Enum.Material.Metal)
	local flag = B.block(CFrame.new(pos + Vector3.new(1.6, 8.6, 0)), Vector3.new(3, 2, 0.15), P.Roof, Enum.Material.Fabric)
	flag.Name = "CheckpointFlag"
	flag:SetAttribute("Checkpoint", id)
	flag.CanCollide = false
	B.cyl(pos.X, base.Y - 0.5, pos.Z, 1.6, 0.8, P.StoneDark)
end

function B.warpBurrow(def)
	local pos = def.pos
	local y = pos.Y
	B.cyl(pos.X, y - 0.5, pos.Z, 5.5, 1.3, P.DirtDark)
	local hole = B.cyl(pos.X, y + 0.5, pos.Z, 3.6, 0.4, Color3.fromRGB(26, 20, 16), nil, B.solid)
	hole.Name = "WarpBurrow"
	hole:SetAttribute("Warp", def.id)
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		B.blob(Vector3.new(pos.X + math.cos(a) * 4.8, y + 1, pos.Z + math.sin(a) * 4.8), Vector3.new(2.6, 1.6, 2.6), P.Dirt, nil, B.decor)
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "WarpPrompt"
	prompt.ActionText = "Hop in"
	prompt.ObjectText = "Burrow Warp"
	prompt.KeyboardKeyCode = Enum.KeyCode.F
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonY
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.HoldDuration = 0
	prompt.Parent = hole
	B.sign(pos + Vector3.new(0, 0, 8), Vector3.new(0, 0, 1), "BURROW WARP", def.name)
	return hole, prompt
end

return B
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">Canyon</string><ProtectedString name="Source"><![CDATA[--[[
	Dustbowl Canyon - a sun-baked mesa island east of the meadow.
	  * Canyon Leap: pillars too far apart for a double jump; roll + jump to long jump
	  * Eagle's Mesa: a tall mesa ringed with ledges
	  * Boulder Run: a long ramp with boulders rolling down it
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Bunny64")
local Config = require(Shared:WaitForChild("Config"))

local Canyon = {}

function Canyon.Build(B)
	local P = B.P
	local rng = B.rng
	local V = Vector3.new
	local cx, cz = 720, 0
	local C = V(cx, 0, cz)
	local SAND = Enum.Material.Sandstone

	B.island(cx, cz, 210, 0, P.Sandstone, P.Sand, Enum.Material.Sand, P.SandstoneDark)

	-- Layered mesa block helper
	local function mesa(center, size, top)
		local h = top
		B.block(CFrame.new(center.X, h / 2, center.Z), V(size.X, h, size.Z), P.Sandstone, SAND)
		for y = 6, h - 4, 9 do
			B.block(CFrame.new(center.X, y, center.Z), V(size.X + 0.6, 2, size.Z + 0.6), P.SandstoneDark, SAND)
		end
		B.block(CFrame.new(center.X, h - 0.4, center.Z), V(size.X + 0.4, 0.8, size.Z + 0.4), Color3.fromRGB(196, 150, 104), SAND)
	end

	----------------------------------------------------------------- Canyon Leap
	do
		local z = -60
		mesa(V(610, 0, z), V(40, 0, 40), 40)
		for i = 0, 4 do
			B.block(CFrame.new(554 + i * 8, 3.5 * (i + 1), z), V(8, 7 * (i + 1), 12), P.SandstoneDark, SAND)
		end
		B.sign(V(600, 40, z + 14), V(1, 0, 0), "CANYON LEAP", "ROLL then JUMP to long jump")
		local pillars = { { 670, 40 }, { 718, 40 }, { 767, 42 }, { 817, 42 } }
		local prevEdge = 630
		for _, pl in ipairs(pillars) do
			B.cyl(pl[1], 0, z, 7, pl[2], P.Sandstone, SAND)
			B.cyl(pl[1], pl[2] - 0.6, z, 7.3, 0.8, Color3.fromRGB(196, 150, 104), SAND)
			B.carrot(V((prevEdge + pl[1] - 7) / 2, pl[2] + 12, z))
			prevEdge = pl[1] + 7
		end
		mesa(V(873, 0, z), V(34, 0, 40), 44)
		B.golden("leap", V(873, 49, z))
		-- a rope ladder of ledges back up the goal mesa for the return trip isn't needed:
		-- the canyon floor is safe, so falling just means trying again.
	end

	----------------------------------------------------------------- Eagle's Mesa
	do
		local mx, mz = 650, 110
		B.cyl(mx, 0, mz, 24, 90, P.Sandstone, SAND)
		for y = 8, 84, 10 do
			B.cyl(mx, y, mz, 24.4, 2, P.SandstoneDark, SAND)
		end
		B.cyl(mx, 89.4, mz, 24.4, 0.8, Color3.fromRGB(196, 150, 104), SAND)
		for i = 0, 11 do
			local a = i * 0.55 + 2.4
			local top = 7 + i * 7
			local p = V(mx + math.cos(a) * 30, top - 1, mz + math.sin(a) * 30)
			B.block(CFrame.new(p) * CFrame.Angles(0, -a, 0), V(12, 2, 8), P.SandstoneDark, SAND)
			if i % 3 == 1 then
				B.carrot(p + V(0, 4, 0))
			end
		end
		-- nest on top
		for i = 0, 9 do
			local a = i / 10 * math.pi * 2
			B.blob(CFrame.new(mx + math.cos(a) * 5, 91, mz + math.sin(a) * 5) * CFrame.Angles(0, -a, 0.3), V(4, 1.4, 1.4), P.Wood)
		end
		B.golden("mesa", V(mx, 95, mz))
	end

	----------------------------------------------------------------- Boulder Run
	do
		local z = 160
		local low, high = V(600, 0, z), V(820, 60, z)
		B.plank(low, high, 24, 3, P.SandstoneDark, SAND)
		for _, s in ipairs({ -1, 1 }) do
			B.plank(low + V(0, 2.5, s * 12.6), high + V(0, 2.5, s * 12.6), 1.2, 5, P.Sandstone, SAND)
		end
		-- temple on top
		B.block(CFrame.new(838, 29.5, z), V(36, 61, 44), P.Sandstone, SAND)
		for _, dx in ipairs({ -12, 12 }) do
			for _, dz in ipairs({ -14, 14 }) do
				B.cyl(838 + dx, 60, z + dz, 1.8, 12, P.Plaster)
			end
		end
		B.block(CFrame.new(838, 73, z), V(32, 2, 36), P.SandstoneDark, SAND)
		B.wedge(CFrame.new(838, 76, z - 9) , V(32, 4, 18), P.Roof, Enum.Material.Slate)
		B.wedge(CFrame.new(838, 76, z + 9) * CFrame.Angles(0, math.pi, 0), V(32, 4, 18), P.Roof, Enum.Material.Slate)
		B.golden("boulder", V(845, 65, z))
		table.insert(B.info.boulderSpawns, { from = V(818, 68, z), dir = V(-1, 0, 0) })
		for i = 1, 5 do
			B.carrot(low:Lerp(high, i / 6) + V(0, 4, (i % 2 == 0) and 7 or -7))
		end
		B.sign(V(590, 0, z - 18), V(-1, 0, 0), "BOULDER RUN", "Look out above!")
	end

	----------------------------------------------------------------- arrival
	B.checkpointFlag("canyon")
	B.warpBurrow(Config.Warps[3])
	B.carrotLine(V(560, 3, 30), V(640, 3, 30), 5)

	----------------------------------------------------------------- scenery & bugs
	-- rock arch
	B.block(CFrame.new(760, 9, 60), V(8, 18, 8), P.SandstoneDark, SAND)
	B.block(CFrame.new(790, 9, 60), V(8, 18, 8), P.SandstoneDark, SAND)
	B.block(CFrame.new(775, 20, 60), V(40, 6, 9), P.Sandstone, SAND)
	B.carrotLine(V(762, 26, 60), V(788, 26, 60), 3)
	local function clear(p)
		if (p - C).Magnitude > 195 then
			return false
		end
		if math.abs(p.Z + 60) < 30 and p.X > 540 then
			return false
		end
		if (p - V(650, 0, 110)).Magnitude < 45 or math.abs(p.Z - 160) < 22 or (p - V(775, 0, 60)).Magnitude < 28 then
			return false
		end
		if math.abs(p.Z) < 16 and p.X < 600 then
			return false
		end
		return true
	end
	local placed = 0
	for _ = 1, 400 do
		if placed >= 30 then
			break
		end
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(20, 195)
		local p = C + V(math.cos(a) * r, 0, math.sin(a) * r)
		if clear(p) then
			if rng:NextNumber() < 0.6 then
				B.cactus(p.X, 0, p.Z, rng:NextNumber(0.8, 1.3))
			else
				B.rock(p.X, 0, p.Z, rng:NextNumber(1, 2.5), P.SandstoneDark)
			end
			placed += 1
		end
	end
	for _, p in ipairs({ V(700, 0, 20), V(760, 0, -10), V(820, 0, 40), V(700, 0, -130), V(600, 0, 60), V(860, 0, 90) }) do
		B.bug(p, "canyon")
	end
	for _, p in ipairs({ V(740, 0, -120), V(800, 0, -100), V(700, 0, 80) }) do
		B.carrot(p + V(0, 3, 0))
	end
end

return Canyon
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">Castle</string><ProtectedString name="Source"><![CDATA[--[[
	Infernal Castle - a volcanic island south of the meadow. The hard part.

	  Approach      lava rivers, cinderbugs, a drawbridge over the lava moat
	  Courtyard     Firebar Gauntlet (west) and Crusher Hall (east)
	  Ramparts      a ramp up to the wall walk, the north-east watchtower
	  The Keep      a lava-floored climb up the inside walls to the roof
	  Dungeon       outside the east wall: sinking blocks, beams and firebars
	  Throne Room   a floating arena high above the castle (King Grumble)
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Bunny64")
local Config = require(Shared:WaitForChild("Config"))

local Castle = {}

Castle.ArenaCenter = Vector3.new(0, 200, 800)
Castle.ArenaRadius = 52

function Castle.Build(B)
	local P = B.P
	local rng = B.rng
	local V = Vector3.new
	local CF = CFrame.new
	local SLATE = Enum.Material.Slate
	local BASALT = Enum.Material.Basalt
	local stone, dark = P.CastleStone, P.CastleDark

	B.island(0, 800, 260, 0, P.Basalt, Color3.fromRGB(72, 64, 62), BASALT, P.BasaltLight)

	----------------------------------------------------------------- approach
	B.checkpointFlag("castle")
	B.warpBurrow(Config.Warps[4])
	B.sign(V(-20, 0, 570), V(0, 0, -1), "INFERNAL CASTLE", "Turn back, little bunny...", dark, Color3.fromRGB(230, 200, 170))
	B.lava(CF(0, 0.3, 602), V(240, 0.8, 12))
	B.lava(CF(0, 0.3, 632), V(240, 0.8, 12))
	B.block(CF(0, 0.6, 602), V(6, 1.2, 15), dark, SLATE)
	B.block(CF(40, 0.6, 632), V(6, 1.2, 15), dark, SLATE)
	B.block(CF(-50, 0.6, 632), V(6, 1.2, 15), dark, SLATE)
	B.carrotLine(V(0, 4, 585), V(0, 4, 650), 5)
	for _, p in ipairs({ V(-60, 0, 585), V(60, 0, 590), V(-30, 0, 645), V(160, 0, 690) }) do
		B.bug(p, "castle")
	end
	for i = 0, 5 do
		local x = -100 + i * 40
		B.torch(V(x, 1.2, 652))
	end
	-- smouldering vents
	for _, p in ipairs({ V(-110, 0, 580), V(100, 0, 615), V(140, 0, 580), V(-140, 0, 640) }) do
		B.cyl(p.X, -0.5, p.Z, 5, 2, P.BasaltLight, BASALT)
		B.lava(CF(p.X, 1.4, p.Z), V(4, 0.4, 4))
	end

	----------------------------------------------------------------- moat & drawbridge
	B.lava(CF(0, 0.3, 672), V(290, 0.8, 32))
	B.block(CF(0, 1, 672), V(24, 2, 40), P.Wood, Enum.Material.WoodPlanks)
	for _, s in ipairs({ -1, 1 }) do
		B.plank(V(s * 11, 2.5, 652), V(s * 11, 30, 690), 0.5, 0.5, Color3.fromRGB(60, 58, 58), Enum.Material.Metal).CanCollide = false
	end
	B.carrot(V(0, 5, 665))
	B.carrot(V(0, 5, 680))

	----------------------------------------------------------------- walls & towers
	local WALL = 45
	B.block(CF(-61, WALL / 2, 695), V(98, WALL, 10), stone, SLATE)
	B.block(CF(61, WALL / 2, 695), V(98, WALL, 10), stone, SLATE)
	B.block(CF(0, 35.5, 695), V(24, 19, 10), stone, SLATE)
	B.block(CF(0, WALL / 2, 905), V(220, WALL, 10), stone, SLATE)
	B.block(CF(-105, WALL / 2, 800), V(10, WALL, 220), stone, SLATE)
	B.block(CF(105, WALL / 2, 800), V(10, WALL, 220), stone, SLATE)
	-- dark band and battlements
	for _, w in ipairs({
		{ CF(0, 30, 690.4), V(220, 2, 0.6) }, { CF(0, 30, 909.6), V(220, 2, 0.6) },
		{ CF(-109.6, 30, 800), V(0.6, 2, 220) }, { CF(109.6, 30, 800), V(0.6, 2, 220) },
	}) do
		B.block(w[1], w[2], dark, SLATE)
	end
	for i = 0, 26 do
		local t = -104 + i * 8
		for _, z in ipairs({ 691.5, 908.5 }) do
			B.block(CF(t, WALL + 2, z), V(3.5, 4, 3), dark, SLATE)
		end
		for _, x in ipairs({ -108.5, 108.5 }) do
			B.block(CF(x, WALL + 2, 696 + i * 8), V(3, 4, 3.5), dark, SLATE)
		end
	end
	for _, c in ipairs({ V(-110, 0, 690), V(110, 0, 690), V(-110, 0, 910), V(110, 0, 910) }) do
		B.cyl(c.X, 0, c.Z, 14, 60, stone, SLATE)
		B.cyl(c.X, 59.4, c.Z, 14.4, 0.8, dark, SLATE)
		for i = 0, 9 do
			local a = i / 10 * math.pi * 2
			B.block(CF(c.X + math.cos(a) * 13, 62, c.Z + math.sin(a) * 13) * CFrame.Angles(0, -a, 0), V(3, 4, 3.5), dark, SLATE)
		end
		B.torch(V(c.X, 61.2, c.Z))
	end
	-- banners on the front wall
	for _, x in ipairs({ -40, 40 }) do
		B.block(CF(x, 32, 689.6), V(8, 18, 0.3), Color3.fromRGB(110, 34, 30), Enum.Material.Fabric)
		B.block(CF(x, 33, 689.4), V(3, 3, 0.2), P.Gold, Enum.Material.Metal)
	end

	-- ramp up the inside of the east wall to the wall walk
	B.ramp(V(94, 2, 785), V(94, WALL, 880), 12, dark, SLATE)
	B.block(CF(99, WALL - 1, 886), V(12, 2, 12), dark, SLATE)
	B.carrotLine(V(94, 10, 800), V(94, 38, 865), 3)
	B.carrotLine(V(-60, WALL + 3, 905), V(60, WALL + 3, 905), 3)
	-- steps around the north-east tower
	for i, a in ipairs({ math.pi - 0.55, math.pi - 1.15, math.pi - 1.75 }) do
		local top = WALL + 5 * i
		B.block(CF(110 + math.cos(a) * 18, top - 1, 690 + math.sin(a) * 18) * CFrame.Angles(0, -a, 0), V(7, 2, 7), dark, SLATE)
	end
	B.golden("rampart", V(110, 66, 690))

	----------------------------------------------------------------- courtyard
	B.block(CF(0, 1, 800), V(200, 2, 200), Color3.fromRGB(84, 78, 76), SLATE)
	B.checkpointFlag("courtyard")
	B.bug(V(0, 2, 790), "castle")
	B.bug(V(20, 2, 805), "castle")

	-- Firebar Gauntlet (west half)
	B.lava(CF(-60, 2.4, 752), V(80, 0.8, 96))
	local plats = {
		{ -26, 712, 6 }, { -42, 727, 9 }, { -58, 741, 12 }, { -72, 756, 15 }, { -84, 772, 18 }, { -90, 790, 21 },
	}
	local speeds = { 0, 1.7, -1.9, 2.1, -2.3, -1.2 }
	for i, pl in ipairs(plats) do
		B.cyl(pl[1], 0, pl[2], 6, pl[3], dark, SLATE)
		B.cyl(pl[1], pl[3] - 0.5, pl[2], 6.3, 0.5, P.Ember, Enum.Material.Neon)
		if speeds[i] ~= 0 then
			B.firebar(V(pl[1], pl[3] + 2.6, pl[2]), i == 6 and 12 or 10, speeds[i], i)
		end
		if i == 1 or i == 3 or i == 5 then
			B.carrot(V(pl[1] + 4, pl[3] + 3.5, pl[2]))
		end
	end
	B.golden("firebar", V(-93, 26, 793))
	B.sign(V(-12, 2, 708), V(0, 0, -1), "FIREBAR GAUNTLET", "Timing is everything", dark, Color3.fromRGB(230, 200, 170))

	-- Crusher Hall (east half)
	B.block(CF(65, 14, 732), V(70, 24, 2), dark, SLATE)
	B.block(CF(65, 14, 768), V(70, 24, 2), dark, SLATE)
	B.block(CF(65, 27, 750), V(70, 2, 38), dark, SLATE)
	for i, x in ipairs({ 40, 52, 64, 76, 88 }) do
		B.crusher(CF(x, 20, 750), V(9, 10, 33), 13, 2.6, i * 0.45)
		if i < 5 then
			B.carrot(V(x + 6, 5, 750))
		end
	end
	for _, x in ipairs({ 35, 95 }) do
		B.torch(V(x, 3.2, 734.5))
	end
	B.golden("thwomp", V(96, 7, 750))
	B.sign(V(26, 2, 742), V(-1, 0, 0), "CRUSHER HALL", "Wait for them to rise...", dark, Color3.fromRGB(230, 200, 170))

	----------------------------------------------------------------- the keep
	do
		local TOP = 64
		B.block(CF(-34, 33, 822), V(52, 62, 4), stone, SLATE)
		B.block(CF(34, 33, 822), V(52, 62, 4), stone, SLATE)
		B.block(CF(0, 41, 822), V(16, 46, 4), stone, SLATE)
		B.block(CF(0, 33, 893), V(120, 62, 4), stone, SLATE)
		B.block(CF(-58, 33, 857.5), V(4, 62, 67), stone, SLATE)
		B.block(CF(58, 33, 857.5), V(4, 62, 67), stone, SLATE)
		-- roof with a hole above the north-west corner
		B.block(CF(11, TOP - 1, 857.5), V(90, 2, 67), dark, SLATE)
		B.block(CF(-45, TOP - 1, 868.5), V(22, 2, 45), dark, SLATE)
		for i = 0, 14 do
			B.block(CF(-56 + i * 8, TOP + 2, 821.5), V(3.5, 4, 3), dark, SLATE)
			B.block(CF(-56 + i * 8, TOP + 2, 893.5), V(3.5, 4, 3), dark, SLATE)
		end
		B.block(CF(0, 20, 819.8), V(18, 4, 0.6), Color3.fromRGB(110, 34, 30), Enum.Material.Fabric)

		B.lava(CF(0, 2.4, 857.5), V(112, 0.8, 67))
		B.block(CF(0, 2, 832), V(20, 4, 16), dark, SLATE)
		B.checkpointFlag("keep")
		for _, p in ipairs({ V(-54.5, 20, 857), V(54.5, 20, 857), V(0, 20, 889.5), V(-54.5, 45, 840), V(54.5, 45, 870) }) do
			B.torch(p)
		end

		local function perimeter(u)
			if u < 100 then
				return V(-50 + u, 0, 830)
			elseif u < 155 then
				return V(50, 0, 830 + (u - 100))
			elseif u < 255 then
				return V(50 - (u - 155), 0, 885)
			else
				return V(-50, 0, 885 - (u - 255))
			end
		end
		for k = 0, 16 do
			local p = perimeter(66 + 15 * k)
			local top = 6 + 3.2 * k
			local ledge = B.block(CF(p.X, top - 1, p.Z), V(9, 2, 9), stone, SLATE)
			if k == 6 or k == 11 then
				B.bobber(ledge, 3, 1.6, k)
			elseif k == 15 then
				B.slider(ledge, V(0, 0, 4), 1.3, 0)
			elseif k == 4 or k == 9 or k == 13 then
				B.firebar(V(p.X, top + 2.6, p.Z), 8, k == 9 and -2.2 or (k == 4 and 2.0 or 2.5), k)
			end
			if k == 2 or k == 7 or k == 12 then
				B.carrot(V(p.X, top + 3.5, p.Z))
			end
		end
		B.golden("keep", V(-50, 62, 834))

		-- the throne room portal on the roof
		local portal = B.cyl(20, TOP - 0.2, 870, 6, 1, Color3.fromRGB(90, 40, 60), Enum.Material.Neon)
		portal.Name = "ThronePortal"
		portal:SetAttribute("ThronePortal", true)
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "ThronePrompt"
		prompt.ActionText = "Enter"
		prompt.ObjectText = "Throne Room"
		prompt.KeyboardKeyCode = Enum.KeyCode.F
		prompt.GamepadKeyCode = Enum.KeyCode.ButtonY
		prompt.MaxActivationDistance = 14
		prompt.RequiresLineOfSight = false
		prompt.Parent = portal
		B.gate(CF(20, TOP + 8, 870), V(14, 16, 14), Config.ThroneGate, Color3.fromRGB(150, 60, 70))
		for i = 0, 3 do
			local a = i / 4 * math.pi * 2 + math.pi / 4
			B.cyl(20 + math.cos(a) * 9, TOP, 870 + math.sin(a) * 9, 1, 10, dark, SLATE)
			B.torch(V(20 + math.cos(a) * 9, TOP + 11.2, 870 + math.sin(a) * 9))
		end
	end

	----------------------------------------------------------------- the dungeon (outside the east wall)
	do
		B.block(CF(150, 15, 721), V(40, 30, 2), dark, SLATE)
		B.block(CF(210, 15, 721), V(40, 30, 2), dark, SLATE)
		B.block(CF(180, 22, 721), V(20, 16, 2), dark, SLATE)
		B.block(CF(180, 15, 879), V(100, 30, 2), dark, SLATE)
		B.block(CF(131, 15, 800), V(2, 30, 160), dark, SLATE)
		B.block(CF(229, 15, 800), V(2, 30, 160), dark, SLATE)
		B.block(CF(180, 31, 800), V(100, 2, 160), Color3.fromRGB(44, 40, 42), SLATE)
		B.sign(V(166, 0, 712), V(0, 0, -1), "THE DUNGEON", "Abandon hope, bring carrots", dark, Color3.fromRGB(230, 200, 170))
		B.checkpointFlag("dungeon")

		B.lava(CF(180, 0.6, 806), V(96, 0.8, 144))
		B.block(CF(180, 1.5, 728), V(96, 3, 12), stone, SLATE)
		-- 1: stepping blocks (one sinks)
		for i, step in ipairs({ { 742, 4 }, { 754, 6 }, { 766, 8 }, { 778, 6 } }) do
			local b = B.block(CF(150, step[2] - 1, step[1]), V(6, 2, 6), stone, SLATE)
			if i == 2 then
				B.bobber(b, 2.6, 1.3, 0)
			end
		end
		-- 2: sliding platform
		local slide = B.block(CF(180, 6, 790), V(10, 2, 10), P.Wood, Enum.Material.WoodPlanks)
		B.slider(slide, V(24, 0, 0), 0.8, math.pi)
		B.block(CF(214, 3.5, 790), V(12, 7, 12), stone, SLATE)
		B.carrot(V(180, 11, 790))
		-- 3: narrow beam swept by firebars
		B.block(CF(214, 6, 821), V(3, 2, 50), dark, SLATE)
		for _, fz in ipairs({ 808, 834 }) do
			B.cyl(221, 0, fz, 1.5, 7, dark, SLATE)
			B.firebar(V(221, 9.6, fz), 11, fz == 808 and 1.4 or -1.6, fz)
		end
		B.carrot(V(214, 10, 821))
		B.block(CF(214, 4, 852), V(12, 8, 12), stone, SLATE)
		-- 4: sinking platforms
		for i, x in ipairs({ 198, 184, 170, 156 }) do
			local b = B.block(CF(x, 7, 860), V(7, 2, 7), stone, SLATE)
			B.bobber(b, 3.2, 1.2, i * 1.3)
			if i % 2 == 0 then
				B.carrot(V(x, 12, 860))
			end
		end
		B.block(CF(140, 5, 862), V(14, 10, 20), stone, SLATE)
		B.golden("dungeon", V(140, 15, 864))
		B.exitPrompt(V(140, 10.5, 856), "dungeon", "Leave dungeon")
		for _, p in ipairs({ V(133, 10, 760), V(133, 10, 840), V(227, 10, 760), V(227, 10, 840), V(180, 10, 877) }) do
			B.torch(p)
		end
		-- hanging cages
		for _, p in ipairs({ V(165, 18, 800), V(195, 20, 840) }) do
			for _, d in ipairs({ V(-2, 0, -2), V(2, 0, -2), V(-2, 0, 2), V(2, 0, 2) }) do
				B.block(CF(p + d), V(0.3, 6, 0.3), Color3.fromRGB(60, 58, 58), Enum.Material.Metal)
			end
			B.block(CF(p + V(0, 3, 0)), V(4.4, 0.4, 4.4), Color3.fromRGB(60, 58, 58), Enum.Material.Metal)
			B.block(CF(p + V(0, 8, 0)), V(0.2, 10, 0.2), Color3.fromRGB(60, 58, 58), Enum.Material.Metal)
		end
	end

	----------------------------------------------------------------- the throne room (boss arena)
	do
		local A = Castle.ArenaCenter
		-- a ring of lava around the edge (the stone floor sits slightly higher)
		local rim = B.cyl(A.X, A.Y - 3.8, A.Z, 55, 4, P.Lava, Enum.Material.Neon)
		rim.Name = "ArenaRim"
		rim:SetAttribute("Lava", true)
		B.cyl(A.X, A.Y - 4, A.Z, 52, 4.4, stone, SLATE)
		B.cyl(A.X, A.Y, A.Z, 22, 0.42, dark, SLATE)
		for i, r in ipairs({ 46, 34, 20 }) do
			B.cyl(A.X, A.Y - 4 - i * 6, A.Z, r, 6, P.BasaltLight, BASALT, B.decor)
		end
		for i = 0, 3 do
			local a = i / 4 * math.pi * 2 + math.pi / 4
			local px, pz = A.X + math.cos(a) * 34, A.Z + math.sin(a) * 34
			local pillar = B.cyl(px, A.Y, pz, 4.5, 16, stone, SLATE)
			pillar.Name = "ArenaPillar"
			B.torch(V(px, A.Y + 17.2, pz))
		end
		B.golden("boss", A + V(0, 5, 0))
		B.exitPrompt(Config.Checkpoints.throne.pos + V(10, -6, 0), "courtyard", "Return to courtyard")
	end

	----------------------------------------------------------------- scenery
	for _ = 1, 30 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(150, 245)
		local p = V(math.cos(a) * r, 0, 800 + math.sin(a) * r)
		local inDungeon = p.X > 120 and p.X < 240 and p.Z > 710 and p.Z < 890
		local onApproach = math.abs(p.X) < 40 and p.Z < 700
		if not inDungeon and not onApproach and (p.Z < 680 or p.Z > 920 or math.abs(p.X) > 125) then
			B.rock(p.X, 0, p.Z, rng:NextNumber(1.5, 3.5), rng:NextNumber() < 0.5 and P.Basalt or P.BasaltLight)
		end
	end
end

return Castle
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">Meadow</string><ProtectedString name="Source"><![CDATA[--[[
	Carrot Meadow - the hub island, plus the routes out to the other regions:
	a grassy causeway north to Frostbite Peaks, a boardwalk east to Dustbowl
	Canyon and a long stone bridge south to the Infernal Castle.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Bunny64")
local Config = require(Shared:WaitForChild("Config"))

local Meadow = {}

function Meadow.Build(B)
	local P = B.P
	local rng = B.rng
	local V = Vector3.new
	local WATER = Config.WaterLevel

	----------------------------------------------------------------- island
	B.island(0, 0, 230, 0, P.Grass, P.Sand)
	for i = 1, 10 do
		local a = i / 10 * math.pi * 2 + rng:NextNumber(-0.2, 0.2)
		local r = rng:NextNumber(205, 222)
		local rad = rng:NextNumber(26, 40)
		B.cyl(math.cos(a) * r, -30, math.sin(a) * r, rad + 14, 27, P.Sand, Enum.Material.Sand)
		B.mound(math.cos(a) * r, math.sin(a) * r, rad, 0, P.Grass, -30)
	end
	for _ = 1, 9 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(40, 180)
		local x, z = math.cos(a) * r, math.sin(a) * r
		if (V(x, 0, z) - V(-130, 0, -120)).Magnitude > 70 and (V(x, 0, z) - V(140, 0, -90)).Magnitude > 80 and math.abs(x) > 20 then
			B.mound(x, z, rng:NextNumber(14, 24), rng:NextNumber(1.5, 3), P.GrassLight, -2)
		end
	end

	----------------------------------------------------------------- spawn
	local spawnPos = V(0, 0, 60)
	B.cyl(0, -0.5, 60, 7, 0.9, P.Stone, Enum.Material.Slate)
	B.sign(V(12, 0, 40), V(-0.5, 0, 0.85).Unit, "CARROT MEADOW", "North: Peaks / East: Canyon / South: Castle")
	B.carrotRing(spawnPos + V(0, 3, 0), 22, 8)
	B.fence(V(-30, 0, 90), V(-10, 0, 98))
	B.fence(V(-10, 0, 98), V(12, 0, 98))
	B.fence(V(12, 0, 98), V(30, 0, 90))
	B.path(spawnPos, V(-60, 0, -28), 7)
	B.path(spawnPos, V(-105, 0, -95), 7)
	B.path(spawnPos, V(100, 0, 120), 7)
	B.path(spawnPos, V(100, 0, -55), 7)
	B.path(spawnPos, V(-225, 0, 40), 7)
	B.path(spawnPos, V(0, 0, -228), 8)
	B.path(spawnPos, V(228, 0, 0), 8)
	B.path(spawnPos, V(0, 0, 228), 8)
	B.checkpointFlag("meadow")
	B.warpBurrow(Config.Warps[1])
	-- reward goldens appear here once earned
	B.golden("collector", V(-14, 4, 76))
	B.golden("buster", V(14, 4, 76))

	----------------------------------------------------------------- cottage
	do
		local x, z = -60, -40
		local wallTop = 12
		B.block(CFrame.new(x, wallTop / 2, z), V(22, wallTop, 16), P.Plaster)
		for _, dx in ipairs({ -10.6, 10.6 }) do
			for _, dz in ipairs({ -7.6, 7.6 }) do
				B.block(CFrame.new(x + dx, wallTop / 2, z + dz), V(1.2, wallTop, 1.2), P.Wood, Enum.Material.Wood)
			end
		end
		B.block(CFrame.new(x, wallTop - 0.5, z), V(22.4, 1, 16.4), P.Wood, Enum.Material.Wood)
		B.block(CFrame.new(x, 3.5, z + 8.05), V(4, 7, 0.3), P.Wood, Enum.Material.Wood)
		for _, dx in ipairs({ -6, 6 }) do
			B.block(CFrame.new(x + dx, 6.5, z + 8.05), V(3.4, 3, 0.3), Color3.fromRGB(70, 82, 86), Enum.Material.Glass)
		end
		B.wedge(CFrame.new(x, wallTop + 3.5, z - 4.5), V(25, 7, 9), P.Roof, Enum.Material.Slate)
		B.wedge(CFrame.new(x, wallTop + 3.5, z + 4.5) * CFrame.Angles(0, math.pi, 0), V(25, 7, 9), P.Roof, Enum.Material.Slate)
		B.block(CFrame.new(x + 6, wallTop + 7, z - 2), V(2.6, 6, 2.6), P.StoneDark, Enum.Material.Brick)
		B.block(CFrame.new(x - 6, 3, z + 13), V(6, 6, 6), P.WoodLight, Enum.Material.WoodPlanks)
		B.block(CFrame.new(x + 2, 6, z + 13), V(6, 12, 6), P.WoodLight, Enum.Material.WoodPlanks)
		B.carrot(V(x - 6, 9, z + 13))
		B.carrot(V(x + 2, 15, z + 13))
		B.golden("burrow", V(x - 4, wallTop + 11, z))
		B.carrotLine(V(x - 15, 3, z + 22), V(x + 15, 3, z + 22), 4)
		for i = 0, 4 do
			B.block(CFrame.new(x - 18, 0.4, z - 6 + i * 4), V(6, 0.8, 2.4), P.DirtDark)
			B.blob(V(x - 18, 1.2, z - 6 + i * 4), V(1.4, 1, 1.4), P.CarrotLeaf)
		end
	end

	----------------------------------------------------------------- lookout tower
	do
		local cx, cz = -130, -120
		B.terrace(cx, cz, { { 50, 7 }, { 38, 14, P.GrassLight }, { 28, 21 } })
		B.cyl(cx, 21, cz, 10, 82, P.Stone, Enum.Material.Slate)
		for y = 35, 95, 15 do
			B.cyl(cx, y, cz, 10.7, 1.4, P.StoneDark, Enum.Material.Slate)
		end
		B.cyl(cx, 103, cz, 14, 3, P.StoneDark, Enum.Material.Slate)
		for i = 0, 11 do
			local a = i / 12 * math.pi * 2
			B.block(CFrame.new(cx + math.cos(a) * 13, 107.5, cz + math.sin(a) * 13) * CFrame.Angles(0, -a, 0), V(2.5, 3, 2.5), P.Stone, Enum.Material.Slate)
		end
		B.block(CFrame.new(cx + 4, 112, cz), V(0.6, 12, 0.6), P.Wood, Enum.Material.Wood)
		B.block(CFrame.new(cx + 6.5, 116, cz), V(4.5, 3, 0.2), P.Roof, Enum.Material.Fabric)
		B.golden("tower", V(cx - 3, 111, cz))
		for i = 0, 12 do
			local a = i * 0.62 + 0.3
			local x, z = cx + math.cos(a) * 18, cz + math.sin(a) * 18
			local top = 27 + i * 6.5
			local step = B.cyl(x, top - 2, z, 5, 2, i % 2 == 0 and P.WoodLight or P.Stone, i % 2 == 0 and Enum.Material.WoodPlanks or Enum.Material.Slate)
			if i == 4 or i == 9 then
				B.bobber(step, 2.5, 1.4, i)
			end
			if i % 2 == 0 then
				B.carrot(V(x, top + 3.5, z))
			end
		end
	end

	----------------------------------------------------------------- the old oak
	do
		local cx, cz = 110, 140
		local canopyTop = 93
		B.cyl(cx, -1, cz, 8, canopyTop - 2, P.Wood, Enum.Material.Wood)
		for i = 0, 3 do
			local a = i / 4 * math.pi * 2 + 0.4
			B.block(CFrame.new(cx + math.cos(a) * 9, 1.5, cz + math.sin(a) * 9) * CFrame.Angles(0, -a, 0.5), V(8, 3, 3), P.Wood, Enum.Material.Wood)
		end
		B.cyl(cx, canopyTop - 3, cz, 16, 3, P.LeafDark, Enum.Material.Grass)
		for i = 0, 7 do
			local a = i / 8 * math.pi * 2
			B.blob(V(cx + math.cos(a) * 15, canopyTop + 1, cz + math.sin(a) * 15), V(12, 7, 12), i % 2 == 0 and P.Leaf or P.LeafDark)
			B.blob(V(cx + math.cos(a) * 12, canopyTop - 5, cz + math.sin(a) * 12), V(14, 8, 14), i % 2 == 0 and P.LeafDark or P.Leaf)
		end
		B.golden("oak", V(cx, canopyTop + 5, cz))
		for i = 0, 10 do
			local a = i * 0.6
			local top = 7 + i * 7.5
			local x, z = cx + math.cos(a) * 20, cz + math.sin(a) * 20
			B.cyl(x, top - 1.5, z, 5, 1.5, P.Leaf, Enum.Material.Grass)
			B.make("Part", {
				Shape = Enum.PartType.Cylinder,
				Size = V(14, 1.6, 1.6),
				CFrame = CFrame.new(cx + math.cos(a) * 12, top - 2, cz + math.sin(a) * 12) * CFrame.Angles(0, -a, 0),
				Color = P.Wood,
				Material = Enum.Material.Wood,
			})
			if i % 2 == 1 then
				B.carrot(V(x, top + 3.5, z))
			end
		end
	end

	----------------------------------------------------------------- big hill & cloud garden
	do
		local hx, hz = 140, -90
		B.terrace(hx, hz, { { 60, 7 }, { 45, 14, P.GrassLight }, { 32, 21 }, { 20, 28, P.GrassLight } })
		for i, r in ipairs({ 54, 41, 27 }) do
			B.carrot(V(hx - r, 7 * i + 3, hz + 8))
			B.carrot(V(hx - r + 2, 7 * i + 3, hz - 8))
		end
		B.cyl(hx, 28, hz, 2.6, 4, P.MushroomStem)
		local cap = B.blob(V(hx, 32.5, hz), V(13, 5, 13), P.Mushroom, nil, B.solid, true)
		cap:SetAttribute("Bounce", Config.MushroomBounce)
		cap.Name = "BounceMushroom"
		for i = 0, 5 do
			local a = i / 6 * math.pi * 2
			B.blob(V(hx + math.cos(a) * 3.8, 34.4, hz + math.sin(a) * 3.8), V(1.8, 0.6, 1.8), P.MushroomStem)
		end

		local function skyIsland(x, top, z, r)
			B.cyl(x, top - 3, z, r, 3, P.Dirt)
			B.cyl(x, top - 1, z, r + 0.4, 1, P.Grass)
			B.cyl(x, top - 6, z, r * 0.75, 3, P.DirtDark, nil, B.decor)
			B.cyl(x, top - 9, z, r * 0.45, 3, P.DirtDark, nil, B.decor)
			B.cyl(x, top - 11, z, r * 0.2, 2, P.DirtDark, nil, B.decor)
		end
		skyIsland(125, 95, -62, 12)
		B.carrot(V(125, 98.5, -62))
		local slider = B.block(CFrame.new(86, 96, -40), V(14, 2, 14), P.WoodLight, Enum.Material.WoodPlanks)
		B.slider(slider, V(14, 0, 0), 0.7, 0)
		skyIsland(45, 99, -25, 11)
		B.carrot(V(45, 102.5, -25))
		local disc = B.cyl(15, 99, 0, 13, 2, P.Plaster)
		for i = 0, 3 do
			local stripe = B.make("Part", {
				Size = V(26.2, 2.1, 2.4),
				CFrame = CFrame.new(15, 100, 0) * CFrame.Angles(0, i * math.pi / 4, 0),
				Color = P.Roof,
				Anchored = false,
				Massless = true,
			})
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = disc
			weld.Part1 = stripe
			weld.Parent = stripe
		end
		B.spinner(disc, 0.6)
		B.carrot(V(15, 104.5, 0))
		skyIsland(-15, 104, 25, 15)
		B.golden("sky", V(-15, 109, 25))
		for i = 0, 5 do
			local a = i * 1.1
			B.flower(-15 + math.cos(a) * 9, 104, 25 + math.sin(a) * 9)
		end
	end

	----------------------------------------------------------------- lonely islet (west)
	do
		local ix, iz = -330, 40
		B.island(ix, iz, 32, 2, P.Grass, P.Sand)
		for i = 0, 3 do
			local a = i / 4 * math.pi * 2 + math.pi / 4
			B.cyl(ix + math.cos(a) * 9, 2, iz + math.sin(a) * 9, 1.4, 11, P.Plaster)
		end
		B.block(CFrame.new(ix, 13.5, iz), V(18, 1.5, 18), P.Roof, Enum.Material.Slate)
		B.cyl(ix, 2, iz, 3, 3, P.Stone, Enum.Material.Slate)
		B.golden("islet", V(ix, 8.5, iz))
		B.pineTree(ix + 18, 2, iz - 14, 1)
		B.pineTree(ix - 16, 2, iz + 17, 0.9)
		B.carrot(V(ix + 14, 5, iz + 12))
		B.carrot(V(ix - 14, 5, iz - 10))
		B.bug(V(ix + 16, 2, iz + 2), "meadow")
		local xs = { -253, -265, -277, -289 }
		for i, x in ipairs(xs) do
			local z = iz + math.sin(i * 1.7) * 5
			local stone = B.cyl(x, WATER - 6, z, 4, 9, P.Stone, Enum.Material.Slate)
			if i == 2 or i == 4 then
				local base = stone.CFrame
				B.mover(stone, function(t)
					return base + V(0, math.sin(t * 1.1 + i) * 4 - 1.5, 0)
				end)
			elseif i == 3 then
				B.slider(stone, V(0, 0, 10), 0.9, 0)
			end
			B.carrot(V(x, 1, z))
		end
	end

	----------------------------------------------------------------- north causeway to the peaks
	do
		B.block(CFrame.new(0, -15.5, -372), V(44, 30, 300), P.Dirt)
		B.block(CFrame.new(0, -0.5, -372), V(45, 1, 300), P.Grass)
		B.block(CFrame.new(0, -18, -372), V(70, 30, 304), P.Sand, Enum.Material.Sand)
		B.path(V(0, 0, -228), V(0, 0, -515), 8)
		for i = 0, 7 do
			local z = -250 - i * 36
			local side = (i % 2 == 0) and -1 or 1
			B.pineTree(side * 16, 0, z, 0.9 + (i % 3) * 0.15)
			B.rock(-side * 17, 0, z + 14, 1.2)
		end
		B.carrotLine(V(0, 3, -250), V(0, 3, -490), 9)
		B.bug(V(8, 0, -330), "meadow")
		B.bug(V(-8, 0, -430), "peaks")
		B.sign(V(14, 0, -240), V(0, 0, 1), "FROSTBITE PEAKS", "Mind the slippery ice")
	end

	----------------------------------------------------------------- east boardwalk to the canyon
	do
		local y = 2
		B.ramp(V(222, 0, 0), V(234, y, 0), 14, P.WoodLight, Enum.Material.WoodPlanks)
		for x = 234, 506, 16 do
			B.block(CFrame.new(x + 8, y - 0.5, 0), V(16, 1, 14), P.WoodLight, Enum.Material.WoodPlanks)
			for _, s in ipairs({ -1, 1 }) do
				B.block(CFrame.new(x, y - 8, s * 6.5), V(1.2, 16, 1.2), P.Wood, Enum.Material.Wood)
				B.block(CFrame.new(x, y + 1.5, s * 6.8), V(0.6, 3, 0.6), P.Wood, Enum.Material.Wood)
			end
		end
		for _, s in ipairs({ -1, 1 }) do
			B.make("Part", {
				Size = V(274, 0.4, 0.4),
				CFrame = CFrame.new(370, y + 2.8, s * 6.8),
				Color = P.Wood,
				Material = Enum.Material.Wood,
			})
		end
		B.ramp(V(522, 0, 0), V(510, y, 0), 14, P.WoodLight, Enum.Material.WoodPlanks)
		B.carrotLine(V(260, y + 3, 0), V(490, y + 3, 0), 8)
		B.sign(V(214, 0, 14), V(-1, 0, 0), "DUSTBOWL CANYON", "Roll + jump = long jump!")
	end

	----------------------------------------------------------------- south bridge to the castle
	do
		local y = 3
		B.ramp(V(0, 0, 222), V(0, y, 236), 24, P.CastleStone, Enum.Material.Slate)
		B.block(CFrame.new(0, y - 1, 388), V(24, 2, 304), P.CastleStone, Enum.Material.Slate)
		for _, s in ipairs({ -1, 1 }) do
			B.block(CFrame.new(s * 12.5, y + 1.3, 388), V(1.2, 2.6, 304), P.CastleDark, Enum.Material.Slate)
		end
		for z = 260, 520, 40 do
			B.block(CFrame.new(0, y - 14, z), V(20, 24, 6), P.CastleDark, Enum.Material.Slate)
		end
		B.ramp(V(0, 0, 552), V(0, y, 540), 24, P.CastleStone, Enum.Material.Slate)
		-- the castle gate arch
		for _, s in ipairs({ -1, 1 }) do
			B.block(CFrame.new(s * 19, y + 14, 532), V(12, 30, 8), P.CastleDark, Enum.Material.Slate)
		end
		B.block(CFrame.new(0, y + 31, 532), V(52, 6, 8), P.CastleDark, Enum.Material.Slate)
		-- a magic barrier spanning the whole approach, so nobody can hop around it
		B.gate(CFrame.new(0, y + 18, 532), V(140, 40, 1.5), Config.CastleGate)
		B.carrotLine(V(0, y + 3, 260), V(0, y + 3, 500), 7)
		B.sign(V(16, 0, 214), V(0, 0, -1), "INFERNAL CASTLE", "10 golden carrots open the gate")
	end

	----------------------------------------------------------------- bug homes
	for _, h in ipairs({
		V(40, 0, 25), V(-40, 0, 10), V(60, 0, -30), V(-20, 0, 120), V(70, 0, 80), V(-100, 0, -30),
		V(-150, 7, -70), V(185, 7, -70), V(45, 0, 160), V(-70, 0, 130), V(120, 0, 30), V(-180, 0, 60),
	}) do
		B.bug(h, "meadow")
	end

	----------------------------------------------------------------- scatter scenery
	local avoid = {
		{ V(0, 0, 60), 30 }, { V(-60, 0, -40), 26 }, { V(-130, 0, -120), 56 }, { V(110, 0, 140), 28 },
		{ V(140, 0, -90), 64 }, { V(12, 0, 40), 8 }, { V(-24, 0, 44), 10 },
	}
	local function ok(p, extra)
		if p.Magnitude > 205 then
			return false
		end
		-- keep the three exit corridors clear
		if math.abs(p.X) < 18 + extra and math.abs(p.Z) > 70 then
			return false
		end
		if math.abs(p.Z) < 18 + extra and p.X > 60 then
			return false
		end
		for _, a in ipairs(avoid) do
			if (p - a[1]).Magnitude < a[2] + extra then
				return false
			end
		end
		return true
	end
	local function scatter(count, tries, minR, maxR, extra, place, spacing)
		local placed = 0
		for _ = 1, tries do
			if placed >= count then
				break
			end
			local a = rng:NextNumber(0, math.pi * 2)
			local r = rng:NextNumber(minR, maxR)
			local p = V(math.cos(a) * r, 0, math.sin(a) * r)
			if ok(p, extra) then
				place(p)
				if spacing then
					table.insert(avoid, { p, spacing })
				end
				placed += 1
			end
		end
	end
	scatter(70, 600, 35, 205, 6, function(p)
		local s = rng:NextNumber(0.8, 1.4)
		if rng:NextNumber() < 0.45 then
			B.pineTree(p.X, 0, p.Z, s)
		else
			B.roundTree(p.X, 0, p.Z, s)
		end
	end, 8)
	scatter(30, 300, 30, 205, 2, function(p)
		B.rock(p.X, 0, p.Z, rng:NextNumber(0.8, 2.2))
	end, 5)
	scatter(24, 600, 35, 190, 3, function(p)
		B.carrot(p + V(0, 3, 0))
	end, 10)
	scatter(200, 400, 10, 210, 0, function(p)
		B.flower(p.X, 0, p.Z)
	end, nil)
end

return Meadow
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">Peaks</string><ProtectedString name="Source"><![CDATA[--[[
	Frostbite Peaks - a snowy island north of the meadow.
	  * A terraced mountain with winding ramps up to the summit
	  * A long ice slide chute spiralling down the outside of the mountain
	  * A giant snowman wearing a very tall hat
	  * A freezing pond with drifting ice floes
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Bunny64")
local Config = require(Shared:WaitForChild("Config"))

local Peaks = {}

function Peaks.Build(B)
	local P = B.P
	local rng = B.rng
	local V = Vector3.new
	local cx, cz = 0, -720
	local C = V(cx, 0, cz)
	local SNOW = Enum.Material.Snow

	B.island(cx, cz, 230, 0, P.Snow, P.SnowShade, SNOW, P.Rock)

	----------------------------------------------------------------- mountain
	local tiers = {
		{ r = 150, top = 6 }, { r = 130, top = 24 }, { r = 104, top = 42 }, { r = 80, top = 60 },
		{ r = 58, top = 78 }, { r = 38, top = 96 }, { r = 20, top = 114 },
	}
	for _, t in ipairs(tiers) do
		B.mound(cx, cz, t.r, t.top, P.Snow, 0, P.Rock, SNOW, Enum.Material.Slate)
	end
	for i = 1, #tiers - 1 do
		local r1 = tiers[i + 1].r
		local top0, top1 = tiers[i].top, tiers[i + 1].top
		local a = 0.6 + i * 2.0
		local rho = r1 + 7
		local tangent = V(-math.sin(a), 0, math.cos(a))
		local mid = C + V(math.cos(a) * rho, 0, math.sin(a) * rho)
		local low = mid - tangent * 22 + V(0, top0, 0)
		local high = mid + tangent * 22 + V(0, top1, 0)
		B.ramp(low, high, 10, P.SnowShade, SNOW)
		-- landing pad joining the top of the ramp to the tier above
		local flat = V(high.X, 0, high.Z) - C
		local dir = flat.Unit
		local inner, outer = r1 - 4, flat.Magnitude + 5
		local center = C + dir * ((inner + outer) / 2) + V(0, top1 - 1, 0)
		B.block(CFrame.lookAt(center, center + dir), V(12, 2, outer - inner), P.Snow, SNOW)
		B.carrot((low + high) / 2 + V(0, 3, 0))
	end
	B.golden("summit", V(cx, 119, cz))
	B.pineTree(cx + 10, 114, cz + 6, 0.6, P.Pine, true)

	----------------------------------------------------------------- the slide chute
	do
		local N = 36
		local function point(s)
			local th = math.pi + 1.6 * math.pi * s
			local R = 45 + 130 * s
			return V(cx + math.cos(th) * R, 96 - 74 * s, cz + math.sin(th) * R)
		end
		local up = V(0, 1, 0)
		for k = 0, N - 1 do
			local a, b = point(k / N), point((k + 1) / N)
			local dir = (b - a).Unit
			local floor = B.plank(a, b + dir * 0.8, 13, 1.5, P.Ice, Enum.Material.Ice)
			floor:SetAttribute("Slide", true)
			floor.Name = "Chute"
			local right = dir:Cross(up).Unit
			for _, s in ipairs({ -1, 1 }) do
				local off = right * s * 6.8 + up * 1.6
				B.plank(a + off, b + dir * 0.8 + off, 0.8, 3.2, P.Snow, SNOW)
			end
			if k % 4 == 0 then
				local support = B.cyl(a.X, 0, a.Z, 1.4, a.Y - 1.5, P.Rock, nil, B.decor)
				support.CanCollide = false
			end
			if k % 6 == 3 then
				B.carrot(a + V(0, 3, 0))
			end
		end
		-- entrance from the second-highest tier
		B.block(CFrame.new(cx - 40, 95, cz), V(22, 2, 16), P.Snow, SNOW)
		B.sign(V(cx - 34, 96, cz + 9), V(1, 0, 0), "ICE CHUTE", "Slide down, steer with the stick")
		-- landing pillar at the bottom
		local th = math.pi + 1.6 * math.pi
		local ex, ez = cx + math.cos(th) * 188, cz + math.sin(th) * 188
		B.cyl(ex, 0, ez, 12, 22, P.Rock, Enum.Material.Slate)
		B.cyl(ex, 21, ez, 12.4, 1, P.Snow, SNOW)
		B.golden("chute", V(ex, 27, ez))
	end

	----------------------------------------------------------------- giant snowman
	do
		local a = 1.0
		local sx, sz = cx + math.cos(a) * 180, cz + math.sin(a) * 180
		local snowBall = function(y, r)
			return B.ball(V(sx, y, sz), r, P.Snow, SNOW)
		end
		snowBall(13, 14)
		snowBall(34, 10)
		snowBall(49, 7)
		local face = V(cx, 0, cz) - V(sx, 0, sz)
		face = face.Unit
		local right = face:Cross(V(0, 1, 0))
		for _, s in ipairs({ -1, 1 }) do
			B.blob(V(sx, 51, sz) + face * 6.4 + right * s * 2.2, V(1.3, 1.3, 1.3), P.Ink)
		end
		local nose = CFrame.lookAt(V(sx, 49, sz) + face * 7.5, V(sx, 49, sz) + face * 20)
		B.make("Part", {
			Shape = Enum.PartType.Cylinder,
			Size = V(5, 1.4, 1.4),
			CFrame = nose * CFrame.new(0, 0, -2) * CFrame.Angles(0, math.pi / 2, 0),
			Color = P.Carrot,
			CanCollide = false,
		}, B.decor)
		for i = 0, 3 do
			B.blob(V(sx, 34 - i * 4 + 6, sz) + face * (9.6 - math.abs(i - 1.5) * 0.4), V(1.2, 1.2, 1.2), P.Ink)
		end
		B.cyl(sx, 54.5, sz, 9, 1.2, Color3.fromRGB(40, 36, 40))
		B.cyl(sx, 55.7, sz, 5.5, 8, Color3.fromRGB(40, 36, 40))
		B.cyl(sx, 56.2, sz, 5.6, 1.4, P.Roof, Enum.Material.Fabric)
		B.golden("snowman", V(sx, 68, sz))
		for i = 0, 9 do
			local pa = a + math.pi + i * 0.5
			local px, pz = sx + math.cos(pa) * 22, sz + math.sin(pa) * 22
			local top = 8 + i * 6
			B.cyl(px, 0, pz, 3, top, P.Ice, Enum.Material.Ice)
			if i % 2 == 1 then
				B.carrot(V(px, top + 3.5, pz))
			end
		end
	end

	----------------------------------------------------------------- frozen pond with drifting floes
	do
		local px, pz = cx + 190, cz
		local center = V(px, 0, pz)
		B.cyl(px, -0.4, pz, 39, 0.8, P.Ice, Enum.Material.Ice)
		local pond = B.cyl(px, -0.5, pz, 36, 1.05, Color3.fromRGB(70, 110, 124), Enum.Material.Glass)
		pond.Transparency = 0.1
		pond.Name = "FreezingWater"
		pond:SetAttribute("Water", true)
		for i = 0, 2 do
			local floe = B.cyl(px + 26, 0.3, pz, 4.5, 1.6, P.Ice, Enum.Material.Ice)
			B.orbiter(floe, center, 26, 0.3, i * math.pi * 2 / 3)
		end
		for i = 0, 1 do
			local floe = B.cyl(px + 13, 0.3, pz, 4, 1.6, P.Ice, Enum.Material.Ice)
			B.orbiter(floe, center, 13, -0.45, i * math.pi)
		end
		B.cyl(px, 0, pz, 5, 2.5, P.Snow, SNOW)
		B.golden("floes", V(px, 7, pz))
		B.carrotRing(V(px, 3.5, pz), 42, 6)
		B.sign(V(px - 46, 0, pz - 10), V(-1, 0, 0), "FROZEN POND", "Brrr! Don't fall in")
	end

	----------------------------------------------------------------- arrival, warp and checkpoint
	B.checkpointFlag("peaks")
	B.warpBurrow(Config.Warps[2])
	B.carrotLine(V(-20, 3, -540), V(20, 3, -540), 5)

	----------------------------------------------------------------- scenery & bugs
	local function clear(p)
		local rel = p - C
		local r = rel.Magnitude
		if r < 156 or r > 222 then
			return false
		end
		local ang = math.atan2(rel.Z, rel.X)
		local function near(a, width)
			local d = math.abs(((ang - a + math.pi) % (2 * math.pi)) - math.pi)
			return d < width
		end
		if near(0, 0.3) or near(1.0, 0.25) or near(0.6 * math.pi, 0.15) or near(math.pi / 2, 0.15) then
			return false
		end
		return true
	end
	local placed = 0
	for _ = 1, 500 do
		if placed >= 40 then
			break
		end
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(158, 222)
		local p = C + V(math.cos(a) * r, 0, math.sin(a) * r)
		if clear(p) then
			B.pineTree(p.X, 0, p.Z, rng:NextNumber(0.8, 1.3), P.Pine, true)
			placed += 1
		end
	end
	for i = 0, 11 do
		local a = i / 12 * math.pi * 2 + 0.2
		local p = C + V(math.cos(a) * 170, 0, math.sin(a) * 170)
		if clear(p) then
			B.blob(CFrame.new(p + V(0, 3, 0)) * CFrame.Angles(0.2, a, 0.3), V(2.5, 8, 2.5), P.Ice, Enum.Material.Ice, B.solid, true)
		end
	end
	for _, b in ipairs({ { 0.3, 175 }, { 2.2, 180 }, { 3.6, 190 }, { 4.5, 175 }, { 5.6, 185 } }) do
		B.bug(C + V(math.cos(b[1]) * b[2], 0, math.sin(b[1]) * b[2]), "peaks")
	end
	B.bug(C + V(math.cos(3.0) * 140, 24, math.sin(3.0) * 140), "peaks")
	B.bug(C + V(math.cos(5.0) * 92, 42, math.sin(5.0) * 92), "peaks")
end

return Peaks
]]></ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">WorldBuilder</string><ProtectedString name="Source"><![CDATA[--[[
	WorldBuilder - builds the whole world at server start.

	  Carrot Meadow (hub)      centre            World/Meadow
	  Frostbite Peaks          north (z -720)    World/Peaks
	  Dustbowl Canyon          east  (x 720)     World/Canyon
	  Infernal Castle          south (z 800)     World/Castle
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Bunny64")
local Config = require(Shared:WaitForChild("Config"))

local folder = script.Parent:WaitForChild("World")
local B = require(folder:WaitForChild("Builder"))
local Meadow = require(folder:WaitForChild("Meadow"))
local Peaks = require(folder:WaitForChild("Peaks"))
local Canyon = require(folder:WaitForChild("Canyon"))
local Castle = require(folder:WaitForChild("Castle"))

local WorldBuilder = {}
WorldBuilder.Castle = Castle

local function setupLighting()
	local Lighting = game:GetService("Lighting")
	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA("Atmosphere") or child:IsA("Sky") or child:IsA("PostEffect") then
			child:Destroy()
		end
	end
	Lighting.ClockTime = 16.3
	Lighting.GeographicLatitude = 35
	Lighting.Brightness = 2.2
	Lighting.Ambient = Color3.fromRGB(96, 90, 84)
	Lighting.OutdoorAmbient = Color3.fromRGB(132, 124, 112)
	Lighting.ColorShift_Top = Color3.fromRGB(255, 232, 196)
	Lighting.ColorShift_Bottom = Color3.fromRGB(0, 0, 0)
	Lighting.EnvironmentDiffuseScale = 0.2
	Lighting.EnvironmentSpecularScale = 0
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.6
	Lighting.FogColor = Color3.fromRGB(176, 182, 172)
	Lighting.FogStart = 160
	Lighting.FogEnd = 900

	local sky = Instance.new("Sky")
	sky.CelestialBodiesShown = true
	sky.SunAngularSize = 14
	sky.StarCount = 0
	sky.Parent = Lighting

	-- Named so the client can retint them per region
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "Bunny64Grade"
	cc.Saturation = -0.18
	cc.Contrast = 0.06
	cc.Brightness = -0.02
	cc.TintColor = Color3.fromRGB(255, 244, 228)
	cc.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Name = "Bunny64Bloom"
	bloom.Intensity = 0.2
	bloom.Size = 22
	bloom.Threshold = 1.4
	bloom.Parent = Lighting
end

local function buildSea()
	local P = Config.Palette
	for _, off in ipairs({ Vector3.new(-1000, 0, -1000), Vector3.new(1000, 0, -1000), Vector3.new(-1000, 0, 1000), Vector3.new(1000, 0, 1000) }) do
		B.make("Part", {
			Name = "Water",
			Size = Vector3.new(2000, 1, 2000),
			CFrame = CFrame.new(off.X, Config.WaterLevel - 0.5, off.Z),
			Color = P.Water,
			Material = Enum.Material.Glass,
			Transparency = 0.15,
			Reflectance = 0.05,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CastShadow = false,
		}, B.decor)
		B.block(CFrame.new(off.X, Config.WaterLevel - 40, off.Z), Vector3.new(2000, 2, 2000), Color3.fromRGB(40, 66, 70), nil, B.decor)
	end
end

function WorldBuilder.Build()
	local old = workspace:FindFirstChild("Baseplate")
	if old then
		old:Destroy()
	end
	workspace.Gravity = Config.Gravity

	local root = Instance.new("Folder")
	root.Name = "Bunny64World"
	B.Init(root)

	setupLighting()
	buildSea()
	Meadow.Build(B)
	Peaks.Build(B)
	Canyon.Build(B)
	Castle.Build(B)

	root.Parent = workspace
	B.Finish()

	local info = B.info
	info.arenaCenter = Castle.ArenaCenter
	info.arenaRadius = Castle.ArenaRadius
	return info
end

return WorldBuilder
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX00000023"><Properties><string name="Name">StarterPlayer</string><bool name="LoadCharacterAppearance">false</bool><bool name="EnableMouseLockOption">false</bool></Properties><Item class="StarterPlayerScripts" referent="RBX0000001F"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX0000001E"><Properties><string name="Name">Bunny64Client</string><ProtectedString name="Source"><![CDATA[--[[
	Bunny 64 - client entry point. Wires together menus, HUD, movement,
	animation, collectibles and world effects, and reacts to server events.
]]

local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Bunny64")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = Shared:WaitForChild("Remotes")

local Effects = require(script:WaitForChild("Effects"))
local Hud = require(script:WaitForChild("Hud"))
local Menus = require(script:WaitForChild("Menus"))
local Movement = require(script:WaitForChild("Movement"))
local Animator = require(script:WaitForChild("Animator"))
local Collectibles = require(script:WaitForChild("Collectibles"))
local WorldFX = require(script:WaitForChild("WorldFX"))

local player = Players.LocalPlayer

task.spawn(function()
	for _ = 1, 10 do
		local ok = pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
		end)
		if ok then
			break
		end
		task.wait(0.5)
	end
end)

player.CameraMaxZoomDistance = 70
player.CameraMinZoomDistance = 12
workspace.CurrentCamera.FieldOfView = 65

local remotes = {}
for _, name in ipairs({
	"GetProfile", "SelectSlot", "EraseSlot", "Customise", "QuitToTitle", "SetOptions", "Collect",
	"Update", "Pound", "Bounce", "Effect", "SetMove", "WarpMenu", "Warp",
}) do
	remotes[name] = Remotes:WaitForChild(name)
end

local goldenNames, checkpointNames, warpNames = {}, {}, {}
for _, g in ipairs(Config.Goldens) do
	goldenNames[g.id] = g.name
end
for id, c in pairs(Config.Checkpoints) do
	checkpointNames[id] = c.name
end
for _, w in ipairs(Config.Warps) do
	warpNames[w.id] = w.name
end

local snap = nil
local GOLD = Config.Palette.Gold

local function applySnapshot(s)
	snap = s
	Menus.SetSnapshot(s)
	Effects.SetOptions(s.menu.options)
	Collectibles.Sync(s.slot)
	if s.slot then
		Hud.SetProgress(s.slot, s.canSave)
		WorldFX.SetGoldenCount(s.slot.goldenCount)
	else
		WorldFX.SetGoldenCount(0)
	end
end

local function handleEvent(s, event)
	if not event or not s.slot then
		return
	end
	local kind = event.kind
	if kind == "carrot" then
		if event.heal then
			Hud.Toast("+1 HEART", 1.5, Color3.fromRGB(240, 140, 140))
		end
	elseif kind == "unlock" then
		Effects.Jingle()
		local what = event.id == "collector" and (Config.CollectorGoal .. " CARROTS!") or (Config.BugBusterGoal .. " BUGS BOPPED!")
		Hud.Toast(what .. "\nA GOLDEN CARROT APPEARED AT THE MEADOW SPAWN", 4, GOLD)
	elseif kind == "golden" then
		Effects.Jingle()
		Effects.Shake(0.5, 0.3)
		local text = string.upper(goldenNames[event.id] or "GOLDEN CARROT") .. string.format("\nGOLDEN CARROT %d / %d", s.slot.goldenCount, #Config.Goldens)
		if event.unlocked then
			text ..= "\nNEW LOOK UNLOCKED: " .. event.unlocked
		end
		Hud.Toast(text, 4, GOLD)
		if s.slot.goldenCount == Config.CastleGate then
			task.delay(4.2, function()
				Hud.Toast("THE CASTLE GATE HAS OPENED...", 3.5, Color3.fromRGB(240, 150, 110))
			end)
		end
	elseif kind == "complete" then
		Effects.Jingle()
		task.delay(0.6, Effects.Jingle)
		Hud.Toast("YOU FOUND THEM ALL!", 3, GOLD)
		task.delay(2.5, function()
			Menus.ShowEnding(snap)
		end)
	elseif kind == "bop" then
		Hud.Toast("BOP!", 0.7)
	elseif kind == "checkpoint" then
		Hud.Toast("CHECKPOINT: " .. string.upper(checkpointNames[event.id] or ""), 2)
	elseif kind == "warpfound" then
		Effects.Play("MenuSelect", 1.4)
		Hud.Toast("BURROW WARP FOUND:\n" .. (warpNames[event.id] or ""), 2.5, GOLD)
	elseif kind == "bossdown" then
		Effects.Jingle()
		task.delay(0.5, Effects.Jingle)
		Hud.Toast("KING GRUMBLE IS DEFEATED!\nTHE CROWN IS YOURS...", 5, GOLD)
	end
end

remotes.Update.OnClientEvent:Connect(function(s)
	applySnapshot(s)
	handleEvent(s, s.event)
end)

remotes.WarpMenu.OnClientEvent:Connect(function(list)
	Menus.ShowWarp(list)
end)

remotes.Effect.OnClientEvent:Connect(function(kind, pos, extra)
	local P = Config.Palette
	if kind == "poof" then
		Effects.Burst(pos, Color3.fromRGB(226, 218, 200), 12, 7, 0.8, 5)
	elseif kind == "pound" then
		Effects.Ring(pos, P.Path, 13)
	elseif kind == "splash" then
		Effects.Burst(pos, Color3.fromRGB(150, 182, 186), 16, 6, 0.7, 9)
		Effects.Play("Splash")
	elseif kind == "burn" then
		Effects.Burst(pos, P.Ember, 14, 5, 0.7, 10, Enum.Material.Neon)
	elseif kind == "fire" then
		Effects.Burst(pos, P.Ember, 6, 3, 0.6, 2, Enum.Material.Neon)
	elseif kind == "shockwave" then
		Effects.Shockwave(pos, extra or 44, 64)
		Effects.Shake(1, 0.4)
		Effects.Play("Land", 0.5)
	elseif kind == "bossroar" then
		Effects.Play("Boss", 0.6)
		Effects.Shake(1.5, 1.5)
	elseif kind == "bosscharge" then
		Effects.Play("Roll", 0.5)
	elseif kind == "bossbonk" then
		Effects.Play("Land", 0.4)
		Effects.Shake(1.4, 0.5)
		Effects.Burst(pos, Color3.fromRGB(255, 236, 160), 10, 6, 0.8, 6, Enum.Material.Neon)
		Hud.Toast("HE'S DIZZY! JUMP ON A GLOWING SPOT!", 2.5, GOLD)
	elseif kind == "bosshit" then
		Effects.Play("Stomp", 0.7)
		Effects.Shake(1.2, 0.4)
		Effects.Burst(pos, Color3.fromRGB(240, 170, 70), 24, 12, 1, 10, Enum.Material.Neon)
	elseif kind == "bossdie" then
		Effects.Play("Boss", 0.4)
		Effects.Shake(2, 2.4)
	elseif kind == "warp" then
		Effects.Play("Boing", 1.2)
		Effects.Burst(pos, Config.Palette.Dirt, 14, 6, 0.7, 6)
	elseif kind == "locked" then
		Hud.Toast(string.format("YOU NEED %d GOLDEN CARROTS\nTO FACE THE KING", pos), 3, Color3.fromRGB(240, 150, 110))
	end
end)

-- Hearts follow the humanoid
local function watchHealth(character)
	local humanoid = character:WaitForChild("Humanoid")
	local last = humanoid.Health
	Hud.SetHearts(humanoid.Health, humanoid.MaxHealth)
	humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(function()
		Hud.SetHearts(humanoid.Health, humanoid.MaxHealth)
	end)
	humanoid.HealthChanged:Connect(function(h)
		Hud.SetHearts(h, humanoid.MaxHealth)
		if h <= 0 and last > 0 then
			Hud.Toast("OUCH! BACK TO THE LAST CHECKPOINT...", 3)
		end
		last = h
	end)
end
if player.Character then
	task.spawn(watchHealth, player.Character)
end
player.CharacterAdded:Connect(watchHealth)

-- Start everything -----------------------------------------------------------------
Hud.Init(function()
	Menus.TogglePause()
end)
Movement.Init(Effects, remotes)
task.spawn(Collectibles.Init, Effects, remotes)
task.spawn(Animator.Init, Movement)
task.spawn(WorldFX.Init, Effects, Hud)
Hud.WatchBoss(WorldFX.InArena)

Menus.Init({
	Effects = Effects,
	Remotes = remotes,
	Movement = Movement,
	Hud = Hud,
	WorldFX = WorldFX,
	onPlay = function()
		WorldFX.ResetRegion()
		Hud.SetVisible(true)
		if snap and snap.slot then
			Hud.SetProgress(snap.slot, snap.canSave)
			if snap.slot.goldenCount == 0 and snap.slot.carrotCount == 0 then
				task.delay(1, function()
					Hud.Toast("FIND THE GOLDEN CARROTS!\nSHIFT: ROLL   C: SLIDE / POUND   M: MENU", 5, GOLD)
				end)
			end
		end
	end,
	onQuit = function()
		remotes.QuitToTitle:FireServer()
		Menus.BackToTitle()
	end,
})
Effects.SetMusic("title")

task.spawn(function()
	local s = nil
	for _ = 1, 5 do
		local ok, result = pcall(function()
			return remotes.GetProfile:InvokeServer()
		end)
		if ok and result then
			s = result
			break
		end
		task.wait(2)
	end
	if s then
		applySnapshot(s)
	end
end)
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX00000016"><Properties><string name="Name">Animator</string><ProtectedString name="Source"><![CDATA[--[[
	Animator - procedural animation for every bunny in the server.

	No animation assets: each frame we compute a pose from the bunny's
	velocity and current move, blend toward it, and write Motor6D.Transform.
	Ears hang on little springs so they flop when you land or run.
	Other players' moves come from the "Move" attribute the server sets.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Bunny64")
local Config = require(Shared:WaitForChild("Config"))

local Animator = {}

local player = Players.LocalPlayer
local Movement
local rigs = {} -- [Model] = rig data
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include

local JOINTS = {
	root = "RootJoint", neck = "Neck", lArm = "LeftShoulder", rArm = "RightShoulder",
	lLeg = "LeftHip", rLeg = "RightHip", lEar = "LeftEarJoint", rEar = "RightEarJoint",
}
local I = CFrame.identity
local A = CFrame.Angles
local TAU = math.pi * 2

local function findRig(char)
	local motors = {}
	for key, name in pairs(JOINTS) do
		local m = char:FindFirstChild(name, true)
		if not m or not m:IsA("Motor6D") then
			return nil
		end
		motors[key] = m
	end
	local cur = {}
	for key in pairs(JOINTS) do
		cur[key] = I
	end
	return {
		motors = motors,
		cur = cur,
		phase = math.random() * 6,
		ears = { l = { a = 0, v = 0 }, r = { a = 0, v = 0 } },
		twitchAt = os.clock() + 3,
		twitch = 0,
		root = char:FindFirstChild("HumanoidRootPart"),
		hum = char:FindFirstChildOfClass("Humanoid"),
	}
end

local function poseFor(rig, char, dt, now, isLocal)
	local root, hum = rig.root, rig.hum
	local v = root.AssemblyLinearVelocity
	local hv = Vector3.new(v.X, 0, v.Z).Magnitude
	local vy = v.Y
	local t = now

	-- what is this bunny doing?
	local move, moveAge, flipAge, grounded
	if isLocal then
		local s = Movement.State()
		move = s.move
		moveAge = now - s.moveStart
		flipAge = now - s.flipAt
		grounded = hum.FloorMaterial ~= Enum.Material.Air
	else
		move = char:GetAttribute("Move") or ""
		local at = char:GetAttribute("MoveAt") or 0
		local age = workspace:GetServerTimeNow() - at
		moveAge = age
		flipAge = (move == "flip") and age or 10
		if move == "flip" then
			move = ""
		end
		local hit = workspace:Raycast(root.Position, Vector3.new(0, -3.6, 0), rayParams)
		grounded = hit ~= nil
	end

	local p = {
		root = I, neck = I, lArm = A(0, 0, -0.12), rArm = A(0, 0, 0.12),
		lLeg = I, rLeg = I,
	}
	local extra = I
	local earTarget = math.clamp(-vy * 0.018 + hv * 0.022, -0.5, 1.3)

	if hum.Health <= 0 then
		p.root = CFrame.new(0, -1.7, 0.4) * A(1.45, 0, 0)
		p.lArm, p.rArm = A(0, 0, -1.6), A(0, 0, 1.6)
		p.lLeg, p.rLeg = A(0.3, 0, -0.2), A(0.3, 0, 0.2)
		earTarget = -0.4
	elseif move == "roll" then
		local spin = moveAge * 17
		extra = CFrame.new(0, -0.7, 0) * A(-spin, 0, 0)
		p.lLeg, p.rLeg = A(1.5, 0, 0), A(1.5, 0, 0)
		p.lArm, p.rArm = A(1.3, 0, 0.35), A(1.3, 0, -0.35)
		p.neck = A(-0.55, 0, 0)
		earTarget = 0.4
	elseif move == "longjump" then
		p.root = A(-1.15, 0, 0)
		p.lArm, p.rArm = A(2.7, 0, 0.25), A(2.7, 0, -0.25)
		p.lLeg, p.rLeg = A(-0.45, 0, -0.08), A(-0.2, 0, 0.08)
		p.neck = A(0.75, 0, 0)
		earTarget = 1.25
	elseif move == "slide" then
		p.root = CFrame.new(0, -1.05, 0) * A(-1.38, 0, math.sin(t * 9) * 0.04)
		p.lArm, p.rArm = A(2.85, 0, 0.3), A(2.85, 0, -0.3)
		p.lLeg, p.rLeg = A(-0.12, 0, -0.12), A(-0.12, 0, 0.12)
		p.neck = A(0.95, 0, 0)
		earTarget = 1.3
	elseif move == "pound" then
		local hang = Config.PoundHang
		if moveAge < hang then
			extra = A(0, moveAge / hang * TAU, 0)
		end
		p.lLeg, p.rLeg = A(1.3, 0, -0.15), A(1.3, 0, 0.15)
		p.lArm, p.rArm = A(0, 0, -2.6), A(0, 0, 2.6)
		p.root = A(0.15, 0, 0)
		earTarget = -0.6
	elseif not grounded then
		local rising = vy > 0
		p.lLeg = A(rising and 0.8 or 0.35, 0, 0)
		p.rLeg = A(rising and -0.25 or 0.15, 0, 0)
		p.lArm = A(0, 0, rising and -2.3 or -1.3)
		p.rArm = A(0, 0, rising and 2.3 or 1.3)
		p.root = A(-0.08, 0, 0)
		if flipAge < 0.45 then
			local u = flipAge / 0.45
			extra = A(-TAU * (1 - (1 - u) * (1 - u)), 0, 0)
			p.lLeg, p.rLeg = A(1.4, 0, 0), A(1.4, 0, 0)
			p.lArm, p.rArm = A(1.2, 0, 0.3), A(1.2, 0, -0.3)
		end
	else
		local f = math.clamp(hv / 24, 0, 1)
		rig.phase += dt * (5 + hv * 0.55)
		local s = math.sin(rig.phase)
		p.lLeg = A(s * 0.95 * f, 0, 0)
		p.rLeg = A(-s * 0.95 * f, 0, 0)
		p.lArm = A(-s * 0.75 * f, 0, -0.15 - 0.1 * f)
		p.rArm = A(s * 0.75 * f, 0, 0.15 + 0.1 * f)
		local idle = 1 - f
		p.root = CFrame.new(0, math.abs(math.cos(rig.phase)) * 0.28 * f + math.sin(t * 2.2) * 0.05 * idle, 0)
			* A(-0.14 * f, 0, s * 0.05 * f)
		p.neck = A(0.08 * f + math.sin(t * 1.7) * 0.04 * idle, math.sin(t * 0.6) * 0.15 * idle, math.sin(t * 0.9) * 0.05 * idle)
		-- idle breathing in the arms
		p.lArm = p.lArm * A(0, 0, -math.sin(t * 2.2) * 0.04 * idle)
		p.rArm = p.rArm * A(0, 0, math.sin(t * 2.2) * 0.04 * idle)
	end

	return p, extra, earTarget
end

local function update(dt)
	local now = os.clock()
	for _, plr in ipairs(Players:GetPlayers()) do
		local char = plr.Character
		if char and char:GetAttribute("Bunny") and char.Parent then
			local rig = rigs[char]
			if rig == nil then
				rig = findRig(char) or false
				rigs[char] = rig
			end
			if rig and rig.root and rig.hum and rig.root.Parent then
				local isLocal = plr == player
				local pose, extra, earTarget = poseFor(rig, char, dt, now, isLocal)
				local alpha = 1 - math.exp(-dt * 16)
				for key, target in pairs(pose) do
					rig.cur[key] = rig.cur[key]:Lerp(target, alpha)
				end
				rig.motors.root.Transform = rig.cur.root * extra
				rig.motors.neck.Transform = rig.cur.neck
				rig.motors.lArm.Transform = rig.cur.lArm
				rig.motors.rArm.Transform = rig.cur.rArm
				rig.motors.lLeg.Transform = rig.cur.lLeg
				rig.motors.rLeg.Transform = rig.cur.rLeg

				-- floppy ears
				if now > rig.twitchAt then
					rig.twitchAt = now + 2 + math.random() * 4
					rig.twitch = math.random() < 0.5 and 1 or -1
				end
				for side, ear in pairs(rig.ears) do
					local target = earTarget
					if (side == "r" and rig.twitch > 0.3) or (side == "l" and rig.twitch < -0.3) then
						target -= 0.35
					end
					ear.v += (target - ear.a) * 110 * dt - ear.v * 9 * dt
					ear.a += ear.v * dt
				end
				rig.twitch *= math.exp(-dt * 6)
				local sway = math.sin(now * 2.3) * 0.05
				rig.motors.lEar.Transform = A(rig.ears.l.a, 0, -math.max(0, rig.ears.l.a) * 0.25 + sway)
				rig.motors.rEar.Transform = A(rig.ears.r.a * 0.92, 0, math.max(0, rig.ears.r.a) * 0.25 - sway)
			end
		end
	end
	-- forget characters that are gone
	for char in pairs(rigs) do
		if not char.Parent then
			rigs[char] = nil
		end
	end
end

function Animator.Init(movement)
	Movement = movement
	local worldFolder = workspace:WaitForChild("Bunny64World")
	rayParams.FilterDescendantsInstances = { worldFolder:WaitForChild("Solid") }
	RunService.Stepped:Connect(function(_, dt)
		update(dt)
	end)
end

return Animator
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000017"><Properties><string name="Name">Collectibles</string><ProtectedString name="Source"><![CDATA[--[[
	Collectibles - spins the carrots, hides the ones this file already has,
	and asks the server to collect carrots the bunny touches.
	Each player has their own carrots, so pickups are client-side visuals
	backed by server validation and saving.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Bunny64")
local Config = require(Shared:WaitForChild("Config"))

local player = Players.LocalPlayer
local Collectibles = {}

local items = {} -- [Model] = item
local folder
local slot = nil -- the active file's progress (nil on the title screen)
local Effects, Remotes
local combo, lastPickup = 0, 0

local reqOf = {}
for _, g in ipairs(Config.Goldens) do
	reqOf[g.id] = g.req
end

local function isLocked(id)
	if not slot then
		return true
	end
	local req = reqOf[id]
	if req == "carrots" then
		return slot.carrotCount < Config.CollectorGoal
	elseif req == "bugs" then
		return slot.bugs < Config.BugBusterGoal
	elseif req == "boss" then
		return not slot.bossDefeated
	end
	return false
end

local function shouldShow(item)
	if not slot then
		return true -- the title screen shows the world as it is
	end
	if item.kind == "golden" then
		if slot.goldens[item.id] or isLocked(item.id) then
			return false
		end
	elseif slot.carrots[item.id] then
		return false
	end
	return os.clock() - item.pendingAt >= 2
end

local function apply(model, item)
	local show = shouldShow(item)
	if show and model.Parent ~= folder then
		model.Parent = folder
	elseif not show and model.Parent ~= nil then
		model.Parent = nil
	end
end

local function register(model)
	if not model:IsA("Model") or items[model] then
		return
	end
	local id = model:GetAttribute("CollectId")
	if not id then
		return
	end
	local item = {
		id = id,
		kind = model:GetAttribute("Kind") or "carrot",
		pivot = model:GetPivot(),
		phase = math.random() * 6,
		pendingAt = -10,
	}
	items[model] = item
	apply(model, item)
end

function Collectibles.Sync(slotSnap)
	slot = slotSnap
	if not folder then
		return
	end
	for model, item in pairs(items) do
		apply(model, item)
	end
end

function Collectibles.Init(effects, remotes)
	Effects, Remotes = effects, remotes
	folder = workspace:WaitForChild("Bunny64World"):WaitForChild("Collectibles")
	for _, child in ipairs(folder:GetChildren()) do
		register(child)
	end
	folder.ChildAdded:Connect(register)

	local nextResync = 0
	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		if t > nextResync then
			nextResync = t + 1
			Collectibles.Sync(slot)
		end
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local alive = root and hum and hum.Health > 0 and slot ~= nil
		for model, item in pairs(items) do
			if model.Parent == folder then
				local golden = item.kind == "golden"
				local bob = math.sin(t * 2.5 + item.phase) * (golden and 0.8 or 0.4)
				model:PivotTo(item.pivot * CFrame.new(0, bob, 0) * CFrame.Angles(0, t * (golden and 1.2 or 2.2) + item.phase, 0))
				if alive then
					local reach = golden and 7 or 5.5
					if (root.Position - item.pivot.Position).Magnitude < reach then
						item.pendingAt = t
						model.Parent = nil
						Remotes.Collect:FireServer(item.id)
						if golden then
							Effects.Burst(item.pivot.Position, Config.Palette.Gold, 24, 12, 0.9, 10)
						else
							combo = (t - lastPickup < 1.5) and math.min(combo + 1, 10) or 0
							lastPickup = t
							Effects.Play("Carrot", 1 + combo * 0.06)
							Effects.Burst(item.pivot.Position, Config.Palette.Carrot, 7, 5, 0.5, 4)
						end
					end
				end
			end
		end
	end)
end

return Collectibles
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000018"><Properties><string name="Name">Effects</string><ProtectedString name="Source"><![CDATA[--[[
	Effects - local sounds, music, chunky block particles and camera shake.
]]

local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Bunny64")
local Config = require(Shared:WaitForChild("Config"))

local Effects = {}

local sfxVolume, musicVolume, shakeOn = 0.8, 0.6, true

local sfxGroup = Instance.new("SoundGroup")
sfxGroup.Name = "Bunny64SFX"
sfxGroup.Volume = sfxVolume
sfxGroup.Parent = SoundService
local musicGroup = Instance.new("SoundGroup")
musicGroup.Name = "Bunny64Music"
musicGroup.Volume = musicVolume
musicGroup.Parent = SoundService

local sounds = {}
for name, def in pairs(Config.Sounds) do
	local s = Instance.new("Sound")
	s.Name = "Bunny64_" .. name
	s.SoundId = def.id
	s.Volume = def.volume or 0.5
	s.SoundGroup = sfxGroup
	s.Parent = SoundService
	sounds[name] = s
end

function Effects.SetOptions(options)
	if type(options) ~= "table" then
		return
	end
	sfxVolume = (options.sfx or 8) / 10
	musicVolume = (options.music or 6) / 10
	shakeOn = options.shake ~= false
	sfxGroup.Volume = sfxVolume
	musicGroup.Volume = musicVolume
end

function Effects.Play(name, speed)
	local base = sounds[name]
	if not base or base.SoundId == "" then
		return
	end
	local s = base:Clone()
	s.PlaybackSpeed = speed or 1
	s.Parent = SoundService
	s:Play()
	Debris:AddItem(s, 4)
end

function Effects.Jingle()
	for i, speed in ipairs({ 0.8, 1.0, 1.2, 1.6 }) do
		task.delay((i - 1) * 0.12, function()
			Effects.Play("Golden", speed)
		end)
	end
end

-- Music: one looping track per area (ids in Config.Music) ----------------------
local currentTrack, currentKey = nil, nil
function Effects.SetMusic(key)
	if key == currentKey then
		return
	end
	currentKey = key
	local id = Config.Music[key] or ""
	local old = currentTrack
	if old then
		TweenService:Create(old, TweenInfo.new(1), { Volume = 0 }):Play()
		Debris:AddItem(old, 1.1)
	end
	currentTrack = nil
	if id ~= "" then
		local s = Instance.new("Sound")
		s.Name = "Bunny64Track"
		s.SoundId = id
		s.Looped = true
		s.Volume = 0
		s.SoundGroup = musicGroup
		s.Parent = SoundService
		s:Play()
		TweenService:Create(s, TweenInfo.new(1.2), { Volume = Config.MusicVolume }):Play()
		currentTrack = s
	end
end

-- Particles ----------------------------------------------------------------------
local fxFolder = Instance.new("Folder")
fxFolder.Name = "Bunny64LocalFX"
fxFolder.Parent = workspace
Effects.Folder = fxFolder

local function cube(pos, color, size, material)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = material or Enum.Material.SmoothPlastic
	p.Color = color
	p.Size = Vector3.one * size
	p.CFrame = CFrame.new(pos) * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6)
	p.Parent = fxFolder
	return p
end

function Effects.Burst(pos, color, count, speed, size, rise, material)
	count = count or 8
	speed = speed or 6
	size = size or 0.6
	rise = rise or 4
	for _ = 1, count do
		local p = cube(pos, color, size * (0.6 + math.random() * 0.8), material)
		local a = math.random() * math.pi * 2
		local dist = speed * (0.4 + math.random() * 0.6)
		local target = pos + Vector3.new(math.cos(a) * dist, rise * (0.3 + math.random()), math.sin(a) * dist)
		local t = 0.45 + math.random() * 0.3
		TweenService:Create(p, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			CFrame = CFrame.new(target) * CFrame.Angles(math.random() * 6, math.random() * 6, 0),
			Size = Vector3.one * 0.05,
			Transparency = 0.6,
		}):Play()
		Debris:AddItem(p, t + 0.05)
	end
end

function Effects.Ring(pos, color, radius, count, duration)
	radius = radius or 12
	count = count or 16
	duration = duration or 0.4
	for i = 1, count do
		local a = i / count * math.pi * 2
		local p = cube(pos + Vector3.new(0, 0.5, 0), color, 1.2)
		local target = pos + Vector3.new(math.cos(a) * radius, 1.2, math.sin(a) * radius)
		TweenService:Create(p, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
			CFrame = CFrame.new(target),
			Size = Vector3.one * 0.4,
			Transparency = 0.5,
		}):Play()
		Debris:AddItem(p, duration + 0.05)
	end
end

-- An expanding ring of fire that the boss's slam sends out
function Effects.Shockwave(pos, speed, maxR)
	local count = 40
	local duration = maxR / speed
	for i = 1, count do
		local a = i / count * math.pi * 2
		local p = cube(pos + Vector3.new(0, 1, 0), Config.Palette.Ember, 2.2, Enum.Material.Neon)
		local target = pos + Vector3.new(math.cos(a) * maxR, 1, math.sin(a) * maxR)
		TweenService:Create(p, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = CFrame.new(target), Size = Vector3.one * 1.2 }):Play()
		Debris:AddItem(p, duration)
	end
end

-- Camera shake ------------------------------------------------------------------------
local shakeAmount, shakeUntil, shakeLen = 0, 0, 0.001
function Effects.Shake(amount, duration)
	if not shakeOn then
		return
	end
	shakeAmount = math.max(amount, shakeAmount * math.max(0, (shakeUntil - os.clock()) / shakeLen))
	shakeLen = duration
	shakeUntil = os.clock() + duration
end

RunService:BindToRenderStep("Bunny64Shake", Enum.RenderPriority.Camera.Value + 1, function()
	local left = shakeUntil - os.clock()
	if left <= 0 then
		return
	end
	local k = shakeAmount * (left / shakeLen)
	local cam = workspace.CurrentCamera
	cam.CFrame = cam.CFrame * CFrame.new((math.random() - 0.5) * k, (math.random() - 0.5) * k, 0)
end)

return Effects
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000019"><Properties><string name="Name">Hud</string><ProtectedString name="Source"><![CDATA[--[[
	Hud - in-game overlay: hearts, golden carrot and carrot counters,
	region title cards, toasts, the boss health bar and the MENU button.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Bunny64")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(script.Parent:WaitForChild("UI"))
local P = Config.Palette

local player = Players.LocalPlayer
local Hud = {}

local gui, root
local hearts = {}
local goldenLabel, carrotLabel, saveLabel, toastLabel, bannerHolder, bannerFace
local bossFrame, bossPips, bossName
local toastToken, bannerToken = 0, 0
local onMenu

local function counter(parent, icon, y)
	local row = Instance.new("Frame")
	row.BackgroundTransparency = 1
	row.Size = UDim2.fromOffset(220, 44)
	row.Position = UDim2.new(1, -220, 0, y)
	row.Parent = parent
	UI.carrot(row, icon, 1.3, UDim2.new(1, -150, 0.5, 0), Vector2.new(0, 0.5))
	UI.label(row, { Text = "x", Font = UI.TITLE, TextSize = 22, Size = UDim2.fromOffset(20, 44), Position = UDim2.new(1, -116, 0, 2) })
	local value = UI.label(row, {
		Text = "0", Font = UI.TITLE, TextSize = 38, Size = UDim2.fromOffset(100, 44), Position = UDim2.new(1, -96, 0, 0),
		TextXAlignment = Enum.TextXAlignment.Left, Stroke = 4,
	})
	return value
end

function Hud.Init(menuCallback)
	onMenu = menuCallback
	gui = Instance.new("ScreenGui")
	gui.Name = "Bunny64Hud"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 1
	gui.Enabled = false
	gui.Parent = player:WaitForChild("PlayerGui")

	root = Instance.new("Frame")
	root.BackgroundTransparency = 1
	root.Size = UDim2.new(1, -40, 1, -40)
	root.Position = UDim2.fromOffset(20, 20)
	root.Parent = gui

	-- hearts
	local heartRow = Instance.new("Frame")
	heartRow.BackgroundTransparency = 1
	heartRow.Size = UDim2.fromOffset(200, 52)
	heartRow.Position = UDim2.fromOffset(0, 36)
	heartRow.Parent = root
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.Padding = UDim.new(0, 2)
	layout.Parent = heartRow
	for i = 1, Config.MaxHearts do
		local h = UI.label(heartRow, {
			Text = "♥", Font = Enum.Font.SourceSansBold, TextSize = 58, Size = UDim2.fromOffset(46, 52),
			TextColor3 = Color3.fromRGB(214, 70, 70), Stroke = 4,
		})
		local shine = UI.label(h, {
			Text = "♥", Font = Enum.Font.SourceSansBold, TextSize = 22, Size = UDim2.fromOffset(20, 20),
			Position = UDim2.fromOffset(9, 8), TextColor3 = Color3.fromRGB(255, 190, 180), Stroke = 0,
		})
		shine.Name = "Shine"
		hearts[i] = h
	end

	goldenLabel = counter(root, P.Gold, 36)
	carrotLabel = counter(root, P.Carrot, 84)

	saveLabel = UI.label(root, {
		Text = "", TextSize = 14, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.fromOffset(420, 20), TextXAlignment = Enum.TextXAlignment.Left, TextTransparency = 0.25, Stroke = 2,
	})

	-- menu button (needed on touch screens, handy everywhere)
	local menu = Instance.new("TextButton")
	menu.Text = "MENU"
	menu.Font = UI.TITLE
	menu.TextSize = 20
	menu.TextColor3 = UI.Cream
	menu.BackgroundColor3 = UI.Navy
	menu.Size = UDim2.fromOffset(92, 34)
	menu.Position = UDim2.fromOffset(0, 96)
	UI.corner(menu, 8)
	UI.stroke(menu, 3, UI.Gold, Enum.ApplyStrokeMode.Border)
	UI.stroke(menu, 2)
	menu.Parent = root
	menu.Activated:Connect(function()
		if onMenu then
			onMenu()
		end
	end)
	UI.label(menu, { Text = "[M]", TextSize = 12, Size = UDim2.fromOffset(30, 14), Position = UDim2.new(1, 4, 0.5, -7), TextXAlignment = Enum.TextXAlignment.Left, Stroke = 2 })

	-- toast
	toastLabel = UI.label(gui, {
		Text = "", Font = UI.TITLE, TextSize = 34, AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.26, 0), Size = UDim2.new(0.9, 0, 0, 90), TextWrapped = true,
		TextTransparency = 1, Stroke = 4,
	})

	-- region title card
	bannerHolder, bannerFace = UI.title(gui, "", 64, UDim2.new(0.5, 0, 0.14, 0), Vector2.new(0.5, 0.5))
	bannerHolder.Visible = false

	-- boss bar
	bossFrame = Instance.new("Frame")
	bossFrame.BackgroundTransparency = 1
	bossFrame.AnchorPoint = Vector2.new(0.5, 0)
	bossFrame.Position = UDim2.new(0.5, 0, 0, 18)
	bossFrame.Size = UDim2.fromOffset(360, 70)
	bossFrame.Visible = false
	bossFrame.Parent = gui
	bossName = UI.label(bossFrame, { Text = "KING GRUMBLE", Font = UI.TITLE, TextSize = 30, Size = UDim2.new(1, 0, 0, 34), TextColor3 = Color3.fromRGB(240, 150, 90), Stroke = 4 })
	bossPips = {}
	for i = 1, 3 do
		local pip = Instance.new("Frame")
		pip.Size = UDim2.fromOffset(100, 18)
		pip.Position = UDim2.fromOffset(12 + (i - 1) * 114, 42)
		pip.BackgroundColor3 = Color3.fromRGB(220, 120, 50)
		pip.BorderSizePixel = 0
		UI.corner(pip, 6)
		UI.stroke(pip, 3, UI.Ink, Enum.ApplyStrokeMode.Border)
		pip.Parent = bossFrame
		bossPips[i] = pip
	end
end

function Hud.SetVisible(on)
	gui.Enabled = on
end

function Hud.SetHearts(health, max)
	for i, h in ipairs(hearts) do
		local full = i <= math.ceil(health - 0.01)
		h.TextColor3 = full and Color3.fromRGB(214, 70, 70) or Color3.fromRGB(70, 56, 60)
		h.Shine.Visible = full
		h.Visible = i <= max
	end
end

function Hud.Pulse(label)
	local scale = label:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
	scale.Parent = label
	scale.Scale = 1.35
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()
end

function Hud.SetProgress(slot, canSave)
	if not slot then
		return
	end
	local g = string.format("%d", slot.goldenCount)
	local c = string.format("%03d", slot.carrotCount)
	if goldenLabel.Text ~= g then
		goldenLabel.Text = g
		Hud.Pulse(goldenLabel)
	end
	if carrotLabel.Text ~= c then
		carrotLabel.Text = c
		Hud.Pulse(carrotLabel)
	end
	saveLabel.Text = canSave and "" or "SAVING OFF (STUDIO OR DATASTORE UNAVAILABLE)"
end

function Hud.Toast(text, seconds, color)
	toastToken += 1
	local token = toastToken
	toastLabel.Text = text
	toastLabel.TextColor3 = color or UI.Cream
	toastLabel.TextTransparency = 0
	local scale = toastLabel:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
	scale.Parent = toastLabel
	scale.Scale = 0.6
	TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	task.delay(seconds or 2.5, function()
		if token == toastToken then
			TweenService:Create(toastLabel, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
		end
	end)
end

function Hud.RegionBanner(text)
	bannerToken += 1
	local token = bannerToken
	for _, d in ipairs(bannerHolder:GetChildren()) do
		if d:IsA("TextLabel") then
			d.Text = text
			d.TextTransparency = 0
		end
	end
	bannerHolder.Visible = true
	bannerHolder.Position = UDim2.new(0.5, 0, 0.08, 0)
	TweenService:Create(bannerHolder, TweenInfo.new(0.5, Enum.EasingStyle.Back), { Position = UDim2.new(0.5, 0, 0.14, 0) }):Play()
	task.delay(2.6, function()
		if token ~= bannerToken then
			return
		end
		for _, d in ipairs(bannerHolder:GetChildren()) do
			if d:IsA("TextLabel") then
				TweenService:Create(d, TweenInfo.new(0.6), { TextTransparency = 1 }):Play()
			end
		end
		task.delay(0.7, function()
			if token == bannerToken then
				bannerHolder.Visible = false
			end
		end)
	end)
end

-- Boss bar follows King Grumble's attributes while you're in the arena
function Hud.WatchBoss(inArenaFn)
	RunService.RenderStepped:Connect(function()
		local folder = workspace:FindFirstChild("Boss")
		local boss = folder and folder:FindFirstChild("KingGrumble")
		local show = boss ~= nil and gui.Enabled and inArenaFn() and boss:GetAttribute("State") ~= "sleep"
		bossFrame.Visible = show
		if show then
			local hp = boss:GetAttribute("HP") or 3
			for i, pip in ipairs(bossPips) do
				pip.BackgroundColor3 = i <= hp and Color3.fromRGB(220, 120, 50) or Color3.fromRGB(50, 40, 44)
			end
			local exposed = boss:GetAttribute("Exposed")
			bossName.TextColor3 = exposed and Color3.fromRGB(255, 230, 120) or Color3.fromRGB(240, 150, 90)
			bossName.Text = exposed and "KING GRUMBLE - JUMP ON HIS BACK!" or "KING GRUMBLE"
		end
	end)
end

return Hud
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001A"><Properties><string name="Name">Menus</string><ProtectedString name="Source"><![CDATA[--[[
	Menus - every full-screen menu:
	  Title (PRESS START) -> File Select (File A/B/C, erase) -> game
	  Customise (fur, accent colour, hat, neckwear with a live 3D preview)
	  Options, Pause, Carrot Log, Burrow Warp list, the ending card.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Bunny64")
local Config = require(Shared:WaitForChild("Config"))
local BunnyModel = require(Shared:WaitForChild("BunnyModel"))
local UI = require(script.Parent:WaitForChild("UI"))
local P = Config.Palette

local player = Players.LocalPlayer
local Menus = {}

local gui, layer, scaler
local deps -- { Effects, Remotes, Movement, Hud, WorldFX, onPlay, onQuit }
local snap = nil
local screen = nil -- current screen name, nil while playing
local orbit = 0

local FILE_LETTERS = { "A", "B", "C" }

local function fmtTime(seconds)
	seconds = math.floor(seconds or 0)
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%d:%02d", m, s)
end
Menus.FormatTime = fmtTime

local function clear()
	layer:ClearAllChildren()
	UI.ClearNav()
end

-- 3D bunny preview in a ViewportFrame
local function bunnyViewport(parent, size, pos, custom, anchor)
	local vp = Instance.new("ViewportFrame")
	vp.BackgroundTransparency = 1
	vp.Size = size
	vp.Position = pos
	vp.AnchorPoint = anchor or Vector2.new(0.5, 0.5)
	vp.Ambient = Color3.fromRGB(170, 160, 150)
	vp.LightColor = Color3.fromRGB(255, 240, 220)
	vp.LightDirection = Vector3.new(-1, -1.2, 1.2)
	vp.Parent = parent
	local cam = Instance.new("Camera")
	cam.FieldOfView = 32
	cam.CFrame = CFrame.lookAt(Vector3.new(0, 5, -15), Vector3.new(0, 3.6, 0))
	cam.Parent = vp
	vp.CurrentCamera = cam
	local model = BunnyModel.BuildPreview(custom)
	model.Parent = vp
	local conn
	conn = RunService.RenderStepped:Connect(function()
		if not vp.Parent then
			conn:Disconnect()
			return
		end
		local t = os.clock()
		model:PivotTo(CFrame.new(0, 2.6 + math.abs(math.sin(t * 2.4)) * 0.35, 0) * CFrame.Angles(0, math.sin(t * 0.7) * 0.9, 0))
	end)
	return vp, model
end

--------------------------------------------------------------------------------
-- Title
--------------------------------------------------------------------------------

local showFiles

local function showTitle()
	screen = "title"
	clear()
	UI.backdrop(layer, 0.55)
	local logo = Instance.new("Frame")
	logo.BackgroundTransparency = 1
	logo.Size = UDim2.fromOffset(820, 300)
	logo.AnchorPoint = Vector2.new(0.5, 0.5)
	logo.Position = UDim2.fromScale(0.5, 0.27)
	logo.Parent = layer
	UI.title(logo, "BUNNY", 130, UDim2.fromOffset(0, 0))
	local _, face64 = UI.title(logo, "64", 170, UDim2.fromOffset(0, 120), nil, {
		Color3.fromRGB(150, 230, 210), Color3.fromRGB(70, 160, 200), Color3.fromRGB(60, 80, 170),
	})
	local scale = Instance.new("UIScale")
	scale.Parent = logo
	scale.Scale = 0.2
	TweenService:Create(scale, TweenInfo.new(0.7, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	task.spawn(function()
		while logo.Parent do
			logo.Rotation = math.sin(os.clock() * 1.3) * 2
			face64.Rotation = math.sin(os.clock() * 2.1) * 4
			task.wait()
		end
	end)

	bunnyViewport(layer, UDim2.fromOffset(300, 300), UDim2.fromScale(0.5, 0.66), snap and snap.menu.custom)

	local press = UI.label(layer, {
		Text = "PRESS START", Font = UI.TITLE, TextSize = 44, AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.89), Size = UDim2.new(1, 0, 0, 50), Stroke = 4,
	})
	task.spawn(function()
		while press.Parent do
			press.Visible = not press.Visible
			task.wait(0.55)
		end
	end)
	UI.label(layer, {
		Text = "v" .. Config.Version, TextSize = 14, AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -12, 1, -8), Size = UDim2.fromOffset(100, 18), TextXAlignment = Enum.TextXAlignment.Right, Stroke = 2,
	})

	local conn
	conn = UserInputService.InputBegan:Connect(function(input, processed)
		if screen ~= "title" then
			conn:Disconnect()
			return
		end
		local t = input.UserInputType
		if t == Enum.UserInputType.Keyboard or t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch
			or t == Enum.UserInputType.Gamepad1 then
			if not snap then
				return -- still loading the save; wait for the next press
			end
			conn:Disconnect()
			deps.Effects.Play("MenuSelect", 0.8)
			showFiles(false)
		end
	end)
end

--------------------------------------------------------------------------------
-- File select
--------------------------------------------------------------------------------

local showCustomise, showOptions

local function confirm(question, onYes, onNo)
	clear()
	UI.backdrop(layer, 0.1)
	local panel = UI.panel(layer, UDim2.fromOffset(560, 260), UDim2.fromScale(0.5, 0.5))
	UI.label(panel, { Text = question, Font = UI.TITLE, TextSize = 34, Size = UDim2.new(1, -40, 0, 110), Position = UDim2.fromOffset(20, 20), TextWrapped = true, Stroke = 4 })
	local yes = UI.item(panel, "YES", { Size = UDim2.fromOffset(200, 50), Position = UDim2.new(0.25, -100, 1, -80) })
	local no = UI.item(panel, "NO", { Size = UDim2.fromOffset(200, 50), Position = UDim2.new(0.75, -100, 1, -80) })
	UI.SetNav({ { button = yes, select = onYes }, { button = no, select = onNo } }, onNo, 2)
end

function showFiles(eraseMode)
	screen = eraseMode and "erase" or "files"
	clear()
	UI.backdrop(layer, 0.05)
	UI.title(layer, eraseMode and "ERASE WHICH FILE?" or "SELECT FILE", 64, UDim2.new(0.5, 0, 0, 30), Vector2.new(0.5, 0), eraseMode and {
		Color3.fromRGB(255, 190, 170), Color3.fromRGB(230, 110, 90), Color3.fromRGB(170, 50, 50),
	} or nil)

	local row = Instance.new("Frame")
	row.BackgroundTransparency = 1
	row.Size = UDim2.fromOffset(820, 280)
	row.AnchorPoint = Vector2.new(0.5, 0.5)
	row.Position = UDim2.fromScale(0.5, 0.47)
	row.Parent = layer

	local entries = {}
	local slots = snap.menu.slots
	for i = 1, Config.SaveSlots do
		local s = slots[i]
		local x = (i - 2) * 275
		local panel, shadow = UI.panel(row, UDim2.fromOffset(250, 260), UDim2.new(0.5, x, 0.5, 0))
		UI.label(panel, { Text = "FILE " .. FILE_LETTERS[i], Font = UI.TITLE, TextSize = 46, Size = UDim2.new(1, 0, 0, 56), Position = UDim2.fromOffset(0, 16), Stroke = 4, TextColor3 = UI.Gold })
		if s.exists then
			UI.carrot(panel, P.Gold, 1.4, UDim2.fromOffset(40, 88))
			UI.label(panel, { Text = string.format("x %d / %d", s.goldens, #Config.Goldens), Font = UI.TITLE, TextSize = 30, Size = UDim2.fromOffset(150, 40), Position = UDim2.fromOffset(78, 88), TextXAlignment = Enum.TextXAlignment.Left })
			UI.carrot(panel, P.Carrot, 1.4, UDim2.fromOffset(40, 136))
			UI.label(panel, { Text = string.format("x %03d", s.carrots), Font = UI.TITLE, TextSize = 30, Size = UDim2.fromOffset(150, 40), Position = UDim2.fromOffset(78, 136), TextXAlignment = Enum.TextXAlignment.Left })
			UI.label(panel, { Text = "TIME " .. fmtTime(s.playTime), TextSize = 20, Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 186) })
			if s.completed then
				UI.label(panel, { Text = "* COMPLETE *", Font = UI.TITLE, TextSize = 22, TextColor3 = UI.Gold, Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 216) })
			end
		else
			UI.label(panel, { Text = "NEW GAME", Font = UI.TITLE, TextSize = 34, Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 120), TextColor3 = Color3.fromRGB(190, 210, 240) })
		end
		local button = UI.item(panel, "", { Size = UDim2.fromScale(1, 1) })
		local stroke = panel:FindFirstChildOfClass("UIStroke")
		local index = i
		table.insert(entries, {
			button = button,
			focus = function(on)
				if stroke then
					stroke.Color = on and Color3.fromRGB(255, 244, 200) or UI.Gold
					stroke.Thickness = on and 6 or 4
				end
				TweenService:Create(shadow, TweenInfo.new(0.15), { Position = UDim2.new(0.5, x, 0.5, on and -10 or 0) }):Play()
			end,
			select = function()
				if eraseMode then
					if not s.exists then
						return
					end
					confirm("ERASE FILE " .. FILE_LETTERS[index] .. "?\nTHIS CAN'T BE UNDONE!", function()
						local ok = deps.Remotes.EraseSlot:InvokeServer(index)
						if ok then
							snap.menu.slots[index] = { exists = false, goldens = 0, carrots = 0, playTime = 0, completed = false }
						end
						showFiles(false)
					end, function()
						showFiles(true)
					end)
				else
					Menus.StartFile(index)
				end
			end,
		})
	end

	local bottom = Instance.new("Frame")
	bottom.BackgroundTransparency = 1
	bottom.Size = UDim2.fromOffset(820, 50)
	bottom.AnchorPoint = Vector2.new(0.5, 0)
	bottom.Position = UDim2.new(0.5, 0, 0.47, 170)
	bottom.Parent = layer
	if eraseMode then
		local cancel = UI.item(bottom, "CANCEL", { Size = UDim2.fromOffset(260, 46), Position = UDim2.new(0.5, -130, 0, 0) })
		table.insert(entries, { button = cancel, select = function()
			showFiles(false)
		end })
		UI.SetNav(entries, function()
			showFiles(false)
		end)
	else
		local labels = { "CUSTOMISE", "OPTIONS", "ERASE" }
		local actions = {
			function()
				showCustomise(function()
					showFiles(false)
				end)
			end,
			function()
				showOptions(function()
					showFiles(false)
				end)
			end,
			function()
				showFiles(true)
			end,
		}
		for i, text in ipairs(labels) do
			local b = UI.item(bottom, text, { Size = UDim2.fromOffset(250, 46), Position = UDim2.new(0.5, (i - 2) * 275 - 125, 0, 0) })
			table.insert(entries, { button = b, select = actions[i] })
		end
		UI.SetNav(entries, function()
			showTitle()
		end)
	end
	if not snap.canSave then
		UI.label(layer, {
			Text = "SAVING IS OFF: publish the game and enable API services to keep progress", TextSize = 16,
			AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Size = UDim2.new(1, 0, 0, 20), Stroke = 2,
		})
	end
end

--------------------------------------------------------------------------------
-- Customise
--------------------------------------------------------------------------------

local function findIndex(list, id)
	for i, e in ipairs(list) do
		if e.id == id then
			return i
		end
	end
	return 1
end

function showCustomise(back)
	local inGame = snap.slot ~= nil
	screen = "custom"
	clear()
	UI.backdrop(layer, inGame and 0.3 or 0.05)
	UI.title(layer, "CUSTOMISE", 60, UDim2.new(0.5, 0, 0, 24), Vector2.new(0.5, 0))
	local custom = table.clone(snap.menu.custom)
	local progress = snap.menu.progress

	local left = UI.panel(layer, UDim2.fromOffset(330, 400), UDim2.new(0.5, -215, 0.53, 0))
	local vp, model = bunnyViewport(left, UDim2.new(1, -20, 1, -20), UDim2.fromScale(0.5, 0.5), custom)
	vp.ZIndex = 3
	local right = UI.panel(layer, UDim2.fromOffset(440, 400), UDim2.new(0.5, 200, 0.53, 0))
	local list = Instance.new("Frame")
	list.BackgroundTransparency = 1
	list.Size = UDim2.new(1, -30, 1, -30)
	list.Position = UDim2.fromOffset(15, 15)
	list.Parent = right
	UI.list(list, 6)

	local function refreshModel()
		BunnyModel.Apply(model, custom)
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Anchored = true
			end
		end
	end

	local rows = {}
	local function makeRow(title, order)
		UI.label(list, { Text = title, Font = UI.TITLE, TextSize = 18, TextColor3 = Color3.fromRGB(190, 200, 236), Size = UDim2.new(1, 0, 0, 20), LayoutOrder = order * 2 - 1, Stroke = 2 })
		local b = UI.item(list, "", { Size = UDim2.new(1, 0, 0, 38), LayoutOrder = order * 2, TextSize = 26 })
		return b
	end

	local function cycler(list2, key, isIdList, colorKey)
		return function(delta)
			if isIdList then
				local i = findIndex(list2, custom[key])
				i = (i - 1 + delta) % #list2 + 1
				custom[key] = list2[i].id
			else
				custom[key] = (custom[key] - 1 + delta) % #list2 + 1
			end
			refreshModel()
		end
	end

	local defs = {
		{ title = "FUR", list = Config.FurColors, key = "fur", ids = false },
		{ title = "ACCENT COLOUR", list = Config.AccentColors, key = "accent", ids = false },
		{ title = "HAT", list = Config.Hats, key = "hat", ids = true },
		{ title = "NECK", list = Config.Necks, key = "neck", ids = true },
	}
	local entries = {}
	local function refreshTexts()
		for _, r in ipairs(rows) do
			local d = r.def
			local text, locked = "", false
			if d.ids then
				local item = d.list[findIndex(d.list, custom[d.key])]
				locked = not BunnyModel.IsUnlocked(d.list, item.id, progress)
				text = item.name
				if locked then
					text = item.boss and (item.name .. " (BEAT THE KING)") or string.format("%s (%d GOLDEN)", item.name, item.need)
				end
			else
				text = d.list[custom[d.key]].name
			end
			r.button.Text = "<  " .. text .. "  >"
			r.locked = locked
			r.button:SetAttribute("Locked", locked)
		end
	end
	for i, d in ipairs(defs) do
		local b = makeRow(d.title, i)
		local cyc = cycler(d.list, d.key, d.ids)
		local r = { button = b, def = d }
		table.insert(rows, r)
		table.insert(entries, {
			button = b,
			left = function()
				cyc(-1)
				refreshTexts()
			end,
			right = function()
				cyc(1)
				refreshTexts()
			end,
			select = function()
				cyc(1)
				refreshTexts()
			end,
		})
	end
	refreshTexts()

	local status = UI.label(list, { Text = "", TextSize = 16, Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 20, TextColor3 = Color3.fromRGB(240, 170, 150), Stroke = 2 })
	local done = UI.item(list, "SAVE LOOK", { Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 21 })
	local cancel = UI.item(list, "BACK", { Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 22 })
	table.insert(entries, {
		button = done,
		select = function()
			for _, r in ipairs(rows) do
				if r.locked then
					status.Text = "THAT ONE IS STILL LOCKED - KEEP COLLECTING!"
					return
				end
			end
			status.Text = "SAVING..."
			local result = deps.Remotes.Customise:InvokeServer(custom)
			if result then
				snap.menu.custom = result
				status.Text = "LOOKING GOOD!"
				task.delay(0.5, function()
					if screen == "custom" then
						back()
					end
				end)
			else
				status.Text = "COULDN'T SAVE - TRY AGAIN"
			end
		end,
	})
	table.insert(entries, { button = cancel, select = back })
	UI.SetNav(entries, back)
end

--------------------------------------------------------------------------------
-- Options
--------------------------------------------------------------------------------

function showOptions(back)
	screen = "options"
	clear()
	UI.backdrop(layer, snap.slot and 0.3 or 0.05)
	UI.title(layer, "OPTIONS", 60, UDim2.new(0.5, 0, 0, 24), Vector2.new(0.5, 0))
	local panel = UI.panel(layer, UDim2.fromOffset(520, 330), UDim2.fromScale(0.5, 0.52))
	local list = Instance.new("Frame")
	list.BackgroundTransparency = 1
	list.Size = UDim2.new(1, -40, 1, -40)
	list.Position = UDim2.fromOffset(20, 20)
	list.Parent = panel
	UI.list(list, 10)
	local o = snap.menu.options
	local function bar(v)
		return string.rep("|", v) .. string.rep(".", 10 - v)
	end
	local sfx = UI.item(list, "", { LayoutOrder = 1 })
	local music = UI.item(list, "", { LayoutOrder = 2 })
	local shake = UI.item(list, "", { LayoutOrder = 3 })
	local function refresh()
		sfx.Text = "SOUND  < " .. bar(o.sfx) .. " >"
		music.Text = "MUSIC  < " .. bar(o.music) .. " >"
		shake.Text = "SCREEN SHAKE  < " .. (o.shake and "ON" or "OFF") .. " >"
		deps.Effects.SetOptions(o)
	end
	refresh()
	local function finish()
		deps.Remotes.SetOptions:FireServer(o)
		back()
	end
	local backButton = UI.item(list, "BACK", { LayoutOrder = 5 })
	UI.label(list, { Text = "Music plays when you add track ids in Config.Music", TextSize = 14, LayoutOrder = 4, Size = UDim2.new(1, 0, 0, 30), Stroke = 2, TextTransparency = 0.3 })
	UI.SetNav({
		{ button = sfx, left = function() o.sfx = math.max(0, o.sfx - 1); refresh() end, right = function() o.sfx = math.min(10, o.sfx + 1); refresh() end, select = function() o.sfx = (o.sfx + 1) % 11; refresh() end },
		{ button = music, left = function() o.music = math.max(0, o.music - 1); refresh() end, right = function() o.music = math.min(10, o.music + 1); refresh() end, select = function() o.music = (o.music + 1) % 11; refresh() end },
		{ button = shake, left = function() o.shake = not o.shake; refresh() end, right = function() o.shake = not o.shake; refresh() end, select = function() o.shake = not o.shake; refresh() end },
		{ button = backButton, select = finish },
	}, finish)
end

--------------------------------------------------------------------------------
-- Carrot Log
--------------------------------------------------------------------------------

local function showLog(back)
	screen = "log"
	clear()
	UI.backdrop(layer, 0.3)
	UI.title(layer, "CARROT LOG", 56, UDim2.new(0.5, 0, 0, 18), Vector2.new(0.5, 0))
	local panel = UI.panel(layer, UDim2.fromOffset(640, 470), UDim2.fromScale(0.5, 0.55))
	local scroll = Instance.new("ScrollingFrame")
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.Size = UDim2.new(1, -30, 1, -80)
	scroll.Position = UDim2.fromOffset(15, 15)
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.CanvasSize = UDim2.new()
	scroll.ScrollBarThickness = 8
	scroll.ScrollBarImageColor3 = UI.Gold
	scroll.Parent = panel
	UI.list(scroll, 2)
	local slot = snap.slot
	local order = 0
	local entries = {}
	for _, region in ipairs(Config.Regions) do
		order += 1
		local got, total = 0, 0
		for _, g in ipairs(Config.Goldens) do
			if g.region == region.id then
				total += 1
				if slot and slot.goldens[g.id] then
					got += 1
				end
			end
		end
		UI.label(scroll, { Text = string.format("%s   %d/%d", region.name, got, total), Font = UI.TITLE, TextSize = 26, TextColor3 = UI.Gold, Size = UDim2.new(1, 0, 0, 34), LayoutOrder = order, Stroke = 3 })
		for _, g in ipairs(Config.Goldens) do
			if g.region == region.id then
				order += 1
				local have = slot and slot.goldens[g.id]
				local b = UI.item(scroll, have and string.upper(g.name) or ("???  " .. g.hint), {
					LayoutOrder = order, TextSize = have and 22 or 16, TextWrapped = true, Size = UDim2.new(1, -12, 0, 40),
					TextColor3 = have and Color3.fromRGB(255, 226, 140) or UI.Cream,
				})
				table.insert(entries, {
					button = b,
					focus = function(on)
						if on then
							local y = b.AbsolutePosition.Y - scroll.AbsolutePosition.Y + scroll.CanvasPosition.Y
							scroll.CanvasPosition = Vector2.new(0, math.max(0, y - scroll.AbsoluteSize.Y / 2))
						end
						if have then
							b.TextColor3 = on and UI.Gold or Color3.fromRGB(255, 226, 140)
						end
					end,
				})
			end
		end
	end
	if slot then
		UI.label(panel, {
			Text = string.format("CARROTS %d/%d    BUGS BOPPED %d    TIME %s", slot.carrotCount, snap.totalCarrots or 0, slot.bugs, fmtTime(slot.playTime)),
			TextSize = 18, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -42), Size = UDim2.new(1, 0, 0, 22), Stroke = 2,
		})
	end
	local backButton = UI.item(panel, "BACK", { Size = UDim2.fromOffset(200, 36), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -6) })
	table.insert(entries, { button = backButton, select = back })
	UI.SetNav(entries, back, #entries)
end

--------------------------------------------------------------------------------
-- Pause, warp, ending
--------------------------------------------------------------------------------

local function regionName()
	local id = deps.WorldFX.Region()
	for _, r in ipairs(Config.Regions) do
		if r.id == id then
			return r.name
		end
	end
	return ""
end

function Menus.Close()
	screen = nil
	clear()
	gui.Enabled = false
	deps.Hud.SetVisible(true)
	deps.Movement.SetEnabled(true)
end

local function showPause()
	screen = "pause"
	clear()
	gui.Enabled = true
	deps.Movement.SetEnabled(false)
	UI.backdrop(layer, 0.35)
	UI.title(layer, "PAUSED", 72, UDim2.new(0.5, 0, 0, 30), Vector2.new(0.5, 0))
	local slot = snap.slot
	if slot then
		UI.label(layer, {
			Text = string.format("FILE %s   -   %s   -   %d GOLDEN   -   %d CARROTS", FILE_LETTERS[snap.active or 1], regionName(), slot.goldenCount, slot.carrotCount),
			TextSize = 20, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 120), Size = UDim2.new(1, 0, 0, 24), Stroke = 2,
		})
	end
	local panel = UI.panel(layer, UDim2.fromOffset(460, 330), UDim2.fromScale(0.5, 0.56))
	local list = Instance.new("Frame")
	list.BackgroundTransparency = 1
	list.Size = UDim2.new(1, -30, 1, -30)
	list.Position = UDim2.fromOffset(15, 15)
	list.Parent = panel
	UI.list(list, 8)
	local resume = UI.item(list, "RESUME", { LayoutOrder = 1 })
	local log = UI.item(list, "CARROT LOG", { LayoutOrder = 2 })
	local custom = UI.item(list, "CUSTOMISE", { LayoutOrder = 3 })
	local options = UI.item(list, "OPTIONS", { LayoutOrder = 4 })
	local quit = UI.item(list, "SAVE & QUIT", { LayoutOrder = 5 })
	local backToPause = function()
		showPause()
	end
	UI.SetNav({
		{ button = resume, select = Menus.Close },
		{ button = log, select = function() showLog(backToPause) end },
		{ button = custom, select = function() showCustomise(backToPause) end },
		{ button = options, select = function() showOptions(backToPause) end },
		{ button = quit, select = function()
			confirm("SAVE AND QUIT TO THE TITLE SCREEN?", function()
				deps.onQuit()
			end, backToPause)
		end },
	}, Menus.Close)
end

function Menus.TogglePause()
	if screen == nil and snap and snap.slot then
		deps.Effects.Play("MenuSelect", 0.9)
		showPause()
	elseif screen == "pause" then
		Menus.Close()
	end
end

function Menus.ShowWarp(ids)
	if screen ~= nil then
		return
	end
	screen = "warp"
	clear()
	gui.Enabled = true
	deps.Movement.SetEnabled(false)
	UI.backdrop(layer, 0.4)
	UI.title(layer, "BURROW WARP", 60, UDim2.new(0.5, 0, 0, 40), Vector2.new(0.5, 0))
	local panel = UI.panel(layer, UDim2.fromOffset(460, 80 + 50 * (#ids + 1)), UDim2.fromScale(0.5, 0.55))
	local list = Instance.new("Frame")
	list.BackgroundTransparency = 1
	list.Size = UDim2.new(1, -30, 1, -30)
	list.Position = UDim2.fromOffset(15, 15)
	list.Parent = panel
	UI.list(list, 6)
	UI.label(list, { Text = "Where to, little bunny?", TextSize = 18, LayoutOrder = 0, Size = UDim2.new(1, 0, 0, 30), Stroke = 2 })
	local entries = {}
	for i, id in ipairs(ids) do
		local name = id
		for _, w in ipairs(Config.Warps) do
			if w.id == id then
				name = w.name
			end
		end
		local b = UI.item(list, name, { LayoutOrder = i })
		table.insert(entries, { button = b, select = function()
			deps.Remotes.Warp:FireServer(id)
			Menus.Close()
		end })
	end
	local cancel = UI.item(list, "STAY HERE", { LayoutOrder = 100 })
	table.insert(entries, { button = cancel, select = Menus.Close })
	UI.SetNav(entries, Menus.Close)
end

function Menus.ShowEnding(s)
	screen = "ending"
	clear()
	gui.Enabled = true
	deps.Movement.SetEnabled(false)
	UI.backdrop(layer, 0.2)
	UI.title(layer, "CONGRATULATIONS!", 76, UDim2.new(0.5, 0, 0, 40), Vector2.new(0.5, 0))
	bunnyViewport(layer, UDim2.fromOffset(260, 260), UDim2.fromScale(0.5, 0.42), snap.menu.custom)
	local panel = UI.panel(layer, UDim2.fromOffset(640, 210), UDim2.fromScale(0.5, 0.76))
	UI.label(panel, { Text = "Every golden carrot is home and King Grumble has learned his manners.\nThanks for playing BUNNY 64!", TextSize = 20, TextWrapped = true, Size = UDim2.new(1, -40, 0, 70), Position = UDim2.fromOffset(20, 16) })
	UI.label(panel, {
		Text = string.format("CLEAR TIME %s     CARROTS %d/%d", fmtTime(s.slot.completedTime), s.slot.carrotCount, s.totalCarrots or 0),
		Font = UI.TITLE, TextSize = 26, TextColor3 = UI.Gold, Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 96),
	})
	local keep = UI.item(panel, "KEEP EXPLORING", { Size = UDim2.fromOffset(300, 44), Position = UDim2.new(0.5, -150, 1, -58) })
	UI.SetNav({ { button = keep, select = Menus.Close } }, Menus.Close)
end

--------------------------------------------------------------------------------
-- Starting / quitting a file
--------------------------------------------------------------------------------

function Menus.StartFile(index)
	if screen ~= "files" then
		return
	end
	screen = "loading"
	clear()
	UI.backdrop(layer, 0)
	UI.title(layer, "LOADING FILE " .. FILE_LETTERS[index] .. "...", 48, UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5))
	local ok = deps.Remotes.SelectSlot:InvokeServer(index)
	if not ok then
		screen = "files"
		showFiles(false)
		return
	end
	local char = player.Character or player.CharacterAdded:Wait()
	char:WaitForChild("Humanoid", 10)
	task.wait(0.3)
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Custom
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		cam.CameraSubject = hum
	end
	deps.onPlay()
	Menus.Close()
end

function Menus.BackToTitle()
	screen = "files"
	gui.Enabled = true
	deps.Hud.SetVisible(false)
	deps.Movement.SetEnabled(false)
	workspace.CurrentCamera.CameraType = Enum.CameraType.Scriptable
	deps.Effects.SetMusic("title")
	showFiles(false)
end

function Menus.SetSnapshot(s)
	snap = s
end

function Menus.Screen()
	return screen
end

function Menus.Init(dependencies)
	deps = dependencies
	UI.Sound = function(name, speed)
		deps.Effects.Play(name, speed)
	end
	gui = Instance.new("ScreenGui")
	gui.Name = "Bunny64Menus"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 10
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = player:WaitForChild("PlayerGui")
	layer = Instance.new("Frame")
	layer.BackgroundTransparency = 1
	layer.Size = UDim2.fromScale(1, 1)
	layer.Parent = gui
	scaler = Instance.new("UIScale")
	scaler.Parent = layer

	-- shrink menus to fit small screens
	local function rescale()
		local size = workspace.CurrentCamera.ViewportSize
		local s = math.min(1, size.X / 900, size.Y / 640)
		scaler.Scale = s
		layer.Size = UDim2.fromScale(1 / s, 1 / s)
	end
	rescale()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)

	-- attract-mode camera while on the title / file screens
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Scriptable
	RunService.RenderStepped:Connect(function(dt)
		if screen ~= nil and not snap or (screen ~= nil and not (snap and snap.slot)) then
			orbit += dt * 0.06
			local pos = Vector3.new(math.cos(orbit) * 190, 75 + math.sin(orbit * 1.7) * 15, 60 + math.sin(orbit) * 190)
			cam.CameraType = Enum.CameraType.Scriptable
			cam.CFrame = CFrame.lookAt(pos, Vector3.new(0, 25, 0))
		end
	end)

	ContextActionService:BindAction("Bunny64Menu", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			Menus.TogglePause()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.M, Enum.KeyCode.ButtonSelect)

	showTitle()
end

return Menus
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001B"><Properties><string name="Name">Movement</string><ProtectedString name="Source"><![CDATA[--[[
	Movement - the bunny's moveset on top of Roblox's humanoid.

	  Jump            Space / A / jump button
	  Double jump     jump again in the air (with a front flip)
	  Roll            Shift / Q / X / ROLL button: a quick tumble that bops bugs
	  Long jump       jump during a roll or a slide
	  Slide           Crouch (C / Ctrl / E / B / CROUCH button) while running.
	                  Ice chutes start a slide automatically; steer with the stick.
	  Ground pound    Crouch in the air
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Bunny64")
local Config = require(Shared:WaitForChild("Config"))

local player = Players.LocalPlayer
local HST = Enum.HumanoidStateType
local DOWN = Vector3.new(0, -1, 0)

local Movement = {}

local Effects, Remotes
local enabled = false
local controls = nil

local character, humanoid, root, lv
local move = "" -- "", roll, longjump, slide, pound
local moveStart = 0
local moveDir = Vector3.new(0, 0, -1)
local moveSpeed = 0
local usedDouble = false
local flipAt = -10
local lastGrounded = 0
local lastJumpRequest = 0
local lastRollEnd = 0
local lastBounce = 0
local airborneSince = nil
local sentMove = nil
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function sendMove(name)
	if name ~= sentMove then
		sentMove = name
		Remotes.SetMove:FireServer(name)
	end
end

local function setPlane(vec)
	if lv then
		lv.PlaneVelocity = Vector2.new(vec.X, vec.Z)
	end
end

local function setMove(name)
	move = name
	moveStart = os.clock()
	if lv then
		lv.Enabled = (name == "roll" or name == "longjump" or name == "slide")
	end
	if name == "" then
		sendMove(os.clock() - flipAt < 0.5 and "flip" or "")
	else
		sendMove(name)
	end
end

local function grounded()
	return humanoid and humanoid.FloorMaterial ~= Enum.Material.Air
end

local function inAir()
	if not humanoid then
		return false
	end
	local s = humanoid:GetState()
	return s == HST.Freefall or s == HST.Jumping
end

local function flatVelocity()
	local v = root.AssemblyLinearVelocity
	return Vector3.new(v.X, 0, v.Z)
end

local function facingDir()
	local md = humanoid.MoveDirection
	if md.Magnitude > 0.1 then
		return Vector3.new(md.X, 0, md.Z).Unit
	end
	local look = root.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	return flat.Magnitude > 0.01 and flat.Unit or Vector3.new(0, 0, -1)
end

-- Walls push back on the velocity we command; follow what physics actually
-- did so the bunny glances along walls instead of grinding into them.
local function followActual()
	local actual = flatVelocity()
	if actual.Magnitude > 4 then
		local d = actual.Unit
		if d:Dot(moveDir) < 0.995 then
			moveDir = d
		end
		if actual.Magnitude < moveSpeed * 0.5 then
			moveSpeed = actual.Magnitude + 4
		end
	end
end

local function floorHit()
	return workspace:Raycast(root.Position, Vector3.new(0, -5, 0), rayParams)
end

--------------------------------------------------------------------------------
-- Moves
--------------------------------------------------------------------------------

local function launch(velocity, kind)
	if not root then
		return
	end
	if move ~= "" then
		setMove("")
	end
	usedDouble = false
	root.AssemblyLinearVelocity = velocity
	if humanoid and velocity.Y > 0 then
		humanoid:ChangeState(HST.Freefall)
	end
	if kind == "stomp" then
		Effects.Play("Stomp", 1.3)
	elseif kind == "hurt" then
		Effects.Play("Hurt", 0.8)
		Effects.Shake(0.8, 0.3)
	elseif kind == "burn" then
		Effects.Play("Burn", 1.3)
		Effects.Shake(0.6, 0.25)
	end
end

local function startRoll()
	if not enabled or not root or move ~= "" or not grounded() or os.clock() - lastRollEnd < Config.RollCooldown then
		return
	end
	moveDir = facingDir()
	moveSpeed = Config.RollSpeed
	setMove("roll")
	setPlane(moveDir * moveSpeed)
	Effects.Play("Roll", 0.9)
	Effects.Burst(root.Position - Vector3.new(0, 2.4, 0), Config.Palette.Path, 5, 3, 0.5, 1)
end

local function startLongJump(speed)
	moveSpeed = math.max(speed or 0, Config.LongJumpSpeed)
	setMove("longjump")
	usedDouble = true -- no double jump out of a long jump
	local v = root.AssemblyLinearVelocity
	root.AssemblyLinearVelocity = Vector3.new(v.X, Config.LongJumpUp, v.Z)
	setPlane(moveDir * moveSpeed)
	task.defer(function()
		-- the humanoid applies its own jump this frame; make sure our arc wins
		if root and move == "longjump" and root.AssemblyLinearVelocity.Y < Config.LongJumpUp - 5 then
			local v2 = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(v2.X, Config.LongJumpUp, v2.Z)
		end
	end)
	Effects.Play("DoubleJump", 0.8)
end

local function startSlide(onChute)
	local hv = flatVelocity()
	if not onChute and hv.Magnitude < 10 then
		return
	end
	moveDir = hv.Magnitude > 1 and hv.Unit or facingDir()
	moveSpeed = math.max(hv.Magnitude, onChute and 30 or Config.SlideStartSpeed)
	setMove("slide")
	setPlane(moveDir * moveSpeed)
	Effects.Play("Roll", 0.7)
end

local function startPound()
	if not enabled or not root or move == "pound" or not inAir() or os.clock() - lastGrounded < 0.1 then
		return
	end
	setMove("pound")
	Remotes.Pound:FireServer("start")
	Effects.Play("Pound", 1.4)
end

local function landPound()
	setMove("")
	local pos = root.Position - Vector3.new(0, 2.6, 0)
	Remotes.Pound:FireServer("land", pos)
	Effects.Shake(1.2, 0.3)
	Effects.Play("Land", 0.8)
end

local function crouch()
	if not enabled or not root then
		return
	end
	if move == "" or move == "longjump" then
		if inAir() and not grounded() then
			startPound()
		elseif move == "" then
			startSlide(false)
		end
	end
end

local function tryJumpMove()
	if not enabled or not root then
		return
	end
	if move == "roll" or (move == "slide" and os.clock() - moveStart > 0.08) then
		startLongJump(moveSpeed + 10)
		return
	end
	if move ~= "" or usedDouble or not inAir() or os.clock() - lastGrounded < 0.15 then
		return
	end
	usedDouble = true
	flipAt = os.clock()
	sendMove("flip")
	local v = root.AssemblyLinearVelocity
	root.AssemblyLinearVelocity = Vector3.new(v.X, Config.DoubleJumpPower, v.Z)
	Effects.Play("DoubleJump", 1.1)
	Effects.Burst(root.Position - Vector3.new(0, 2.5, 0), Color3.fromRGB(230, 222, 204), 6, 4, 0.5, -1)
end

--------------------------------------------------------------------------------
-- Character setup
--------------------------------------------------------------------------------

local function onCharacter(char)
	character = char
	humanoid = char:WaitForChild("Humanoid")
	root = char:WaitForChild("HumanoidRootPart")
	move = ""
	usedDouble = false
	sentMove = nil
	rayParams.FilterDescendantsInstances = { char, Effects.Folder }

	local att = Instance.new("Attachment")
	att.Name = "MoveAttachment"
	att.Parent = root
	lv = Instance.new("LinearVelocity")
	lv.Name = "MoveVelocity"
	lv.Attachment0 = att
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	lv.PrimaryTangentAxis = Vector3.new(1, 0, 0)
	lv.SecondaryTangentAxis = Vector3.new(0, 0, 1)
	lv.MaxForce = 200000
	lv.Enabled = false
	lv.Parent = root

	humanoid.StateChanged:Connect(function(_, new)
		if new == HST.Landed or new == HST.Running then
			usedDouble = false
			lastGrounded = os.clock()
		elseif new == HST.Jumping then
			lastGrounded = os.clock()
			if move == "" then
				Effects.Play("Jump", 1 + math.random() * 0.1)
			end
		end
	end)
end

function Movement.SetEnabled(on)
	enabled = on
	if controls then
		if on then
			controls:Enable()
		else
			controls:Disable()
		end
	end
	if not on and move ~= "" and root then
		setMove("")
	end
end

function Movement.IsEnabled()
	return enabled
end

-- For the animator: what is the local bunny doing right now?
function Movement.State()
	return {
		move = move,
		moveStart = moveStart,
		flipAt = flipAt,
		speed = moveSpeed,
	}
end

--------------------------------------------------------------------------------
-- Per-frame update
--------------------------------------------------------------------------------

local function step(dt)
	if not root or not humanoid or humanoid.Health <= 0 then
		return
	end
	local now = os.clock()
	local onGround = grounded()
	if onGround then
		lastGrounded = now
		airborneSince = nil
	elseif not airborneSince then
		airborneSince = now
	end

	if move == "" and onGround and sentMove == "flip" then
		sendMove("")
	end

	if move == "roll" or move == "longjump" or move == "slide" then
		if now - moveStart > 0.1 then
			followActual()
		end
	end

	if move == "roll" then
		local t = now - moveStart
		moveSpeed = Config.RollSpeed * (1 - 0.35 * t / Config.RollTime)
		setPlane(moveDir * moveSpeed)
		if t > Config.RollTime then
			lastRollEnd = now
			setMove("")
		end
	elseif move == "longjump" then
		local t = now - moveStart
		local md = humanoid.MoveDirection
		if md.Magnitude > 0.1 then
			local want = Vector3.new(md.X, 0, md.Z).Unit
			local blend = math.clamp(dt * 2.4, 0, 1)
			moveDir = (moveDir:Lerp(want, blend)).Unit
		end
		moveSpeed = math.max(moveSpeed - 9 * dt, 26)
		setPlane(moveDir * moveSpeed)
		if onGround and t > 0.15 then
			setMove("")
			Effects.Burst(root.Position - Vector3.new(0, 2.5, 0), Config.Palette.Path, 6, 4, 0.5, 1)
		end
	elseif move == "slide" then
		local hit = floorHit()
		if hit then
			local onChute = hit.Instance:GetAttribute("Slide") == true
			local n = hit.Normal
			local v = moveDir * moveSpeed
			-- gravity pulls you downhill
			local downhill = DOWN - n * n:Dot(DOWN)
			local flatDown = Vector3.new(downhill.X, 0, downhill.Z)
			if flatDown.Magnitude > 0.02 then
				local steep = math.sqrt(math.max(0, 1 - n.Y * n.Y))
				v += flatDown.Unit * Config.Gravity * steep * dt * 1.6
			end
			-- steering
			local md = humanoid.MoveDirection
			if md.Magnitude > 0.1 then
				v += Vector3.new(md.X, 0, md.Z) * (onChute and 50 or 28) * dt
			end
			local speed = v.Magnitude
			if onChute then
				-- chutes keep you moving forward, fast
				speed = math.clamp(speed + 22 * dt, 30, Config.ChuteSpeed)
			else
				speed = math.max(0, speed - Config.SlideFriction * dt)
			end
			if v.Magnitude > 0.01 then
				moveDir = Vector3.new(v.X, 0, v.Z).Unit
			end
			moveSpeed = speed
			setPlane(moveDir * moveSpeed)
			if not onChute and speed < 8 then
				setMove("")
			end
		elseif airborneSince and now - airborneSince > 0.12 then
			-- sailed off an edge: keep the momentum as a glide
			setMove("longjump")
			usedDouble = true
		end
	elseif move == "pound" then
		local t = now - moveStart
		if t < Config.PoundHang then
			root.AssemblyLinearVelocity = Vector3.zero
		else
			root.AssemblyLinearVelocity = Vector3.new(0, -Config.PoundSpeed, 0)
			if onGround then
				landPound()
			elseif t > 4 then
				setMove("")
			end
		end
	elseif move == "" and onGround and enabled then
		-- ice chutes grab you
		local hit = floorHit()
		if hit and hit.Instance:GetAttribute("Slide") then
			startSlide(true)
		end
	end
end

--------------------------------------------------------------------------------

local function onBounceTouch(part, hit)
	if not character or not hit:IsDescendantOf(character) then
		return
	end
	local now = os.clock()
	if now - lastBounce < 0.4 then
		return
	end
	lastBounce = now
	local power = part:GetAttribute("Bounce") or Config.MushroomBounce
	if move == "pound" then
		power *= 1.15
	end
	local v = root.AssemblyLinearVelocity
	launch(Vector3.new(v.X, power, v.Z), "bounce")
	Effects.Play("Boing", 0.7)
	Effects.Burst(part.Position + Vector3.new(0, part.Size.Y / 2, 0), part.Color, 10, 8, 0.7, 3)
end

local function watchBouncers()
	local worldFolder = workspace:WaitForChild("Bunny64World")
	local function hook(d)
		if d:IsA("BasePart") and d:GetAttribute("Bounce") then
			d.Touched:Connect(function(hit)
				onBounceTouch(d, hit)
			end)
		end
	end
	for _, d in ipairs(worldFolder:GetDescendants()) do
		hook(d)
	end
	worldFolder.DescendantAdded:Connect(hook)
end

function Movement.Init(effects, remotes)
	Effects = effects
	Remotes = remotes

	task.spawn(function()
		local ok, module = pcall(function()
			return require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"))
		end)
		if ok and module then
			controls = module:GetControls()
			if not enabled then
				controls:Disable()
			end
		end
	end)

	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	player.CharacterAdded:Connect(onCharacter)

	UserInputService.JumpRequest:Connect(function()
		local now = os.clock()
		local fresh = now - lastJumpRequest > 0.2
		lastJumpRequest = now
		if fresh then
			tryJumpMove()
		end
	end)

	ContextActionService:BindAction("Bunny64Roll", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			startRoll()
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.KeyCode.LeftShift, Enum.KeyCode.Q, Enum.KeyCode.ButtonX)
	ContextActionService:SetTitle("Bunny64Roll", "ROLL")
	ContextActionService:SetPosition("Bunny64Roll", UDim2.new(1, -230, 1, -110))

	ContextActionService:BindAction("Bunny64Crouch", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			crouch()
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.KeyCode.C, Enum.KeyCode.LeftControl, Enum.KeyCode.E, Enum.KeyCode.ButtonB)
	ContextActionService:SetTitle("Bunny64Crouch", "CROUCH")
	ContextActionService:SetPosition("Bunny64Crouch", UDim2.new(1, -170, 1, -170))

	remotes.Bounce.OnClientEvent:Connect(function(vel, keepHorizontal, kind)
		if not root then
			return
		end
		if kind == "reset" then
			if move ~= "" then
				setMove("")
			end
			root.AssemblyLinearVelocity = Vector3.zero
			return
		end
		local v = root.AssemblyLinearVelocity
		if keepHorizontal then
			vel = Vector3.new(v.X, vel.Y, v.Z)
		end
		launch(vel, kind)
	end)

	RunService.Heartbeat:Connect(step)
	task.spawn(watchBouncers)
end

return Movement
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001C"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[--[[
	UI - shared building blocks for Bunny 64's late-90s console look:
	chunky beveled panels with gold trim, gradient title lettering, a bouncing
	carrot cursor, and menu navigation that works with keyboard, gamepad,
	mouse and touch.
]]

local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Bunny64")
local Config = require(Shared:WaitForChild("Config"))
local P = Config.Palette

local UI = {}

UI.TITLE = Enum.Font.LuckiestGuy
UI.BODY = Enum.Font.FredokaOne
UI.Cream = P.UiText
UI.Gold = Color3.fromRGB(246, 200, 86)
UI.Ink = Color3.fromRGB(20, 14, 18)
UI.Navy = Color3.fromRGB(30, 32, 60)

local rgb = Color3.fromRGB

function UI.stroke(inst, thickness, color, mode)
	local s = Instance.new("UIStroke")
	s.Thickness = thickness or 3
	s.Color = color or UI.Ink
	s.ApplyStrokeMode = mode or Enum.ApplyStrokeMode.Contextual
	s.LineJoinMode = Enum.LineJoinMode.Round
	s.Parent = inst
	return s
end

function UI.corner(inst, px)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, px or 10)
	c.Parent = inst
	return c
end

function UI.gradient(inst, colors, rotation)
	local g = Instance.new("UIGradient")
	local keys = {}
	for i, c in ipairs(colors) do
		table.insert(keys, ColorSequenceKeypoint.new((i - 1) / math.max(1, #colors - 1), c))
	end
	g.Color = ColorSequence.new(keys)
	g.Rotation = rotation or 90
	g.Parent = inst
	return g
end

function UI.label(parent, props)
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Font = UI.BODY
	t.TextColor3 = UI.Cream
	t.TextSize = 22
	t.Size = UDim2.new(1, 0, 0, 30)
	local strokeSize = 3
	for k, v in pairs(props) do
		if k == "Stroke" then
			strokeSize = v
		else
			t[k] = v
		end
	end
	if strokeSize > 0 then
		UI.stroke(t, strokeSize)
	end
	t.Parent = parent
	return t
end

-- Big lettering with a gold-to-orange face and a chunky extruded shadow
function UI.title(parent, text, size, pos, anchor, colors)
	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.new(1, 0, 0, size + 16)
	holder.Position = pos or UDim2.new()
	holder.AnchorPoint = anchor or Vector2.new()
	holder.Parent = parent
	for i = 4, 1, -1 do
		local shadow = UI.label(holder, {
			Text = text, Font = UI.TITLE, TextSize = size, TextColor3 = rgb(40 + i * 6, 22 + i * 4, 30 + i * 4),
			Size = UDim2.fromScale(1, 1), Position = UDim2.fromOffset(i * 1.5, i * 2), Stroke = 0,
		})
		shadow.ZIndex = 1
	end
	local face = UI.label(holder, {
		Text = text, Font = UI.TITLE, TextSize = size, TextColor3 = Color3.new(1, 1, 1),
		Size = UDim2.fromScale(1, 1), Stroke = 4,
	})
	face.ZIndex = 2
	UI.gradient(face, colors or { rgb(255, 236, 140), rgb(246, 186, 70), rgb(214, 110, 46) }, 90)
	return holder, face
end

-- Beveled panel with gold trim and a drop shadow
function UI.panel(parent, size, pos, anchor)
	local shadow = Instance.new("Frame")
	shadow.Size = size
	shadow.Position = pos
	shadow.AnchorPoint = anchor or Vector2.new(0.5, 0.5)
	shadow.BackgroundColor3 = Color3.new(0, 0, 0)
	shadow.BackgroundTransparency = 0.55
	shadow.BorderSizePixel = 0
	UI.corner(shadow, 16)
	shadow.Parent = parent
	local f = Instance.new("Frame")
	f.Name = "Panel"
	f.Size = UDim2.new(1, 0, 1, 0)
	f.Position = UDim2.fromOffset(-7, -7)
	f.BackgroundColor3 = Color3.new(1, 1, 1)
	f.BorderSizePixel = 0
	UI.corner(f, 16)
	UI.gradient(f, { rgb(64, 70, 120), rgb(36, 38, 72), rgb(24, 24, 46) }, 90)
	UI.stroke(f, 4, UI.Gold, Enum.ApplyStrokeMode.Border)
	f.Parent = shadow
	local inner = Instance.new("Frame")
	inner.BackgroundTransparency = 1
	inner.Size = UDim2.new(1, -12, 1, -12)
	inner.Position = UDim2.fromOffset(6, 6)
	UI.stroke(inner, 2, rgb(16, 14, 30), Enum.ApplyStrokeMode.Border)
	UI.corner(inner, 12)
	inner.Parent = f
	return f, shadow
end

-- Little carrot drawn with frames (icons, cursor)
function UI.carrot(parent, color, scale, pos, anchor)
	scale = scale or 1
	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.fromOffset(22 * scale, 30 * scale)
	holder.Position = pos or UDim2.new()
	holder.AnchorPoint = anchor or Vector2.new()
	holder.Parent = parent
	local function bit(x, y, w, h, c)
		local f = Instance.new("Frame")
		f.BorderSizePixel = 0
		f.BackgroundColor3 = c
		f.Position = UDim2.fromOffset(x * scale, y * scale)
		f.Size = UDim2.fromOffset(w * scale, h * scale)
		UI.stroke(f, math.max(1, 2 * scale), UI.Ink, Enum.ApplyStrokeMode.Border)
		f.Parent = holder
		return f
	end
	for i, x in ipairs({ 4, 9, 14 }) do
		bit(x, i == 2 and 0 or 3, 4, i == 2 and 10 or 7, color == P.Gold and rgb(236, 222, 170) or P.CarrotLeaf)
	end
	local body = bit(5, 9, 12, 12, color)
	UI.corner(body, 3 * scale)
	bit(7, 20, 8, 6, color)
	bit(9, 25, 4, 4, color)
	return holder
end

-- Scrolling patterned backdrop (sits behind menus)
function UI.backdrop(parent, opacity)
	local bg = Instance.new("Frame")
	bg.Name = "Backdrop"
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color3.new(1, 1, 1)
	bg.BackgroundTransparency = opacity or 0.15
	bg.BorderSizePixel = 0
	bg.ClipsDescendants = true
	bg.Parent = parent
	local grad = UI.gradient(bg, { rgb(46, 52, 104), rgb(70, 44, 92), rgb(38, 70, 96) }, 45)
	local tiles = Instance.new("Frame")
	tiles.BackgroundTransparency = 1
	tiles.Size = UDim2.new(1, 240, 1, 240)
	tiles.Parent = bg
	for gx = 0, 13 do
		for gy = 0, 9 do
			if (gx + gy) % 2 == 0 then
				local c = UI.carrot(tiles, rgb(255, 255, 255), 1, UDim2.fromOffset(gx * 120, gy * 120))
				c.Rotation = 25
				for _, d in ipairs(c:GetDescendants()) do
					if d:IsA("Frame") then
						d.BackgroundTransparency = 0.9
					elseif d:IsA("UIStroke") then
						d.Transparency = 1
					end
				end
			end
		end
	end
	local conn
	conn = RunService.RenderStepped:Connect(function()
		if not bg.Parent then
			conn:Disconnect()
			return
		end
		local t = os.clock()
		local off = (t * 24) % 240
		tiles.Position = UDim2.fromOffset(-off, -off)
		grad.Rotation = 45 + math.sin(t * 0.2) * 20
	end)
	return bg
end

--------------------------------------------------------------------------------
-- Menu navigation
--------------------------------------------------------------------------------
-- entries: { button = GuiButton, select = fn, left = fn?, right = fn? }

local nav = { entries = {}, index = 1, back = nil, sound = nil }
UI.Sound = function() end

local function highlight()
	for i, e in ipairs(nav.entries) do
		local on = i == nav.index
		if e.button and e.button.Parent then
			e.button.TextColor3 = on and UI.Gold or UI.Cream
			local scale = e.button:FindFirstChildOfClass("UIScale")
			if scale then
				TweenService:Create(scale, TweenInfo.new(0.12), { Scale = on and 1.08 or 1 }):Play()
			end
			local cursor = e.button:FindFirstChild("Cursor")
			if cursor then
				cursor.Visible = on
			end
		end
		if e.focus then
			e.focus(on)
		end
	end
end

function UI.SetNav(entries, back, startIndex)
	nav.entries = entries or {}
	nav.back = back
	nav.index = math.clamp(startIndex or 1, 1, math.max(1, #nav.entries))
	for i, e in ipairs(nav.entries) do
		if e.button and not e.hooked then
			e.hooked = true
			e.button.MouseEnter:Connect(function()
				if nav.entries[i] == e and nav.index ~= i then
					nav.index = i
					UI.Sound("MenuMove", 1.3)
					highlight()
				end
			end)
			e.button.Activated:Connect(function()
				if nav.entries[i] == e then
					nav.index = i
					highlight()
					UI.Sound("MenuSelect", 1)
					if e.select then
						e.select()
					end
				end
			end)
		end
	end
	highlight()
end

function UI.ClearNav()
	nav.entries = {}
	nav.back = nil
end

function UI.NavActive()
	return #nav.entries > 0
end

local function moveSel(delta)
	if #nav.entries == 0 then
		return
	end
	nav.index = (nav.index - 1 + delta) % #nav.entries + 1
	UI.Sound("MenuMove", 1.3)
	highlight()
end

local function side(delta)
	local e = nav.entries[nav.index]
	if e then
		local fn = delta < 0 and e.left or e.right
		if fn then
			UI.Sound("MenuMove", delta < 0 and 1.1 or 1.5)
			fn()
			return true
		end
	end
	return false
end

local function activate()
	local e = nav.entries[nav.index]
	if e and e.select then
		UI.Sound("MenuSelect", 1)
		e.select()
	end
end

local KEYS_UP = { [Enum.KeyCode.Up] = true, [Enum.KeyCode.W] = true, [Enum.KeyCode.DPadUp] = true }
local KEYS_DOWN = { [Enum.KeyCode.Down] = true, [Enum.KeyCode.S] = true, [Enum.KeyCode.DPadDown] = true }
local KEYS_LEFT = { [Enum.KeyCode.Left] = true, [Enum.KeyCode.A] = true, [Enum.KeyCode.DPadLeft] = true }
local KEYS_RIGHT = { [Enum.KeyCode.Right] = true, [Enum.KeyCode.D] = true, [Enum.KeyCode.DPadRight] = true }
local KEYS_OK = { [Enum.KeyCode.Return] = true, [Enum.KeyCode.Space] = true, [Enum.KeyCode.ButtonA] = true, [Enum.KeyCode.KeypadEnter] = true }
local KEYS_BACK = { [Enum.KeyCode.Backspace] = true, [Enum.KeyCode.ButtonB] = true }

UserInputService.InputBegan:Connect(function(input, processed)
	if processed or #nav.entries == 0 then
		return
	end
	local k = input.KeyCode
	if KEYS_UP[k] then
		moveSel(-1)
	elseif KEYS_DOWN[k] then
		moveSel(1)
	elseif KEYS_LEFT[k] then
		if not side(-1) then
			moveSel(-1)
		end
	elseif KEYS_RIGHT[k] then
		if not side(1) then
			moveSel(1)
		end
	elseif KEYS_OK[k] then
		activate()
	elseif KEYS_BACK[k] and nav.back then
		UI.Sound("MenuMove", 0.8)
		nav.back()
	end
end)

-- Thumbstick navigation with repeat
local stickReady = true
UserInputService.InputChanged:Connect(function(input)
	if input.KeyCode ~= Enum.KeyCode.Thumbstick1 or #nav.entries == 0 then
		return
	end
	local p = input.Position
	if math.abs(p.X) < 0.4 and math.abs(p.Y) < 0.4 then
		stickReady = true
		return
	end
	if not stickReady then
		return
	end
	stickReady = false
	if math.abs(p.Y) > math.abs(p.X) then
		moveSel(p.Y > 0 and -1 or 1)
	elseif not side(p.X > 0 and 1 or -1) then
		moveSel(p.X > 0 and 1 or -1)
	end
end)

-- A menu row: text button with a bouncing carrot cursor
function UI.item(parent, text, props)
	local b = Instance.new("TextButton")
	b.BackgroundTransparency = 1
	b.AutoButtonColor = false
	b.Font = UI.BODY
	b.Text = text
	b.TextSize = 28
	b.TextColor3 = UI.Cream
	b.Size = UDim2.new(1, 0, 0, 42)
	for k, v in pairs(props or {}) do
		b[k] = v
	end
	UI.stroke(b, 3)
	local scale = Instance.new("UIScale")
	scale.Parent = b
	local cursor = UI.carrot(b, P.Carrot, 1, UDim2.new(0, 6, 0.5, 0), Vector2.new(0, 0.5))
	cursor.Name = "Cursor"
	cursor.Rotation = 90
	cursor.Visible = false
	TweenService:Create(cursor, TweenInfo.new(0.28, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
		Position = UDim2.new(0, 14, 0.5, 0),
	}):Play()
	b.Parent = parent
	return b
end

function UI.list(parent, padding)
	local l = Instance.new("UIListLayout")
	l.Padding = UDim.new(0, padding or 4)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.HorizontalAlignment = Enum.HorizontalAlignment.Center
	l.Parent = parent
	return l
end

return UI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001D"><Properties><string name="Name">WorldFX</string><ProtectedString name="Source"><![CDATA[--[[
	WorldFX - client-side world behaviour:
	  * animates firebars and crushers from the shared server clock
	  * opens golden-carrot gates for players who have enough golden carrots
	  * per-region lighting, fog and music, plus the region title banner
	  * makes King Grumble flash when he's hit
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Bunny64")
local Config = require(Shared:WaitForChild("Config"))
local HazardMath = require(Shared:WaitForChild("HazardMath"))

local player = Players.LocalPlayer
local WorldFX = {}

local Effects, Hud
local hazards = {}
local gates = {}
local goldenCount = 0
local currentRegion = nil
local inArena = false

-- Region looks -------------------------------------------------------------------
local LOOKS = {
	meadow = {
		fog = Color3.fromRGB(176, 182, 172), fogStart = 160, fogEnd = 900, ambient = Color3.fromRGB(132, 124, 112),
		tint = Color3.fromRGB(255, 244, 228), sat = -0.18, clock = 16.3,
	},
	peaks = {
		fog = Color3.fromRGB(196, 206, 214), fogStart = 120, fogEnd = 700, ambient = Color3.fromRGB(138, 144, 156),
		tint = Color3.fromRGB(236, 244, 255), sat = -0.25, clock = 14.5,
	},
	canyon = {
		fog = Color3.fromRGB(206, 178, 140), fogStart = 160, fogEnd = 850, ambient = Color3.fromRGB(150, 126, 100),
		tint = Color3.fromRGB(255, 236, 210), sat = -0.12, clock = 17.2,
	},
	castle = {
		fog = Color3.fromRGB(70, 34, 30), fogStart = 60, fogEnd = 520, ambient = Color3.fromRGB(110, 70, 60),
		tint = Color3.fromRGB(255, 214, 196), sat = -0.1, clock = 18.6,
	},
}

local function regionAt(pos)
	if pos.Z > 470 and math.abs(pos.X) < 320 then
		return "castle"
	elseif pos.Z < -470 then
		return "peaks"
	elseif pos.X > 460 then
		return "canyon"
	end
	return "meadow"
end

local function applyLook(id)
	local look = LOOKS[id]
	local info = TweenInfo.new(2.5, Enum.EasingStyle.Sine)
	TweenService:Create(Lighting, info, {
		FogColor = look.fog, FogStart = look.fogStart, FogEnd = look.fogEnd,
		OutdoorAmbient = look.ambient, ClockTime = look.clock,
	}):Play()
	local grade = Lighting:FindFirstChild("Bunny64Grade")
	if grade then
		TweenService:Create(grade, info, { TintColor = look.tint, Saturation = look.sat }):Play()
	end
end

-- Hazards ---------------------------------------------------------------------------------
local function register(model)
	if not model:IsA("Model") then
		return
	end
	local kind = model:GetAttribute("Kind")
	if kind == "firebar" then
		table.insert(hazards, {
			model = model, kind = kind, pivot = model:GetAttribute("Pivot"),
			speed = model:GetAttribute("Speed"), phase = model:GetAttribute("Phase"),
		})
	elseif kind == "crusher" then
		table.insert(hazards, {
			model = model, kind = kind, base = model:GetAttribute("Base"), drop = model:GetAttribute("Drop"),
			period = model:GetAttribute("Period"), offset = model:GetAttribute("Offset"), last = 0,
		})
	end
end

local function updateHazards()
	local t = HazardMath.Now()
	for _, h in ipairs(hazards) do
		if h.model.Parent then
			if h.kind == "firebar" then
				local a = HazardMath.FirebarAngle(h.speed, h.phase, t)
				h.model:PivotTo(CFrame.new(h.pivot) * CFrame.Angles(0, a, 0))
			else
				local d = HazardMath.CrusherDrop(h.period, h.offset, t)
				h.model:PivotTo(h.base - Vector3.new(0, d * h.drop, 0))
				if d >= 1 and h.last < 1 then
					local char = player.Character
					local root = char and char:FindFirstChild("HumanoidRootPart")
					if root and (root.Position - h.base.Position).Magnitude < 40 then
						Effects.Shake(0.5, 0.2)
						Effects.Play("Land", 0.6)
					end
				end
				h.last = d
			end
		end
	end
end

-- Gates -----------------------------------------------------------------------------------
local function refreshGates()
	for _, g in ipairs(gates) do
		local open = goldenCount >= (g:GetAttribute("GoldenGate") or 0)
		g.CanCollide = not open
		g.Transparency = open and 0.85 or 0.2
	end
end

function WorldFX.SetGoldenCount(n)
	goldenCount = n or 0
	refreshGates()
end

function WorldFX.InArena()
	return inArena
end

function WorldFX.Init(effects, hud)
	Effects, Hud = effects, hud
	local world = workspace:WaitForChild("Bunny64World")
	local hazardFolder = world:WaitForChild("Hazards")
	for _, m in ipairs(hazardFolder:GetChildren()) do
		register(m)
	end
	hazardFolder.ChildAdded:Connect(register)
	for _, d in ipairs(world:WaitForChild("Solid"):GetDescendants()) do
		if d:IsA("BasePart") and d:GetAttribute("GoldenGate") then
			table.insert(gates, d)
		end
	end
	refreshGates()

	local nextZoneCheck = 0
	RunService.RenderStepped:Connect(function()
		updateHazards()

		local now = os.clock()
		if now < nextZoneCheck then
			return
		end
		nextZoneCheck = now + 0.5
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not root then
			return
		end
		local pos = root.Position
		local region = regionAt(pos)
		if region ~= currentRegion then
			currentRegion = region
			applyLook(region)
			for _, r in ipairs(Config.Regions) do
				if r.id == region then
					Hud.RegionBanner(r.name)
				end
			end
			if not inArena then
				Effects.SetMusic(region)
			end
		end
		local arena = (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(0, 0, 800)).Magnitude < 70 and pos.Y > 185
		if arena ~= inArena then
			inArena = arena
			Effects.SetMusic(arena and "boss" or region)
			if arena then
				Hud.RegionBanner("THRONE ROOM")
			end
		end
	end)

	-- Boss flashing while hurt
	task.spawn(function()
		local bossFolder = workspace:WaitForChild("Boss", 60)
		if not bossFolder then
			return
		end
		RunService.RenderStepped:Connect(function()
			local boss = bossFolder:FindFirstChild("KingGrumble")
			if not boss then
				return
			end
			local hurt = boss:GetAttribute("State") == "hurt"
			local flash = hurt and (math.floor(os.clock() * 12) % 2 == 0) and 0.6 or 0
			for _, d in ipairs(boss:GetChildren()) do
				if d:IsA("BasePart") and d.Name ~= "Root" then
					d.LocalTransparencyModifier = flash
				end
			end
		end)
	end)
end

-- Forget the current region so entering the game re-applies its look and music
function WorldFX.ResetRegion()
	currentRegion = nil
	inArena = false
end

function WorldFX.Region()
	return currentRegion
end

return WorldFX
